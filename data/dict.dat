p to strengthen his presidential powers and to cleanse not only the military but other institutions suspected of harboring opponents.","幾乎沒有哪個地區分析人士懷疑，他現在會利用這次失敗的政變來加強自己的總統權力，並清洗不僅是軍隊，還有窩藏反對派的可疑機…"]]],"institutional":[[["adj.",["制度的","公共机构的","学会的","组织机构的"]]],null,3206,2,0,"s:institutionals"],"institutionalization":[[["",["制度化"]]],null,16948,0,0],"institutionalize":[[["v.",["使制度化","使成为惯常的行为","使一成不变","把...送进疯人院"]]],"toefl",11149,1,0,"d:institutionalized/i:institutionalizing/3:institutionalizes"],"instruct":[[["v.",["教","教育","命令","通知"]],["",["托办","指导","指示"]]],"gk cet4 cet6 ky toefl",4243,3,0,"d:instructed/i:instructing/3:instructs",[["Please do as they have instructed you.","請按他們教你的做。"]]],"instruction":[[["n.",["指令","教导","命令"],["(computer science) a line of code written as part of a computer progr…"]]],"zk gk cet4 cet6 ky toefl ielts",1563,2,1,"s:instructions",[["I'll keep the instructions you sent for assembling the furniture.","我會將你傳來的家具組裝說明記下來。"]]],"instructional":[[["adj.",["教学的","教育的"]]],null,4324,0,0],"instructive":[[["adj.",["有益的","增进知识的"]]],"toefl gre",11647,1,0,[["This is an instructive book.","这是本有教育意义的书。"]]],"instructor":[[["n.",["教员","讲师","指导者"]]],"cet6",3211,2,0,"s:instructors",[["I know an English language instructor who comes from Canada.","我认识一个加拿大来的英语教师。"]]],"instrument":[[["n.",["工具","手段","仪器"],["a device that requires skill for proper use"]]],"gk cet4 cet6 ky toefl ielts",1611,3,1,"s:instruments",[["Do you play any other instruments besides the piano?","除了钢琴以外，还会玩什么乐器吗？"]]],"instrumental":[[["adj.",["仪器的","器具的","可作为手段的"]],["",["器械的"]]],"cet6 ky toefl ielts gre",5653,1,0,"s:instrumentals",[["I like instrumental music.","我喜歡器樂。"]]],"instrumentalist":[[["n.",["工具主义者","乐器演奏家"]]],"ky toefl gre",21815,0,0,"s:instrumentalists"],"instrumentation":[[["n.",["乐器法","仪器制造学","仪表化"]],["",["器械用法","器械操作法"]]],null,12089,1,0,"s:instrumentations"],"insubordinate":[[["adj.",["不顺从的","地位不低的"]]],"toefl gre",36912,0,0,"s:insubordinates"],"insubstantial":[[["adj.",["脆弱的","无实体