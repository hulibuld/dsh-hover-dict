.",["移植","移民","移植术"]]],"gre",15416,0,0,"s:transplantations"],"transport":[[["n.",["运输","运输工具","激动","狂喜","流放犯"]],["v.",["传送","运输","流放"]]],"gk cet4 cet6 ky ielts gre",4640,4,1,"d:transported/i:transporting/3:transports",[["The government transported goods to the island by helicopter.","政府用直升機把物資送到了那個小島。"]]],"transportation":[[["n.",["运输","输送","交通车辆","运转","运输费"]]],"cet4 cet6 ielts",2374,2,0,"s:transportations",[["This hotel is conveniently located in terms of public transportation.","這間酒店的交通位置很方便。"]]],"transpose":[[["v.",["调换","颠倒顺序","移项","互换位置"]],["",["转置"]]],"gre",19217,0,0,"d:transposed/i:transposing/3:transposes"],"transverse":[[["adj.",["横的","横向的"]],["n.",["横断物"]]],"cet6",20982,0,0,"d:transversed"],"transvestite":[[["adj.",["爱穿异性服装的","易装癖的"]],["n.",["易装癖者"]]],null,24504,1,0,"s:transvestites"],"trap":[[["v.",["设圈套","设陷阱","诱捕","诱骗","抓住"]],["n.",["圈套","陷阱","诡计","存水弯"]],["",["俘获","陷井"]]],"gk cet4 cet6 ky toefl ielts",3538,3,1,"d:trapped/s:traps/i:trapping",[["We set a trap to catch a fox.","我们设了个陷阱来抓狐狸。"]]],"trapeze":[[["n.",["吊秋千"]]],"gre",22416,0,0,"s:trapezes/i:trapezing"],"trapper":[[["n.",["设陷阱捕兽者","设陷阱猎兽者","看门工"]]],"toefl",15840,0,0,"s:trappers"],"trappings":[[["n.",["马饰","服饰","礼服","装饰品","外部标志"]]],null,11010,1,0],"trash":[[["n.",["垃圾","废物"]],["v.",["丢弃"]]],"ky toefl",4408,1,0,"p:trashed/i:trashing/3:trashes",[["This trash bag does not contain any dangerous chemicals.","这个垃圾袋不含任何有害化学物质。"]]],"trauma":[[["n.",["外伤","损伤","创伤"]]],"ielts",4824,2,0,"s:traumas"],"traumatic":[[["adj.",["外伤的","创伤的"]]],null,7301,0,0],"traumatize":[[["v.",["使受损伤","使受精神创伤"]]],null,15005,1,0,"d:traumatized/3:traumatizes/i:traumatizing",[["Not every addict is traumatized, but there would be a lot fewer addicts if a lot fewer people were traumatized.","不是每個癮君子都有創傷；不過有創傷的人變少，癮君子也會變少。"]]],"travail":[[["n.",["分娩的痛苦","阵痛","辛劳"]],["v.",["发生阵痛","辛劳"]]],null,17612,0,0,"s:travails/i:travailing/p:travailed"],"travel":[[["v.",["旅行","行进","移动","被传播","通过"],["change location; move, travel, or proceed, also m