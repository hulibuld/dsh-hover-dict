ion, the noble person should strive for continuous self-improvement. As the earth's nature is receptive and nurturing, the noble person should cultivate great virtue to support and carry all things.","天行健，君子以自强不息；地势坤，君子以厚德载物。"]]],"vigorously":[[["adv.",["朝气蓬勃","精力充沛","壮健","茁壮","健壮"]]],null,7025,0,0,[["The woodpecker is pecking the tree trunk vigorously.","啄木鸟正在使劲地啄树干。"]]],"vigour":[[["n.",["精力","活力","力量","效力","气势"]]],"cet6",0,1,0],"viking":[[["n.",["海盗"]]],null,5410,1,0,"s:vikings",[["Viking helmets with horns aren't in style in Scandinavia anymore.","斯堪的纳维亚现在已经不流行戴维京人那种有角的头盔了。"]]],"vile":[[["adj.",["恶劣的","肮脏的","低廉的","卑鄙的","极坏的"]]],"gre",13534,1,0,"t:vilest/r:viler",[["Guards! Slap that vile woman's face!","來人，給我掌這賤女人嘴巴！"]]],"vilify":[[["v.",["诽谤","贬低","诋毁","中伤"]]],"gre",17173,0,0,"d:vilified/i:vilifying/3:vilifies"],"villa":[[["n.",["别墅"]]],"cet6",10076,2,0,"s:villas",[["Who owns this villa?","這棟別墅的主人是誰？"]]],"village":[[["adj.",["乡村的","村庄的"]],["n.",["村庄"],["a community of people smaller than a town"]]],"zk gk ielts",1245,4,1,"s:villages",[["To my surprise, there were no people in the village.","奇怪的是，村子裏竟然一個人也沒有。"]]],"villager":[[["n.",["村民"]]],"gk",6100,2,0,"s:villagers",[["The initiative measurably improved quality of life for the villagers.","計劃使村民的生活改善了不少。"]]],"villain":[[["n.",["坏人","恶棍","歹徒","恶徒"]]],null,7948,1,0,"s:villains",[["Afterwards, he set off for Villain Valley.","然后他出发去了恶人谷。"]]],"villainous":[[["adj.",["坏人似的","恶棍的","罪恶的","极坏的"]],["",["歹徒的:邪恶的","恶的"]]],"gre",25669,0,0],"vim":[[["n.",["精力","生气","精神"]]],"gre",32287,0,0],"vinaigrette":[[["n.",["一种油、醋、盐、香料等合成的浓烈调味品"]]],null,11953,0,0,"s:vinaigrettes"],"vindicate":[[["v.",["辩护","证明...无辜","维护","辩解","辩明"]]],"toefl ielts gre",13147,1,0,"d:vindicated/3:vindicates/i:vindicating"],"vindication":[[["n.",["辩护","证明无辜","辩明","辩白"]]],"gre",16226,0,0,"s:vindications"],"vindictive":[[["adj.",["有报仇心的","怀恨的","惩罚的","报复的","复仇的"]]],"gre",18233,1,0],"vine":[[["n.",["藤本植物","葡萄","藤","蔓"]],["v.",["形成藤蔓"]]],"cet4 cet6 toefl",5675