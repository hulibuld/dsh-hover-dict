,1202,4,1,[["Laser printers are generally cheaper to maintain than inkjet printers.","激光打印机一般比喷墨打印机用起来更省钱。"]]],"generate":[[["v.",["产生","发生","导致"],["bring into existence"]]],"cet4 cet6 ky toefl ielts gre",1692,3,1,"d:generated/3:generates/i:generating",[["The atomic reactor generates enormous amounts of thermal energy.","原子反应堆发出大量的热能。"]]],"generation":[[["n.",["一代","一世","产生"],["group of genetically related organisms constituting a single step in …"]],["",["生殖","世代"]]],"gk cet4 cet6 ky gre",1026,4,1,"s:generations",[["We should pass on our culture to the next generation.","我们应当把文化传承到下一代。"]]],"generational":[[["adj.",["生殖的","世代的","代与代之间的","一代的","生育的"]]],null,11821,0,0],"generator":[[["n.",["产生器","发电机","生产者"]],["",["发生器"]]],"cet4 cet6 ky gre",5836,2,0,"s:generators",[["Officials from government and industry are also starting to recognize the potential of the Methane Capture Project. The U.S. Department of Agriculture is funding experimental on-farm sites in Mississippi and several other states. Some large poultry processors are launching renewable energy divisions to power their feed mills. And a fuel company is investigating the possibility of pumping chicken-waste methane instead of natural gas through its pipeline, and to use it to power some of the generators along the way.","政府官員與業界人士也開始意識到「甲烷捕捉計畫」的潛力。美國農業部正在密西西比州及其他數個州資助農場內的實驗場址。部分大…"]]],"generic":[[["adj.",["属类的","一般的"]]],"ielts gre",6445,1,0,"s:generics"],"generosity":[[["n.",["慷慨","宽大"]]],"cet6 gre",7952,0,0,"s:generosities",[["I had great admiration for his generosity.","我很钦佩他的慷慨大方。"]]],"generous":[[["adj.",["慷慨的","有雅量的","大量的","丰富的"]]],"gk cet4 cet6 ky toefl ielts",3886,3,1,[["I don't think that Tom was as generous as he should've been.","我認為湯姆不夠大方。"]]],"generously":[[["adv.",["宽大地","慷慨地","丰盛地"]]],null,10555,0,1,[["Meg always acts generously.","瑪格總是處事大方。"]]],"genesis":[[["n.",["发生","起源","创世记","生殖"]]],"toefl gre",13864,0,0],"genetic":[[["adj.",["创始的","遗传的","起源的","遗传学的","生殖的"]]],"cet4 ky toefl ielts gre",2721,0,0,[["Through genetic modification, we can improve crops.","通过遗传修饰，我们可以改良农作物。"]]],"genetically":[[["adv.",["创始","遗传学","生殖","基因","遗传"]]],"toefl",6747,0,0],"geneticist":[[["n.",["遗传学家"]]],null,13239,0,0,"s:geneticists",[["Neil Gemmell, a geneticist from the University of Otago in New Zealand, led the study that tried to catalog all living species in the lake by extracting DNA from water samples.","紐西蘭奧塔哥大學的遺傳學家尼爾杰梅爾領導了這項研究，試圖透過從水樣本中提取 DNA 來對湖泊中所有生物物種進行編目。"]]],"genetics":[[["n.",["遗传学"]]],"cet6 toefl gre",7640,2,0],"genial":[[["adj.",["和蔼的","亲切的","友善的"]],["",["颏的"]]],"toefl ielts gre",17323,1,0],"genie":[[["n.",["妖怪","鬼"]]],null,18320,0,0],"genital":[[["adj.",["生殖的","生殖器的"]]],null,14000,1,0,"s:genitals",[["Most bans on gender-affirming care explicitly carve out exceptions for the only actual child genital mutilation going on, that against intersex babies.","大多數針對性別肯定照護的禁令都針對陰陽人嬰兒明確規定了唯一豁免，允許他們接受真正的兒童生殖器切割。"]]],"genius":[[["n.",["天才","天赋","精神","神魔"]],["",["特征"]]],"cet4 cet6 ky toefl ielts",4065,2,0,"s:geniuses",[["With data, he's a genius. But with code -- complete numbskull.","在处理资料上，他很有天赋。但编写代码的话，只能说一窍不通。"]]],"genocidal":[[["adj.",["种族灭绝的"]]],null,19872,0,0,[["What kind of person looks up to a genocidal killer and calls him a hero?","什麼樣的人會將種族滅絕者，稱之為“英雄”？"]]],"genocide":[[["n.",["种族灭绝","灭绝整个种族的大屠杀"]],["",["种族灭绝(侵略军队加害居民的罪行)"]]],null,7560,1,0,"p:genocided/s:genocides"],"genome":[[["",["基因组","染色体组"]]],"gre",7379,1,0,"s:genomes"],"genre":[[["n.",["类型","流派"]]],"toefl gre",4496,2,0,"s:genres",[["What genres of music are you into?","你喜欢哪种类型的音乐？"]]],"gent":[[["n.",["绅士"]]],null,19117,1,0,"s:gents"],"genteel":[[["adj.",["有教养的","上流的","优雅的"]]],"toefl gre",15890,1,0],"gentility":[[["n.",["出身高贵","绅士们","上流阶层","斯文","有教养"]]],"toefl",27599,0,0],"gentle":[[["adj.",["温和的","文雅的"]]],"gk cet4 cet6 ky toefl ielts gre",3393,3,1,"p:gentled/i:gentling/3:gentles",[["A gentle wind made ripples on the surface of the pond.","微風在湖面上掀起了一絲絲漣漪。"]]],"gentleman":[[["n.",["绅士","先生"]]],"zk gk cet4 cet6 ky",2447,3,1,"s:gentlemen",[["He must be a gentleman to act that way.","这样的举止只可能是个绅士。"]]],"gentleness":[[["n.",["温顺","柔和","亲切"]]],null,17873,0,0,[["Gentleness and cheerfulness, these come before all morality; they are the perfect duties.","良善和喜樂比道德更加重要，是我們所應盡的絕對義務。"]]],"gently":[[["adv.",["温和地","温柔地","轻轻地","逐渐地"]]],"cet4 cet6 ky",2751,0,1,[["The leaves on the trees rustle gently in the wind.","树叶在风中簌簌作响。"]]],"gentry":[[["n.",["贵族们"]]],"toefl gre",18454,1,0],"genuflect":[[["v.",["曲膝","跪","屈服"]]],"gre",28591,0,0,"p:genuflected/i:genuflecting/3:genuflects"],"genuine":[[["adj.",["真正的","真实的","诚恳的"]],["",["真性的"]]],"cet4 cet6 ky toefl ielts gre",3747,3,1,[["This might not be a genuine diamond.","這可能不是真的鑽石。"]]],"genuinely":[[["adv.",["真诚地","诚实地"]]],null,6439,0,1,[["In fact, love is the only genuinely precious thing in life; it's also the only thing worthy of pursuit.","其實愛情是人生唯一的、真正珍貴的；也是唯一的、真正值得追求的東西。"]]],"genus":[[["n.",["种","类"]],["",["属(分类)"]]],"toefl gre",10828,0,0,"s:genera",[["The Sargasso Sea is a vast patch of ocean named for a genus of free-floating seaweed called Sargassum.","馬尾藻海是一片廣闊的海域，因一種名為「馬尾藻」的自由漂浮海藻而得名。"]]],"geographer":[[["n.",["地理学者"]]],null,12741,0,0,"s:geographers"],"geographic":[[["adj.",["地理(学)的","地区(性)的"]]],"toefl ielts",5436,0,0],"geographical":[[["adj.",["地理学的","地理的"]]],"cet6",6716,2,0],"geographically":[[["",["自通地"]]],null,11601,0,0],"geography":[[["n.",["地理学","地理"]]],"zk gk cet4 cet6 ky ielts",5163,2,1,"s:geographies",[["He did pioneering work in the field of physical geography.","他在自然地理科學界取得了突破性的成果。"]]],"geologic":[[["adj.",["地质的","地质学的"]]],"toefl",16372,0,0],"geological":[[["adj.",["地质学的","地质的"]]],null,8805,1,0],"geologist":[[["n.",["地质学家","地质学者"]]],null,9704,0,0,"s:geologists"],"geology":[[["n.",["地质学","地质情况"]]],"cet4 cet6 ky ielts",11449,1,0,"s:geologies",[["The probe will summarize Mars' geology and past climate, and become the first spacecraft to collect and store Martian rocks and regolith, paving the way for humans to explore the Red Planet.","該探測器會歸納火星的地質和過去的氣候，並成為第一個收集和儲存火星岩石和風化層的探測器，為人類探索這顆紅色星球鋪平道路。"]]],"geomagnetic":[[["adj.",["地磁的"]]],"toefl",34347,0,0],"geometric":[[["adj.",["几何学的","几何学上的","几何学图形的"]]],"toefl",9848,1,0,"s:geometrics"],"geometrical":[[["adj.",["几何学的","几何的"]]],"cet6",22692,0,0],"geometrician":[[["n.",["几何学者"]]],"gre",0,0,0,"s:geometricians"],"geometry":[[["n.",["几何学"]]],"gk cet4 cet6 ky toefl ielts",7851,1,0,"s:geometries",[["The Greeks invented a theoretical model of geometry.","希臘人建立了幾何學的理論模型。"]]],"geopolitical":[[["",["地理的"]]],null,11410,0,0],"georgian":[[["adj.",["乔治王时代的","乔治王时代艺术风格的","乔治亚的"]],["n.",["乔治亚州人","乔治亚人"]]],null,11484,2,0,"s:georgians",[["The languages that have been transliterated within the Tatoeba Project are Japanese, Chinese, Shanghainese, Georgian and Uzbek.","Tatoeba 计划获得了音译的语言为日语、汉语、上海话、格鲁吉亚语及乌兹别克语。"]]],"geothermal":[[["adj.",["地温的","地热的"]]],null,16179,0,0],"geranium":[[["n.",["老鹳草属植物","天竺葵"]],["",["老鹳草"]]],null,16530,1,0,"s:geraniums",[["The red geranium is very beautiful.","红色天竺葵很美。"]]],"geriatric":[[["adj.",["老年病学的","衰老的","老年的","老年医学的","老人学的"]]],null,16808,1,0,"s:geriatrics"],"germ":[[["n.",["细菌","种子","生殖细胞","根源"]],["",["芽胞","胚","胚芽","病菌"]]],"cet4 cet6 ky toefl ielts gre",9241,1,0,"s:germs"],"german":[[["adj.",["德国的","德国人的","德国语的","同父母的"],["of or pertaining to or characteristic of Germany or its people or lan…"]],["n.",["德国人","德语"],["a person of German nationality"]]],"gk cet4 cet6 ielts",1823,0,0,"s:germans",[["I can't remember how to say \"Thank you\" in German.","我想不起「謝謝」用德語怎麼說。"]]],"germane":[[["adj.",["关系密切的","有关的","同样的","恰当的","贴切的"]],["",["锗烷"]]],"toefl gre",20190,0,0],"germany":[[["n.",["德国"]]],"gk cet4 cet6 ielts",0,0,0,[["If you ironed Switzerland, it would be bigger than Germany.","如果把瑞士熨了，会比德国还要大。"]]],"germicide":[[["n.",["杀菌剂"]]],"gre",0,0,0],"germinate":[[["v.",["发芽","萌芽","开始发育","使发芽","使发育"]]],"toefl gre",17457,1,0,"d:germinated/i:germinating/3:germinates",[["What should one do with germinating garlic bulbs?","蒜头发芽了怎么办?"]]],"gerontocracy":[[