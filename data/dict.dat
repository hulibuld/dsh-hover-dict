ing hours were extended.","当工作时间被延长时，工人们忍不住开口抱怨起来。"]]],"extension":[[["n.",["延长","扩充","范围","扩展名","扩充名"]],["adj.",["伸缩的"]]],"gk cet4 cet6 ky toefl ielts",3190,2,1,"s:extensions",[["Grace goes upstairs to the extension telephone.","格雷斯去樓上的分機電話。"]]],"extensive":[[["adj.",["广的","广泛的","多方面的"]],["",["广大的","扩大的"]]],"cet4 cet6 ky toefl ielts",2845,3,1,[["Those selected will have to face extensive medical and psychological tests.","被选上的将会面临大量的医学和精神测试。"]]],"extensively":[[["adv.",["广大","广延","外延","大面积(耕种)","粗放"]]],null,6985,0,0],"extent":[[["n.",["范围","程度","区域"],["the point or degree to which something extends"]]],"cet4 cet6 ky toefl ielts",1758,3,1,"s:extents",[["To what extent do you agree or disagree with this statement?","要你在多大程度上同意或不同意這種說法？"]]],"extenuate":[[["v.",["减轻","为...找借口","低估","藐视"]]],"toefl gre",0,0,0,"i:extenuating/s:extenuates/p:extenuated"],"exterior":[[["n.",["外部","表面","外貌"]],["adj.",["外部的","外在的","表面的"]]],"cet4 cet6 ky toefl ielts",8761,1,0,"s:exteriors"],"exterminate":[[["v.",["扑灭","消灭","根绝"]]],"toefl ielts gre",17637,1,0,"d:exterminated/i:exterminating/3:exterminates"],"extermination":[[["n.",["消灭","根绝"]]],null,18574,0,0,"s:exterminations"],"external":[[["adj.",["外部的","客观的","表面的"]],["n.",["外部","外面"]]],"cet4 cet6 ky toefl ielts",2864,2,0,"s:externals",[["Save it on the external hard drive.","把它保存在外接式硬碟。"]]],"externality":[[["n.",["外形","外在性"]]],null,18904,0,0,"s:externalities"],"externalize":[[["v.",["给...以外型","使客观化","使具体化"]],["",["表面化"]]],"gre",17829,0,0,"p:externalized/i:externalizing/3:externalizes"],"externally":[[["adv.",["在外部","外表上","从外面","在外面","从外部"]]],null,14416,0,0,[["This kind of medicine can only be applied externally.","这种药物只能外用。"]]],"extinct":[[["adj.",["熄灭的","灭绝的","耗尽的"]],["",["消灭了的","过时的","无效的"]]],"cet4 cet6 ky toefl ielts gre",9357,1,0,[["It was during the ice age that the saber-toothed tiger became extinct.","劍齒虎是在冰河時期絕種的。"]]],"extinction":[[["n.",["消失","消灭","废止"]],["",["消光","熄灭"]]],"cet6 toefl gre",6977,0,0,"s:extinctions",[["The Ordovician-Silurian Extinction Event wiped out nearly 85% of marine species.","奧陶紀—志留紀滅絕事件消滅了近 85% 的海洋物種。"]]],"extinguish":[[["v.",["熄灭","使消亡","压制","使减色"]],["",["消灭"]]],"cet6 ky toefl ielts gre",11906,1,0,"d:extinguished/i:extinguishing/3:extinguishes",[["The rain wasn't heavy enough to extinguish the fire.","雨沒大到能把火澆滅。"]]],"extinguisher":[[["n.",["熄灭者","灭火器","消灭者","灭火剂"]]],null,18594,0,0,"s:extinguishers",[["Tom used a fire extinguisher to try and put the fire out.","湯姆試著用滅火器把火撲滅。"]]],"extirpation":[[["n.",["消灭","根除","毁灭"]],["",["摘除"]]],"gre",36139,0,0],"extol":[[["v.",["颂扬","称赞","吹捧"]]],"toefl gre",14621,1,0,"i:extolling/d:extolled/3:extols"],"extort":[[["v.",["勒索","敲诈","强要"]],["",["外旋"]]],"toefl ielts gre",19443,1,0,"d:extorted/i:extorting/3:extorts"],"extortion":[[["n.",["勒索","敲诈","强取","强夺"]]],null,14121,0,0,"s:extortions"],"extra":[[["adv.",["额外地","特别地","非常地"]],["n.",["额外的事物","另外的收费"],["an additional edition of a newspaper (usually to report a crisis)"]],["adj.",["额外的","特别的"]]],"gk cet4 cet6 ky ielts",1543,4,1,"s:extras",[["Do you have an extra English dictionary by any chance?","您碰巧有一本額外的英文字典嗎？"]]],"extract":[[["v.",["(费力地)取出","采掘","榨取","摘录","吸取"]],["n.",["榨出物","精汁","摘录","选段"]],["",["提取"]]],"cet6 ky toefl ielts gre",4971,2,0,"s:extracts/d:extracted/i:extracting",[["She extracts beautiful colors from turmeric.","她从姜黄里提取美丽色彩。"]]],"extraction":[[["n.",["抽出","取出","拔出术","抽出物"]],["",["萃取","提取"]]],"cet6",10457,0,0,"s:extractions"],"extracurricular":[[["adj.",["课外的","业余的"]]],"cet6",13137,0,0],"extradite":[[["v.",["引渡","获取(逃犯等)的引渡","使被引渡"]]],"gre",23897,2,0,"i:extraditing/p:extradited/3:extradites"],"extradition":[[["n.",["引渡逃犯","亡命者送还本国"]],["",["引渡"]]],null,16030,0,0,"s:extraditions"],"extramarital":[[["",["私通的","通奸的"]],["adj.",["婚外的"]]],null,17306,0,0],"extraneous":[[["adj.",["外来的","非必要的","无关的"]],["",["体外的"]]],"toefl gre",17572,0,0],"extraordinarily":[[["adv.",["非凡","破例","特别","非常","离奇"]]],"cet6",7314,0,0,[["A clear conscience is an extraordinarily soft pillow.","問心無愧是一個非常柔軟的枕頭。"]]],"extraordinary":[[["adj.",["非常的","特别的","非凡的","临时的"]]],"gk cet4 cet6 ky toefl",2625,3,1,"s:extraordinaries",[["True art of life is to see the extraordinary amongst the ordinary.","生活真正的艺术是在平凡中看到不平凡。"]]],"extrapolate":[[["v.",["推断","外推"]]],"gre",14252,0,0,"i:extrapolating/d:extrapolated/3:extrapolates",[["Most of the words are faded, but it's still possible to extrapolate the meaning from these sentences.","大部分的字跡已經褪色，但仍可從這些句子中推敲出含意。"]]],"extraterrestrial":[[["adj.",["地球外的","地球大气圈外的"]]],null,15606,0,0,"s:extraterrestrials",[["I was abducted by extraterrestrials.","我被外星人绑架了。"]]],"extravagance":[[["n.",["奢侈","浪费","放肆的言行"]]],"gre",17144,1,0,"s:extravagances",[["Looking back at the former wise rulers and nations, their success was achieved through diligence and frugality, while their downfall was caused by extravagance and luxury.","历览前贤国与家，成由勤俭破由奢。"]]],"extravagant":[[["adj.",["奢侈的","挥霍无度的","浪费的"]]],"cet6 ky toefl ielts",10399,1,0,[["This diamond ring is too extravagant for me.","我覺得這鑽石戒指太奢侈了。"]]],"extravaganza":[[["n.",["狂文","铺张华丽的表演","狂行","狂言","狂剧"]]],null,14853,1,0,"s:extravaganzas",[["The Oscar ceremonies are Hollywood's biggest extravaganza.","奥斯卡颁奖典礼，是好莱坞最盛大的活动。"]]],"extreme":[[["adj.",["极端的","尽头的","极度的","偏激的"]],["n.",["极端","末端"]]],"gk cet4 cet6 ky ielts",2519,3,1,"s:extremes/t:extremest",[["Those who love too much, hate in like extreme.","愛得深，恨得也深。"]]],"extremely":[[["adv.",["极端地","非常地"]]],"gk cet4 cet6",1756,4,1,[["It's not even a little bit cheap, it's extremely expensive!","一点也不便宜，贵得不得了。"]]],"extremism":[[["n.",["极端倾向","极端论","过激主义"]]],null,13094,0,0],"extremist":[[["",["偏激份子"]]],"gre",7916,2,0,"s:extremists"],"extremity":[[["n.",["极端","极点","困境","绝境"]],["",["肢","端"]]],"toefl",13554,0,0,"s:extremities"],"extricable":[[["adj.",["可救出的","可解救的"]]],"gre",0,0,0],"extricate":[[["v.",["使解脱","救出"]]],"toefl gre",16562,0,0,"i:extricating/p:extricated/3:extricates"],"extrinsic":[[["adj.",["外在的","外来的","非国有的","外表的"]],["",["外部的","体外的"]]],"gre",16022,0,0],"extrovert":[[["n.",["外向性格的人"]],["",["外倾者"]]],"gre",27717,1,0,"s:extroverts/p:extroverted"],"extrude":[[["v.",["挤出","压出","逐出","伸出","突出"]]],"toefl gre",25266,0,0,"d:extruded/3:extrudes/i:extruding"],"exuberance":[[["n.",["茂盛","茂盛的生长物","丰富"]]],"gre",13760,0,0],"exuberant":[[["adj.",["繁茂的","丰富的","生气勃勃的"]],["",["生成过多的","高度增生的"]]],"toefl ielts gre",12368,1,0,"s:exuberants"],"exude":[[["v.",["(使)流出","(使)渗出"]]],"toefl gre",12157,1,0,"p:exuded/3:exudes/i:exuding",[["During mating season many animals exude strong fragrances.","很多動物會在交配季節釋放出很強的氣味。"]]],"exult":[[["v.",["非常高兴","欢欣"]]],"gre",20109,0,0,"p:exulted/i:exulting/3:exults",[["The people exulted over their good luck.","人們都為他們的好運感到十分高興。"]]],"exultant":[[["adj.",["非常高兴的","欢欣的"]]],"toefl gre",28122,0,0],"eye":[[["n.",["眼睛","视力","看"],["the organ of sight"]],["v.",["看","注视"]]],"zk gk ielts",242,5,1,"s:eyes/p:eyed/i:eyeing",[["You nearly poked me in the eye with your pencil.","你的鉛筆差點戳到我的眼睛了。"]]],"eye-catching":[[["adj.",["引人注目的","引人瞩目的"]]],"toefl",0,1,0],"eyeball":[[["n.",["眼球"]]],null,10942,1,0,"s:eyeballs/i:eyeballing/p:eyeballed",[["There's no need to worry about accuracy this time; just eyeball it.","现在精确度已经不重要了，你目测一下就好。"]]],"eyebrow":[[["n.",["眉毛"]],["",["眉"]]],"ky",4465,2,0,"s:eyebrows",[["Xiaolin's eyebrows are thick, his eyes are big, and his eyelashes are long.","小林的眉毛长得浓，眼睛又大，睫毛很长。"]]],"eyeglass":[[["n.",["镜片"]]],null,14443,0,0,"s:eyeglasses",[["I tripped in the alleyway in the darkness, as I crashed my knees on the asphalt. There was a wooden board that covered a wire between houses across the alleyway. It was very dark there at night. My eyeglasses fell off my face. Luckily, a Cantonese labourer with a flashlight helped me. My knees just got scraped. I remember another time when I crashed on my knees. It was at Don José Heights in Quezon City in the Philippines. There was a vastness of Martianesque red soil, wherein the \"talahib\" grass grew. Sometimes, workers intentionally set the grass on fire. My brother and I were still playing, even then, outside. We were still prepubescent. Near burning grass, I stumbled on my knees. My grandmother, Lola Bebe, was so angry. A maid washed my legs in the big tiled sink behind the garage.","我在黑暗的巷子中絆倒，膝蓋砸在柏油路上。一塊木板蓋著巷弄的房屋之間的電線。深夜的巷弄非常之暗。我的眼鏡從眼睛上掉了下來…"]]],"eyelash":[[["n.",["睫毛"]],["",["睫"]]],null,13195,1,0,"s:eyelashes/p:eyelashed",[["Xiaolin's eyebrows are thick, his eyes are big, and his eyelashes are long.","小林的眉毛长得浓，眼睛又大，睫毛很长。"]]],"eyelid":[[["n.",["眼皮","眼睑"]],["",["睑"]]],null,8666,1,0,"s:eyelids",[["Were your eyelids stuck together when you woke up this morning?","您今天早上醒來的時候您的眼皮有沒有粘在一起？"]]],"eyepiece":[[["n.",["(接)目镜"]],["",["目镜"]]],null,11332,0,0,"s:eyepieces"],"eyesight":[[["n.",["视力","目力"]]],"gk cet4 cet6 ky ielts",14627,1,0,[["He lost his eyesight in the accident.","他在意外中失明了。"]]],"eyewitness":[[["n.",["目击者","见证人"]]],"gk toefl",8633,1,0,"s:eyewitnesses"],"f":[[["",["故障","假","法拉","字段","标记"]]],"gk",0,0,0,[["J.F. Kennedy was buried in Arlington Cemetery.","约翰甘迺迪被安葬在阿靈頓公墓。"]]],"fab":[[["adj.",["绝好的","极妙的"]],["",["快速原子轰击离子源"]]],null,17732,0,0,"s:fabs"],"fable":[[["n.",["寓言","神话","谎言"]],["v.",["虚构","作寓言"]]],"cet6 ky toefl",12174,1,0,"s:fables",[["\"Drawing dragons and dotting in the eyes\" is a fable.","画龙点睛是一则寓言故事。"]]],"fabled":[[["adj.",["寓言(或传说、神话)中的","虚构的"]]],null,13925,0,0],"fabric":[[["n.",["织物","布","结构","构造","建筑物"]]],"cet4 cet6 ky toefl ielts gre",3059,3,0,"s:fabrics",[["The suits in this row are all made of imported European fabric.","这里一排都是进口面料欧版的西装。"]]],"fabricate":[[["v.",["制造","建造","装配","伪造"]]],"cet6 ky toefl ielts gre",10365,1,0,"d:fabricated/i:fabricating/3:fabricates",[["No external evidence can, at this long distance of time, be produced to prove whether the church fabricated the doctrine called redemption or not.","經過如此漫長的時間，已不可能提出任何外部證據，來證明教會是否捏造了所謂的「救贖」教義。"]]],"fabrication":[[["n.",["制造","建造","虚构的谎言"]],["",["虚谈症"]]],"cet6",11480,0,0,"s:fabrications"],"fabulous":[[["adj.",["传说的","寓言般的","难以置信的"]]],"ky ielts gre",5757,2,0,[["It was a fabulous show which brought us an endless delight.","那是一个给我们带来无穷乐趣的传奇性的演出。"]]],"facade":[[["n.",["建筑物的正面","外观","表面"]]],"toefl gre",7600,1,0,"s:facades",[["That building's facade is bizarre. No idea what the architect was thinking.","這座大樓的外觀很奇怪，不知道設計師是怎麼想的。"]]],"face":[[["v.",["面对","朝","正视","面临","向"]],["n.",["脸","面容","正面","外观"],["the front of the human head from the forehead to the chin and ear to …"]],["",["现场可改变的控制元件"]]],"zk gk toefl ielts",330,5,1,"i:facing/s:faces/d:faced",[["I perceive by your face that you have good news.","我从你的表情猜到你有好消息。"]]],"facedown":[[["n.",["<美>直接对抗","摊牌"]]],null,17892,0,0],"faceless":[[["adj.",["无面的","无个性的","匿名的","无名的"]]],null,15846,1,0],"facelift":[[["n.",["除去面部皱纹的整容手术"]]],"toefl",0,0,0,"s:facelifts/p:facelifted"],"facet":[[["n.",["(多面体的)面","方面","琢面"]],["",["小平面","小面"]]],"cet6 toefl ielts gre",8774,1,0,"s:facets"],"facetious":[[["adj.",["滑稽的","爱开玩笑的"]]],"toefl gre",27377,0,0],"facial":[[["adj.",["脸的","表面的","脸部用的"]],["n.",["美颜","脸部按摩"]]],"gk",5735,2,0,"s:facials",[["I want to pluck your facial hair.","我想拔你的胡须。"]]],"facile":[[["adj.",["容易的","灵巧的","温和的"]]],"toefl gre",19319,0,0],"facilitate":[[["v.",["使容易","促进","帮助","使便利","推进"]]],"cet6 ky toefl ielts gre",3568,1,0,"d:facilitated/3:facilitates/i:facilitating"],"facilitation":[[["",["容易化","助长","接通"]]],"toefl",21857,0,0],"facilitator":[[["n.",["服务商","促进者"]]],null,12000,0,0,"s:facilitators"],"facility":[[["n.",["容易","灵巧","设备","设施","装备"],["a building or place that provides a particular service or is used for…"]]],"cet4 cet6 ky toefl ielts",1297,4,1,"s:facilities",[["After business came to a halt, many bathhouses added new facilities, such as saunas and exercise equipment, in an effort to attract customers.","生意停頓了以後，許多公共浴堂都添置了桑拿浴室、健身器材等的新設備，希望能吸引多點人來光顧。"]]],"facsimile":[[["n.",["摹(真)本","传真","复制","精确复制"]],["v.",["传真","临摹"]],["adj.",["复制的"]]],"toefl gre",18332,0,0,"s:facsimiles",[["Could you send me a map by facsimile?","您能把地图传真给我吗？"]]],"fact":[[["n.",["事实","真实性","真相","细节","论据"],["a piece of information about circumstances that exist or events that …"]]],"zk gk cet4 ky",235,5,1,"s:facts",[["I don't like him much, in fact I hate him.","我不太喜欢他，其实我讨厌他。"]]],"fact-finding":[[["n.",["实情调查","调解","查明事实","调停"]]],null,0,1,0],"faction":[[["",["宗派","派别","小集团"]],["n.",["小派系","内讧"]]],"cet6 toefl gre",5641,3,0,"s:factions"],"factious":[[["adj.",["好搞派系的","好结党营私的"]]],"toefl",42944,0,0],"factitious":[[["adj.",["人为的","人工的","不自然的","人造的","假的"]]],"toefl gre",43371,0,0],"factor":[[["n.",["因素","因数","系数","基因","代理人"],["anything that contributes causally to a result"]],["",["因式"]]],"cet4 ky toefl ielts",729,4,1,"s:factors/i:factoring/p:factored",[["Honesty was the most important factor in his success.","誠實是他成功最重要的因素。"]]],"factorable":[[["",["可分解因子的"]]],"gre",0,0,0],"factory":[[["n.",["工厂","产生地","代理店","商行在国外的代理处"]]],"zk gk ielts",2132,4,1,"s:factories",[["Immediately after it caught fire, the chemical factory blew up.","化学工厂一着火就爆炸了。"]]],"factotum":[[["n.",["家务总管","杂役","爱管闲事者"]],["",["杂工"]]],"gre",39415,0,0,"s:factotums"],"factual":[[["adj.",["事实的","实际的","与事实有关的"]]],"toefl gre",8973,1,0],"faculty":[[["n.",["才能","能力","全体教员","(大学的)系","院系"],["one of the inherent cognitive or perceptual powers of the mind"]]],"cet4 cet6 ky toefl ielts gre",1985,2,0,"s:faculties",[["I study comparative religion in the arts faculty of the University of Turku.","我在图尔库大学文化系学习宗教比较学。"]]],"fad":[[["n.",["时尚"]],["",["黄素腺嘌呤二核苷酸"]]],"gre",11194,1,0,"s:fads"],"faddish":[[["adj.",["趋于时尚的","风行的","流行的"]]],"gre",34379,0,0],"fade":[[["v.",["褪色","消失","凋谢","使褪色"]],["n.",["淡入","淡出"]],["adj.",["平淡的"]]],"gk cet4 cet6 ky toefl ielts gre",2882,3,0,"i:fading/d:faded/3:fades",[["Her beauty will fade in time.","她的美貌會隨着時間而流逝。"]]],"faeces":[[["n.",["粪便"]]],null,0,1,0],"fag":[[["n.",["吃力的工作","苦工"]],["v.",["努力地工作","使劳累"]]],"gre",20870,0,0,"s:fags/p:fagged/i:fagging"],"fagot":[[["n.",["柴把","束薪"]],["v.",["捆","束"]]],"toefl",0,0,0,"i:fagoting/p:fagoted/3:fagots"],"fahrenheit":[[["adj.",["华氏温度计的"]],["n.",["华氏温度计"]]],"cet4 cet6 toefl ielts",0,0,0,[["The temperature today is seventy degrees Fahrenheit.","今天气温是华氏七十度。"]]],"fail":[[["v.",["失败","缺乏","中断","衰退","失灵"],["fail to do something; leave something undone"]],["n.",["不及格"]]],"zk gk",808,5,1,"d:failed/i:failing/3:fails",[["Having failed many times, he never gave up the plan.","雖然失敗了很多次，但是他仍從不放棄。"]]],"fail-safe":[[["n.",["自动防故障装置"]],["adj.",["自动防故障装置的"]],["",["故障保险"]]],"gre",0,0,0,"s:fail-safes"],"failure":[[["n.",["失败","失败者","不足","缺乏","破产"],["an act that fails"]],["",["故障","失效"]]],"gk cet4 ky ielts",1360,4,1,"s:failures",[["He tried to kill himself but it ended in failure.","他试图自杀，但是失败了。"]]],"faint":[[["adj.",["模糊的","微弱的","无力的"]],["n.",["昏厥","昏倒"]],["v.",["昏倒","变得微弱"]]],"cet4 cet6 ky toefl ielts",4117,2,1,"t:faintest/p:fainted/r:fainter/i:fainting/3:faints",[["I feel like I'm going to faint.","我覺得我快昏倒了。"]]],"fainthearted":[[["adj.",["懦弱的","无精神的","胆小的"]]],"gre",0,0,0],"faintly":[[["adv.",["微弱地","模糊地","朦胧地"]]],null,9681,0,1],"fair":[[["adj.",["公平的","按规则进行的","不好不坏的","晴朗的","美丽的"],["free from favoritism or self-interest or bias or deception; conformin…"]],["adv.",["公平地","正面地","有教养地","清楚地"]],["n.",["展览会","市集","美好的事物"],["gathering of producers to promote business"]],["v.",["转晴"],["join so that the external surfaces blend smoothly"]]],"zk gk cet4 cet6 ky toefl",1484,4,1,"s:fairs/r:fairer/t:fairest/i:fairing/p:faired",[["It's not fair! I have to do the hard work!","这不公平！凭什么我必须做艰苦的工作。"]]],"fairground":[[["n.",["举行赛会的场所","露天市场"]]],null,21363,1,0,"s:fairgrounds"],"fairly":[[["adv.",["美观地","公平地","相当地","清楚地"]]],"gk cet4 cet6 ky toefl",2157,3,1,[["Mary is fairly plain, but Tom thinks she's the bee's knees.","玛丽是个平淡无奇的人，但是汤姆却认为她出类拔萃。"]]],"fairness":[[["n.",["晴朗","光明正大","美丽"]],["",["公正","适当"]]],"gk",5954,1,0,[["In all fairness, he did do his best.","说句实话，他真的尽力了。"]]],"fairway":[[["n.",["航路"]]],null,9430,1,0,"s:fairways"],"fairy":[[["n.",["仙女","精灵"]],["adj.",["仙女的"]]],"ky",6368,2,0,"s:fairies",[["The author translated the fairy tale into our mother tongue.","作者將童話翻譯成了我們的母語。"]]],"faith":[[["n.",["信心","信任","忠实","保证","信仰"],["complete confidence in a person or plan etc"]]],"gk cet4 cet6 ky toefl ielts",1326,3,1,"s:faiths",[["He had lost all faith in his ability to succeed.","他完全丧失了能成功的信心。"]]],"faithful":[[["adj.",["忠实的","详确的","可靠的"]],["n.",["信徒"]]],"cet4 cet6 ky toefl",5013,2,1,"s:faithfuls",[["The statue of Hachiko, the faithful dog, stands in front of Shibuya Station.","忠犬八公的雕像伫立在涩谷站前。"]]],"faithfully":[[["adv.",["忠实地","诚心诚意地","深信着地"]]],null,12244,2,1,[["He carried out the scheme faithfully.","他忠实地实行了该计划。"]]],"faithfulness":[[["n.",["忠诚","诚实","正确"]]],"toefl",20790,0,0],"fake":[[["n.",["假货","欺骗","诡计"]],["v.",["假造","仿造","伪装"]],["adj.",["假的"]]],"cet6 ky toefl ielts gre",5098,2,0,"s:fakes/i:faking/p:faked",[["How can you be sure your girlfriend isn't faking her orgasms?","你怎麼確定你的女朋友沒有假裝高潮?"]]],"falcon":[[["n.",["隼","猎鹰"]]],"toefl gre",14005,0,0,"s:falcons/i:falconing",[["Shahina is an Arabic name meaning \"falcon\".","Shahina是阿拉伯名，意思是猎鹰。"]]],"falconer":[[["n.",["以鹰狩猎者","放鹰者","养鹰者"]]],"toefl",29743,0,0,"s:falconers"],"fall":[[["v.",["倒下","落下","来临","失守","阵亡"]],["n.",["落下","瀑布","采伐量","下降","落差"],["the season when the leaves fall from the trees"]],["adj.",["秋天的"]]],"zk gk ielts",410,5,1,"p:fell/d:fallen/i:falling/3:falls",[["Another step, and you would have fallen down the stairs.","再走一步的话，你就已经跌下楼梯了。"]]],"fallacious":[[["adj.",["使人误解的","谬误的","不合理的","骗人的"]]],"toefl gre",27765,0,0,[["Her line of reasoning is attractive, but ultimately fallacious.","她说理的主线引人注目，但从根本上是靠不住的。"]]],"fallacy":[[["n.",["错误的观念(或信念)","谬见","谬论"]],["",["错觉","幻觉","虚妄"]]],"ielts gre",14946,1,0,"s:fallacies"],"fallibility":[[["n.",["易错","易误","出错性"]]],"gre",28935,0,0,"s:fallibilities"],"fallible":[[["adj.",["易错的","可能犯错的"]]],"toefl ielts gre",24585,0,0],"fallout":[[["n.",["原子尘的降下","辐射性微尘","原子尘","附带结果"]],["",["回降"]]],null,9133,1,0],"fallow":[[["adj.",["休耕的","淡棕色的"]],["n.",["休耕地"]]],"toefl gre",18378,0,0,"s:fallows/i:fallowing"],"false":[[["adj.",["错误的","虚伪的","假的","不老实的"]],["adv.",["不准确地","欺诈地"]]],"gk cet4 cet6 ky",2516,3,1,[["The truth is that nothing is totally true or false.","真相是沒有甚麼完全正確或錯誤。"]]],"falsehood":[[["n.",["谎言","虚假(性)","虚伪陈述","谬误"]]],"gre",16951,0,0,"s:falsehoods"],"falsely":[[["adv.",["虚伪地","错误地","不实地"]]],null,12383,0,0],"falsify":[[["v.",["伪造","歪曲","说谎"]]],"gre",16242,1,0,"d:falsified/i:falsifying/3:falsifies",[["The prediction was falsified by the result.","預言被實驗結果推翻了。"]]],"falter":[[["v.",["支吾地说","支吾","蹒跚地走"]],["n.",["颤抖","支吾","踌躇"]]],"ky toefl ielts gre",9324,1,0,"p:faltered/i:faltering/3:falters"],"fame":[[["n.",["名望","名声","传说"]]],"cet4 cet6 ky toefl ielts",4593,2,1,[["Even with all his wealth and fame, he's unhappy.","尽管有金钱和名誉，他还是不幸福。"]]],"famed":[[["adj.",["著名的","闻名的"]]],null,8010,0,0],"familial":[[["adj.",["家族的","家庭的","全家的"]]],null,10809,0,0],"familiar":[[["adj.",["熟悉的","常见的","亲密的"],["well known or easily recognized"]],["n.",["熟友","常客"],["a person attached to the household of a high official (as a pope or b…"]]],"gk cet4 cet6 ky ielts",1492,3,1,"s:familiars",[["All of you are familiar with the truth of the story.","你們所有的人都熟悉這個故事的真相。"]]],"familiarity":[[["n.",["熟悉","精通","亲密"]]],"gre",8057,0,0,"s:familiarities"],"familiarize":[[["v.",["使熟悉","使熟知","使通俗化"]]],"toefl",17746,0,0,"d:familiarized/i:familiarizing/3:familiarizes"],"family":[[["n.",["家庭","家人","族"],["a social unit living together"]],["adj.",["家庭的"]]],"zk gk ielts",147,5,1,"s:families",[["Mr. Meier thought the Neumann family was away on vacation.","Meier先生以为Neumann一家去度假了。"]]],"famine":[[["n.",["饥荒","缺乏","饥饿"]]],"cet4 cet6 ky toefl ielts gre",8193,2,0,"s:famines",[["For a long time, society was strongly hierarchical and unequal, primarily composed of peasants. The most backward, impoverished segment of the population, they were crushed by the weight of taxes, wars, and famines.","在过去一个相当长的时期里，社会都是等级制度森严并且极度不公的，做为社会阶级中最大一部分的贫农常常被赋税，战争，饥荒压得…"]]],"famish":[[["v.",["使挨饿","饥饿","挨饿"]]],"toefl gre",0,0,0,"i:famishing/p:famished/3:famishes",[["I'm famished!","我肚子饿极了。"]]],"famous