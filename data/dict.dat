],"toefl",17553,0,0,"s:elations"],"elbow":[[["n.",["手肘","弯头","扶手"]],["v.",["用手肘推开","推挤"]]],"cet4 cet6 ky toefl ielts gre",3512,2,1,"s:elbows/p:elbowed/i:elbowing",[["Don't put your elbows on the table.","不要把你的手肘放在桌子上。"]]],"elder":[[["n.",["年长者","老人","前辈"]],["adj.",["年长的","资深的"]]],"zk gk cet4 ky ielts",4056,2,0,"s:elders",[["You seem to have mistaken me for my elder brother.","你似乎把我当成我哥哥了。"]]],"elderly":[[["adj.",["过了中年的","稍老的"]]],"cet4 ky ielts",2907,3,1,[["An elderly person in the street fell and broke a leg.","一位老人在街上摔斷了腿。"]]],"eldest":[[["adj.",["最年长的","排行中第一的"]],["n.",["最年长者","排行中第一者"]]],null,9528,1,0,[["His elder sister is older than my eldest brother.","他姐姐比我哥哥大。"]]],"elect":[[["v.",["选举","选择","作选择"]],["n.",["当选人","被选的人"]],["adj.",["被选的","选出的"]]],"gk cet4 ky",2265,4,1,"d:elected/i:electing/3:elects",[["I think that it's unlikely that Tom will get elected.","我觉得汤姆不太可能会当选。"]]],"election":[[["n.",["选举","当选","选择权"],["a vote to select the winner of a position or political office"]]],"cet4 cet6 toefl",801,5,1,"s:elections",[["We were more or less disappointed about the election.","我們或多或少對這次的選舉感到失望。"]]],"elective":[[["adj.",["选举的","根据选举的","选修的"]],["n.",["选修课程"]]],null,11919,0,0,"s:electives"],"elector":[[["n.",["有选举权的人","选举人"]],["",["有选举权者","合格选举人"]]],null,20097,1,0,"s:electors"],"electoral":[[["adj.",["选举人的","选举的","(有关)选举的","由选举人组成的"]]],null,5088,3,0],"electorate":[[["n.",["选民","有选举权者","选区","选举团"]]],"gre",8624,2,0,"s:electorates"],"electric":[[["adj.",["电的","导电的","电动的"]]],"zk gk cet4 cet6 ky",2696,3,1,"s:electrics",[["An electric guitar doesn't sound the same as an acoustic one.","電結他的聲音和木結他不同。"]]],"electrical":[[["adj.",["电的","有关电的"]]],"gk cet4 cet6 ky ielts",3789,2,1,"s:electricals",[["Sharks are sensitive to electrical impulses as well as sound.","鯊魚對電子信號和噪音很敏感。"]]],"electrically":[[["adv.",["电力地","有关电地"]]],null,17986,0,0],"electrician":[[["n.",["电学家","电气技师","电工","电气工人"]]],"cet6 ky ielts",13255,1,0,"s:electricians",[["I am an electrician.","我是一名電工。"]]],"electrici