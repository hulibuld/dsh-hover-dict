, / His musical notes to the heaven.","於是那歡快的小男孩們四處遊蕩，/ 如此喜悅地穿越山丘與山谷，/ 薔薇的芬芳穿過荊棘叢 / 將隨溫柔的夏風飄散：/ 每個…"]]],"covertly":[[["adv.",["偷偷摸摸地","秘密地"]]],null,19127,0,0],"covet":[[["v.",["妄想","垂涎"]]],"gre",12611,0,0,"3:covets/i:coveting/p:coveted",[["Thoreau coveted the plant's strong purple stalk for a cane, and the robins eat its dark crimson-juiced berries.","梭羅垂涎於這種植物強壯的紫色莖稈，將其製成藤條，而知更鳥則以深紅色汁液的漿果為食。"]]],"coveted":[[["adj.",["令人垂涎的","垂涎的","梦寐以求的"]]],null,12278,1,0,[["Thoreau coveted the plant's strong purple stalk for a cane, and the robins eat its dark crimson-juiced berries.","梭羅垂涎於這種植物強壯的紫色莖稈，將其製成藤條，而知更鳥則以深紅色汁液的漿果為食。"]]],"covetous":[[["adj.",["贪婪的","妄想的"]]],"toefl",33282,0,0],"cow":[[["n.",["母牛","母兽"]],["v.",["威胁"]]],"zk gk cet4 cet6 ky gre",3078,3,1,"s:cows/d:cowed/i:cowing",[["The cows were moving very slowly through the long green grass.","牛群在鬱鬱蔥蔥的草地上緩緩移動著。"]]],"coward":[[["n.",["懦弱的人","胆小的人"]]],"cet4 cet6 ky ielts gre",11476,1,0,"s:cowards",[["John is brave in appearance, but is in reality a coward.","約翰看起來很勇敢，但其實是個膽小鬼。"]]],"cowardice":[[["n.",["懦弱"]]],null,16879,0,0],"cowardly":[[["adj.",["怯懦的","懦弱的","胆小的"]]],null,15436,0,0,[["Tom is shy and cowardly.","汤姆害羞胆怯。"]]],"cowboy":[[["n.",["牛仔","牛郎","牧童"]]],"gk toefl",5048,2,0,"s:cowboys"],"cower":[[["v.",["畏缩","退缩","抖缩"]]],"toefl gre",14810,0,0,"i:cowering/p:cowered/3:cowers"],"cowhand":[[["n.",["（美）牧牛工"]]],"toefl",33473,0,0,"s:cowhands"],"coy":[[["adj.",["腼腆的","怕羞的","羞怯的"]]],"gre",17006,1,0],"coyote":[[["n.",["丛林狼","讨厌的家伙"]]],null,8087,0,0,"s:coyotes",[["Is that a coyote?","那是丛林狼吗？"]]],"cozen":[[["v.",["欺骗","瞒"]]],"gre",0,0,0,"d:cozened/i:cozening/3:cozens"],"cozy":[[["adj.",["舒适的","安逸的","惬意的"]],["n.",["(茶壶等的)保暖罩","舒适的座位"]],["v.",["以假话使安心"]]],"cet6 toefl",7168,0,0,"i:cozying/r:cozier",[["His home is furnished in a very cozy way.","他家的布局非常温馨。"]]],"cpa":[[["",["调用程序分析","交叉程序审查程序"]]],null,15100,0,0,"s:cpas"],"cpu":[[["",["中央处理器"]]],null,14004,0,0,"s:cpus"],"crab":[[["v.",["捕蟹","偏航","发牢骚","使偏航","抱怨"]],["n.",["螃蟹","偏航","脾气乖戾的