":[[["n.",["语音学","语音体系","表音拼法"]]],"toefl",39601,0,0,[["Without actually knowing what \"phonetics\" meant and probably not even knowing the alphabet, I was able to think to myself that \"p\" was a harder version of \"b\" as was \"t\" to \"d\", \"k\" to \"g\" and \"s\" to \"z\".","我在不真正了解「語音學」是什麼意思、甚至可能連字母都不熟悉的情況下，自己能夠想到「p」是「b」的較硬版本，「t」對「d…"]]],"phoney":[[["adj.",["假的","假冒的","伪造的"]],["n.",["骗子","假货","假冒者"]]],null,35932,1,0,"s:phoneys"],"phonics":[[["n.",["声学","基础语音教学法"]]],null,19424,0,0],"phonological":[[["adj.",["音位学的","音韵学的"]]],null,18959,0,0],"phony":[[["adj.",["伪造的","假的","不可信的","华而不实的"]],["n.",["假货","假冒者","赝品"]]],"gre",8590,0,0,"s:phonies/t:phoniest"],"phosphate":[[["n.",["磷酸盐","磷酸酯"]]],null,16729,1,0,"s:phosphates/i:phosphating"],"phosphorus":[[["n.",["启明星","金星","磷","磷光体"]],["",["磷P"]]],null,14278,1,0],"photo":[[["adj.",["照相的","摄影用的","详细记录的","逼真的","酷似的"]],["n.",["相片","照片","逼真的描绘"]],["v.",["照相"]]],"zk",1328,5,0,"s:photos",[["My younger brother really likes to take photos of mountains.","我弟弟很喜欢拍山的照片。"]]],"photocopy":[[["n.",["影印","复印件"]],["v.",["影印"]]],"ielts",18377,1,1,"s:photocopies/d:photocopied/i:photocopying"],"photoelectric":[[["adj.",["光电的","灯光摄影装置的"]]],"cet6",31967,0,0],"photograph":[[["n.",["相片","照片","逼真的描绘"],["a representation of a person or scene in the form of a print or trans…"]],["v.",["照相","摄影"],["record on photographic film"]]],"zk gk cet4 cet6 toefl ielts",1481,4,1,"s:photographs/d:photographed/i:photographing",[["Look at these two photographs - which one is better?","你看这两张照片哪张好？"]]],"photographer":[[["n.",["摄影师","摄影者"]]],"gk",3098,0,1,"s:photographers",[["Her acute observation skills make her a very suitable photographer.","她因为敏锐的观察力，很适合当一名摄影师。"]]],"photographic":[[["adj.",["照相的","摄影用的","详细记录的","逼真的","酷似的"]]],"cet4 cet6",6248,2,0],"photography":[[["n.",["摄影","摄影术"]],["",["照相术"]]],"cet6",3986,2,1,[["I have an interest in photography.","我对摄影感兴趣。"]]],"photojournalism":[[["n.",["摄影新闻工作","摄影报道"]]],"ielts",24944,0,0],"photon":[[["n.",["光子","光量子","光度"]]]