n.",["商人","商船","交易者"]]],"cet6",5021,3,0,"s:traders",[["As commercial and cultural contacts between East and West developed, Arab and Persian traders began calling on China along the Silk Road in increasing numbers.","隨著東西方之間的貿易及文化往來日漸發展，越來越多的阿拉伯和波斯商人開始沿著絲路拜訪中國。"]]],"tradesman":[[["n.",["零售商","工匠","商人","店主"]]],"cet6",22615,0,0,"s:tradesmen"],"tradition":[[["n.",["传说","传统","交付","惯例","移交"],["an inherited pattern of thought or action"]]],"gk cet4 cet6 ky",1243,3,1,"s:traditions",[["It is a Chinese tradition to welcome spring with flowers.","用花迎春是中国的传统。"]]],"traditional":[[["adj.",["传统的","惯例的"],["consisting of or derived from tradition"]]],"zk gk cet4 cet6 ielts",925,4,1,[["He's a painter, but he doesn't do traditional Chinese painting.","他是个画家，但他不会画国画。"]]],"traditionalist":[[["n.",["传统主义者","因循守旧者"]]],null,13770,1,0,"s:traditionalists"],"traditionally":[[["adv.",["传统上","传说上","习惯上"]]],"toefl",3705,0,1,[["A new art trend in New York City takes the age-old craft of crocheting to the streets, where traditionally walls and fences have been serving as canvases for graffiti artists.","紐約市出現了一種新的藝術潮流，將古老的鉤編工藝帶到了街頭。在那裡，傳統上，牆壁和柵欄一直是塗鴉藝術家的畫布。"]]],"traduce":[[["v.",["诽谤","中伤","背叛","诋毁"]]],"toefl gre",0,0,0,"d:traduced/i:traducing/3:traduces"],"traffic":[[["n.",["交通","通行","运输","交通量","贸易"],["the aggregation of things (pedestrians or vehicles) coming and going …"]],["v.",["交易","做买卖","用...作交换"],["deal illegally"]]],"zk gk cet4 cet6 ky toefl ielts",1712,3,1,"i:trafficking/p:trafficked/3:traffics",[["The driver does not have responsibility for the traffic accident.","司機不需要為這次的交通意外負責。"]]],"trafficker":[[["n.",["商人","贩子","贩卖者","买卖者"]]],null,10909,1,0,"s:traffickers"],"trafficking":[[["n.",["非法交易"]]],null,9676,0,0],"tragedy":[[["n.",["悲剧","惨案","悲剧作品"]],["",["惨事","灾难","不辛"]]],"cet4 cet6 ky toefl ielts gre",2883,3,0,"s:tragedies",[["A single death is a tragedy, a million deaths is a statistic.","死一个人是悲剧；死上万人是数据。"]]],"tragic":[[["adj.",["悲惨的","悲剧的"]]],"cet6 ky",4259,2,0,[["They both cried after