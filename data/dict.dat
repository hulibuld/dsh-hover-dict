.",["暗指","提及"]]],"toefl gre",8601,1,0,"p:alluded/i:alluding/3:alludes"],"allure":[[["v.",["引诱","吸引"]],["n.",["魅力","诱惑力"]]],"toefl",11876,1,0,"d:allured/i:alluring/3:allures"],"allusion":[[["n.",["提及","暗指"]]],"toefl gre",11191,1,0,"s:allusions"],"ally":[[["v.",["使联盟","使联合","使有关系","结盟"]],["n.",["同盟者","同盟国","助手"]]],"cet6 ky toefl ielts",2408,4,1,"s:allies/d:allied/i:allying",[["Algeria is a close ally of both Russia and China.","阿尔及利亚是俄罗斯和中国的亲密盟友。"]]],"almanac":[[["n.",["年历","历书"]],["",["年鉴"]]],null,19960,0,0,"s:almanacs",[["In an almanac you can find information about the phases of the moon.","你可以在年鑑中找到月相的資訊。"]]],"almighty":[[["adj.",["万能的","全能的"]]],null,11894,1,0],"almond":[[["n.",["杏仁"]]],"gre",7510,1,0,"s:almonds",[["Add the honey, lemon juice, chopped almonds and the chopped apples.","加入蜂蜜，檸檬汁，切碎的杏仁和切碎的蘋果。"]]],"almost":[[["adv.",["几乎","差不多"]]],"zk gk",291,5,1,[["I have been living in Canada for almost five years.","我在加拿大生活了近五年。"]]],"alms":[[["n.",["施舍","救济金","救济品"]]],"gre",23266,0,0],"aloft":[[["adv.",["在高处","在上"]]],"toefl gre",12541,1,0,[["She had an uncomfortable feeling that while this odd child's body might be there at the table her spirit was far away in some remote airy cloudland, borne aloft on the wings of imagination.","她觉得浑身不自在，尽管这个奇怪孩子的身体可能坐在桌子旁，但她的精神却在风尘云雾中遥不可及，高高地于想象力的翅膀上漂浮。"]]],"alone":[[["adj.",["孤独的","单独的","独自的"]],["adv.",["独自地"]]],"zk gk cet4 ky toefl ielts",1097,4,1,[["I used to play alone when I was a child.","我小时候常常独自玩耍。"]]],"along":[[["adv.",["平行地","向前"]],["prep.",["沿着"]]],"zk gk",447,5,1,[["You're not even fazed. You must have known all along!","看你并不感到惊讶，你肯定已经知道了。"]]],"alongside":[[["adv.",["在旁边","靠拢着"]],["prep.",["在...旁边","与...在一起"]]],"gk cet6 ky ielts",4203,3,1,[["Native Chinese people are working alongside foreigners to change the culture of Shanghai.","本地人、外来人齐心共创上海新文明。"]]],"aloof":[[["adj.",["远离的","冷淡的"]],["adv.",["远离","冷漠超然地"]]],"toefl gre",14411,1,0],"aloud":[[["adv.",["出声地","大声地"]]],"zk gk cet4 ky",5694,1,1,[["He thought to himself, \