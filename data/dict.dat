ride":[[["n.",["新娘"]]],"gk ky",4871,2,0,"s:brides",[["According to custom, the bride should be compliant.","根据习俗，新娘应该循规蹈矩。"]]],"bridegroom":[[["n.",["新郎"]]],"gk cet6",24066,0,0,"s:bridegrooms"],"bridesmaid":[[["n.",["女傧相"]]],null,18014,1,0,"s:bridesmaids"],"bridge":[[["n.",["桥","舰桥","桥梁","桥牌","网桥"],["a structure that allows people or vehicles to cross an obstacle such …"]],["v.",["架桥于","跨越"]]],"zk gk ielts",1687,4,1,"s:bridges/d:bridged/i:bridging",[["We enjoyed watching the fireworks on a bridge last summer.","去年夏天，我们在桥上看焰火看得很过瘾。"]]],"bridle":[[["n.",["马勒","约束","系带"]]],"cet6 gre",19059,1,0,"s:bridles/p:bridled/i:bridling"],"brief":[[["v.",["对...作简报","摘要","节录"]],["n.",["摘要","简报"]],["adj.",["简短的","短暂的"]]],"gk cet4 ky toefl",2146,4,1,"d:briefed/s:briefs/i:briefing/t:briefest/r:briefer",[["Could you give us a brief introduction of yourself?","你能簡短地介紹一下你自己嗎？"]]],"briefcase":[[["n.",["公事包"]]],"ky ielts",7660,1,0,"s:briefcases",[["I left my briefcase in the bus.","我把我的公事包留在公車上了。"]]],"briefly":[[["adv.",["简短地","扼要地","简明地","简单地"]]],null,3002,2,1,[["To put it briefly, I do not agree.","简而言之，我不同意。"]]],"brigade":[[["n.",["旅","队","团体","组"]]],null,9282,2,0,"s:brigades/i:brigading/p:brigaded"],"brigadier":[[["n.",["陆军准将","准将"]]],null,25614,1,0,"s:brigadiers"],"bright":[[["adj.",["明亮的","聪明的","鲜明的","欢快的"],["emitting or reflecting light readily or in large amounts"]],["adv.",["明亮地","欢快地"]]],"zk gk",1308,4,1,"r:brighter/t:brightest",[["I'm not a university student, but I'm brighter than them.","我不是一個大學生, 但我比他們更聰明。"]]],"brighten":[[["v.",["变亮","活跃","使生辉","使快活"]]],"cet4 toefl",7814,1,0,"p:brightened/i:brightening/3:brightens"],"brightly":[[["adv.",["生辉地","明亮地","鲜明地"]]],null,6950,0,1,[["The stars are shining very brightly in the sky tonight.","今晚的夜空星光非常明亮。"]]],"brightness":[[["n.",["光亮","明亮","聪明"]],["",["亮度"]]],"cet6",7963,0,0,"s:brightnesses"],"brill":[[["n.",["一种可食用的欧洲比目鱼","鲽类鱼"]]],null,0,1,0],"brilliance":[[["n.",["卓越","光辉"]],["",["辉度"]]],"toefl",10319,0,0,"s:brilliances",[["Emperor Qin Shi Huang and Emperor Wu of Han, though remarkable in their achievements, somewhat lacked in literary grace; Emperor Taizong of Tang and Emperor Taizu of Song, though commendable in their elegance, still fall slightly short in their brilliance. The proud conqueror, Genghis Khan, knew only how to bend the bow and shoot great eagles. All of them are now bygone, and if you want to count the truly remarkable figures, look to the present age.","惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。一代天骄，成吉思汗，只识弯弓射大雕。俱往矣，数风流人物，还看今朝。"]]],"brilliant":[[["adj.",["光辉的","灿烂的","有才气的"]],["",["亮的"]]],"gk cet4 ky ielts",3159,3,1,"s:brilliants",[["A brilliant, seductive chef turns to espionage in Napoleon-era France.","拿破崙時代的法國，魅力誘人的天才廚師搖身一變成為間諜。"]]],"brilliantly":[[["adv.",["辉煌地","光亮地","灿烂地"]]],"toefl",10358,0,0,[["She swims brilliantly well.","她游泳很厉害。"]]],"brim":[[["n.",["边","边缘","(河)边"]],["v.",["注满","使满溢","满溢"]]],"cet4 cet6 ky toefl gre",12307,1,0,"i:brimming/p:brimmed/s:brims",[["His eyes were brimming over with tears.","他热泪盈眶。"]]],"brindled":[[["adj.",["有斑的","有斑纹的"]]],"gre",46987,0,0],"brine":[[["n.",["盐水","海水","海"]],["v.",["用浓盐水处理"]]],null,16183,0,0,"s:brines/i:brining/p:brined"],"bring":[[["v.",["带来","产生","促使","提出","生产"],["take something or somebody with oneself somewhere"]]],"zk gk ielts",215,5,1,"d:brought/i:bringing/3:brings",[["A slip of the tongue often brings about unexpected results.","一時失言常常會帶來意想不到的結果。"]]],"brink":[[["n.",["边缘","陡岸"]]],"toefl ielts gre",7663,2,0,"s:brinks",[["First Contact became humanity's salvation as it was at the brink of self-destruction.","在人類自我毀滅的邊緣，第一次接觸成了福音。"]]],"briny":[[["adj.",["盐水似的","海水似的","咸的"]],["",["含盐度"]]],"toefl",26904,0,0],"brisk":[[["adj.",["强烈的","寒冷而干燥的","活泼的"]],["v.",["使活泼","活跃起来"]]],"cet4 cet6 ky toefl ielts gre",9149,2,0,"r:brisker/i:brisking/t:briskest",[["Sales were brisk during the holiday season but have dropped off since.","假期期間銷售業績暢旺，但之後就下滑了。"]]],"brisket":[[["n.",["动物的胸部","动物的胸肉"]]],null,19497,0,0],"briskly":[[["adv.",["活泼地","精神勃勃地"]]],null,11477,0,0],"briskness":[[["n.",["轻快","活泼"]]],"toefl",45362,0,0],"bristle":[[["v.",["直立","发怒","充满","使直立"]],["n.",["刚毛","猪鬃"]]],"cet4 cet6 gre",11066,1,0,"s:bristles/i:bristling/p:bristled",[["This system is bristling with defects and drawbacks.","这个系统存在着许多缺陷和不尽完善的地方。"]]],"bristol":[[["n.",["布里斯托尔(英国西部港口)"]]],"ielts",0,0,0],"brit":[[["n.",["小海生动物","小鲱鱼"]]],null,0,2,0,"s:brits",[["In London, my hotel was near the Barbican Centre. A memorable event was eating delicious fish and chips wrapped in newspaper, which back home, North Americans could not replicate. My favourite Brits are Olaf Stapledon and J.R.R. Tolkien, respectively a sci-fi writer and a fantasy writer. I have surveyed the British Isles via satellite imagery, and a really interesting area is southwestern England, where there are quaint towns and hamlets.","在倫敦，我住的飯店靠近巴比肯藝術中心。一次難忘的經驗是用報紙包著，吃美味的炸魚薯條，這在北美人家裡是無法複製的。我最喜…"]]],"britain":[[["n.",["英国"]]],"gk ielts",0,0,0,[["In Britain a truck is referred to as a lorry.","英國人把貨車叫作「lorry」。"]]],"british":[[["n.",["英国人","英国英语"],["the people of Great Britain"]],["adj.",["英国的"],["of or relating to or characteristic of Great Britain or its people or…"]]],"gk ielts",1183,0,0,[["Fifty-two per cent of British women prefer chocolate to sex.","有百分之五十二的英國女性喜歡巧克力勝於性。"]]],"briton":[[["n.",["大不列颠人","英国人"]]],null,13551,2,0,"s:britons",[["Tom is a Briton.","湯姆是英國人。"]]],"brittle":[[["adj.",["易碎的","脆弱的","易坏的","脆的","脆性的"]]],"cet4 cet6 ky toefl ielts gre",10220,1,0,"i:brittling"],"bro":[[["",["兄弟（brother）"]]],null,17118,0,0,"s:bros",[["Libertarianism is fashionable in tech bro circles.","自由意志主義在科技男的圈子裡很受追捧。"]]],"broach":[[["n.",["烧肉叉","凿子","钻头"]],["v.",["用凿子修琢(石块)","钻孔","露出水面"]]],"gre",15430,0,0,"d:broached/i:broaching/3:broaches"],"broad":[[["adj.",["宽广的","辽阔的","广大的","显著的"]],["adv.",["宽阔地"]],["n.",["宽阔部分"],["slang term for a woman"]]],"gk cet4 ky",1404,4,1,"r:broader/t:broadest/s:broads",[["We should judge matters on a broader basis.","要有大局观。"]]],"broad-brimmed":[[["",["宽边的"]]],"toefl",0,0,0],