]],["n.",["茎","追踪","高视阔步"]]],"cet6 ky toefl gre",6634,2,0,"s:stalks/p:stalked/i:stalking",[["The lion is stalking its prey.","狮子在跟踪它的猎物。"]]],"stalker":[[["n.",["潜随猎物者"]]],null,16890,0,0,"s:stalkers"],"stall":[[["v.",["关入厩","停顿","推托","支吾","使陷于泥中"]],["n.",["厩","停车处","牧师职位","货摊","托辞"]]],"cet6 ky toefl ielts gre",6674,2,0,"s:stalls/d:stalled/i:stalling",[["For years he has been at the market every Tuesday morning with his fish stall.","他在街市賣魚賣了許多年了，這些年來每逢星期二都會在街市見到他。"]]],"stallion":[[["n.",["种马"]]],null,14932,1,0,"s:stallions",[["Is this a stallion or a mare?","那是一匹公馬還是母馬？"]]],"stalwart":[[["adj.",["高大结实的","坚定的"]],["n.",["健壮的人"]]],"gre",17482,1,0,"s:stalwarts"],"stamina":[[["n.",["精力","活力","耐力","雄蕊"]]],"toefl",12821,1,0,"s:staminas"],"stammer":[[["v.",["口吃","结结巴巴地说"]],["n.",["口吃","结巴"]]],"cet6 gre",14314,1,0,"p:stammered/i:stammering/3:stammers",[["If someone told Bismarck early on that he's a great public speaker, he would be very angry. That's so plain, he would say he is not a good public speaker, I talk with a stammer. I'm a politician, not a good public speaker.","如果有人早期对俾斯麦说他是个很好的演说家，他会很生气。那也太平淡了，他会说自己不是个好演说家，我说话结巴。我是个政治家…"]]],"stamp":[[["n.",["印","邮票","打印器","戳子","图章"]],["v.",["盖章于","顿足","贴上邮票","铭刻","捣碎"]]],"zk gk toefl gre",5139,3,1,"s:stamps/p:stamped/i:stamping",[["Don't forget to put a stamp on your letter.","别忘了在你的信上贴张邮票。"]]],"stampede":[[["v.",["(使)惊跑","(使)蜂拥"]],["n.",["惊跑","蜂拥"]]],null,17310,1,0,"d:stampeded/i:stampeding/3:stampedes",[["Commentators have variously described the sound of vuvuzelas as \"annoying\" and \"satanic\" and compared it with \"a stampede of noisy elephants\", \"a deafening swarm of locusts\", \"a goat on the way to slaughter\", \"a giant hive full of very angry bees\", and \"a duck on speed\".","評論員對巫巫茲拉的聲音作出了各種各樣的描述：除了「煩人」、「像魔鬼一般」之外，還把它比作「一群嘈吵的大象」、「一群嗡嗡…"]]],"stance":[[["n.",["准备击球姿势","站立的姿势","位置","姿态"]],["",["地位","形势"]]],"gre",4447,2,0,"s:stances"],"stanch":[[["v.",["使止血","止住","止血"]],["adj.",["坚固的","防水的","忠实的"]]],"gre",27684,0,0,"i