ious.","她说理的主线引人注目，但从根本上是靠不住的。"]]],"ultimatum":[[["n.",["最后通牒","基本原理","哀的美敦书","最后结论"]]],"toefl ielts",14001,1,0,"s:ultimatums"],"ultra":[[["n.",["极端主义者","过激论者","急进论者"]],["adj.",["过分的","极端的"]]],null,13490,0,0,"s:ultras"],"ultramundane":[[["adj.",["世界之外的","太阳系外的","超俗的","非现世的"]]],"gre",0,0,0],"ultrasonic":[[["n.",["超声波"]],["adj.",["超音速的"]]],"cet6 toefl",21711,0,0],"ultrasonics":[[["n.",["超声学"]]],"toefl",0,0,0],"ultrasound":[[["n.",["超声"]]],null,12215,1,0,"s:ultrasounds",[["I'd like you to have an ultrasound.","我想讓你接受超聲檢查。"]]],"ultraviolet":[[["adj.",["紫外线的","紫外线"]]],"cet6 ky toefl ielts",9521,1,0,[["The ozone in the stratosphere absorbs ultraviolet radiation.","平流層的臭氧會吸收紫外線。"]]],"um":[[["int.",["嗯（表示迟疑）"]]],null,7325,0,0,"s:ums/p:ummed/i:umming",[["Um... can we join your group?","嗯。。。我可以加入你的小组嘛"]]],"umber":[[["n.",["棕土","棕土色"]],["adj.",["棕色的","棕土色的"]],["v.",["涂红棕色于"]]],null,19853,0,0,"s:umbers"],"umbilical":[[["adj.",["脐带的","脐的","近脐的","关系密切的"]]],null,16507,0,0,"s:umbilicals"],"umbrage":[[["n.",["不快","生气","阴影","树荫","怀疑等模糊感觉"]]],"gre",26938,0,0],"umbrella":[[["n.",["伞","雨伞","保护伞"]],["adj.",["伞的","包罗万象的"]],["v.",["用伞遮掩"]]],"zk gk",5664,2,1,"s:umbrellas",[["Don't forget to take an umbrella in case it rains.","如果下雨的話，別忘了帶把傘。"]]],"umm":[[["",["Unlversal Measuring Microscope"]]],null,16789,0,0,"s:umms"],"umpire":[[["v.",["对...进行仲裁","当...的裁判","当裁判"]],["n.",["裁判员","仲裁人"]]],"gre",9861,2,0,"s:umpires/i:umpiring/d:umpired",[["I was asked to umpire the game.","我被要求當這場比賽的裁判。"]]],"unabashed":[[["adj.",["不脸红的","不害羞的","脸皮厚的"]]],null,18291,0,0],"unabashedly":[[["",["老着脸皮"]]],null,18417,0,0],"unable":[[["",["无能力的","无资格的","没有办法的"]],["adj.",["不能的","不会的"]]],"gk cet4 cet6",2136,3,1,[["I am unable to walk as fast as he can.","我走得没他快。"]]],"unacceptable":[[["adj.",["无法接受的","不受欢迎的","不能接受的","难以承认的"]]],null,6531,2,1,[["Not that it's unacceptable.","並不是不可以。"]]],"unaccustomed":[[["adj.",["不习惯的","不惯的","异乎惯例的","不寻常的"]]],null,17468,0,0],"unadorned":[[["adj.",["无装饰的","未装饰的","不加渲染的","朴素的"]]],"toefl",19609,0,0],"unaffected":[[["adj.",["不矫揉造作的","自然的","未受影响的","未被感动的"]],["",["不受影响的"]]],"gre",13116,1,0],"unaided":[[["adj.",["无助的","未受协助的"]]],"toefl",20002,0,0],"unambiguous":[[["",["清晰的","明白的","不模糊的"]],["adj.",["不含糊的","明确的"]]],null,15946,1,0],"unambiguously":[[["adv.",["明白地","不含糊地"]]],null,19910,0,0],"unanimity":[[["n.",["无异议","同意","(全体)一致"]],["",["全体一致","一致同意","合意"]]],"toefl",19111,1,0,[["Read, every day, something no one else is reading. Think, every day, something no one else is thinking. Do, every day, something no one else would be silly enough to do. It is bad for the mind to be always part of unanimity.","每天读一些没有人读的东西。每天想一些没有人想的东西。每天做一些没有人会傻到去做的事。一直和别人保持一致对头脑有害。"]]],"unanimous":[[["adj.",["意见一致的","无异议的"]]],"cet6 ky toefl ielts gre",8826,2,0,[["The election was unanimous.","选举一致通过了。"]]],"unanimously":[[["adv.",["全体一致","无异议","一致同意"]]],null,10452,0,0,[["The board unanimously decided to appoint her as CEO.","董事会一致决定任命她为执行总裁。"]]],"unannounced":[[["adj.",["未经宣布的"]]],null,15841,1,0],"unanswered":[[["adj.",["未答复的","无反应的"]]],null,9901,1,0,[["His question remained unanswered.","他的問題最終沒被回答。"]]],"unanticipated":[[["",["非先行的"]]],null,16086,0,0],"unarmed":[[["adj.",["没有武装的","非武装的","徒手的","手无寸铁的","无突的"]]],null,12344,1,0],"unashamed":[[["adj.",["无羞耻心的","不知耻的","厚脸无耻的","问心无愧的"]],["",["厚颜无耻的","公然的","无羞耻的"]]],null,30979,1,0],"unassuming":[[["adj.",["谦逊的","不装腔作势的"]]],"gre",15838,0,0],"unattainable":[[["adj.",["难到达的","不可得到的"]]],null,19006,0,0],"unattended":[[["adj.",["无人出席的","无随员的","无侍从的","无伴的","未被注意的"]]],null,16293,0,0],"unattractive":[[["adj.",["无吸引力的","无魅力的","乏味的","不美的"]]],null,13841,1,0],"unauthorized":[[["adj.",["未经许可的","无权的","未经授权的"]]],null,10927,1,0],"unavailable":[[["adj.",["得不到的","不能利用的","无用的","不可得的","无效的"]]],null,9876,1,0,"s:unavailables",[["We're sorry. The number you have dialed is currently unavailable.","对不起，您拨打的用户暂时无法接通。"]]],"unavoidable":[[["adj.",["不可避免的","不得已的","不能作废的"]],["",["难免的"]]],"cet6",11557,1,0,[["What happened here was unavoidable.","發生這事是免不了的。"]]],"unaware":[[["adj.",["未认识到的","不知道的","不察觉的","无意的"]]],null,5941,2,0,[["They were carelessly unaware of the danger.","他们粗心大意，还没意识到危险。"]]],"unbalanced":[[["adj.",["不平衡的","错乱的","不稳定的","收支不平衡的","不均衡的"]]],null,16943,1,0],"unbearable":[[["adj.",["无法忍受的","承受不住的"]]],"gk cet4 cet6 toefl",10284,1,0,[["Dan left Linda when life became unbearable with her.","Dan离开了Linda，因为已经没法和她一起过日子了。"]]],"unbeatable":[[["adj.",["无敌的","无与伦比的"]]],null,20703,1,0,[["Liu Bei and Zhuge Liang are an unbeatable team.","刘备和诸葛亮是一支无法战胜的队伍。"]]],"unbeaten":[[["adj.",["未曾挨打的","未搅打的","未走过的","未被击败的"]]],null,18753,2,0,[["Both teams are unbeaten.","兩隊至今均未嘗敗績。"]]],"unbecoming":[[["adj.",["不适合的","不合体的","不相配的"]]],"toefl gre",25108,0,0],"unbeknownst":[[["",["=unbeknown"]]],null,19906,0,0],"unbelievable":[[["adj.",["难以置信的"]]],"gk",6070,2,0,[["Unbelievable!","难以置信！"]]],"unbelievably":[[["adv.",["难以置信地","不可信地"]]],null,13505,0,0,[["The queue for buying tickets was unbelievably long.","买票的人龙竟然那么长！"]]],"unbend":[[["v.",["把...弄直","使...伸直","放松","使松弛","解开"]]],"gre",28359,0,0,"i:unbending/p:unbent/3:unbends"],"unbiased":[[["",["无偏见的","大公无私的","公平的"]],["adj.",["没有偏见的"]]],"toefl",15836,0,0,[["He puts on a show of being impartial and unbiased, but I think he's just a guy with no opinion of his own.","他總在別人面前裝出大公無私的樣子，但依我看，他只不過是個沒有主見的傢伙。"]]],"unbidden":[[["adj.",["未奉命的","未受指使的","自发的","未受邀请的"]]],"gre",0,0,0],"unblemished":[[["adj.",["无瑕疵的","无缺点的","无污点的","清白的"]]],"toefl",22353,0,0],"unborn":[[["adj.",["未诞生的","未来的","在胎内的","原来存在的"]]],null,11469,1,0,[["Mary had an ultrasound to find out the sex of her and Tom's unborn baby.","瑪莉為了知道她和湯姆未出生的孩子的性別，做了超音波檢查。"]]],"unbridgeable":[[["adj.",["不能架桥的","不能逾越的"]]],"toefl",30728,0,0],"unbridled":[[["adj.",["无缰辔的","不受控制的","无拘束的"]]],"toefl gre",16628,0,0],"unbroken":[[["adj.",["未破损的","未被征服的","未打垮的","不屈服的","不涣散的"]]],"toefl",13515,1,0,[["In nostalgic moments we may tend to think of childhood as a time of almost unbroken happiness.","在懷念舊日時光的時刻，我們可能往往想起童年像是有著幾乎完整幸福的一段時期。"]]],"unbutton":[[["v.",["解开...的钮扣","解开钮扣"]]],n