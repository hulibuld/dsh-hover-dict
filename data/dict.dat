nd coal companies in order to minimize the significance of global climate change.","人們很容易將能源和電力小組委員會的大多數成員描述為笨蛋。他們散佈石油和煤炭公司炮製的虛假信息，以最大限度地減少全球氣候…"]]],"misinterpret":[[["v.",["曲解"]]],null,14400,1,0,"d:misinterpreted/3:misinterprets/i:misinterpreting"],"misjudge":[[["v.",["判断错"]]],null,18197,1,0,"d:misjudged/i:misjudging/3:misjudges",[["If I've misjudged you, I'm terribly sorry.","如果我对你产生误解，我实在抱歉。"]]],"mislead":[[["v.",["误导"]]],"cet4 cet6 ky toefl",8670,1,0,"d:misled/i:misleading/3:misleads",[["I didn't want to mislead anyone.","我不想誤導任何人。"]]],"misleading":[[["adj.",["引入歧途的","使人误解的","骗人的"]],["",["误写姓名的","误称的","令人误解的"]]],"toefl",6573,2,0,[["It's a misleading title.","这是一个误导性的标题。"]]],"mismanagement":[[["n.",["管理不善","处置失当"]]],null,13227,0,0],"mismatch":[[["v.",["错配","使...成不相配的婚姻"]],["n.",["错配"]]],null,15966,0,0,"s:mismatches/i:mismatching/d:mismatched"],"misnomer":[[["",["叫错姓名","用词不当","使用不适名称"]],["n.",["取名不当"]]],"gre",19971,0,0,"s:misnomers"],"misogamy":[[["n.",["厌恶结婚"]],["",["厌婚症"]]],"gre",0,0,0],"misperceive":[[["v.",["误解","看错"]]],"gre",33565,0,0,"d:misperceived/i:misperceiving"],"misperception":[[["",["错误知觉"]]],null,18161,0,0,"s:misperceptions",[["This idea is a misperception, and makes no sense.","这个看法是个错觉，并且没道理。"]]],"misplace":[[["v.",["放错地方"]]],null,14641,0,0,"d:misplaced/3:misplaces/i:misplacing"],"misplaced":[[["adj.",["错位的","寄托错的"]]],null,15991,1,0],"misread":[[["v.",["读错","看错"]]],null,15822,0,0,"i:misreading/3:misreads",[["I misread.","我看錯了。"]]],"misrepresent":[[["v.",["不如实地叙述(或说明)","不称职地代表"]]],"ielts gre",16251,1,0,"d:misrepresented/i:misrepresenting/s:misrepresents"],"misrepresentation":[[["",["错误表示法","误列","错误表示","告知不实"]]],"gre",16528,0,0,"s:misrepresentations"],"miss":[[["v.",["未得到","未达到","未听到","未觉察","逃脱"],["fail to perceive or to catch with the senses or the mind"]],["n.",["失误","避免","失败","小姐"],["a failure to hit (or meet or find etc)"]]],"zk gk",833,4,1,"d:missed/i:missing/3:misses",[["He hasn't come yet. He must have missed the bus.","他还没来。他肯定错过公交车了。"]]],"mi