gradations"],"grade":[[["n.",["等级","年级","阶段","成绩","程度"],["a relative position or degree of value in a graded group"]],["v.",["分等","分级","评分","属于某等级","逐渐变化"]]],"zk gk ielts",1426,3,1,"s:grades/d:graded/i:grading",[["They spoke of their high exam grades with understandable pride.","他們很驕傲地談到考試中的好成績，這種驕傲是可以理解的。"]]],"grader":[[["n.",["把东西分类别的人/机器","平路机","推土机"]]],null,7142,0,0,"s:graders"],"gradient":[[["n.",["倾斜度","梯度","坡度","斜率"]],["adj.",["渐升的","渐降的","步行的"]]],"cet6 toefl",14325,1,0,"s:gradients"],"gradual":[[["adj.",["逐渐的","渐增的"]],["n.",["弥撒升阶圣歌"]]],"cet4 cet6 ky ielts",6796,3,1,[["Learning is a gradual process.","学习是一个循序渐进的过程。"]]],"gradually":[[["adv.",["逐渐地"]]],"gk cet4 cet6",2961,0,1,[["To be honest, I've gradually come to dislike the life here.","老實說, 我已經漸漸地不喜歡這裡的生活。"]]],"graduate":[[["v.",["毕业","得学位","逐渐变为","准予...毕业","授予...学位"]],["adj.",["已得学位的","研究生的","毕业的"]],["n.",["毕业生","量杯"]]],"gk cet4 cet6 ky toefl",2115,3,0,"s:graduates/p:graduated/i:graduating",[["If you pass this test, you could graduate next month.","如果你通過這個考試，你下個月就可以畢業了。"]]],"graduation":[[["n.",["毕业","得学位","分划","刻度","分等级"]]],"gk",4759,1,0,"s:graduations",[["I've been really busy with my graduation dissertation recently.","我最近真忙于我的毕业论文。"]]],"graffiti":[[["n.",["墙上乱写乱画的东西"]]],null,8807,1,0,"i:graffitiing",[["A new art trend in New York City takes the age-old craft of crocheting to the streets, where traditionally walls and fences have been serving as canvases for graffiti artists.","紐約市出現了一種新的藝術潮流，將古老的鉤編工藝帶到了街頭。在那裡，傳統上，牆壁和柵欄一直是塗鴉藝術家的畫布。"]]],"graft":[[["v.",["嫁接","移植","贪污"]],["n.",["嫁接","贪污"]]],"toefl gre",14077,1,0,"d:grafted/s:grafts/i:grafting"],"grail":[[["n.",["长期以来梦寐以求的东西"]]],null,20791,1,0,"s:grails"],"grain":[[["n.",["谷粒","颗粒","谷类","纹理","本质"]],["v.",["(使)成谷粒"]]],"gk cet4 cet6 ky toefl ielts gre",3222,3,1,"s:grains/d:grained/i:graining",[["There isn't a grain of truth in what he says.","他说的话全不可信。"]]],"grainy":[[["adj.",["有纹理的","粒状的","多粒的","木纹状的"]]],null,14010,0,0,"r:grainier"],"gram":[[["n.",["克","绿豆"