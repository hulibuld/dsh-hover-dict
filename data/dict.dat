nsive.","这家精品店的服装卖得很贵."]]],"bovine":[[["adj.",["牛的","似牛的","迟钝的"]]],"gre",19406,0,0,"s:bovines",[["At first the forensics team thought that they'd discovered human blood, only to find out later, at the lab, that it was bovine.","一开始法医团队以为他们发现了人血，但后来才在实验室里发现这原来是牛血。"]]],"bow":[[["n.",["弓","眼睛框","鞠躬","屈服"]],["v.",["用弓拉琴","弯成弓形"]]],"gk cet4 cet6 ky toefl",4098,1,0,"p:bowed/s:bows/i:bowing",[["I walked up to her, bowed, and kissed her hand.","我走到她身旁，鞠了个躬，亲吻她的手。"]]],"bowdlerize":[[["v.",["删除","删改"]]],"gre",0,0,0,"p:bowdlerized/i:bowdlerizing/3:bowdlerizes"],"bowel":[[["n.",["肠","内脏","内部"]],["v.",["挖...的内脏"]]],"ky ielts",9380,2,0,"s:bowels"],"bower":[[["n.",["凉亭","树阴处"]]],"gre",23367,1,0,"s:bowers/i:bowering/p:bowered",[["He that hears much and speaks not at all shall be welcome both in bower and hall.","多聽不多言, 裡外人不嫌。"]]],"bowl":[[["n.",["碗","木球","大酒杯"],["a round vessel that is open at the top; used chiefly for holding food…"]],["v.",["滚木球","快而稳地行驶"]]],"zk gk cet4 ky toefl",1829,3,1,"s:bowls/p:bowled/i:bowling",[["Even though I enjoy bowling, I haven't gone bowling recently.","虽然我享受打保龄球，但是我最近没有去打保龄球。"]]],"bowlegged":[[["adj.",["弯腿的"]]],"toefl",0,0,0],"bowler":[[["n.",["玩滚球的人","玩球戏的人","投球手"]]],null,17066,2,0,"s:bowlers"],"bowman":[[["n.",["弓射手","持弓的兵","船首的划手"]]],null,19469,0,0,"s:bowmen"],"box":[[["n.",["盒子","箱","方框","一巴掌"],["a (usually rectangular) container; may have a lid"]],["v.",["装...入盒中","装箱","打耳光","拳击"]]],"zk gk",795,4,1,"s:boxes/d:boxed/i:boxing",[["I want a box in which to keep these toys.","我想要个能装这些玩具的盒子。"]]],"boxcar":[[["n.",["有盖货车"]],["",["转换盒"]]],null,19543,0,0,"s:boxcars"],"boxer":[[["n.",["拳师"]]],null,8192,2,0,"s:boxers",[["In Spain, they wear red boxers or knickers on Christmas.","在西班牙，聖誕節要穿紅內褲紅內衣。"]]],"boxy":[[["adj.",["似盒子的","盒状的"]]],null,19736,0,0,"r:boxier"],"boy":[[["n.",["男孩","少年","儿子"],["a friendly informal reference to a grown man"]]],"zk gk",382,5,1,"s:boys",[["As a boy, I used to swim in the pond.","我還是個小男孩時常去池塘游泳。"]]],"boycott":[[["n.",["联合抵制"]],[