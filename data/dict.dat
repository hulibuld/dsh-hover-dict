ony":[[["n.",["阳台","戏院楼厅"]]],"gk cet4 cet6 ky toefl ielts",5799,2,0,"s:balconies/p:balconied",[["The family is eating breakfast on the balcony.","一家人在陽臺上吃早飯。"]]],"bald":[[["adj.",["秃头的","光秃的","单调的","赤裸的"]],["v.",["变秃"]]],"cet6 ky toefl ielts",6185,2,0,"r:balder/t:baldest/i:balding/d:balded",[["He's a quiet man, a little bald on top.","他是个很安静的人，头顶有点秃。"]]],"baldness":[[["n.",["光秃","率直","枯燥"]],["",["秃","脱发"]]],"ielts",21772,0,0],"bale":[[["n.",["包","捆","货物","灾难"]],["v.",["打包","捆包"]]],"gre",11466,1,0,"s:bales/p:baled/i:baling",[["Bale was fouled, and his team was awarded a free kick.","贝尔被犯规了，球队获得了任意球。"]]],"baleful":[[["adj.",["有害的","恶意的"]]],"gre",26489,0,0],"balk":[[["v.",["阻止","错过","推诿","逡巡不前"]],["n.",["障碍","错误","失败"]]],"toefl gre",10330,1,0,"p:balked/s:balks/i:balking"],"balkan":[[["adj.",["巴尔干的"]]],null,15692,0,0],"balky":[[["adj.",["停蹄不前的"]]],"gre",26666,0,0],"ball":[[["n.",["球","舞会","球状物"],["round object that is hit or thrown or kicked in games"]],["v.",["捏成球形"]]],"zk gk",912,4,1,"s:balls/p:balled/i:balling",[["Seen from the moon, the earth looks like a ball.","从月球上看的话，地球看起来像个皮球。"]]],"ballad":[[["n.",["歌谣"]]],"gre",9402,1,0,"s:ballads",[["It's Lulu Island, 3 August 2025. After supper—green figs tender with sunlight, sweet vinegar from yesterday’s pickled jar, and reheated Alfredo—I sat on the balcony and watched the conifer. Stillness below, a street without cars, without haste. My lime water, iced, caught the light. Michael, the Franco-Danish ufologist, has been in my conversations lately. We speak of inner things: the trance of smart devices, the mind’s eye dwindling. He says cafés aren’t cafés anymore. People forget how to look, how to linger. I tell him of Arthur in Japan—how he'd stare into blank walls like a monk gazing at emptiness. Lately I ask machines to speak like poets, and they do. They mimic Elizabethan verses and the old wistful lilt of Tagalog ballads. I pick blackberries along the path to Tim Hortons. \"¡Moras!\" I shout like a child. My friend Mora, whose blood flows with Andes mist, would smile. Today, I bought lemons. I meant limes, but lemons are all right. / blackberry morning— / a fig's ghost on my fingers / and the street still sleeps","現在是 2025 年 8 月 3 日，露露島。晚餐後，陽光下嫩綠的無花果，昨天醃製的甜醋，還有重新加熱的阿爾弗雷多義麵…"]]],"ballast":[[["n.",["压载物","压舱物"]],["",["底货","压舱货"]]],"gre",14813,1,0,"p:ballasted/i:ballasting/s:ballasts"],"ballerina":[[["n.",["芭蕾舞女演员"]]],"gre",15542,1,0,"s:ballerinas"],"ballet":[[["n.",["芭蕾舞"]]],"gk cet6 ky toefl ielts",6552,2,0,"s:ballets",[["My husband and I are going on Sunday to see the ballet, Carmen, performed by the National Ballet Company at the Four Seasons Centre.","我和丈夫周日要去四季演艺中心，去看国家芭蕾舞团表演的芭蕾舞剧《卡门》。"]]],"ballgame":[[["n.",["（美）棒球运动"]]],null,17128,0,0],"ballistic":[[["",["射击的","冲击的"]],["adj.",["弹道的"]]],null,9950,1,0,"s:ballistics",[["They unveiled new ballistic missiles.","他們推出了新型彈道飛彈。"]]],"balloon":[[["v.",["使成气球状","膨胀如气球","激增"]],["n.",["气球"]]],"zk gk cet4 ky toefl ielts gre",4774,2,0,"s:balloons/p:ballooned/i:ballooning",[["The balloon was caught in the tree.","這顆氣球被樹絆住了。"]]],"balloonist":[[["n.",["驾驶/操纵气球的人"]]],"toefl",34953,0,0,"s:balloonists"],"ballot":[[["v.",["投票","抽签","投票选出","拉选票"]],["n.",["投票","投票用纸","抽签"]]],"cet6 ky toefl ielts gre",3706,3,0,"s:ballots/i:balloting/p:balloted",[["At a time when women's voices were silenced and their hopes dismissed, she lived to see them stand up and speak out and reach for the ballot. Yes, we can.","妇女当时没有投票权，她们的希望被挫败，但是安-尼克松-库波尔活着看到妇女们站了起来，看到她们站出来发表自己的见解，看到…"]]],"ballpark":[[["n.",["（美）棒球场","活动领域","可变通范围"]]],null,9072,0,0,[["You can go to the ballpark on this bus.","坐這個公車可以到球場。"]]],"ballplayer":[[["n.",["棒球手"]]],null,14842,0,0],"ballpoint":[[["n.",["圆珠笔"]]],"gk",24069,0,0,"s:ballpoints",[["My ballpoint pen just ran out of ink.","我的原珠筆沒墨了。"]]],"ballroom":[[["n.",["舞厅","跳舞场"]]],"ielts",9032,1,0,"s:ballrooms"],"balm":[[["n.",["镇痛软膏","香膏"]],["",["香树膏","香脂"]]],"gre",14452,1,0,"s:balms/p:balmed",[["I tend to collect tiny little objects, like balms sold on the market, little candles and candlesticks. As long as they are tiny and cutesy, I like them.","我习惯于收集琐碎的物件，像是集市上卖的香膏，小蜡烛与烛台，只要是那种小巧又可爱的东西，我都会很喜欢。"]]],"balmy":[[["adj.",["芳香的","温和的","止痛的"]],["",["香脂气味的"]]],"toefl gre",17136,0,0,"t:balmiest/r:balmier"],"baloney":[[["n.",["胡扯","大红肠"]]],null,19617,0,0,[["What you said is baloney.","你说的东西是胡扯。"]]],"balsamic":[[["adj.",["香膏质的","如香油的","镇静的"]],["",["香脂性的","香脂的"]]],null,13598,0,0],"baltic":[[["adj.",["波罗的海的"]]],null,11602,0,0],"bamboo":[[["n.",["竹子"]],["",["竹类"]]],"zk gk cet6 ielts",8248,1,0,"s:bamboos",[["In spring, the bamboo grove outside Hsinchu City is especially green.","春天的時候，新竹城外的竹林特別翠綠。"]]],"bamboozle":[[["v.",["欺骗","迷惑"]]],"gre",30889,0,0,"p:bamboozled/i:bamboozling/s:bamboozles"],"ban":[[["v.",["禁止","取缔"]],["n.",["禁令"]]],"gk cet4 cet6 ky toefl ielts gre",3273,4,1,"d:banned/i:banning/s:bans",[["Germany is to ban employers from snooping on Facebook.","德国将禁止雇主在脸书上偷窥。"]]],"banal":[[["adj.",["平凡的","陈腐的"]]],"gre",16209,1,0],"banana":[[["n.",["香蕉"]]],"zk gk",4677,2,0,"s:bananas",[["Time flies like an arrow; fruit flies like a banana.","光陰飛逝如箭; 果蠅喜歡香蕉。"]]],"band":[[["n.",["带子","队","乐队"],["instrumentalists not including string players"]],["",["频带","波段","区"]],["v.",["联合","结合"]]],"gk cet4 ky toefl ielts gre",1277,4,1,"s:bands/d:banded/i:banding",[["We need to band together to beat the enemy.","我们必须团结起来才能战胜敌人。"]]],"bandage":[[["n.",["绷带","帘布筒","实心轮胎","紧带"]]],"gk cet6 ky ielts gre",9428,1,1,"s:bandages/d:bandaged/i:bandaging",[["He cleansed the wound before putting on a bandage.","他先清洗了伤口，再绑上绷带。"]]],"bandanna":[[["n.",["一各印花大手帕"]]],"toefl",17577,0,0,"s:bandannas"],"bandit":[[["n.",["强盗"]]],"cet6 toefl",11776,1,0,"s:bandits"],"bandleader":[[["n.",["伴舞乐队的指挥"]]],"toefl",25439,0,0,"s:bandleaders"],"bandmaster":[[["n.",["管乐队指挥"]]],"toefl",0,0,0],"bandwagon":[[["n.",["乐队彩车","流行"]]],null,14374,1,0,"s:bandwagons/i:bandwagonning"],"bandwidth":[[["n.",["频带宽度","通带宽度"]],["",["带宽","频宽"]]],null,12921,0,0,"s:bandwidths"],"bandy":[[["v.",["打来打去","谈论","往复投掷"]],["adj.",["向外弯曲的"]]],"gre",24176,0,0,"d:bandied/i:bandying/3:bandies"],"bane":[[["n.",["祸根","毒药","灭亡的原因","灭亡","毒物"]]],"gre",21357,0,0,"s:banes"],"bang":[[["n.",["重击","突然巨响","刘海"]],["adv.",["砰然地","突然巨响地","直接地"]],["v.",["发巨响","重击"]],["",["撞击符"]]],"gk cet4 cet6 ky toefl ielts",5069,2,0,"i:banging/p:banged/s:bangs",[["She banged the table with her fist.","她用拳頭拍了桌子。"]]],"banish":[[["v.",["驱逐","消除","流放"]]],"toefl ielts gre",9415,1,0,"d:banished/i:banishing/3:banishes"],"banister":[[["n.",["栏杆的支柱","楼梯的扶栏"]]],"gre",19144,0,0,"s:banisters"],"banjo":[[["n.",["班卓琴"]]],null,16146,1,0,"s:banjos",[["I bought Tom a banjo for Christmas.","我給湯姆買了把斑卓琴作聖誕禮物。"]]],"bank":[[["n.",["银行","堤","岸"],["sloping land (especially the slope beside a body of water)"]],["",["库"]]],"zk gk ielts",663,1,1,"s:banks/i:banking/d:banked",[["This is a post office and that is a bank.","这是邮局，那是银行。"]]],"banker":[[["n.",["银行家","庄家","银行业者"]]],"cet6 toefl",4421,3,0,"s:bankers"],"banknote":[[["n.",["钞票"]]],null,28997,1,0,"s:banknotes",[["This banknote is a forgery.","这张钞票是假造的。"]]],"bankrupt":[[["n.",["破产者"]],["adj.",["破产的"]],["v.",["使破产"]]],"cet6 ky toefl ielts gre",8878,2,0,"s:bankrupts/d:bankrupted/i:bankrupting",[["The company went bankrupt. We laid off all of the employees.","公司倒閉了。我們遣散了所有員工。"]]],"bankruptcy":[[["",["破产","倒闭"]],["n.",["破产者"]]],"cet6 toefl",4171,2,0,"s:bankruptcies"],"banner":[[["adj.",["显著的","特别好的"]],["n.",["旗帜"]]],"cet4 ky toefl ielts",5333,2,0,"s:banners/p:bannered",[["The protesters threatened to stomp on the banners left by their opposition.","抗議者威脅要踐踏反對者留下的橫幅。"]]],"banquet":[[["n.",["宴会"]]],"cet6 ky toefl ielts gre",9056,1,0,"s:banquets/i:banquetting/p:banqueted",[["Some Shanghainese hold large banquets when they get married.","上海人结婚，有的人家办酒宴场面很大。"]]],"banter":[[["n.",["戏谑","嘲弄"]],["v.",["戏弄","开玩笑"]]],"gre",16960,1,0,"i:bantering/p:bantered/3:banters",[["Lucy was bantered by her grandparents.","露西被她的祖父母揶揄。"]]],"baptism":[[["n.",["浸礼","洗礼"]]],null,11608,1,0,"s:baptisms"],"baptist":[[["n.",["施洗礼者","浸礼会教友"]]],null,7211,0,0,"s:baptists"],"baptize":[[["v.",["施洗礼","使经受考验","命名"]]],null,12832,0,0,"d:baptized/i:baptizing/3:baptizes",[["The man on whom you see the Spirit come down and remain is he who will baptize with the Holy Spirit.","你如果看見聖靈降下，落在誰身上，誰就是用聖靈替人施洗的了。"]]],"bar":[[["n.",["条","棒","酒吧","栅","障碍物"],["a counter where you can obtain food or drink"]],["v.",["禁止","阻挡","妨碍"]],["",["棒形图"]]],"gk cet4 ky toefl ielts gre",991,4,1,"s:bars/d:barred/i:barring",[["The police will put you behind bars for twenty years.","警方會把你關在牢裡二十年。"]]],"barb":[[["n.",["倒钩"]],["v.",["装倒钩于"]]],"toefl gre",16454,0,0,"s:barbs",[["It's the 26th of April of 2025. Before 14:00, a sunny blue-sky afternoon, I went to my neighbourhood's cul-de-sac to meditatively walk around and around there. I admired the gardens. They reminded me of Daoism: how the microcosm reflects the macrocosm: The puffs of sakura would be a nebula afar. One need not really travel too far. Barb my white neighbour was at her driveway. She and her husband Ken would be going out to buy eggs. They eat many eggs.","那是 2025 年 4 月 26 日。下午兩點前，陽光明媚，萬里無雲。我來到我家附近的死胡同，靜靜地漫步。我欣賞著花園…"]]],"barbarian":[[["n.",["野蛮人"]],["adj.",["野蛮的"]]],"toefl",14613,1,0,"s:barbarians",[["With regards to culture, you could say they're like barbarians.","在教養上，他們可以說是和野蠻人差不多。"]]],"barbaric":[[["adj.",["野蛮的","粗野的"]]],null,15078,1,0],"barbarous":[[["adj.",["野蛮的","残暴的","粗野的"]]],"gre",24373,0,0,[["A more barbarous form of these rejoicings took place among the rude peoples of the north where great blocks of wood blazed in honor of Odin and Thor, and sacrifices of men and cattle were made to them. Mistletoe was cut then from the sacred oaks with a golden sickle by the Prince of the Druids.","在北方的原始部落中，也存在著一種更野蠻的慶祝形式：他們點燃巨大的木柴，以紀念奧丁和托爾，並向祂們獻祭人和牲畜。德魯伊王…"]]],"barbecue":[[["v.",["烤肉","烧烤"]],["n.",["烤肉"]]],"gk ky toefl ielts gre",6778,1,0,"s:barbecues/d:barbecued/i:barbecuing",[["We'll have a barbecue at the beach.","我們要在海邊烤肉。"]]],"barbed":[[["adj.",["有倒刺的"]]],null,11507,1,0],"barber":[[["n.",["理发师"]]],"gk cet4 ky toefl ielts",9131,1,0,"s:barbers/d:barbered/i:barbering",[["I had my hair cut at the barber shop yesterday.","我昨天去了理髮店理髮。"]]],"barbershop":[[["n.",["理发店"]]],"gk",16205,0,0,[["I intend to go to the barbershop.","我打算去理髮店。"]]],"bard":[[["n.",["吟游诗人","诗人"]]],"gre",17063,0,0,"s:bards/p:barded/i:barding"],"bare":[[["adj.",["赤裸的","缺少的","无遮蔽的","坦率的"]],["v.",["使赤裸","露出"]]],"gk cet4 ky toefl ielts gre",3430,3,0,"p:bared/t:barest/i:baring/3:bares/r:barer",[["It's hard to catch a rabbit with your bare hands.","徒手逮兔挺难。"]]],"barefaced":[[["adj.",["公然的","无耻的","无面具的"]]],"gre",0,0,0],"barefoot":[[["adj.",["赤脚的"]]],null,9395,1,0,[["When was the last time you walked barefoot on a meadow?","你最后一次赤脚在草地上走是什么时候？"]]],"barely":[[["adv.",["几乎不"]]],"cet4 cet6 ky toefl ielts",1973,3,0,[["During droughts, farmers are barely able to eke out a living.","發生旱災的時候，農民很難維持生計。"]]],"bargain":[[["n.",["交易","买卖协定","特价商品"]],["v.",["讲价","交易"]]],"gk cet4 cet6 ky ielts gre",4962,3,1,"s:bargains/i:bargaining/d:bargained",[["The bargain sale will run for three days, beginning today.","这场减价活动会持续三天，从今天开始。"]]],"barge":[[["v.",["用船运输","蹒跚","闯入"]],["n.",["驳船"]]],"cet6 toefl gre",9954,0,0,"s:barges/p:barged/i:barging"],"baritone":[[["n.",["男中音","男中音歌手","低音铜管乐器"]]],null,14164,1,0,"s:baritones",[["She was a tiny girl, but she really held her own on the baritone sax. Nonetheless, I couldn't help but imagine the thing wrapping itself around her and devouring her like a boa constrictor.","她是一個非常嬌小的女孩，但她的中音薩克斯真的不亞於人。不過，我忍不住想像這個東西纏繞包裹住她，並像蟒蛇般的吞噬她。"]]],"bark":[[["v.",["吠","叫骂","喊出","剥树皮"]],["n.",["树皮","吠声"]]],"gk cet4 cet6 ky toefl ielts gre",5831,2,0,"p:barked/i:barking/s:barks",[["I heard a dog barking in the distance.","我听到远处传来狗叫声。"]]],"barley":[[["n.",["大麦"]]],"cet6",11471,1,0,"s:barleys",[["Can you tell wheat from barley?","你能辨别小麦和大麦吗？"]]],"barman":[[["n.",["酒吧间男招待"]]],null,26606,1,0,"s:barmen"],"barn":[[["n.",["谷仓"]],["",["靶(恩)(核反应截面单位)"]]],"cet4 cet6 ky toefl ielts gre",4108,2,0,"s:barns",[["We took refuge from the storm in a nearby barn.","为躲避风暴，我们躲到了附近的一个谷仓内。"]]],"barometer":[[["n.",["气压计"]]],"cet6 toefl ielts",16352,1,0,"s:barometers",[["The barometer is falling. It is going to rain.","气压计下降了 - 要下雨了。"]]],"baron":[[["n.",["男爵","贵族","大王"]]],"cet6 gre",11092,1,0,"s:barons",[["While the rest of us toil, the robber barons eat from gilt tableware.","當我們其他人辛苦工作時，強盜貴族卻用鍍金餐具吃飯。"]]],"baroque":[[["adj.",["巴罗克式的","绮靡的","以俗艳标新立异的"]],["n.",["巴罗克风格","巴罗克式"]]],"toefl gre",16149,1,0],"barrack":[[["n.",["兵舍","军营"]],["v.",["使驻兵营内"]]],null,0,2,0,"i:barracking/d:barracked/3:barracks"],"barrage":[[["n.",["弹幕","掩护炮火"]],["v.",["以密集炮火进攻"]]],"gre",10255,1,0,"s:barrages/d:barraged/i:barraging"],"barrel":[[["n.",["桶"]],["v.",["装入桶内"]]],"cet4 cet6 ky toefl ielts",3084,3,0,"s:barrels/d:barrelled/i:barrelling",[["Political power grows out of the barrel of a gun.","枪杆子里面出政权。"]]],"barren":[[["adj.",["不育的","贫瘠的"]],["n.",["荒地"]]],"cet6 ky toefl ielts gre",8809,1,0,"s:barrens"],"barrenness":[[["n.",["贫瘠","不妊","不孕","不生育","不毛"]],["",["不育症","不孕症"]]],"toefl",30758,0,0],"barricade":[[["n.",["路障","障碍"]],["v.",["设路障于","阻碍"]]],"toefl ielts gre",11273,2,0,"s:barricades/d:barricaded/i:barricading",[["She barricaded herself in his room.","她把自己反锁在了他的房间里。"]]],"barrier":[[["",["势垒","阻片","阻挡层"]],["n.",["障碍","栅栏"]]],"gk cet4 cet6 ky toefl ielts gre",2609,3,1,"s:barriers",[["Trade barriers were lifted after the war ended.","戰爭結束之後貿易障礙被解除。"]]],"barrister":[[["n.",["出庭律师","律师","专门律师","大律师"]]],"gre",26259,2,0,"s:barristers",[["She practised as a barrister for many years.","她从事律师职业多年。"]]],"bartender":[[["n.",["酒保","酒吧侍者"]]],null,7886,0,0,"s:bartenders",[["Either as a waiter at a restaurant or a bartender, both are OK.","做餐馆服务员啊、酒吧招待员啊，都可以。"]]],"barter":[[["n.",["物物交换","实物交易"]],["v.",["物物交换","交换"]]],"toefl ielts gre",15482,1,0,"i:bartering/d:bartered/s:barters"],"basal":[[["adj.",["基础的","基本的","基底的"]]],null,17113,0,0],"base":[[["n.",["底部","垒","基础","基地"],["installation from which a military force initiates operations"]],["adj.",["卑鄙的","低劣的"]],["v.",["以...作基础"]],["",["基准"]]],"gk cet4 ky gre",536,5,1,"d:based/i:basing/3:bases/r:baser",[["Their wish is engraved on the base of the statue.","他們的願望被刻在雕像的底座上。"]]],"baseball":[[["n.",["棒球"],["a ball game played with a bat and ball between two teams of nine play…"]],["",["棒球系统"]]],"zk gk cet4 cet6 ky ielts",1373,3,0,[["The baseball game was called off due to rain.","棒球比賽因為天雨取消了。"]]],"baseline":[[["n.",["基线","基准"]]],null,5972,1,0,"s:baselines/i:baselining"],"baseman":[[["n.",["守垒员"]]],null,8797,0,0],"basement":[[["n.",["地下室","墙脚"]]],"gk cet6 ky toefl ielts",3598,2,0,"s:basements",[["The police think the burglar entered through a basement window.","警察認爲竊賊從地下室窗口進入。"]]],"bash":[[["v.",["猛击","打坏"]],["n.",["猛撞","猛击"]]],null,9629,2,0,"i:bashing/d:bashed/3:bashes",[["\"What happened to your nose?\" \"When I was backing my car up I went to check behind me, convinced that the car window was open, and bashed my face into it!\"","「你鼻子怎麼了？」「我剛才倒車的時候，想探頭出窗看清楚後面有沒有人。我以為車窗是開著的，誰知原來是關上了，於是就一頭撞…"]]],"bashful":[[["adj.",["害羞的"]]],"toefl",22828,0,0],"basic":[[["n.",["基本原理","要素","基本规律"],["a popular programming language that is relatively easy to learn; an a…"]],["adj.",["基本的","碱性的"],["pertaining to or constituting a base or basis"]],["",["(计算机)BASIC语言"],["reduced to the simplest and most significant form possible without lo…"]]],"zk gk cet4 ky toefl ielts",1144,4,1,"s:basics",[["Branching and merging are two basic operations of revision control.","分支和合併是版本控制的兩種基本操作。"]]],"basically":[[["adv.",["基本上","主要地"]]],"cet4",1691,3,1,[["Basically, I agree with your opinion.","基本上我贊同你的意見。"]]],"basil":[[["",["罗勒","矮糠"]],["n.",["罗勒属植物"]]],null,7391,1,0,"s:basils"],"basilica":[[["n.",["长方形廊柱大厅","长方形教堂"]]],null,22309,1,0,"s:basilicas",[["Every time I go to Paris, I visit the Sacred Heart Basilica, sit on the steps, and listen to the people below singing and playing musical instruments.","我每次去巴黎，都会去圣心大教堂，坐在台阶上，听下面的人唱歌