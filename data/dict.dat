sure":[[["n.",["压","榨","按","强制","压力"],["the force applied to a unit area of surface; measured in pascals (SI …"]],["v.",["迫使","使增压","密封"]]],"gk cet4 cet6 ky toefl ielts",765,5,1,"s:pressures/d:pressured/i:pressuring",[["I'm under so much pressure, I just want to cry.","我壓力好大，我真想哭。"]]],"pressurized":[[["adj.",["加压的","受压的"]]],null,21120,1,0],"prestige":[[["n.",["声望","威望","威信"]],["",["商誉","声誉"]]],"cet6 ky toefl ielts gre",6691,2,0,[["His prestige is fading.","他的威信日渐衰落。"]]],"prestigious":[[["adj.",["享有声望的"]]],"ky toefl ielts gre",6451,2,0,[["Bates, who won three gold medals at the 1984 Summer Games in Los Angeles, is one of the few elite athletes who has some idea of the stress and emotions that run through athletes like gymnast Simone Biles, who withdrew from some Olympic events at the Games in Japan, and tennis ace Naomi Osaka, who left the prestigious Wimbledon tournament in June.","貝茨曾在 1984 年洛杉磯夏季奧運會上獲得三枚金牌，他是少數幾位能夠體會到像體操運動員西蒙拜爾斯 (她在日本奧運會上…"]]],"presumable":[[["adj.",["可推测的","可能有的","似真的"]],["",["可假定的:可推测的","可推定的:可能的"]]],"gre",45526,0,0],"presumably":[[["adv.",["推测上","大概"]]],"cet4 cet6 ky toefl ielts",4288,3,1],"presume":[[["v.",["假定","推测","擅自","意味着","擅自行动"]]],"cet6 ky toefl gre",5740,2,0,"d:presumed/3:presumes/i:presuming",[["She presumes him to be innocent.","她假設他是無辜的。"]]],"presumption":[[["n.",["专横","放肆","假定","推测","设想"]]],"toefl ielts gre",9906,1,0,"s:presumptions"],"presumptuous":[[["adj.",["放肆的","冒昧的","傲慢的"]]],"toefl",19469,0,0,[["It's presumptuous for humans to assume that our task is to do what only God can do.","人类假设我们的任务是完成只有上帝能做的事，这太自以为是了。"]]],"presuppose":[[["v.",["预先假定","预料","以...为先决条件"]]],null,14031,0,0,"3:presupposes/d:presupposed/i:presupposing"],"presupposition":[[["n.",["预想","假定","预先推测"]]],"gre",20621,0,0,"s:presuppositions"],"preteen":[[["adj.",["青春期前的"]],["n.",["青春期前的孩子"]]],null,19932,0,0],"pretence":[[["n.",["假装","虚伪","借口","自称","要求"]]],"gre",37692,1,0,"s:pretences"],"pretend":[[["v.",["假装","伪称","自命","自称"]]],"gk cet4 cet6 ky toefl gre",2905,2,1,"i