"]]],"zk gk",1981,3,1,[["What he said was beside the point.","他說的話跑題了。"]]],"besides":[[["adv.",["而且","此外"]],["prep.",["除...之外"]]],"zk gk cet4 ky toefl",3012,3,0,[["There was no one in the room besides Tom and Mary.","除了汤姆和玛丽，房间里没有人。"]]],"besiege":[[["v.",["围攻","包围"]]],"toefl gre",14890,2,0,"d:besieged/i:besieging/3:besieges"],"besmirch":[[["v.",["弄污"]]],"gre",28398,0,0,"d:besmirched/i:besmirching/3:besmirches",[["Please don't do anything that would besmirch the Matsuno family name!","请不要做任何有损松野家族名声的事！"]]],"bespeak":[[["v.",["预约","订","表示"]],["n.",["预约"]]],"toefl gre",22202,0,0,"3:bespeaks/i:bespeaking/p:bespoke/d:bespoken"],"best-selling":[[["adj.",["最畅销的","畅销作品的"]]],null,0,1,0,[["She lost no time in reading a best-selling novel.","她抓緊時間地閱讀一本暢銷小說。"]]],"bestial":[[["adj.",["似野兽的","残忍的","卑劣的"]]],"gre",29608,0,0],"bestow":[[["v.",["授予","使用","贮藏","留宿"]]],"cet6 toefl gre",9425,1,0,"d:bestowed/i:bestowing/3:bestows",[["When Heaven is about to bestow a great responsibility on a person, it must first distress their mind, exhaust their muscles and bones, starve their body, and deprive them of resources, making their actions go against their will. This is done to stimulate their heart and temper their character, thereby increasing what they are capable of.","故天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为，所以动心忍性，曾益其所不能。"]]],"bet":[[["n.",["打赌","赌注"]],["v.",["打赌"]]],"cet4 ky ielts",2699,3,1,"s:bets/i:betting",[["I'll bet you a hundred dollars that Tom is gay.","我和你赌一百元，汤姆是同性恋。"]]],"beta":[[["",["β(希腊文的第二个字母)","乙种"]],["n.",["希腊字母表的第二个字母"]]],null,9048,0,0,"s:betas",[["Alpha, beta and gamma are Greek letters.","阿尔法、贝塔和咖玛是希腊文字。"]]],"betoken":[[["v.",["预示"]]],"toefl gre",34079,0,0,"3:betokens/i:betokening/p:betokened"],"betray":[[["v.",["出卖","背叛","辜负","暴露","泄漏"]]],"gk cet4 cet6 ky toefl ielts gre",4974,2,0,"d:betrayed/i:betraying/3:betrays",[["He would rather lose his life than betray his organization.","他寧可犧牲生命，也不出賣組織。"]]],"betrayal":[[["n.",["背叛","辜负","通敌","背信"]]],null,7284,1,0,"s:betrayals"],"betroth":[[["v.",["订婚","许配"]]],"gre",31735,0,0,"d:betrothed/i:betrothing/3:betroths"],"between":[[["prep.",["在...之间"]]],"zk gk",140,5,1,[["In America, the consumption of fast-food has tripled between 1977 and 1995.","美國人快餐食物的消耗量在一九七七至一九九五年間大幅增長了三倍。"]]],"beverage":[[["n.",["饮料"]],["",["饮料(如牛奶、茶、咖啡、啤酒等)"]]],"ky toefl ielts gre",6831,1,0,"s:beverages",[["People who drink alcoholic beverages are not allowed to enter.","飲酒者不准禁入。"]]],"beware":[[["v.",["小心","谨防"]]],"cet6 ky",9885,1,0,"i:bewaring/p:bewared/3:bewares",[["Beware of anyone who claims objectivity.","要小心那些说自己客观的人。"]]],"bewilder":[[["v.",["使迷惑","使不知所措"]]],"cet6 ky toefl ielts gre",30215,0,0,"d:bewildered/3:bewilders/i:bewildering"],"bewildered":[[["adj.",["困惑的","晕眩的","混乱的","不知所措的"]],["v.",["使困惑"]]],null,10588,1,0],"bewildering":[[["adj.",["令人困惑的","使人昏乱的"]]],"gre",15654,0,0],"bewilderment":[[["n.",["困惑","昏乱"]]],null,16656,1,0,"s:bewilderments"],"beyond":[[["prep.",["超过","在那一边","迟于"]],["adv.",["在远处"]],["n.",["更远处"]]],"zk gk cet4 ky",746,4,1,[["It is beyond my power to build my own house.","蓋我自己的房子超出了我的能力範圍。"]]],"bias":[[["",["偏流","偏压","偏磁","偏离"]],["n.",["偏见","斜纹"]],["adj.",["偏斜的"]],["adv.",["偏斜"]],["v.",["使有偏见"]]],"cet6 ky toefl ielts",3925,2,0,"d:biased/i:biassing/3:biases",[["People tend to look at others with bias.","人们趋向于带着偏见看待他人。"]]],"bible":[[["n.",["圣经"]]],"cet4 ky ielts",2742,2,0,"s:bibles",[["Every time I read the Bible, I am deeply moved.","每次我读圣经都会被深深地感动。"]]],"biblical":[[["adj.",["圣经的"]]],null,5176,1,0],"bibliography":[[["",["书目","文献目录"]],["n.",["参考书目"]]],"ky ielts gre",14033,1,0,"s:bibliographies",[["Hand in a bibliography of your sources.","把书目提要交上。"]]],"bibliophile":[[["n.",["爱书者","藏书家"]]],"gre",38047,0,0,"s:bibliophiles"],"bibulous":[[["adj.",["饮酒的","嗜酒的","吸水的"]]],"gre",0,0,0],"bicameral":[[["adj.",["两院制的","有两个议院的"]],["",["二室的","两室的"]]],"toefl",37409,0,0],"biceps":[[["n.",["二头肌","臂部肌肉","二头的"]]],null,12143,0,0],"bicker":[[["v.",["斗嘴","潺潺而流","闪动"]],["n.",["口角","流水声"]]],"toefl gre",15140,1,0,"i:b