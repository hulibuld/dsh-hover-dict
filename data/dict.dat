,3377,1,0,"s:hypotheses",[["We can now say definitely that this hypothesis holds water.","我們現在能肯定地說，這個假設是成立的。"]]],"hypothesize":[[["v.",["假设","假定"]]],"toefl",8799,0,0,"d:hypothesized/i:hypothesizing/3:hypothesizes"],"hypothetical":[[["adj.",["假设的","有待证实的","假定的","有前提的"]],["",["理想的"]]],"gre",8049,1,0,"s:hypotheticals",[["When will the most probable hypothetical accident occur?","最大可能假想事故什么时候会发生？"]]],"hysterectomy":[[["n.",["子宫切除"]],["",["子宫切除术"]]],null,18708,1,0,"s:hysterectomies"],"hysteria":[[["n.",["歇斯底里症","不正常的兴奋","癔病","歇斯底里"]]],"cet6 gre",10247,1,0,"s:hysterias"],"hysterical":[[["adj.",["歇斯底里的","异常兴奋的","癔病的"]]],"cet6 ky ielts",9244,1,0],"hysterically":[[["adv.",["歇斯底里地"]]],null,17880,0,0],"i":[[["",["电流","中断","指令","指示符"]],["pron.",["我"]]],"zk gk",11,5,1,[["When I grow up, I want to be a king.","我長大後想當國王。"]]],"i'd":[[["",["我愿意（等于I would）"]]],null,0,5,0,[["I'd like to stay one more night. Is that possible?","我想还待一夜，行不行？"]]],"i'll":[[["",["我将","我会（=I shall）"]]],null,0,5,0,[["I don't know if I'll have time to do it.","我不知道我是否有时间做。"]]],"i'm":[[["",["我是（缩写）"]]],null,0,5,0,[["You've both been very impressive today. I'm proud of you.","今天你们俩很让人印象深刻。我为你们感到骄傲。"]]],"i've":[[["",["（等于I have）"]]],null,0,5,0,[["I've been feeling poorly for the last couple of days.","过去两天我觉得不太舒服。"]]],"i.e.":[[["adv.",["也就是"]]],"cet4 cet6",0,2,0],"ibid":[[["adv.",["如上","同前"]]],null,0,2,0],"ice":[[["n.",["冰","冰淇淋","糖衣","冷若冰霜","矜持"],["water frozen in the solid state"]],["v.",["使结冰","冰镇","覆以糖衣","结冰"]]],"zk gk ielts",1230,4,1,"i:icing/s:ices/d:iced",[["Water and ice are the same substance in different forms.","水和冰雖然形態不同，但其實是同一種物質。"]]],"ice-cream":[[["adj.",["冰淇淋的","乳白色的"]]],"cet4",0,0,0,"s:ice-creams",[["The ice-cream will melt, so I put it in the fridge.","冰淇淋会融化所以我把它放在冰箱里。"]]],"iceberg":[[["n.",["冰山","冷冰冰的人"]]],"toefl",9987,1,0,"s:icebergs",[["The sea looked quite green, and large icebergs were floating about.","海水看起來一片碧綠，巨大的冰山漂浮在周圍。"]]],"iceland":[[["n.",["冰岛"]]],"gk",0,0,0,"s:icelands",[["Iceland has not joined the European Union.","冰島沒有加入歐盟。"]]],"icelandic":[[["adj.",["冰岛的","冰岛人的","冰岛语的"]],["n.",["冰岛语"]]],null,17430,0,0,"s:icelandics",[["One of my dreams is to learn Icelandic.","学会冰岛语是我的梦之一。"]]],"ichthyosaur":[[["n.",["鱼龙"]]],"toefl",39869,0,0,"s:ichthyosaurs"],"icicle":[[["n.",["垂冰","冰柱","冷冰冰的人"]]],"toefl gre",20039,0,0,"s:icicles"],"icon":[[["n.",["画像","肖像","偶像","图标","像标"]]],"toefl gre",4354,1,0,"s:icons",[["You have added a comment, not a translation. To add a translation, click on the \"あ→а\" icon above the sentence.","您已添加了評論，而不是一個翻譯。要添加一個翻譯，點擊這句話上面的«あ→а»圖標。"]]],"iconic":[[["",["图标的"]]],null,12330,0,0],"iconoclast":[[["n.",["反对偶象崇拜者","提倡打破旧习的人"]]],"gre",26632,0,0,"s:iconoclasts"],"iconoclastic":[[["adj.",["反对偶象崇拜的","打破旧习的"]]],"gre",22103,0,0],"iconographic":[[["adj.",["图像材料的","肖像学的","肖像的","图示法的象征"]]],"toefl",21784,0,0],"iconography":[[["n.",["图像材料","图示法","肖像研究"]],["",["影像学","影像塑造术"]]],null,14409,0,0,"s:iconographies"],"icu":[[["",["工业控制器","指令控制器","综合控制器","接口控制器","中断控制器"]]],null,13571,0,0,"s:icus"],"icy":[[["adj.",["冰的","冰冷的","冷淡的","滑溜的"]]],"cet6",6454,1,0,"r:icier",[["It is hard to keep our balance on icy streets.","在结冰的街道上我们很难保持平衡。"]]],"id":[[["",["识别","标识符","项目说明"]],["n.",["遗传素质","本能冲动"]]],null,0,1,0,"s:ids/i:iding",[["My ID card has expired, what should I do?","我的身份证过期了，我该怎么办？"]]],"idea":[[["n.",["主意","办法","理想","思想","概念"],["the content of cognition; the main thing you are thinking about"]]],"zk gk ielts",311,5,1,"s:ideas",[["I have no idea of how to send a fax.","我不知道如何传真。"]]],"ideal":[[["n.",["理想","典范","观念","思想","最后目标"]],["adj.",["理想的","完美的","空想的","观念的","唯心论的"]]],"cet4 cet6 ky toefl ielts",2815,4,1,"s:ideals",[["The beach is an ideal place for children to play.","海滩是一个供孩子们玩乐的理想场所。"]]],"idealism":[[["n.",["唯心主义","观念论","唯心论","理想主义"]]],"cet6",11045,1,0,"s:idealisms"],"idealist":[[["n.",["理想主义者","唯心主义者"]],["adj.",["唯心论的","理想主义的"]]],null,17991,0,0,"s:idealists"],"idealistic":[[["adj.",["理想主义的","唯心论的","唯心主义的","唯心主义者的"]]],null,11860,1,0],"idealize":[[["v.",["使理想化","理想化","形成思想","描述理想"]]],null,17388,1,0,"p:idealized/3:idealizes/i:idealizing"],"idealized":[[["",["理想化的"]]],null,14349,0,0],"ideally":[[["adv.",["完美地","理想地"]]],"cet6",7858,1,1,[["Ideally, a candidate for this job should have four years' work experience.","我们希望应聘者能有4年工作经验。"]]],"identical":[[["adj.",["同一的","恒等的","完全相同的","同等的"]]],"cet4 cet6 ky toefl ielts",3822,2,0,[["No two words are identical in meaning.","每一個字的意思都是獨特的。"]]],"identifiable":[[["",["可证明为同一的","可以办清的"]],["adj.",["可辨认的"]]],"toefl",10546,1,0],"identification":[[["",["鉴定","鉴别","鉴别法","认证"]],["n.",["识别","身份证明","认同"]]],"gk cet4 cet6 ky toefl ielts",3289,1,0,"s:identifications",[["Do you have your student identification card?","你有學生證嗎？"]]],"identify":[[["v.",["识别","认为...等同于","确定","使参与","一致"],["recognize as being; establish the identity of someone or something"]]],"cet4 cet6 ky toefl ielts",770,4,1,"d:identified/i:identifying/3:identifies",[["You can identify children's voices without any problem.","你可以毫无问题地辨别孩子们的声音。"]]],"identity":[[["n.",["身份","相同","一致","特性","恒等式"],["the distinct personality of an individual regarded as a persisting en…"]],["",["(打)标记","标识"]]],"gk cet4 ky toefl ielts",1322,3,1,"s:identities",[["A student should not lose sight of his own identity.","学生不该忽略自己的身份。"]]],"ideological":[[["adj.",["意识形态的","空想的","思想的","思想上的"]]],"toefl",4216,2,0,[["To claim sex is binary requires ignoring intersex people, which is unscientific and purely ideological.","若要聲稱性別是二元的，就需要忽視陰陽人，這是不科學的，且純粹屬於意識形態問題。"]]],"ideologically":[[["adv.",["思想上","思想体系","意识形态","观念形态"]]],null,13546,0,0],"ideologue":[[["n.",["理论家","思想家","空想家"]]],null,15814,0,0,"s:ideologues"],"ideology":[[["n.",["思想体系","意识形态","观念学","空论","观念形态"]]],"cet6 ky toefl ielts gre",3644,2,0,"s:ideologies",[["This is the ideology to which my speech is written.","我的演讲稿就是依据这个理论写的。"]]],"idiocy":[[["n.",["白痴","极端愚蠢"]]],"toefl",23256,0,0,"s:idiocies"],"idiom":[[["n.",["习语","成语","惯用语法","方言"]]],"gk cet4 cet6 ky toefl ielts gre",12698,1,0,"s:idioms",[["\"Having a clear conscience\" is an idiom.","问心无愧是一个成语。"]]],"idiomatic":[[["adj.",["符合语言习惯的","惯用的","有许多习语的"]]],"toefl",28819,0,0,[["Is it more idiomatic if I say it like this?","这样说是不是更加地道呢？"]]],"idiosyncrasy":[[["n.",["气质","特性","风格"]],["",["特异反应","特异性体质"]]],"toefl",19034,0,0,"s:idiosyncrasies"],"idiosyncratic":[[["adj.",["特质的","异质的","特殊的"]],["",["特应性的","特异体质的"]]],null,12906,0,0],"idiot":[[["n.",["白痴","极蠢之人"]],["",["白痴者","痴子"]]],"cet6 ky toefl ielts",5944,2,0,"s:idiots",[["Someone who doesn't understand you is not necessarily an idiot.","一個不懂你的人不一定就是一個笨蛋。"]]],"idiotic":[[["adj.",["白痴的","愚蠢的","呆头呆脑的"]]],"toefl",17349,0,0],"idle":[[["v.",["无所事事","闲散","浪费","空转","虚度"]],["adj.",["懒惰的","闲散的","停顿的","空闲的","无用的"]],["n.",["空转","空闲时间"]]],"cet4 cet6 ky ielts gre",8146,2,0,"i:idling/p:idled/3:idles",[["It's wasteful to leave the land lying idle.","讓土地閒置著很浪費。"]]],"idleness":[[["n.",["懒惰","闲散","失业"]],["",["空载"]]],"cet6",23589,0,0,[["Sooner or later, you will regret your idleness.","你迟早要后悔懒惰。"]]],"idly":[[["adv.",["懒惰地","空闲地"]]],null,13463,0,0,[["She was idly looking out of the window.","她无所事事地看向窗外"]]],"idol":[[["n.",["偶像","崇拜物","宠儿","幻象","谬论"]]],"toefl gre",9381,1,0,"s:idols",[["Tom is a teen idol.","汤姆是一位青少年偶像。"]]],"idolater":[[["n.",["偶像崇拜者","崇拜者","皈依者"]]],"gre",39692,0,0],"idolatrize":[[["v.",["把…奉为偶像","盲目崇拜"]]],"gre",0,0,0],"idolize":[[["v.",["把...当偶像崇拜","极端崇拜","醉心于","崇拜偶像"]]],"gre",18359,0,0,"p:idolized/i:idolizing/3:idolizes",[["Is it normal that many young people these days idolize pretty boy stars?","現在很多年輕人追捧小鮮肉的現象正常嗎？"]]],"idyll":[[["n.",["叙事诗","田园景色","田园诗","田园乐曲","牧歌"]]],"gre",25541,0,0,"s:idylls"],"idyllic":[[["adj.",["田园诗的","牧歌的","悠闲的"]]],"toefl",13828,1,0],"ie":[[["",["中断启动"]]],null,2682,0,0,"s:ies"],"if":[[["conj.",["如果","是否","无论何时","假设","即使"],["In case that; granting, allowing, or supposing that; --"]],["n.",["条件"]],["",["DOS批处理命令:根据所测试的条件决定是否执行另一条命令"],["introducing a condition or supposition."]]],"zk gk",40,5,1,[["I don't know if I'll have time to do it.","我不知道我是否有时间做。"]]],"ig