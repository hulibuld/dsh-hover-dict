,1,0,"s:illegitimates"],"illiberal":[[["adj.",["狭隘的","无教养的","吝啬的"]]],"gre",27259,0,0],"illicit":[[["adj.",["不法的","不正当的","禁止的"]],["",["违法的","违禁的","被禁止的"]]],"toefl gre",8764,1,0,"3:illicits"],"illiteracy":[[["n.",["文盲","无知"]]],null,16517,0,0],"illiterate":[[["adj.",["目不识丁的","没受教育的"]],["n.",["文盲"]]],"cet6 ky toefl ielts gre",12243,1,0,"s:illiterates",[["He was an orphan and illiterate.","他是个孤儿，而且不识字。"]]],"illness":[[["n.",["疾病","恶意"]],["",["病"]]],"zk gk cet4 ky ielts",2303,3,1,"s:illnesses",[["I believe this type of medicine will help your illness.","我相信這種藥對你的病情有幫助。"]]],"illogical":[[["adj.",["不合逻辑的","无缘由的","无条理的","说不通的"]]],null,18157,1,0,[["That's illogical.","那不合邏輯。"]]],"illuminate":[[["v.",["照明","用灯装饰","阐明","说明","使灿烂"]]],"cet6 ky toefl ielts gre",5388,1,0,"d:illuminated/3:illuminates/i:illuminating",[["Thousands of candles illuminated the church during the ceremony.","数以千计的蜡烛点亮了仪式中的教堂。"]]],"illuminati":[[["n.",["先觉者"]]],"gre",43199,0,0],"illumination":[[["n.",["照明","阐明","启发","映光"]]],"toefl",11150,1,0,"s:illuminations"],"illusion":[[["n.",["幻影","错觉","幻想"]]],"cet4 cet6 ky toefl ielts gre",4317,2,0,"s:illusions",[["He had the illusion that he was a genius.","他幻想自己是個天才。"]]],"illusive":[[["adj.",["幻影的","错觉的","迷惑人的"]]],"toefl gre",33878,0,0],"illusory":[[["adj.",["产生幻觉的","幻影的","错觉的"]],["",["因错觉产生的","虚幻的"]]],"gre",16148,0,0,[["The feelings of \"love at first sight\" and \"faithful unto death\" are unrealistic; this sort of unrealistic and illusory feeling is not what we need.","「一見鍾情」以及「從一而終」的感情是不切實際的，我們需要的不是這種不切實際而虛幻的感情。"]]],"illustrate":[[["v.",["举例说明","作图解","阐明"]]],"cet4 cet6 ky toefl ielts gre",2348,3,1,"d:illustrated/3:illustrates/i:illustrating",[["The artist who illustrated this book is very good.","給這本書畫插畫的畫家很好。"]]],"illustration":[[["n.",["例证","插图"]]],"cet4 cet6 ky toefl",4475,0,0,"s:illustrations",[["This book has a lot of illustrations.","这本书有很多插图。"]]],"illustrative":[[["adj.",["说明的","解说的","作例证的"]]],null,16962,0,0],"illustrator":[[["n.",["插画家","图解者","说明者"]]],null,12176,0,0,"s:illustrators"],"illustrious":[[["adj.",["著名的","辉煌的","明亮的"]]],"toefl gre",16464,1,0],"image":[[["n.",["影像","肖像","想象","图像","形象"],["an iconic mental representation"]],["v.",["作...的像","反映","想象","象征"],["render visible, as by means of MRI"]],["",["图象"]]],"cet4 cet6 ky toefl ielts",555,4,1,"s:images/i:imaging/d:imaged",[["Please select a language for the Image Viewer interface.","请为Image Viewer的界面选择语言。"]]],"imagery":[[["n.",["肖像","比喻","雕刻"]],["",["成像"]]],"toefl",5197,1,0,"s:imageries",[["In London, my hotel was near the Barbican Centre. A memorable event was eating delicious fish and chips wrapped in newspaper, which back home, North Americans could not replicate. My favourite Brits are Olaf Stapledon and J.R.R. Tolkien, respectively a sci-fi writer and a fantasy writer. I have surveyed the British Isles via satellite imagery, and a really interesting area is southwestern England, where there are quaint towns and hamlets.","在倫敦，我住的飯店靠近巴比肯藝術中心。一次難忘的經驗是用報紙包著，吃美味的炸魚薯條，這在北美人家裡是無法複製的。我最喜…"]]],"imaginable":[[["adj.",["可想像的","可能的"]]],null,11264,1,0],"imaginary":[[["adj.",["想像的","虚构的","假想的"]]],"cet4 cet6 ky toefl",6513,1,1,[["All the events described in this story are imaginary.","故事裏發生的事都是虛構出來的。"]]],"imagination":[[["n.",["想像","听觉","想像力"]]],"cet4 cet6 ky",2892,3,1,"s:imaginations",[["This is beyond the scope of my imagination.","這超出了我的想像範圍。"]]],"imaginative":[[["adj.",["想像的","虚构的"]]],"cet6 ky toefl ielts",7925,2,0,[["He used to be an imaginative boy.","他曾經是一個富有想像力的男孩。"]]],"imagine":[[["v.",["想像","设想","猜测","想像起来"],["form a mental image of something that is not present or that is not t…"]]],"zk gk cet4 cet6 ky toefl",909,4,1,"d:imagined/i:imagining/3:imagines",[["I foolishly imagined that he was going to help me.","我傻乎乎地以为他会帮助我。"]]],"imam":[[["n.",["阿訇","伊玛目"]]],null,16394,1,0,"s:imams"],"imbalance":[[["n.",["不平衡","不均衡","失调"]]],"toefl",8131,1,0,"s:imbalances/d:imbalanced/i:imbalancing"],"imbecile":[[["adj.",["低能的","愚钝的","虚弱的"]],["n.",["低能者","痴呆","蠢人"]]],"gre",26269,0,0,"s:imbeciles"],"imbibe":[[["v.",["饮","吸取","吸入","喝","吸收水分"]]],"toefl gre",23983,0,0,"d:imbibed/i:imbibing/3:imbibes"],"imbroglio":[[["n.",["纷乱","纠葛","一团糟"]]],"gre",29392,0,0],"imbue":[[["v.",["使感染","灌输","使浸透"]]],"toefl gre",12805,1,0,"d:imbued/3:imbues/i:imbuing",[["A university thesis describes the \"Orientalism\" that imbues sci-fi in the West.","一篇大學論文描述了充斥在西方科幻作品中的「東方主義」。"]]],"imf":[[["",["国际货币基金组织","国际货币基金"]]],null,0,2,0,[["The IMF ruled out any new loans to that country.","国际货币基金组织不考虑再借款给该国。"]]],"imitate":[[["v.",["模仿","效法","冒充","仿造"]]],"cet4 cet6 ky toefl ielts",6150,1,0,"i:imitating/d:imitated/3:imitates",[["Children imitate their peers rather than their parents.","比起父母，儿童更喜欢模仿自己的同龄人。"]]],"imitation":[[["n.",["模仿","效法","冒充","赝品","仿制"]]],"cet6 ky toefl ielts gre",7375,1,0,"s:imitations",[["What is the difference between imitation and real diamonds?","假的鑽石和真的鑽石有甚麼分別？"]]],"imitative":[[["adj.",["喜模仿的","伪造的","仿制的","摹拟的"]]],"gre",27592,0,0],"imitator":[[["n.",["模仿者","临摹者","仿造者","伪造者"]],["",["模拟","模拟程序","模拟器"]]],null,19622,0,0,"s:imitators"],"immaculate":[[["adj.",["无污点的","纯洁的","无缺点的","无辜的"]],["",["无斑点","无瑕疵的","洁净的"]]],"gre",12659,1,0],"immanent":[[["adj.",["内在的","固有的"]]],"gre",20559,0,0],"immaterial":[[["adj.",["非物质的","无形的","精神的","非实质的"]]],null,19669,1,0],"immature":[[["adj.",["不成熟的","未完全发育的","粗糙的"]],["",["未成熟的"]]],null,11697,1,0,"s:immatures",[["Sami was so immature.","萨米太幼稚了。"]]],"immediacy":[[["n.",["直接","目前","迫切需要的事物"]]],null,13832,0,0,"s:immediacies"],"immediate":[[["adj.",["立即的","直接的","接近的"]]],"gk cet4 cet6 ky toefl",2180,4,1,[["They needed to make a decision - an immediate decision.","他们需要做决定——即刻作出决定。"]]],"immediately":[[["adv.",["直接地","立刻","立即"]]],"zk gk cet4 cet6 toefl",1142,4,1,[["We took action immediately so that things wouldn't get worse.","為了避免情況惡化，我們馬上採取了行動。"]]],"immemorial":[[["adj.",["太古的","远古的","无法追忆的","无法追溯的","无法记忆的"]]],"gre",23735,0,0],"immense":[[["adj.",["极广大的","无边的","非常好的"]]],"cet4 cet6 ky toefl ielts gre",5645,2,0,[["The teachers are all continuing to teach despite the immense pressure.","老師們都頂著巨大的壓力在堅持上課。"]]],"immensely":[[["adv.",["无限地","广大地","庞大地"]]],null,10037,1,0],"immensity":[[["n.",["广大","无边","巨物"]]],"gre",21339,0,0,"s:immensities"],"immerse":[[["v.",["沉浸","使陷入"]],["",["浸"]]],"cet6 ky toefl ielts gre",8097,1,0,"d:immersed/i:immersing/3:immerses",[["He is totally immersed in family life and has no wish to work.","他完全沉浸于家庭生活中，不想工作了。"]]],"immersion":[[["n.",["沉浸","专心","陷入"]],["",["浸","浸渍"]]],null,12374,0,0,"s:immersions",[["He needed a Berber language immersion course.","他需要參加柏柏爾語沉浸式課程。"]]],"immigrant":[[["adj.",["移入的","移民的"]],["n.",["移民"]]],"cet4 cet6 ky toefl ielts",2069,3,0,"s:immigrants",[["The immigrants entered the country in a steady flow.","移民川流不息地进入这个国家。"]]],"immigrate":[[["v.",["使移居入境","移入"]]],"cet4 cet6 toefl",13831,0,0,"p:immigrated/i:immigrating/3:immigrates",[["When did you immigrate to our country?","你何時移民到我們國家?"]]],"immigration":[[["n.",["移民","移居"]]],"gk cet6 toefl",2431,3,0,[["Please let me see your passport, also did you complete the immigration form?","请你把护照出示给我看看，还有入境表格填好了吗？"]]],"imminent":[[["adj.",["即将来临的","逼近的"]]],"toefl ielts gre",6712,2,0,"s:imminents"],"immobile":[[["adj.",["不动的","不变的","固定的","静止的"]]],"toefl",16603,1,0],"immobility":[[["n.",["不动性","不动","固定"]]],"toefl",23903,0,0],"immobilize":[[["v.",["使不动","使固定","使不能移动"]],["",["制动","固定"]]],"toefl",16616,0,0,"d:immobilized/3:immobilizes/i:immobilizing"],"immodesty":[[["",["无礼"]]],"toefl",38858,0,0],"immolate":[[["v.",["为供神而宰杀","牺牲","杀死"]]],"toefl gre",36015,0,0,"d:immolated/i:immolating/3:immolates"],"immoral":[[["adj.",["不道德的","邪恶的","放荡的","道德败坏的"]]],null,9751,1,1,[["It's not immoral for a novelist to tell lies. In fact, the bigger the lies, the better lies, and the more the common folks and critics will praise you.","小說家說謊並不是不道德的事。其實，謊話說得愈離譜、愈有技巧，就愈會受到公眾和批評家的表揚。"]]],"immorality":[[["n.",["不道德","道德败坏","不道德的行为","伤风败俗的行为"]]],null,19298,0,0,"s:immoralities"],"immortal":[[["adj.",["永远的","不死的","长久的"]],["n.",["不朽人物","神仙"]]],"cet6 toefl gre",11365,1,0,"s:immortals",[["There has never been a savior nor an immortal emperor to rely on.","从来就没有什么救世主， 也不靠神仙皇帝！"]]],"immortality":[[["n.",["不朽","不灭的声望"]]],null,12858,0,0,[["Millions long for immortality who do not know what to do with themselves on a rainy Sunday afternoon.","世界上有數之不盡的人渴望自己能長生不老，但這些人卻連一個下雨的星期天下午也不懂得該怎麼打發。"]]],"immortalize":[[["v.",["使不灭","使名垂千古"]]],null,17923,0,0,"d:immortalized/i:immortalizing/3:immortalizes"],"immune":[[["adj.",["免疫的","免除的","不受影响的"]],["n.",["免疫者"]]],"cet6 ky toefl ielts gre",4200,3,0,[["Everybody is immune to smallpox nowadays.","現今每個人都對天花免疫了。"]]],"immunity":[[["n.",["免疫","免疫性","免除"]]],"cet6 toefl gre",6941,0,0,"s:immunities"],"immunization":[[["n.",["免疫"]],["",["免疫法"]]],null,13077,0,0,"s:immunizations"],"immunize":[[["v.",["使免疫","赋予免疫性"]]],"gre",18368,1,0,"p:immunized/i:immunizing/3:immunizes"],"immure":[[["v.",["监禁","禁闭"]]],"gre",43148,0,0,"d:immured/i:immuring/3:immures"],"immutable":[[["adj.",["不可变的","不变的","不能变的"]]],null,18955,0,0,"s:immutables"],"imp":[[["v.",["加强","给...装上翅膀"]],["",["图象处理程序","接口信息处理器"]],["n.",["顽童"]]],"gre",26286,0,0,"s:imps"],"impact":[[["n.",["冲击","冲突","影响","效果"],["the striking of one body against another"]],["v.",["挤入","撞击","压紧","对...发生影响"],["press or wedge together; pack together"]]],"cet4 cet6 ky toefl ielts gre",919,4,1,"s:impacts/p:impacted/i:impacting",[["The blizzard has already had a severe impact on the economy.","这场暴风雪已经对经济造成了很严重的影响。"]]],"impair":[[["v.",["损害","减少","削弱","伤害"]]],"cet6 ky toefl ielts gre",7440,1,0,"d:impaired/3:impairs/i:impairing"],"impairment":[[["n.",["削弱","减少","损害","损伤","危害"]],["",["减损"]]],null,5768,0,0,"s:impairments"],"impale":[[["v.",["刺穿","使绝望","钉住"]]],"toefl gre",19536,0,0,"p:impaled/i:impaling/3:impales"],"impalpable":[[["adj.",["不可触知的","不能感知的","难以理解的"]],["",["不可接触的","极细微的"]]],"gre",40482,0,0],"impart":[[["v.",["给予","传授","告知"]]],"cet6 ky toefl ielts gre",9673,1,0,"p:imparted/3:imparts/i:imparting"],"impartial":[[["adj.",["公平的","不偏不倚的","公正无私的","不偏袒的"]]],"cet6 ky toefl gre",12318,1,0,[["He puts on a show of being impartial and unbiased, but I think he's just a guy with no opinion of his own.","他總在別人面前裝出大公無私的樣子，但依我看，他只不過是個沒有主見的傢伙。"]]],"impartially":[[["adv.",["公平地","无私地","秉公"]]],"toefl",28613,0,0,[["Teachers should treat all their students impartially.","老师应该一视同仁地对待他们的学生。"]]],"impasse":[[["n.",["难局","僵局","死路","死胡同"]]],"gre",12663,1,0],"impassible":[[["adj.",["不觉痛苦的","不受伤害的","无感觉的","无感情的"]]],"toefl",43965,0,0],"impassioned":[[["adj.",["充满激情的","狂热的","热烈的"]]],"toefl gre",13977,1,0],"impassive":[[["adj.",["无感情的","冷淡的","无感觉的","不能伤害的"]]],"toefl gre",18936,1,0],"impatience":[[["n.",["性急","难耐","焦急","急躁"]]],null,11344,0,0],"impatient":[[["adj.",["不耐烦的","着急的","急切的"]]],"cet4 cet6 ky toefl",7451,2,1,[["I'm very impatient to see the new version of Tatoeba.","我迫不及待地想要看到Tatoeba的新版本。"]]],"impatiently":[[["adv.",["不耐烦","忍受不了","急躁","急欲","急切"]]],null,11692,0,1],"impeach":[[["v.",["控告","怀疑","检举","弹劾"]]],"toefl gre",13892,1,0,"d:impeached/i:impeaching/3:impeaches",[["You guys in America can impeach your president too.","你們美國人也可以彈劾你們的總統。"]]],"impeachable":[[["adj.",["可控告的","可弹劾的","可怀疑的"]]],null,18414,0,0],"impeachment":[[["",["控告","检举","弹劾"]]],null,7636,0,0,"s:impeachments"],"impeccable":[[["adj.",["无懈可击的","勿容置疑的","无瑕疵的","不会做坏事的"]]],"toefl gre",12871,1,0,[["He is generally an impeccable student.","他总体上是个无可非议的学生。"]]],"impeccably":[[["",["完美地","毋庸置疑地","无瑕疵地"]]],null,18951,0,0],"impecunious":[[["adj.",["没有钱的","身无分文的","贫穷的"]]],"gre",37761,0,0],"impede":[[["v.",["妨碍","阻碍","阻止"]]],"toefl ielts gre",8791,1,0,"d:impeded/i:impeding/3:impedes"],"impediment":[[["n.",["妨碍","障碍","阻止","口吃"]],["",["对履行义务的阻碍"]]],"toefl gre",10593,1,0,"s:impediments"],"impel":[[["v.",["推动","激励","驱使","迫使"]]],"toefl gre",16966,0,0,"p:impelled/3:impels/i:impelling"],"impend":[[["v.",["迫近","威胁","悬挂"]]],"gre",0,0,0,"i:impending/p:impended/3:impends",[["Agitated activity by certain animals may be a sign of an impending earthquake.","某些动物烦躁不安, 可能是地震临震前的预兆。"]]],"impenetrable":[[["adj.",["不能通过的","不可理喻的","费解的","顽固的"]]],"gre",13690,1,0,[["In reality, translation is akin to working for peanuts, since the corresponding meaning of something in one language is often hidden in some deep and impenetrable recesses of the other. As a result, the translator is forced to search all over... Never mind that the picky reader is very difficult to fool.","翻译其实是一件吃力不讨好的事，因为一种语言在另一种语言中的对应物藏在往往隐藏在深不可测之处，翻译者需要百般寻觅，而且，…"]]],"impenitent":[[["adj.",["不知悔改的","顽固的"]],["n.",["不知悔改的人","顽固的人"]]],"gre",0,0,0],"imperative":[[["n.",["命令","必要的事","规则","祈使语气"]],["adj.",["命令式的","急需的","势在必行的","强制的"]]],"cet6 ky toefl ielts gre",8360,1,0,"s:imperatives",[["It is imperative for you to finish by Sunday.","你必須在星期日前完成。"]]],"imperceptible":[[["adj.",["不能感知的","微细的"]]],null,19580,0,0],"imperceptibly":[[["adv.",["不感觉地","微细地","极微地"]]],null,19643,0,0],"imperfect":[[["adj.",["不完美的","不完整的","减弱的","未完成过去时的"]],["n.",["未完成体"]]],null,10063,1,0],"imperfection":[[["",["缺陷","疵点","毛病"]],["n.",["不完美","缺点"]]],null,12940,0,0,"s:imperfections"],"imperial":[[["adj.",["帝王的","宗主国的","至尊的","壮丽的"]],["n.",["特等品"]]],"cet6 ky ielts gre",5035,2,0,[["Aristocrats lived to the east and west of the imperial palace.","贵族住在故宫的东边和西边。"]]],"imperialism":[[["n.",["帝国主义","帝制"]]],null,11126,1,0],"imperialist":[[["n.",["帝国主义者","皇帝统治的拥护者","皇帝派的人"]],["adj.",["帝国主义的"]]],null,17402,0,0,"s:imperialists",[["\"You, Sir, are an imperialist!\" \"And you, Sir, are a troll.\"","\"先生, 你是一個帝國主義者!\" \"而你, 先生, 是一個巨魔。\""]]],"imperil":[[["v.",["使处于危险","危害"]]],"gre",17494,0,0,"d:imperilled/i:imperilling/3:imperils/p:imperiled"],"imperious":[[["adj.",["专横的","傲慢的","迫切的"]],["",["强制的","不随意的"]]],"gre",19179,0,0,[["No, faith, not a jot; but to follow him thither with modesty / enough, and likelihood to lead it; as thus: Alexander died, / Alexander was buried, Alexander returneth into dust; the dust is / earth; of earth we make loam; and why of that loam (whereto he / was converted) might they not stop a beer barrel? / Imperious Caesar, dead and turn'd to clay, / Might stop a hole to keep the wind away. / O, that that earth which kept the world in awe / Should patch a wall t' expel the winter's flaw!","不，說真的，一點也不；但要循著合理的推論、憑著適度的謹慎 / 跟隨他到那裡，就像這樣：亞歷山大死了，/ 亞歷山大被埋葬…"]]],"impermanent":[[["adj.",["暂时的","非永久的"]]],"gre",36170,0,0],"impermeability":[[["n.",["不渗透性","不透过性"]],["",["不透性"]]],"gre",46779,0,0],"impermeable":[[["adj.",["不能渗透的","不能通过的"]],["",["不透性"]]],"toefl gre",26837,0,0],"impersonal":[[["adj.",["客观的","和个人无关的","没有人情味的","非人称的"]],["n.",["非人称动词(或代词)"]]],"toefl",12028,1,0],"impersonate":[[["v.",["模仿","扮演","体现","使人格化","拟人"]]],"toefl gre",18460,1,0,"i:impersonating/3:impersonates/d:impersonated"],"impersonation":[[["n.",["扮演","装扮","模仿"]]],"toefl",21249,0,0,"s:impersonations"],"impertinence":[[["n.",["不切题","鲁莽","无礼","不恰当","不对题"]]],"gre",30600,0,0,"s:impertinences"],"impertinent":[[["adj.",["不切题的","鲁莽的","无礼的","粗鲁的","不恰当的"]]],"toefl",28609,0,0],"imperturbable":[[["adj.",["沉着的","泰然自若的","镇静的"]]],"gre",31906,0,0],"impervious":[[["adj.",["透不过的","不易损坏的","无动于衷的","不受影响的"]],["",["不能透过的"]]],"toefl gre",15239,0,0],"impetuous":[[["adj.",["冲动的","猛烈的","轻率的","狂暴的"]]],"toefl gre",23230,0,0],"impetus":[[["n.",["动力","推动力","动量"]],["",["冲动","动能","起始(病)"]]],"cet6 ky toefl ielts gre",9359,1,0],"impinge":[[["v.",["撞击","起作用","侵犯"]]],"gre",18394,0,0,"3:impinges/d:impinged/i:impinging"],"impious":[[["adj.",["无信仰的","不敬神的","不虔诚的","不孝的"]]],"toefl",34209,0,0],"implacable":[[["adj.",["不能安抚的","难和解的","不变的"]]],null,18770,1,0],"implant":[[["v.",["深植","灌输","嵌入"]],["n.",["植入物","植入管"]]],"gre",6359,1,0,"s:implants/d:implanted/i:implanting"],"implantation":[[["",["植入法","移植法","植入","埋入法(如药物等)"]],["n.",["移植","鼓吹","灌输"]]],null,18976,0,0,"s:implantations"],"implausible":[[["adj.",["难以置信的","不象真实的"]]],"gre",17010,0,0],"implement":[[["n.",["工具","器具","手段"]],["v.",["实现","使生效","执行"]]],"cet4 cet6 ky toefl ielts gre",2285,3,0,"d:implemented/i:implementing/s:implements",[["Our company will implement new price standards regarding this product.","关于这个产品，我公司将执行新的价格标准。"]]],"im