","粗略的"]]],"toefl gre",15656,0,0],"curt":[[["adj.",["简略的","简短的","生硬的"]]],"cet6 toefl gre",18407,1,0,[["Don't you think it's rude to give people such a curt reply like that?","你回答得這麼簡短，不覺得有點沒禮貌嗎？"]]],"curtail":[[["v.",["缩减","剥夺","简略"]],["",["剥夺特权"]]],"toefl ielts gre",9041,1,0,"d:curtailed/i:curtailing/3:curtails"],"curtain":[[["n.",["帐","幕","窗帘"]],["v.",["装帘子于","遮蔽"]]],"gk cet4 cet6 ky toefl",3622,3,1,"s:curtains/d:curtained/i:curtaining",[["A green carpet will not go with this blue curtain.","绿色的毯子和这条蓝色的帘子不配。"]]],"curvaceous":[[["adj.",["曲线美的","肉体美的"]]],"gre",28092,0,0],"curvature":[[["n.",["弯曲","曲率"]],["",["弯","曲"]]],null,18737,0,0,"s:curvatures"],"curve":[[["n.",["曲线","弯曲","曲线球"]],["v.",["弯","使弯曲","成曲形"]]],"cet4 cet6 ky toefl ielts",3462,2,1,"s:curves/i:curving/p:curved",[["In its graphical representation, the normal distribution is a bell-shaped curve, with the value growing as one moves closer to the middle and decreasing as one moves away.","在图形上，正态分布是一种钟形曲线，越接近中心，取值越大，越远离中心，取值越小。"]]],"cushion":[[["v.",["加垫褥","缓冲","掩盖"]],["n.",["垫子","橡皮软垫"]]],"gk cet4 cet6 ky toefl ielts gre",6893,2,0,"s:cushions/d:cushioned/i:cushioning"],"cusp":[[["n.",["尖头","尖端"]],["",["尖"]]],null,17389,0,0,"s:cusps/p:cusped/i:cusping"],"cuss":[[["n.",["诅咒","坏话","家伙"]],["v.",["诅咒","咒骂"]]],null,19491,0,0,"i:cussing/d:cussed/s:cusses"],"custard":[[["n.",["蛋奶糕"]],["",["乳蛋糕"]]],null,13196,1,0,"s:custards",[["The custard buns are sold out today.","今天的奶黃包賣完了。"]]],"custodial":[[["adj.",["保管的","保管人的"]],["n.",["圣物保存器"]]],null,17876,0,0],"custodian":[[["n.",["管理人","保管人","监护人"]]],"toefl ielts gre",14618,1,0,"s:custodians"],"custody":[[["n.",["监护","拘留","监禁"]],["",["保管","照顾","保护"]]],"gre",4422,2,0,[["As for the papers, I have custody of them.","至于该文件，我在保管。"]]],"custom":[[["n.",["习惯","风俗","海关","自定义","定制"]],["adj.",["定制的"]]],"gk cet4 cet6 ky toefl ielts",2993,2,1,"s:customs",[["The manners and customs of a country reflect its culture.","一个国家的风俗习惯反映了它的文化。"]]],"customarily":[[["adv.",["照例","通常","习惯上"]]],"to