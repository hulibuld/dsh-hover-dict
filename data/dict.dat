toefl ielts gre",10058,1,0,"s:rectangles",[["Roll the pastry into a rectangle.","把麵團擀成方形。"]]],"rectangular":[[["adj.",["成直角的"]],["",["矩形的"]]],"cet6 toefl",9527,0,0],"rectify":[[["v.",["订正","矫正","改正","调正","校正"]]],"cet6 ky toefl ielts gre",14350,1,0,"d:rectified/i:rectifying/3:rectifies",[["Teachers must get tired of rectifying the same mistakes over and over again in their students' papers.","老师肯定厌倦了一遍又一遍地纠正学生试卷中同样的错误。"]]],"rectitude":[[["n.",["正直","纯正","正确","公正","严正"]]],"gre",24055,0,0],"rector":[[["n.",["教区长","校长","院长"]]],null,20910,1,0,"s:rectors"],"recumbent":[[["adj.",["斜靠着的","躺着的","不活泼的","休息着的","斜卧的"]]],"gre",27352,0,0,"s:recumbents"],"recuperate":[[["v.",["恢复","使复原","使恢复健康","使恢复精神","复原"]]],"gre",16025,1,0,"i:recuperating/d:recuperated/s:recuperates",[["Before long, he had recuperated.","不久後, 他恢復了健康。"]]],"recur":[[["v.",["复发","回到","重现","再来","诉诸"]]],"cet6 ky toefl",13001,1,0,"3:recurs/p:recurred/i:recurring",[["Did you ever have a recurring dream?","你有過一個你會重複做的夢嗎？"]]],"recurrence":[[["n.",["再现","再发生","反复","循环"]],["",["复发","再发"]]],"cet6 ky",10768,1,0,"s:recurrences"],"recurrent":[[["adj.",["再发生的","定期重复的","循环的"]],["",["复发的","再发的","回归的"]]],"ky",11386,1,0],"recyclable":[[["adj.",["可循环再用的"]]],null,19149,0,0,"s:recyclables",[["These cardboard boxes are a hundred per cent recyclable.","這些紙板盒是百分之百可回收的。"]]],"recycle":[[["v.",["使再循环","重新利用","再制"]],["n.",["再循环"]]],"gk cet6 ky toefl ielts",5806,2,0,"i:recycling/d:recycled/3:recycles",[["We've got to start thinking about recycling.","我們必須開始考慮回收。"]]],"recycling":[[["",["再循环"]]],"ielts",5995,0,0,[["We've got to start thinking about recycling.","我們必須開始考慮回收。"]]],"red":[[["adj.",["红的","红色的","红肿的","流血的"]],["n.",["红色","红颜料","赤字"],["red color or pigment; the chromatic color resembling the hue of blood"]],["",["简化","减少"],["of a color at the end of the color spectrum (next to orange); resembl…"]]],"zk gk",598,5,1,"s:reds/r:redder",[["Many Chinese people consider red to be the best colour.","很多中國人認為红色是最好的顏色。"]]],"red-hot":[[["adj.",["炽热的","热烈的","激烈的"]]],null,0,1,0,"t:red-hottest"],"redden":[[["v.",["变红","脸红","使变红"]]],null,16258,0,0,"d:reddened/i:reddening/3:reddens",[["His face reddened with shame.","他的臉因羞恥而變紅了。"]]],"reddish":[[["adj.",["微红的","略带红色的"]]],"toefl",12362,1,0,[["What color is your urine: clear, dark yellow, reddish, or brown like beer?","你的尿液是什么颜色的：浅色的、深黄色的、浅红色的还是像啤酒一样的咖啡色？"]]],"redecorate":[[["v.",["vi. 重新装饰"]]],null,22227,1,0,"i:redecorating/d:redecorated/3:redecorates",[["You need to redecorate your room.","你需要装修你的房间。"]]],"redeem":[[["v.",["赎回","挽回","恢复","偿还","补偿"]]],"toefl ielts gre",9250,1,0,"d:redeemed/i:redeeming/3:redeems",[["The only thing that will redeem mankind is co-operation.","合作是人類唯一的救贖。"]]],"redefine":[[["v.",["重新定义"]]],null,7563,1,0,"d:redefined/i:redefining/3:redefines",[["This film attempts to break stereotypes and redefine what true masculinity is.","這部電影試圖打破刻板印象，重新詮釋何謂真正的男性特質。"]]],"redefinition":[[["n.",["重新定义"]]],null,18758,0,0,"s:redefinitions"],"redemption":[[["n.",["赎回","赎身","偿还","拯救","买回"]]],null,8244,1,0,"s:redemptions",[["No external evidence can, at this long distance of time, be produced to prove whether the church fabricated the doctrine called redemption or not.","經過如此漫長的時間，已不可能提出任何外部證據，來證明教會是否捏造了所謂的「救贖」教義。"]]],"redemptive":[[["adj.",["赎回的","救世的","赎身的"]]],"gre",19552,0,0],"redesign":[[["",["重新设计"]]],null,10636,1,0,"d:redesigned/i:redesigning/3:redesigns"],"redevelopment":[[["n.",["再开发","重点恢复"]]],null,12964,1,0,"s:redevelopments"],"redhead":[[["n.",["红发的人"]]],null,15089,0,0,"s:redheads",[["In the morning of the 27th of February of 2022, on my way out of my Lulu Island house, I saw my neighbours the redhead Rochelle of Russian-Mennonite ancestry and the grey-haired moustached Al from the Anglophone section of Montreal; he was from many generations of Canadians. He said that he did not know French, when he lived in Montreal. I ate a slice of pesto cheese pizza at the pizzeria. The vendor was from Mumbai. Through the window, I could see a young brown-blond-haired man in a dark-grey hooded jacket and blue shorts, which made him look like a \"big boy.\" At the cafe, there was an under-age-30 crowd of ten outside, of whom one looked like a handsome Jew. Inside was a table of five or six over-age-30 people, of whom one was a handsome tomboy in a dark-green jacket and army-green pants. I drank my iced black tea. Heading out of the cafe, I saw the \"big boy\" smoking in the wooded park. I took the long route home, through the grassy school field littered with goose poop, the northern snowcapped mountains obscured by clouds, an Animistic-Buddhistic view seemingly of a different planet. Near my house, parked in a truck were Olivia and Daniel. Olivia was studying Biochemistry. In the back seat of the truck was a fully black German Shepherd.","2022 年 2 月 27 日早上，我正要離開盧盧島的家，卻碰見了鄰居——紅頭髮的俄羅斯門諾派血統的羅謝爾，以及來自蒙…"]]],"redirect":[[["v.",["重新寄送","使改道","使改方向"]],["",["重定向","重新引导"]]],"gk toefl gre",11425,1,0,"d:redirected/i:redirecting/3:redirects"],"rediscover":[[["v.",["重新发现"]]],null,10565,1,0,"d:rediscovered/i:rediscovering/3:rediscovers"],"redistribute":[[["v.",["重新分配","再分发","再分配"]]],null,15327,1,0,"d:redistributed/i:redistributing/3:redistributes",[["At a community center on Shek Lei public housing estate in northern Hong Kong, stacks of mooncake boxes are waiting to be distributed on Mid-Autumn Festival the following day. Inside they contain some of the 76,000 mooncakes that have been collected by Food Grace, a local charity, this holiday season to be redistributed to low-income families and individuals.","在香港北部石籬公共屋邨的一個社區中心裡，一堆堆月餅盒正等著在隔天的中秋節當天分發出去。月餅盒裡裝的，是本地慈善機構「惜…"]]],"redistribution":[[["n.",["重新分配","再分发"]]],"gre",13781,0,0,"s:redistributions"],"redneck":[[["n.",["红脖子（指美国南方保守的露天劳动者）","乡下人"]]],null,17332,0,0,"s:rednecks"],"redness":[[["n.",["红","红色"]]],null,17538,0,0,"s:rednesses"],"redolent":[[["adj.",["芬芳的","有...香味的","令人想起...的"]]],"gre",21497,0,0],"redoubtable":[[["adj.",["可怕的","厉害的","可敬的"]]],"gre",31113,0,0],"redraw":[[["v.",["重画"