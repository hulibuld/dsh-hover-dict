,["预防法","预防措施","预防物","预防药"]],["adj.",["预防的","防止的"]]],null,18878,0,0],"prevention":[[["n.",["阻止","妨碍","预防"]]],"cet6 ielts",3960,0,0,"s:preventions",[["An ounce of prevention is worth a pound of cure.","預防勝於治療。"]]],"preventive":[[["n.",["防止物","预防方法","预防药"]],["adj.",["预防的","防止的"]]],null,7596,1,0,"s:preventives",[["Preventive measures are much more effective than the actual treatment.","预防措施比真正的治疗更有效。"]]],"preview":[[["n.",["事先查看","预览"]],["v.",["事先查看","预演"]]],"gk gre",7529,2,0,"s:previews/d:previewed/i:previewing"],"previous":[[["adj.",["早先的","前面的","过急的"]],["",["以前的","生前的","前述的"],["just preceding something else in time or order"]]],"cet4 cet6 ky toefl ielts gre",1276,4,1,[["Our conclusion is based on previous studies of the problem.","我们的结论基于之前对这个问题的研究。"]]],"previously":[[["adv.",["先","先前","以前","前","(非正式)过早"]],["",["先前地"]]],"cet4 cet6",2313,3,1,[["Previously people believed the earth was flat.","以前的人以為地球是平的。"]]],"prevision":[[["n.",["先见","预知"]]],"gre",0,0,0],"prey":[[["n.",["被掠食者","牺牲者"]],["v.",["捕食"]]],"cet6 ky toefl ielts gre",5502,2,0,"d:preyed/i:preying/s:preys",[["Your random firing will scare away the prey.","你胡乱打枪，会吓跑猎物的。"]]],"price":[[["n.",["价格","代价","价值"],["the amount of money needed to purchase something"]],["v.",["定...的价格"]]],"zk gk ielts",475,5,1,"s:prices/d:priced/i:pricing",[["Houses here are double the price of those in Kobe.","這裏的房子比神戶的要貴上兩倍。"]]],"priceless":[[["adj.",["无价的","极贵重的"]]],null,12469,1,0,[["The saying goes: to turn a new leaf is priceless. The saying also goes: a dog can't change their habits of eating shit!","俗話說：浪子回頭金不換；可俗話又說：狗改不了吃屎！"]]],"pricey":[[["adj.",["昂贵的","价格高的"]]],null,11216,0,0],"prick":[[["v.",["刺","戳","刺痛","使竖起","竖起"]],["n.",["扎","一刺","刺痛"]],["adj.",["竖起的"]]],"cet6 ky gre",13277,1,0,"i:pricking/p:pricked/s:pricks",[["If you prick us, do we not bleed?","你們要是用刀劍刺向我們，我们难道不會流血嗎？"]]],"prickle":[[["v.",["刺","扎","戳","引起刺痛","使感到刺痛"]],["n.",["刺","刺痛","柳条篮子"]]],"gre",22157,0,0,"p:prickled/i:prickling/s:prickles"],"prickly":[[["adj.",["多刺