t/d:wised",[["Although he may be clever, he is not wise.","他只不過是有點小聰明。"]]],"wisely":[[["adv.",["聪明地","精明地"]]],null,9108,0,0],"wish":[[["n.",["希望","愿望","祝愿","命令","请求"],["a specific feeling of desire"]],["v.",["愿","想要","希望","祝愿"],["hope for; have a wish"]]],"zk gk",1055,4,1,"p:wished/i:wishing/3:wishes",[["He wishes he had gone to the theater last night.","昨晚他希望他去了剧场。"]]],"wishful":[[["adj.",["愿望的","渴望的","一厢情愿的"]]],null,14083,0,0],"wisp":[[["n.",["小把","小物体","纤细的东西"]],["v.",["把...卷成小把"]]],null,13203,1,0,"s:wisps/i:wisping/p:wisped"],"wispy":[[["adj.",["小束状的","细微的","飘渺的"]]],"toefl",16412,0,0,"t:wispiest"],"wistful":[[["adj.",["渴望的","想望的"]]],"toefl gre",15300,1,0,[["It's Lulu Island, 3 August 2025. After supper—green figs tender with sunlight, sweet vinegar from yesterday’s pickled jar, and reheated Alfredo—I sat on the balcony and watched the conifer. Stillness below, a street without cars, without haste. My lime water, iced, caught the light. Michael, the Franco-Danish ufologist, has been in my conversations lately. We speak of inner things: the trance of smart devices, the mind’s eye dwindling. He says cafés aren’t cafés anymore. People forget how to look, how to linger. I tell him of Arthur in Japan—how he'd stare into blank walls like a monk gazing at emptiness. Lately I ask machines to speak like poets, and they do. They mimic Elizabethan verses and the old wistful lilt of Tagalog ballads. I pick blackberries along the path to Tim Hortons. \"¡Moras!\" I shout like a child. My friend Mora, whose blood flows with Andes mist, would smile. Today, I bought lemons. I meant limes, but lemons are all right. / blackberry morning— / a fig's ghost on my fingers / and the street still sleeps","現在是 2025 年 8 月 3 日，露露島。晚餐後，陽光下嫩綠的無花果，昨天醃製的甜醋，還有重新加熱的阿爾弗雷多義麵…"]]],"wistfully":[[["adv.",["惆怅地","渴望地"]]],null,15664,0,0],"wit":[[["n.",["机智","智力","头脑","理智","妙语"]]],"cet4 cet6 ky toefl ielts gre",5755,2,0,"s:wits",[["A fall into a pit, a gain in your wit.","吃一塹，長一智。"]]],"witch":[[["n.",["巫婆","女巫"]],["v.",["施巫术","迷惑"]]],"ky gre",5294,2,0,"s:witches/i:witching/p:witched",[["Mary dressed up as a witch.","玛丽打扮成一个女巫。"]]],"witchcraft":[[["n.",["巫术","魔法","魔力"]]],null,13968,1,0,"s:witchcrafts",[["It's witchcraft!","是巫術！"]]],"with":[[["prep.",["和...在一起","以","由于"],["With denotes or expresses some situation or relation of"]]],"zk gk",16,5,1,[["The problem is how we cope with the present difficulties.","问题是我们如何应付目前的困难。"]]],"withdraw":[[["v.",["撤回","取回","撤消","使撤退","拉开"]]],"gk cet4 cet6 ky toefl ielts gre",2786,4,1,"d:withdrawn/p:withdrew/i:withdrawing/3:withdraws",[["You may as well withdraw from the club right away.","你還不如立刻退出這個俱樂部。"]]],"withdrawal":[[["n.",["提款","撤退","退回","撤消","退隐"]],["",["戒除","脱瘾"]]],"toefl",4130,3,0,"s:withdrawals",[["The Soviet troops have started the withdrawal from Afghanistan.","苏联军队开始从阿富汗撤军了。"]]],"wither":[[["v.",["使凋谢","使消亡","使畏缩","枯萎","衰退"]]],"cet6 toefl ielts gre",11891,1,0,"p:withered/i:withering/3:withers",[["The flowers in my garden have withered in the cold.","我花園裏的花在寒冷的天氣下枯萎了。"]]],"withhold":[[["v.",["使停止","扣留","保留","拒给","克制"]]],"cet6 ky ielts gre",6650,2,0,"d:withheld/i:withholding/3:withholds"],"within":[[["n.",["内部","里头"]],["adv.",["在内部","在内心里"]],["prep.",["在...之内"]]],"gk cet4 cet6 ky",352,5,1,[["She was within an ace of saying \"I don't know\".","她差點要說「我不知道」了。"]]],"without":[[["prep.",["没有","不","在...之外"],["On or at the outside of; out of; not within; as"]],["adv.",["在外面","户外"],["On or art the outside; not on the inside; not within"]],["n.",["外面","外部"]]],"zk gk",218,5,1,[["I cannot see you without thinking of your late father.","我一見到你就會想起你已故的父親。"]]],"withstand":[[["v.",["抵住","顶住","经得起"]]],"cet4 cet6 ky toefl ielts gre",6972,1,0,"d:withstood/i:withstanding/3:withstands",[["She is unable to withstand the pressure.","她無法應付壓力。"]]],"witness":[[["v.",["目击","作证","证明","表明","作证人"]],["n.",["证人","目击者","证据","证词"],["someone who sees an event and reports what happened"]]],"gk cet4 cet6 ky toefl ielts gre",1970,3,1,"s:witnesses/d:witnessed/i:witnessing",[["Have you ever served as a witness in a court case?","你曾是一宗司法案件的证人？"]]],"witticism":[[["n.",["妙语","俏皮话"]]],"gre",28208,0,0,"s:witticisms"],"witty":[[["adj.",["富于机智的","诙谐的"]]],"cet6 toefl",9923,2,0,"t:wittiest/r:wittier",[["She's quick on her feet, so no matter what you say to her, she'll have a witty comeback.","她的腦筋轉得很快，無論你對她說些什麼，她總能巧妙地作出反駁。"]]],"wizard":[[["n.",["男巫","术士","奇才"]],["adj.",["男巫的","巫术的"]],["",["向导"]]],null,9502,1,0,"s:wizards",[["\"What craft do you know?\" the wizard asked the youth.","巫師問年輕人：「你懂什麼技藝？」"]]],"wizardry":[[["n.",["巫术"]]],"gre",21796,0,0],"wizen":[[["v.",["vi. (使)枯萎","(使)雕谢"]]],"gre",0,0,0,"p:wizened"],"wizened":[[["adj.",["干枯的","枯萎的","干瘪的","消瘦的"]]],"gre",25082,0,0],"wobble":[[["v.",["摇晃","摇摆","游移不定","使摇摆","使颤动"]],["n.",["摆动","摇晃","不稳定","抖动"]]],"gre",12620,1,0,"p:wobbled/i:wobbling/3:wobbles"],"wobbly":[[["adj.",["摆动的","不稳定的"]]],null,14785,1,0,"s:wobblies",[["All I did was run a little and now my knees are wobbly.","只跑了一點點，膝蓋就開始發抖。"]]],"woe":[[["n.",["悲哀","悲痛","苦痛"]]],"cet6 gre",8122,1,0,"s:woes",[["Woe to the vanquished.","悲哉失敗者!"]]],"woeful":[[["adj.",["悲伤的","悲哀的"]]],null,23845,1,0],"woefully":[[["adv.",["悲伤地","不幸地","使人痛苦地"]]],null,15773,0,0],"wok":[[["n.",["锅（源自广东话）","炒菜锅"]]],null,18705,0,0,"i:wokking/s:woks",[["Where is the wok?","炒鍋在哪裡？"]]],"wolf":[[["n.",["狼","残忍贪婪之人","极度穷困"]],["v.",["狼吞虎咽","大吃"]]],"zk gk cet4 cet6 ky",4150,1,0,"s:wolves/p:wolfed/i:wolfing/3:wolfs",[["Tom shot his own dog, thinking it was a wolf.","汤姆把他的狗认成狼了，所以把它毙了。"]]],"wollongong":[[["",["伍伦贡"]]],"ielts",0,0,0],"woman":[[["n.",["女人","妇女","女仆"],["an adult female person (as opposed to a man)"]],["adj.",["女用的","女性的","妇女的"]],["v.",["贬称...为女人","使成女人腔"]]],"zk gk",111,5,1,"s:women",[["The young woman was carrying an infant in her arms.","那個年輕女人手抱著嬰兒。"]]],"womanhood":[[["n.",["女子成年身分","女子成年期","女子成年资格","女子气质","女子特性"]]],null,16162,0,0],"womb":[[["n.",["子宫","发源地"]]],null,9091,1,0,"s:wombs/p:wombed",[["Surely he can not enter a second time into his mother's womb to be born!","他当然不可能回到娘胎里再出生一次了！"]]],"won't":[[["",["将不","不会（=will not）"]]],null,0,5,0,[["She won't take an airplane for fear of a crash.","她不会乘飞机因为害怕坠机。"]]],"wonder":[[["v.",["惊奇","想知道","惊讶","怀疑"],["have a wish or desire to know something"]],["n.",["奇迹","惊奇","惊愕"],["the feeling aroused by something strange and surprising"]]],"zk gk cet4 cet6 ky toefl",790,4,1,"p:wondered/i:wondering/s:wonders",[["To be surprised, to wonder, is to begin to understand.","感到惊讶、感到惊奇就是明白的开始。"]]],"wonderful":[[["adj.",["令人惊奇的","奇妙的","极好的"]]],"zk gk cet4 cet6 ky",1405,4,1,[["The show was wonderful, but the tickets were too expensive.","这场秀棒极了，但是门票太贵了。"]]],"wonderfully":[[["adv.",["惊人地","极好地","精彩地"]]],null,8891,0,0],"wonderland":[[["n.",["奇境","仙境","非常奇妙的地方"]]],null,20202,1,0,"s:wonderlands"],"wondrous":[[["adj.",["令人惊奇的"]]],null,12808,1,0,[["Occasionally, wondrous texts were included.","偶爾也會收錄一些精彩的文字。"]]],"wont":[[["adj.",["惯常的","易于...的"]],["v.",["习惯","使习惯于"]],["n.",["习惯"]]],"gre",18224,0,0],"woo":[[["v.",["追求","向...求爱","恳求","求爱","央求"]]],"gk gre",8645,2,0,"d:wooed/i:wooing/3:woos"],"wood":[[["v.",["植林于","给...添加木柴","收集木材"]],["n.",["木材","木制品"],["the hard fibrous lignified substance under the bark of trees"]]],"zk gk cet4 cet6 ky ielts",1236,4,1,"s:woods",[["We spread out and began to search through the woods.","我们分散开来并在树林中展开搜索。"]]],"woodcut":[[["n.",["木刻","木刻印版"]]],"gre",21971,0,0,"s:woodcuts/i:woodcutting"],"wooded":[[["adj.",["树木繁茂的"]]],null,9850,1,0,[["In the morning of the 27th of February of 2022, on my way out of my Lulu Island house, I saw my neighbours the redhead Rochelle of Russian-Mennonite ancestry and the grey-haired moustached Al from the Anglophone section of Montreal; he was from many generations of Canadians. He said that he did not know French, when he lived in Montreal. I ate a slice of pesto cheese pizza at the pizzeria. The vendor was from Mumbai. Through the window, I could see a young brown-blond-haired man in a dark-grey hooded jacket and blue shorts, which made him look like a \"big boy.\" At the cafe, there was an under-age-30 crowd of ten outside, of whom one looked like a handsome Jew. Inside was a table of five or six over-age-30 people, of whom one was a handsome tomboy in a dark-green jacket and army-green pants. I drank my iced black tea. Heading out of the cafe, I saw the \"big boy\" smoking in the wooded park. I took the long route home, through the grassy school field littered with goose poop, the northern snowcapped mountains obscured by clouds, an Animistic-Buddhistic view seemingly of a different planet. Near my house, parked in a truck were Olivia and Daniel. Olivia was studying Biochemistry. In the back seat of the truck was a fully black German Shepherd.","2022 年 2 月 27 日早上，我正要離開盧盧島的家，卻碰見了鄰居——紅頭髮的俄羅斯門諾派血統的羅謝爾，以及來自蒙…"]]],"wooden":[[["adj.",["木制的","呆笨的","木然的"]]],"gk cet4 cet6 ky",2512,3,1,[["Do you remember when we made wooden bridges?","还记得咱们造木桥那时候么？"]]],"woodland":[[["n.",["林区","林地"]]],null,11183,2,0,"s:woodlands"],"woodpecker":[[["n.",["啄木鸟"]]],"cet6",16605,0,0,"s:woodpeckers",[["The woodpecker is pecking the tree trunk vigorously.","啄木鸟正在使劲地啄树干。"]]],"woodwork":[[["n.",["木制品","木制家具","木工手艺","木工活","房屋内的木建部分"]]],null,15187,1,0,"s:woodworks"],"woodworking":[[["n.",["木工活","木工行业"]]],null,19267,0,0],"woody":[[["adj.",["多树木的","木质的"]]],null,14494,0,0,"r:woodyer"],"wool":[[["n.",["羊毛","毛织物","毛线","绒线","绒毛"]]],"cet4 cet6 ky toefl",5569,2,1,"s:wools",[["Cats love to run after balls of wool.","猫喜欢追着毛线球跑。"]]],"woolen":[[["adj.",["羊毛的","羊毛制的","毛织的"]],["n.",["毛制品"]]],"toefl",16629,0,0,[["I'm looking for a warm, woolen skirt.","我想找一件溫暖的羊毛裙。"]]],"woollen":[[["n.",["毛织品"]],["adj.",["羊毛制的"]]],"gk cet4 cet6",41582,1,0,"s:woollens",[["She bought a woollen pullover to give to him.","她买了件羊毛套衫给他。"]]],"woolly":[[["adj.",["羊毛制的","模糊的","似羊毛的","蓬乱的"]]],"toefl",16278,1,0,"s:woollies/r:woollier"],"word":[[["n.",["话","消息","词","诺言","命令"],["a unit of language that native speakers can identify"]],["v.",["用言辞表达"]],["",["字"]]],"zk gk",244,5,1,"s: