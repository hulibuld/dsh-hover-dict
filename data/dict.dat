r.","我們ACME有限公司，特此宣布，我們將盡我們的力量抵制這種惡意收購。"]]],"acne":[[["n.",["痤疮","粉刺"]]],null,13862,1,0,[["Oliver has an acne problem.","奧利弗有粉刺。"]]],"acolyte":[[["n.",["侍僧","助手"]]],"gre",20449,0,0,"s:acolytes"],"acorn":[[["",["浆栎","浆栎果"]],["n.",["橡树果实"]]],"gre",15397,0,0,"s:acorns",[["From a small acorn grows a tall oak tree.","一粒小小的橡實可以長成一棵高大的橡樹。"]]],"acoustic":[[["adj.",["听觉的","声学的","音响的","听的"]]],"gre",10194,2,0,"s:acoustics",[["An electric guitar doesn't sound the same as an acoustic one.","電結他的聲音和木結他不同。"]]],"acoustical":[[["adj.",["听觉的","声学的"]]],"toefl",24425,0,0],"acquaint":[[["v.",["使认识","介绍"]]],"cet6 ky toefl ielts gre",9630,1,0,"d:acquainted/i:acquainting/3:acquaints",[["Yes, people usually curse at someone they are acquainted with.","對，人通常會對自己的熟人口出惡言。"]]],"acquaintance":[[["n.",["认识","相识者"]]],"gk cet4 cet6 ky toefl gre",6274,2,0,"s:acquaintances",[["She is more of an acquaintance than a friend.","与其说她是我的朋友，不如说她只是一个我认识的人。"]]],"acquiesce":[[["v.",["默许","默然同意"]]],"gre",15179,0,0,"d:acquiesced/i:acquiescing/3:acquiesces"],"acquiescence":[[["n.",["默许","默认"]]],null,17580,0,0],"acquire":[[["v.",["获得","学到"]],["",["目标锁定"]]],"gk cet4 cet6 ky toefl ielts",2063,3,1,"d:acquired/i:acquiring/3:acquires",[["You have to acquire real skills, not just superficial knowledge.","你要學的是實實在在的技能，而不單是表面的知識。"]]],"acquisition":[[["",["收购","招揽","取得"]],["n.",["获得","获得物"]]],"gk cet4 cet6 ky toefl ielts",3856,3,0,"s:acquisitions"],"acquisitive":[[["",["取得的","获得的","贪得无厌的"]],["adj.",["渴望获得的","贪婪的"]]],"cet6 toefl gre",28517,0,0,[["He is acquisitive of knowledge.","他很有求知慾。"]]],"acquit":[[["v.",["无罪释放","表现","使履行"]],["",["开释","释放","免"]]],"toefl gre",9999,2,0,"d:acquitted/i:acquitting/s:acquits",[["The court acquitted him of the charge of murder.","法庭对他的谋杀罪名作出了无罪判决。"]]],"acquittal":[[["n.",["履行","无罪开释"]],["",["(债务的)清偿"]]],"gre",15274,0,0,"s:acquittals"],"acre":[[["n.",["英亩"]]],"gk cet4 ky toefl",0,3,0,"s:acres",[["The pasture has an area of 10 acres.","牧场的面积有10英亩。"]]],"acreage":[[["n.",["英亩数","土地面积","矿区租赁面积"]]],