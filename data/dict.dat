.",["遗物","遗迹","纪念物","遗风","残留物"]]],"toefl gre",8394,1,0,"s:relics",[["Cherish our cultural relics; it is all our duty.","爱护文物, 人人有责。"]]],"relief":[[["n.",["减轻","解除","救济","安慰","调剂"],["the feeling that comes when something burdensome is removed or reduced"]]],"gk cet4 cet6 ky toefl ielts",1812,4,1,"s:reliefs",[["We all breathed a big sigh of relief.","我們都舒了一口長氣。"]]],"relieve":[[["v.",["减轻","救济","解除","使免除","换...的班"]]],"cet4 cet6 ky toefl",3764,2,0,"p:relieved/i:relieving/3:relieves",[["They looked relieved only when it was in motion.","当它运转了，他们才看起来放心了。"]]],"reliever":[[["n.",["解除痛苦的人","接替者","救济者"]]],null,12227,0,0,"3:relievers"],"religion":[[["n.",["宗教","信仰","宗教信仰"],["a strong belief in a supernatural power or powers that control human …"]]],"gk cet4 cet6 ky toefl ielts gre",1383,3,1,"s:religions",[["The article on Buddhism revived my interest in oriental religions.","那篇關於佛教的文章再次勾起了我對東方宗教的興趣。"]]],"religiosity":[[["n.",["笃信","虚伪信仰","虔诚","宗教狂"]]],null,14672,0,0],"religious":[[["adj.",["宗教性的","虔诚的","宗教上的","严谨的"],["having or showing belief in and reverence for a deity"]],["n.",["修道士","出家人"],["a member of a religious order who is bound by vows of poverty and cha…"]]],"gk cet4 cet6 ky toefl",884,4,1,[["I'm a deeply religious man and believe in life after death.","我是一個虔誠的教徒，我相信死後的生命。"]]],"religiously":[[["adv.",["虔诚而经常地","笃诚地"]]],null,12088,0,0],"relinquish":[[["v.",["放弃","撤回","停止","松开","让与"]]],"toefl ielts gre",9453,1,0,"p:relinquished/i:relinquishing/3:relinquishes"],"relish":[[["n.",["滋味","风味","美味","爱好","食欲"]],["v.",["调味","喜欢","玩味","有味道"]]],"ky gre",8659,2,0,"p:relished/i:relishing/3:relishes"],"relive":[[["v.",["再生","复活","再体验"]]],null,10823,1,0,"i:reliving/p:relived/3:relives"],"reload":[[["v.",["再装","再装填弹药"]]],null,16397,0,0,"p:reloaded/i:reloading/3:reloads"],"relocate":[[["v.",["重新安置","再配置","放在新地方"]],["",["再定位","浮动"]]],null,6928,1,0,"d:relocated/i:relocating/3:relocates"],"relocation":[[["n.",["再布置","变换布置"]],["",["重新安置"]]],null,10541,0,0,"s:relocations"],"reluctance":[[["n.",["不情愿","勉强"]],["",["磁阻"]]],null,6979,0,0],"reluctant":[[["adj.",["不情愿的","勉强的","不愿的","难以处理的"]]],"cet4 cet6 ky toefl ielts",3900,3,0,[["Tom is reluctant to talk about it.","湯姆不太願意談這件事。"]]],"reluctantly":[[["adv.",["不情愿地","勉强地"]]],null,7107,0,0,[["Reluctantly, he started the engine and drove off.","他不情愿地启动引擎开车走了。"]]],"rely":[[["v.",["信赖","依赖","信任"]]],"gk cet4 cet6 ky toefl ielts",1857,3,0,"i:relying/3:relies/d:relied",[["It is questionable whether this data can be relied on.","這些資料未必可靠。"]]],"remain":[[["v.",["保持","逗留","剩余"],["be left; of persons, questions, problems, results, evidence, etc."]],["",["停留","居住","继续"]]],"zk gk cet4 cet6 ky",426,5,1,"3:remains/p:remained/i:remaining",[["Since he didn't know what to say, he remained silent.","自从他不知道该说什么的时候，便一直沉默着。"]]],"remainder":[[["n.",["剩余物","其他人","残余","余数"]],["adj.",["剩余的","出售削价剩书的"]],["v.",["削价出售(图书)"]]],"cet6 ky toefl gre",6805,2,0,"s:remainders/d:remaindered/i:remaindering"],"remake":[[["v.",["再作","再制","重作"]],["n.",["再制","改作","重制物"]]],null,10609,1,0,"d:remade/i:remaking/s:remakes",[["But I will always be honest with you about the challenges we face. I will listen to you, especially when we disagree. And above all, I will ask you to join in the work of remaking this nation, the only way it's been done in America for 221 years; block by block, brick by brick, calloused hand by calloused hand.","但我将总是会向你们坦陈我们所面临的挑战。我会听取你们的意见，尤其是存在不同意见的时候。最重要的是，我会请求你们参与重建…"]]],"remand":[[["n.",["遣回","还押"]],["v.",["遣回","还押候审"]]],null,23442,1,0,"d:remanded/s:remands/i:remanding"],"remark":[[["v.",["评论","注意","谈论"]],["n.",["评论","注意"]],["",["注释"]]],"gk cet4 cet6 ky toefl ielts",3389,3,1,"s:remarks/p:remarked/i:remarking",[["The beginning of the trouble was his careless remark.","麻煩的開頭是他草率的評論。"]]],"remarkable":[[["adj.",["不平常的","值得注意的","显著的"]]],"cet4 cet6 ky toefl ielts",2708,3,1,[["This company achieved a remarkable increase in turnover last year.","这家公司去年获得显著的营业额增长。"]]],"remarkably":[[["adv.",["显著地","引人注目地","非常地"]]],"toefl",5158,0,1,[["Her dark, almond-shaped eyes were remarkably beautiful.","她那雙深色的杏仁眼非常美麗。"]]],"remarry":[[["v.",["(使)再婚"]]],null,10958,1,0,"d:remarried/i:remarrying/3:remarries",[["Who did you remarry?","你和谁再婚了？"]]],"rematch":[[["n.",["复赛","重赛"]]],null,19053,0,0],"remedial":[[["adj.",["治疗的","补救的","矫正的"]]],null,10419,1,0,"s:remedials",[["She has to take a remedial course in English.","她需要上英语补习班。"]]],"remediation":[[["n.",["补习","辅导","补救","纠正"]]],null,14082,0,0],"remedy":[[["v.",["治疗","补救","矫正","改善","修补"]],["n.",["药物","治疗法","治疗","补救","赔偿"]]],"cet4 cet6 ky toefl ielts",5111,2,0,"s:remedies/d:remedied/i:remedying",[["Smiling is the best remedy for negative emotions.","笑容是壞心情的最佳藥方。"]]],"remember":[[["v.",["记得","回忆起","记住","铭记","纪念"],["recall knowledge from memory; have a recollection"]]],"zk gk",379,5,1,"p:remembered/i:remembering/3:remembers",[["It is really marvelous of you to remember my birthday.","你還記得我的生日，那真是太好了。"]]],"remembrance":[[["n.",["回想","记忆","纪念品","记忆力","问候"]]],null,10803,1,0,"s:remembrances"],"remind":[[["v.",["提醒","使想起"],["put in the mind of someone"]]],"gk cet4 cet6 ky toefl ielts",1458,3,1,"p:reminded/3:reminds/i:reminding",[["You remind me of a boy I used to know.","你让我想起我过去认识的一个男孩。"]]],"reminder":[[["n.",["提醒的人","暗示"]],["",["催单"]]],"toefl gre",4390,2,0,"s:reminders",[["Friendly Reminder: Please keep in mind the closing time of the line you need to switch to, so as to avoid delays in your trip.","友情提示：请留意您需要换乘线路的首末班时间，以免耽误您的出行。"]]],"reminisce":[[["v.",["追忆说","追忆往事","话旧"]]],"gre",13731,1,0,"i:reminiscing/p:reminisced/3:reminisces"],"reminiscence":[[["n.",["回想","回忆","怀旧","话旧"]]],null,17145,1,0,"s:reminiscences"],"reminiscent":[[["adj.",["回忆的","怀旧的"]],["n.",["往事叙述者","回忆录作者"]]],null,7515,2,0,[["This 14th of May of 2025 is cloudy skies interspersed with blue spaces. I walked to the Roman Catholic church on St. Albans Road twice, once in the morning and again in the afternoon, my 12th and 13th times this spring. In the morning was confession for the little boys and girls in uniform. They were of different races, in the big worship hall. The priest was in the confession booth talking to a student. At the Adoration Chapel, I noticed a nice pot of orchids on the front left. In the afternoon, the big worship hall was mostly empty, a condition which I usually prefer. At the road was a handsome muscle man in white tank top jogging. The big purple-bloom tree seems like an Empress Tree, a Paulownia, because of the big heart-shaped leaves. Reminiscent of Jacaranda with its purple blooming, it's saudade for me about South America. At Tim Hortons café, I enjoyed Scrambled Eggs with Sausage and Potatoes and an Earl Grey Tea with oat milk in the morning, and an Iced Classic Lemonade in the afternoon. The day was full of walking. At home, I study bits of Lojban and Esperanto. I have many books in Esperanto. I tend towards Animism-Buddhism in my Syncretism.","2025 年 5 月 14 日，天空多雲，間或有藍色空間。我兩次走到聖奧爾本斯路上的羅馬天主教堂，一次在早上，一次在下…"]]],"remiss":[[["adj.",["怠慢的","不小心的","没精打采的","疏忽的"]]],"gre",24156,0,0],"remission":[[["n.",["宽恕","豁免","免罪","缓和","减轻"]],["",["缓解","弛张"]]],"gre",15046,1,0,"s:remissions"],"remit":[[["v.",["宽恕","赦免","免除","汇出","缓解"]],["n.",["移交的事物"]]],"toefl gre",28338,1,0,"d:remitted/s:remits/i:remitting"],"remittance":[[["n.",["汇款","寄款","支付(金额)"]]],"ielts gre",16559,1,0,"s:remittances",[["I'm sorry, without an I.D. you cannot receive a remittance.","对不起，没有身份证是不能领汇款的。"]]],"remittent":[[["adj.",["张弛性的","缓解的"]],["n.",["弛张热"]]],"gre",0,0,0],"remix":[[["v.",["使再混合","再搅拌","重新合成（乐曲等）"]]],null,30654,1,0,"s:remixes/d:remixed/i:remixing"],"remnant":[[["n.",["剩余","零料","遗迹"]],["adj.",["剩余的","残余的"]]],"cet6 ky toefl ielts gre",6394,1,0,"s:remnants"],"remodel":[[["v.",["改造","改型","改变"]]],null,11351,0,0,"d:remodelled/i:remodelling/3:remodels"],"remonstrance":[[["n.",["抗议","忠告","规劝","抗辩"]]],"gre",35549,0,0,"s:remonstrances"],"remonstrate":[[["v.",["表示异议","抗议","责备","抗议地说"]]],"gre",31022,0,0,"p:remonstrated/i:remonstrating/3:remonstrates"],"remorse":[[["n.",["懊悔","良心不安","自责","同情","悔恨"]]],"ielts gre",10471,1,0,[["Sociopaths rarely display remorse or feelings of guilt for their crimes.","反社会者极少为他们的罪行显露懊悔或有罪恶的感觉。"]]],"remote":[[["adj.",["遥远的","偏僻的","疏远的","微少的"]],["",["远程","远程访问实用程序"]]],"gk cet4 cet6 ky toefl",2778,3,1,"r:remoter/t:remotest",[["She was born in a remote village in Nepal.","她出生于尼泊尔的一个偏远小山村。"]]],"remotely":[[["adv.",["极小地","极细微地"]]],null,9613,1,0,[["I often use SSH to remotely connect to my computer.","我经常使用SSH来远程连接到我的电脑。"]]],"removable":[[["adj.",["可移去的","可免职的","可移动的"]]],null,14776,0,0,"s:removables"],"removal":[[["n.",["移动","移居","迁移","排除","切除"]]],"cet4 cet6 ky ielts",4711,2,1,"s:removals",[["Early removal of the placenta is very dangerous.","胎盘早剥很危险。"]]],"remove":[[["v.",["移动","调动","除去","迁移","开除"],["remove something concrete, as by lifting, pushing, or taking off, or …"]],["n.",["班级","升级","移动","搬家","间距"],["degree of figurative distance or separation"]],["",["删除"]]],"gk cet4 cet6 ky toefl gre",876,4,1,"d:removed/i:removing/3:removes",[["My mum helps me remove the core of the plum.","妈妈帮我把李子去了核。"]]],"remunerate":[[["v.",["给与报酬","赔偿","酬劳"]]],"gre",42476,0,0,"d:remunerated/i:remunerating/3:remunerates"],"remunerative":[[["adj.",["有报酬的","有利可图的","合算的"]]],"gre",37629,0,0],"renaissance":[[["n.",["复活","复兴","文艺复兴"]],["adj.",["文艺复兴的"]]],"cet6 ky toefl ielts",11032,2,0,[["With Renaissance, scholastic ideas gave place to positive ideas.","隨著文藝復興，學院派的想法被積極的想法取而代之了。"]]],"renal":[[["adj.",["肾脏的","肾的"]]],null,13800,0,0],"rename":[[["v.",["重新命名","再命名","给...改名"]],["",["重命名","DOS内部命令:更改文件名"]]],null,9242,1,0,"d:renamed/i:renaming/3:renames",[["On July 29, 1939, by a resolution of the Supreme Council of the BSSR, the capital of Belarus, Miensk, was renamed Minsk, even in the Belarusian version.","1939 年 7 月 29 日，根據白俄羅斯蘇維埃社會主義共和國最高蘇維埃的決議，白俄羅斯首都明斯克的英文名「Mien…"]]],"renascent":[[["adj.",["再生的","复活的"]]],"gre",0,0,0],"rend":[[["v.",["分裂","劈开","强夺","撕碎","划破"]]],"toefl gre",27164,0,0,"i:rending/3:rends/p:rent",[["I can pay no more than $50 a week for rent.","我最多只能付每周50美元的房租。"]]],"render":[[["v.",["回报","给于","付给","汇报","提出"]],["n.",["交纳","打底"]]],"cet4 cet6 ky toefl ielts gre",3537,2,0,"d:rendered/3:renders/i:rendering",[["The surprise rendered her speechless.","她驚訝得說不出話來。"]]],"rendezvous":[[["v.",["集合","集结","在约定场所会面"]],["n.",["约会","约会地点"]],["",["会合"]]],"ielts gre",12972,1,0,"i:rendezvousing/p:rendezvoused/3:rendezvouses",[["Tom bought, for his rendezvous, a flower and some gifts.","湯姆為約會買了一束花和一些禮物。"]]],"rendition":[[["n.",["译文","施舍","表演"]],["",["生产量"]]],"toefl gre",10446,1,0,"s:renditions"],"renegade":[[["n.",["背教者","变节者","脱党者"]],["adj.",["背弃的","脱离的","叛徒的"]],["v.",["背叛","背弃","脱离"]]],"gre",13169,1,0,"s:renegades"],"renege":[[["v.",["违例出牌","食言","毁约","否认","放弃"]],["n.",["出牌违例"]]],"gre",18611,1,0,"i:reneging/d:reneged/s:reneges"],"renegotiate":[[["v.",["重新谈判"]]],null,15650,0,0,"d:renegotiated/i:renegotiating/3:renegotiates"],"renew":[[["v.",["使更新","使恢复","复兴","修补","补充"]]],"cet4 cet6 ky toefl",5526,3,0,"p:renewed/i:renewing/3:renews",[["She renewed the soil in the flower pot.","她更新了花盆裡的土。"]]],"renewable":[[["adj.",["可更新的","可恢复的","可继续的","可换新的","可重复的"]],["",["可更新","可再生的"]]],"toefl",7302,1,0,"s:renewables",[["Can Algeria rely on renewable energy?","阿尔及利亚能依赖可再生能源吗？"]]],"renewal":[[["n.",["更新","革新","复兴","恢复","修补"]]],"toefl ielts",6501,0,0,"s:renewals"],"renounce":[[["v.",["拒绝","放弃","否认","垫牌","声明放弃权利"]],["n.",["垫牌"]]],"toefl gre",10656,1,0,"d:renounced/i:renouncing/3:renounces",[["The Japanese people have renounced war.","日本人放弃了战争。"]]],"renovate":[[["v.",["更新","革新","刷新","修复","使恢复活力"]]],"ky toefl gre",8620,1,0,"d:renovated/i:renovating/3:renovates",[["Our venue wasn't renovated too long ago.","我们的场地不久前翻新了。"]]],"renovation":[[["n.",["革新","刷新","修理"]],["",["改建"]]],"cet6 toefl ielts",7265,0,0,"s:renovations"],"renown":[[["n.",["名声","声望"]],["v.",["使有声望"]]],"gre",18742,0,0,[["The Memorial To The Emperor upon his campaign truly established his renown for all time; Who, in a thousand years, could stand shoulder to shoulder with it?","出师一表真名