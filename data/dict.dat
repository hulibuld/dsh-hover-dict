e.","肥皂可以清除髒汙。"]]],"grimly":[[["adv.",["严格地","冷酷地","可怕地"]]],null,12183,0,0],"grimy":[[["adj.",["污秽的","肮脏的"]]],null,15467,0,0,"r:grimier"],"grin":[[["n.",["露齿笑"]],["v.",["露齿而笑"]]],"cet6 ky ielts gre",4154,2,0,"p:grinned/i:grinning/s:grins",[["We just have to grin and bear it.","我們只能強忍著。"]]],"grind":[[["v.",["磨擦","磨碎","磨光","折磨","压榨"]],["n.",["磨","碾","苦差","摩擦声","用功的学生"]]],"cet4 cet6 ky toefl ielts gre",5372,2,0,"d:ground/i:grinding/3:grinds",[["Don't keep your eyes on the ground; look at me.","你的眼睛不要看著地上; 看著我。"]]],"grinder":[[["",["磨床","磨木机","研磨机"]],["n.",["推磨的人","研磨者"]]],null,13050,0,0,"s:grinders"],"grip":[[["n.",["紧握","柄","握力","握手方式","手提包"]],["v.",["抓紧","抱住","吸住","掌握","握牢"]]],"cet4 cet6 ky toefl ielts",3694,3,0,"p:gripped/s:grips/i:gripping",[["Get a grip on yourself!","冷静下来！"]]],"gripe":[[["v.",["抓紧","抱住","使肠痛","激怒","肠绞痛"]],["n.",["紧握","柄","把手","控制"]]],"gre",17456,1,0,"s:gripes/i:griping/p:griped"],"grisly":[[["adj.",["可怕的","厉害的","令人畏惧的"]]],"gre",15353,1,0,"t:grisliest",[["Police arrived at the grisly crime scene.","警察到达了可怕的犯罪现场。"]]],"gristle":[[["n.",["软骨"]]],"gre",31820,0,0],"grit":[[["v.",["覆以砂砾","咬牙切齿地说","摩擦作声"]],["n.",["砂砾","粗砂石"]]],"ielts gre",9008,1,0,"p:gritted/i:gritting/s:grits",[["Grit your teeth and bear it!","咬紧牙关坚持到底！"]]],"gritty":[[["adj.",["有砂砾的","坚韧不拔的"]]],null,10456,1,0,"r:grittier/t:grittiest",[["A gritty story of redemption and hope in a ramshackle urban township is the South African entry for this year's Academy Awards and one of the five finalists for Best Foreign Language Film.","这部发生在破旧不堪小镇的救赎与希望之歌，是南非选送今年奥斯卡的作品，并入围了最佳外语片五强角逐。"]]],"grizzly":[[["adj.",["略为灰色的","呈灰色的"]],["n.",["灰熊"]]],null,12822,0,0,"s:grizzlies/t:grizzliest/r:grizzlier",[["This grizzly bear weighs half a ton.","这只灰熊有0.5吨重。"]]],"groan":[[["v.",["呻吟","抱怨","受压迫","呻吟地说"]],["n.",["呻吟","叹息"]]],"cet4 cet6 ky ielts gre",7178,2,0,"p:groaned/i:groaning/s:groans",[["The table was groaning with food.","桌子上放滿了食物。"]]],"grocer":[[["n.",["食品商"]]],"gk cet4 cet6 ky",14410,1,0,"s:grocers"],"gro