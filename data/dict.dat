utable":[[["adj.",["无可置否的","无疑问的"]]],"gre",0,0,0],"undisputed":[[["",["无需争论的","无疑问的","确然无疑的"]],["adj.",["无可争辩的","无异议的"]]],null,15748,1,0],"undistorted":[[["adj.",["未失真的","不偏激的"]]],"toefl",37726,0,0],"undisturbed":[[["adj.",["未被扰乱的","安静的","镇定的"]]],"toefl",13096,1,0],"undivided":[[["adj.",["未分开的","专一的","(组织等)未分裂的"]],["",["不可分割的","完整的","未分割的"]]],"gk",20480,0,0],"undo":[[["v.",["解开","取消","破坏","毁灭","扰乱"]],["",["撤消"]]],"gk cet4 cet6 ky toefl ielts",6632,1,1,"d:undone/p:undid/i:undoing/3:undoes",[["Wait a minute. My shoelace is undone.","等下，我鞋帶散了。"]]],"undocumented":[[["adj.",["无正式文件的","无事实证明的"]]],null,11308,0,0,[["It's not a bug, it's an undocumented feature.","这不是一个漏洞，而是一个没有写进文档的特性。"]]],"undoubted":[[["adj.",["无疑的","确实的"]]],null,32626,2,0],"undoubtedly":[[["adv.",["无疑","必定","确实地"]]],"cet4 cet6 ky toefl ielts",5545,0,0,[["The computer is undoubtedly a valuable tool.","電腦無疑是一項有價值的工具。"]]],"undress":[[["v.",["使脱衣服","暴露","使卸去装饰","脱衣服"]]],null,12150,1,0,"p:undressed/i:undressing/3:undresses",[["Tom undressed and got into bed.","湯姆脫光睡覺了。"]]],"undue":[[["adj.",["不适当的","过度的","未到期的"]],["",["未到(支付)期的"]]],"ielts",12602,1,0],"undulate":[[["v.",["波动","起伏","呈波浪形","使起伏","使波动"]],["adj.",["波动的","起伏的"]]],"gre",25684,1,0,"p:undulated/s:undulates/i:undulating"],"unduly":[[["",["过分的","过度的","不正当的"]],["adv.",["不适当地","过度地"]]],null,14848,1,0],"unearth":[[["v.",["发掘","掘出","从洞中赶出","揭露","发现"]]],"toefl gre",10691,1,0,"d:unearthed/i:unearthing/3:unearths"],"unearthly":[[["adj.",["非世间的","神秘的","怪异的"]]],"gre",21162,0,0],"unease":[[["n.",["不安"]]],null,13614,1,0,[["With North Korea's announcement on the 26th of its nuclear development plan based upon the agreement stemming from the Six Party Talks, and the United States' commencement of procedures to remove North Korea from its designation on the list of State Sponsors of Terrorism, the families of abductees have expressed growing unease that it may constitute an abandonment of the abductee issue.","随着北朝鲜在26号宣布了按照六方谈话上达成的共识所制定的核计划发展，美国将其从美国的恐怖主义捐助国的名单上去除。被