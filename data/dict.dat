"]],["v.",["存入关栈","使黏合","结合"]]],"gk cet4 cet6 ky toefl ielts",1880,4,0,"s:bonds/d:bonded/i:bonding",[["Though passion may have strained, it must not break our bonds of affection.","雖然激情可能會褪去，但我們不能切斷感情上的聯繫。"]]],"bondage":[[["n.",["奴役","束缚","监禁","奴隶"]]],"toefl gre",16176,1,0,[["I guess she's into bondage and domination.","我想她想要的是束縛與支配。"]]],"bondholder":[[["n.",["债券持有人","公债持有人","公债证书所有者"]]],null,22772,1,0,"s:bondholders"],"bone":[[["n.",["骨头","骨","骨制品"],["rigid connective tissue that makes up the skeleton of vertebrates"]],["v.",["剔骨","专心致志"],["remove the bones from"]]],"gk cet4 ky",1443,3,1,"s:bones/i:boning/p:boned",[["An icy blast of wind chilled me to the bone.","冰冷的疾風吹到我骨子裡去了。"]]],"boneless":[[["adj.",["无骨的"]]],null,15507,0,0],"bonfire":[[["n.",["大篝火","营火"]]],null,12749,1,0,"s:bonfires"],"bonhomie":[[["n.",["愉快","温和","和蔼"]]],"gre",31897,0,0],"bonnet":[[["",["阀盖","阀帽"]],["n.",["软帽"]]],"gre",15125,1,0,"s:bonnets",[["Tall and striking, with a black and gold embroidered shirt and a glittering brown bonnet, she blends in easily with the trendy, after-work crowd.","她身材高挑，外形出眾，身穿黑金刺繡襯衫，頭戴閃亮的棕色軟帽，輕鬆地融入了時髦的下班人潮之中。"]]],"bonus":[[["n.",["奖金","红利","额外补贴"]]],"gk cet6 ky toefl ielts",4172,2,0,"s:bonuses"],"bony":[[["adj.",["如骨的","多骨的","瘦骨嶙峋的"]]],null,9500,1,0],"boo":[[["v.",["嘘(某人)","喝倒彩"]],["int.",["嘘"]]],"gre",12713,1,0,"s:boos/i:booing/p:booed"],"boob":[[["n.",["笨蛋","蠢材"]]],null,16713,0,0,"s:boobs/d:boobed/i:boobing",[["She has big boobs.","她的胸很大。"]]],"boogie":[[["",["(随着摇摆舞音乐节奏)摆动身体","黑人"]]],null,28788,1,0,"i:boogieing/p:boogied/3:boogies"],"book":[[["n.",["书","书籍","帐簿","名册","工作簿"],["a written work or composition that has been published (printed on pag…"]],["v.",["登记","预订"]]],"zk gk ielts",241,5,1,"s:books/d:booked/i:booking",[["I read the book after I had finished my homework.","我做完我的功课后，就读这本书。"]]],"bookcase":[[["n.",["书架","书柜"]]],"gk ielts",12527,1,0,"s:bookcases",[["Tom can't move this bookcase without a little help.","如果沒人幫點忙的話，湯姆是沒辦法移動書櫃的。"]]],"bookie":[[["n.",["登记赌注者"]]],null,22473,1,0],"bookkeeper":[[["n.",["簿记员","记帐员"]]],"ielts",19504,0,0,"s:bookkeepers"],"bookkeeping":[[["n.",["簿记","簿记学"]]],null,18935,0,0,[["Can you do bookkeeping?","你會記帳嗎?"]]],"booklet":[[["n.",["小册子"]]],"ielts",10619,2,0,"s:booklets",[["This booklet is free of charge.","這本小冊子是免費的。"]]],"booklist":[[["",["(某个题目或学科的)推荐书目","书单"]]],"ielts",0,0,0,"s:booklists"],"bookmaker":[[["n.",["著作家","编辑者","赌注登记经营人"]],["",["以赌为业者","赌本","编书谋利者"]]],null,29427,1,0,"s:bookmakers"],"bookmark":[[["n.",["书签"]]],"gk",20965,0,0,"s:bookmarks",[["Bookmark this site.","將此網站存入書籤。"]]],"bookseller":[[["n.",["书商"]]],null,16702,1,0,"s:booksellers"],"bookshelf":[[["n.",["书架"]]],"gk ielts",11170,1,0,[["There are only books on the bookshelf.","书架上都是书。"]]],"bookshop":[[["n.",["书店"]]],"gk ielts",21128,1,0,"s:bookshops",[["Tomorrow I am going to the bookshop to buy books.","明天我在一家書店買書。"]]],"bookstore":[[["n.",["书店"]]],"gk",6186,1,0,"s:bookstores",[["There is a bookstore in front of the department store.","百货商店前有个书店。"]]],"boom":[[["v.",["急速发展","发隆隆声","使兴旺"]],["n.",["繁荣","隆隆声"]]],"gk ky toefl ielts gre",3171,3,0,"p:boomed/s:booms/i:booming",[["He amassed a fortune in stock trading during the last boom.","他在上个景气时期炒股攒下了一笔钱。"]]],"boomer":[[["n.",["往来无定的临时工"]]],null,6858,0,0,"s:boomers",[["OK, boomer.","好啦，老古董。"]]],"boon":[[["n.",["恩惠"]]],"toefl gre",11451,1,0,"s:boons"],"boor":[[["n.",["粗野的人","不懂礼貌的人","农民"]]],"gre",35049,0,0,"s:boors/i:booring"],"boost":[[["v.",["推进","提高","宣扬","促进"]],["n.",["推进","吹捧"]]],"cet4 cet6 ky toefl ielts gre",3691,3,0,"d:boosted/i:boosting/3:boosts",[["It is the 27th of June of 2013. The Blue Dreams are plural. The Blue Dreams are many. Interlingua is not the only one. For decades now, there have existed other Latinate conlangs, different projects. And in the future, some hope for others. But it has been the Green Dream, Esperanto, that has succeeded for more than a century. Reforms attempted upon Esperanto have met with failure over the decades because genuine Esperanto has an artistic balance with which one cannot tamper. Esperanto remains enduring. Amongst the Blues, my vote is still Interlingua. More people should give it a chance. Esperanto's accents give a charm to the language that perhaps boosted its survival over the years. There are substitute systems.","今天是 2013 年 6 月 27 日。藍色夢想不只有一種，而是有很多種。國際語並非唯一。幾十年來，一直存在著其他拉丁…"]]],"booster":[[["n.",["向前推的人","支持者","后援者","升压器","爆管"]]],null,8144,1,0,"s:boosters"],"boot":[[["n.",["长靴","踢","解雇","效用"]],["v.",["使穿靴","踢","解雇","有用"]],["",["引导","自举"]]],"gk cet4 ky ielts",2347,3,1,"s:boots/d:booted/i:booting",[["I want to buy a pair of ski boots.","我想买一双滑雪靴。"]]],"booth":[[["n.",["亭","摊棚"]],["",["货摊","电话间"]]],"gk cet4 cet6 ky ielts",4300,1,0,"s:booths",[["Telephone booths are as scarce as hen's teeth around here.","這裏附近的電話亭少得可憐。"]]],"bootleg":[[["v.",["私卖(酒)"]]],null,23417,1,0,"s:bootlegs/d:bootlegged/i:bootlegging"],"bootless":[[["adj.",["无用的","无益的"]]],"gre",0,0,0],"booty":[[["n.",["战利品","获得之物","赃物","掳获物"]]],null,12826,0,0,"s:booties"],"booze":[[["n.",["酒","酒宴"]],["v.",["豪饮"]]],null,11048,1,0,"i:boozing/d:boozed/3:boozes",[["My friends were so boozed up that I had to drive them home.","我的朋友全都喝得酩酊大醉，我只好開車把他們送回家。"]]],"border":[[["n.",["边缘","边境","边界","花坛"],["a strip forming the outer edge of something"]],["v.",["在...上镶边","接近","接界","近似"],["provide with a border or edge"]],["",["边框"]]],"gk cet4 ky toefl ielts",1344,4,1,"s:borders/i:bordering/d:bordered",[["On the border, there is a stretch of agricultural land.","邊境上有一片農業區。"]]],"borderline":[[["n.",["边界","界线"]],["adj.",["边界的"]]],null,12910,1,0,"s:borderlines"],"bored":[[["adj.",["无聊的","烦人的","无趣的"]]],"gk",5873,2,1,[["If you're bored, I suggest you go to the cinema.","如果你感到无聊，我建议你去电影院。"]]],"boredom":[[["n.",["厌烦","厌倦","令人厌烦的事物"]]],"toefl gre",8671,1,0],"boring":[[["adj.",["烦人的","无聊的","无趣的"]],["",["成孔期","搪孔"]]],"zk gk toefl gre",4915,2,1,"s:borings",[["Nothing is more boring than traveling long distances by car.","没有什么比坐长途汽车更无聊。"]]],"borough":[[["n.",["自治的市镇","区"]]],null,11872,2,0,"s:boroughs"],"borrow":[[["v.",["借","借入","借用"]],["",["借位","借位数"]]],"zk gk",3214,3,1,"d:borrowed/i:borrowing/3:borrows",[["I don't dare ask the boss to borrow the car.","我不敢問老闆借車。"]]],"borrower":[[["n.",["借用人","剽窃者","借款人"]]],null,9542,0,0,"s:borrowers"],"bosnian":[[["n.",["波斯尼亚人"]],["adj.",["波斯尼亚的"]]],null,6556,0,0,"s:bosnians"],"bosom":[[["n.",["胸部","胸","胸怀","内部","中间"]],["v.",["怀抱"]]],"cet4 cet6 ky",12630,1,0,"s:bosoms/i:bosoming/p:bosomed"],"boss":[[["n.",["老板","上司","岩瘤","浮雕","母牛"]],["v.",["指挥","控制","浮雕"]]],"zk gk cet4 ky",2324,4,1,"s:bosses/i:bossing/p:bossed",[["He is our boss, and must be treated as such.","他是我們的老闆，所以一定要受到這樣的禮待。"]]],"bot":[[["",["磁带开始标志","计算机角色","肤蝇幼虫"]]],null,18864,0,0,"s:bots/i:botting",[["I'm translating the messages of the bot from English to Hungarian.","我正在把这个机器人的消息从英语翻译成匈牙利语。"]]],"botanical":[[["adj.",["植物学的"]],["n.",["植物性药材"]]],"gk toefl",10006,1,0,"s:botanicals",[["We found many strange plants in a botanical garden.","我們在一家植物園裏找到了許多稀奇古怪的植物。"]]],"botanist":[[["n.",["植物学家"]]],null,14787,0,0,"s:botanists"],"botany":[[["n.",["植物学"]]],"gk toefl gre",20491,1,0,[["On the 14th of April of 2015, I walk to the Richmond Public Market, I first climbing the stairs outside. Inside, the wide atrium-like building is like a garden in a jungle surrounding, I imagine. Already quite hungry, I trot to Captain Wa, the food vendor, to get noodles with squid, fish, and tofu, as well as hot tea. As I eat, a handsome First Nations man in a purple T-shirt walks by. Then a handsome, stocky Jewish fellow walks by. A few minutes later, I begin to thirst, so I get a cold Mint Bubble Green Tea at the vendor QQ Bubble Tea and Coffee. I sit by the stairs to sip. A threesome family sits eating nearby, the man being black, the woman being Oriental, and the child being a hybrid. Addicted to Bubble Tea, I get another one, this time at Peanut's. It is a cold Green Apple Bubble Green Tea. It is delicious. I take the escalator down. On my way to the washroom, I notice a big aquarium full of probably giant red Alaskan king crabs with barnacles on their legs. They remind me of extraterrestrials, somehow. At the bookstore, I buy a heavily illustrated green botany book in sinograms. I left it on top of a box a month ago and it is still there. It is $14. I take the escalator up. Addicted to Bubble Tea, I spend my remaining coins on a cold Lychee Bubble Green Tea. It is delicious with even bits of white lychee flesh.","2015 年 4 月 14 日，我步行前往列治文公共市場，先是爬上了外面的階梯。市場內部寬敞的中庭式建築，讓我感覺彷彿…"]]],"botch":[[["v.",["拙笨地修补","糟蹋"]],["n.",["拙笨的修补","难看的补缀"]]],"gre",17866,1,0,"d:botched/i:botching/3:botches"],"both":[[["adj.",["两者的"]],["adv.",["两者都"]],["pron.",["两者"]]],"zk gk",255,5,1,[["You've both been very impressive today. I'm proud of you.","今天你们俩很让人印象深刻。我为你们感到骄傲。"]]],"bother":[[["v.",["烦扰","迷惑","烦恼","操心"]],["n.",["麻烦","纠纷","讨厌的人"]]],"ielts",2189,3,1,"d:bothered/i:bothering/3:bothers",[["He didn't pass the exam, but it doesn't bother him.","他考試沒過，但他不是特別在意。"]]],"bottle":[[["v.",["装瓶","抑制","围困"],["store (liquids or gases) in bottles"]],["n.",["瓶子","酒瓶"],["a glass or plastic vessel used for storing drinks or other liquids; t…"]]],"zk gk",1740,4,1,"s:bottles/d:bottled/i:bottling",[["There was only a little milk left in the bottle.","瓶子裏只剩下一丁點牛奶。"]]],"bottleneck":[[["n.",["瓶颈","增产障碍"]]],"gre",15429,0,0,"s:bottlenecks/i:bottlenecking/p:bottlenecked"],"bottom":[[["v.",["给...装底","查明真相","到达底部","建立基础"]],["n.",["底部"],["the lower side of anything"]],["adj.",["底部的"]]],"zk gk cet4 ky",1511,4,1,"s:bottoms/i:bottoming/p:bottomed",[["Their child got their bottom smacked, because they wouldn't listen.","他們家小孩因為不聽話，被打了屁股。"]]],"bottomless":[[["adj.",["无底的","无限的","深不可测的","没有根据的"]]],null,16529,0,0,[["The demon grabbed my sister and, with howling laughter, cast her into a bottomless pit.","惡魔一把抓住了我的妹妹，一邊猙獰地狂笑着，一邊把她丟進了一個無底洞裏。"]]],"bough":[[["n.",["大树枝"]]],"cet4 cet6 gre",15790,0,0,"s:boughs/i:boughing",[["The boughs that bear most hang lowest.","稻穗越飽滿越低頭。"]]],"b