efl",15282,1,0,[["Many people believe that acupuncture can cure diseases.","很多人都相信針灸有治癒疾病的功效。"]]],"acute":[[["adj.",["尖锐的","敏锐的","激烈的","严重的","急性的"]]],"gk cet4 cet6 ky toefl ielts gre",5255,2,0,"s:acutes/t:acutest",[["Her acute observation skills make her a very suitable photographer.","她因为敏锐的观察力，很适合当一名摄影师。"]]],"acutely":[[["adv.",["尖锐地","剧烈地"]]],null,11397,1,0],"ad":[[["",["地址","模拟-数字"],["in the Christian era; used before dates after the supposed year Chris…"]],["n.",["广告"],["a public promotion of some product or service"]]],"cet4",1748,1,1,"s:ads",[["The classified ad wanted female singers to form an a cappella group.","這則分類廣告招募女歌手組成無伴奏合唱團。"]]],"adage":[[["n.",["格言","谚语"]]],"toefl gre",15783,0,0,"s:adages"],"adamant":[[["adj.",["非常坚硬的","坚强的","固执的"]],["n.",["坚硬的东西"]]],"toefl gre",11251,1,0,[["Bill was adamant that she should obey him.","比尔坚持她必须听从他的话。"]]],"adamantly":[[["adv.",["坚硬无比地","坚强地","固执地","不动摇地"]]],null,15690,0,0],"adapt":[[["v.",["使适应","改编","适应"]]],"gk cet4 cet6 ky toefl ielts gre",2933,2,1,"d:adapted/i:adapting/3:adapts",[["Man has a great capacity to adapt to environmental changes.","人類適應環境變化的能力很強。"]]],"adaptability":[[["n.",["适应性","自适应性"]]],null,17278,0,0],"adaptable":[[["adj.",["能适应的","适合的","可修改的"]]],"toefl gre",14811,1,0,[["Software development as an industry is very adaptable, so it's unclear whether AI will significantly disrupt the programming job market.","軟體開發業的適應力很強，因此 AI 是否會對程式設計的就業市場造成重大衝擊，目前仍不明朗。"]]],"adaptation":[[["n.",["适应","改编","改编本"]]],"gk toefl",5196,1,0,"s:adaptations"],"adapter":[[["n.",["适应者","改编者","接合器"]],["",["衔接器","适配器","适配卡"]]],null,13621,0,0,"s:adapters"],"adaptive":[[["adj.",["适应的","能适应的"]]],"toefl",8259,0,0],"add":[[["v.",["增加","添加","附带说明","计算...总和","做加法"],["make an addition (to); join or combine or unite with others; increase…"]],["",["加法"]]],"zk gk cet4 ky",340,5,1,"p:added/i:adding/3:adds",[["You are adding new names to the list, aren't you?","你在把新的名字放在程序里面。"]]],"addendum":[[["n.",["补遗","附加物","齿顶"]]],"gre",25689,0,0,"s:addendums"],"addict":[[["v.",["使沉溺","使上瘾"]],["n.",["入迷的人","上瘾者"]]],"cet6 ky toefl ielts gre",6091,2,0,"d:addicted/s:addicts/i:addicting",[["Many criminals in the United States are addicted to drugs.","美國的罪犯大多是吸毒成癮的癮君子。"]]],"addiction":[[["n.",["入迷","瘾","癖嗜"]]],null,5177,2,0,"s:addictions",[["There really is such a thing as Internet addiction.","确实有网瘾这回事。"]]],"addictive":[[["adj.",["上瘾的"]]],"toefl",10283,1,0,[["Tatoeba is addictive.","Tatoeba會使人上癮。"]]],"addition":[[["n.",["加法","增加的人(或物)"]]],"gk cet4 cet6 ky ielts gre",2048,4,1,"s:additions",[["We had to pay ten thousand yen in addition.","我们还得付多一万日元。"]]],"additional":[[["adj.",["附加的","另外的","额外的","加添的"],["s further or added"]]],"cet4 cet6 ky toefl ielts",1319,0,1,[["As a consequence, additional tests must be carried out to ensure complete security.","因此，必须进行额外的测试以确保完整的安全性。"]]],"additionally":[[["adv.",["另外","此外"]]],null,5948,1,0],"additive":[[["adj.",["添加的","附加的","加法的","累积的"]],["n.",["添加物"]]],"toefl gre",14762,1,0,"s:additives",[["He turned to his orange juice sullenly, sneering that every little additive would sign him up for experiments he wanted no part in.","他悶悶不樂地轉向了他的橙汁，埋怨著自己不情愿地成了裡頭每一點添加劑的實驗品。"]]],"addle":[[["v.",["使昏乱","使腐坏","变质"]],["adj.",["昏乱的","腐坏的"]]],"toefl gre",37606,0,0,"d:addled/3:addles/i:addling"],"address":[[["n.",["住址","演说","举止","灵巧","求爱"],["(computer science) the code that identifies where a piece of informat…"]],["v.",["发表(演说或讲话)","对付","写地址"]],["",["地址","寻址"]]],"zk gk cet4 cet6 ky toefl ielts gre",1028,4,1,"d:addressed/i:addressing/s:addresses",[["If I knew his address, I could write to him.","如果我知道他的地址，就能寫信給他了。"]]],"adduce":[[["v.",["引证","举出","援引","提出"]]],"gre",26527,0,0,"d:adduced/3:adduces/i:adducing"],"adept":[[["adj.",["熟练的","老练的","巧妙的"]],["n.",["能手","内行"]]],"toefl ielts gre",10221,1,0,"s:adepts",[["Hackers are adept at getting around computer security measures.","黑客很會利用電腦安全措拖的漏洞。"]]],"adequacy":[[["n.",["适当","足够"]]],null,14558,0,0,"s:adequacies"],"adequate":[[["adj.",["适当的","足够的","胜任的","充分的"]]],"gk cet4 cet6 ky toefl ielts gre",3297,3,1,[["We need not only adequate water but clean water.","我們不僅需要充足的水，還需要乾淨的水。"]]],"adequately":[[["adv.",["足够地","适当地"]]],null,6089,0,1,[["Never attribute to malice that which is adequately explained by stupidity.","能解釋為愚蠢的，就不要解釋為惡意。"]]],"adhd":[[["",["注意力不集中症（ attention deficit hyperactivity disorder ）"]]],null,16065,0,0],"adhere":[[["v.",["依附","粘着","坚持","追随","拥护"]]],"cet4 cet6 ky toefl ielts gre",6516,2,0,"d:adhered/i:adhering/3:adheres",[["He adhered to the original plan.","他堅持原來的計畫。"]]],"adherence":[[["n.",["依附","固执","坚持"]],["",["粘合"]]],"toefl",9972,0,0],"adherent":[[["n.",["信徒","追随者"]],["adj.",["附着的","发生联系的"]]],"gre",12675,0,0,"s:adherents"],"adhesion":[[["n.",["附着","粘着","支持","追随","粘合"]]],null,19916,0,0,"s:adhesions"],"adhesive":[[["adj.",["粘着的","涂有粘性物质的"]],["n.",["粘合剂","橡皮膏"]]],"toefl gre",17140,1,0,"s:adhesives"],"adjacent":[[["adj.",["毗连的","邻近的","连接的"]],["",["相邻的","邻位的","交界的"]]],"cet6 ky toefl ielts gre",6649,1,0,[["The living room is adjacent to the dining room.","客廳緊鄰著餐廳。"]]],"adjective":[[["adj.",["形容词的","从属的"]],["n.",["形容词"]]],"cet4 ky",10317,1,0,"s:adjectives",[["In this case, the adjective goes before the noun.","在这种情况下，形容词放在名词前面。"]]],"adjoin":[[["v.",["邻接","毗连"]]],"cet6 ky toefl ielts",17562,1,0,"i:adjoining/3:adjoins/p:adjoined",[["The living room adjoins the dining room.","客廳緊鄰著餐廳。"]]],"adjoining":[[["adj.",["邻接的","毗连的"]],["",["联接"]]],"toefl",11972,0,0],"adjourn":[[["v.",["休会","换地方","使中止","推迟"]]],"toefl gre",16425,1,0,"d:adjourned/i:adjourning/s:adjourns"],"adjudicate":[[["v.",["判决","宣告","裁定"]]],"gre",18877,0,0,"d:adjudicated/i:adjudicating/3:adjudicates"],"adjudication":[[["n.",["判决","裁定","宣告","裁决"]]],null,19727,0,0,"s:adjudications"],"adjunct":[[["n.",["附属物","附件","助手","修饰语"]],["adj.",["附属的"]]],"toefl gre",11816,0,0,"s:adjuncts"],"adjust":[[["v.",["调整","使适应于","校准","适应于","被调节"]]],"gk cet4 cet6 ky toefl ielts gre",2300,3,1,"d:adjusted/i:adjusting/3:adjusts",[["I need a week to adjust to the time difference.","我需要一個星期來倒時差。"]]],"adjustable":[[["adj.",["可调节的"]],["",["可调整的"]]],"cet6",10047,1,0,"s:adjustables"],"adjuster":[[["n.",["调整员","调停者","调节器","校正器"]]],null,18596,0,0,"s:adjusters"],"adjustment":[[["n.",["调整","调节","校正"]]],"gk toefl",3121,0,0,"s:adjustments"],"adlib":[[["v.",["临时穿插","信口说出","即兴讲演"]],["",["状态说明设计语言"]]],"gre",0,0,0,"i:adlibbing"],"administer":[[["v.",["管理","料理","执行","执行遗产管理人的职责","给予帮助"]]],"ky toefl ielts",3661,2,0,"d:administered/i:administering/3:administers",[["The doctor administered medicine to the patient.","医生向病人用药。"]]],"administrate":[[["v.",["管理","支配"]]],"ky toefl",36644,0,0,"i:administrating/3:administrates/d:administrated",[["When Spain colonized the Philippines, they were administrated by Mexico City. So it was Mexican Spanish, not Castilian Spanish, that influenced Tagalog.","当西班牙殖民了菲律宾时，是从墨西哥城管理它的。于是他加禄语是收到了墨西哥式西班牙语的影响，而不卡斯蒂利亚式的。"]]],"administration":[[["n.",["行政","管理","政府机关"],["a method of tending to or managing the affairs of a some group of peo…"]],["",["给药"]]],"gk cet4 cet6 ky toefl ielts",635,4,0,"s:administrations"],"administrative":[[["adj.",["管理的","行政的","遗产管理的"]]],"toefl",3510,2,0,[["Who is the Administrative Assistant?","誰是行政助理？"]]],"administrator":[[["n.",["管理人","行政官"]],["",["遗产管理人员"]]],"toefl ielts",2484,2,0,"s:administrators"],"admirable":[[["adj.",["可钦佩的","极好的","令人惊奇的"]]],"gk toefl",10469,2,0],"admirably":[[["adv.",["极好地","美好地"]]],null,18012,0,0],"admiral":[[["n.",["舰队司令","海军上将","旗舰"]]],null,10814,2,0,"s:admirals"],"admiration":[[["n.",["赞赏","钦佩","引人赞赏的对象"]]],"cet6 toefl",6964,0,1,"s:admirations",[["All of a sudden I'm filled with great admiration for you!","我瞬间对你肃然起敬！"]]],"admire":[[["v.",["赞美","钦佩","爱慕","称赞","惊奇"]]],"gk cet4 ky toefl gre",3277,3,1,"p:admired/i:admiring/3:admires",[["Tom and Mary admired the scenery as they held hands.","汤姆和玛丽手牵着手，一起欣赏风景。"]]],"admirer":[[["n.",["钦佩者","仰慕者","求爱者"]]],null,9570,0,0,"s:admirers",[["Anne has many admirers.","安妮有許多崇拜者。"]]],"admission":[[["n.",["准许进入","入场费","录用","承认"]],["",["加入","入股"]]],"gk cet4 cet6 ky toefl ielts gre",3031,2,0,"s:admissions",[["There is no admission fee for children under five.","五岁以下的小孩票价全免。"]]],"admit":[[["v.",["承认","接受","允许进入","容许","开向"],["declare to be true or admit the existence or reality or truth of"]]],"gk cet4 ky toefl",1089,4,1,"p:admitted/3:admits/i:admitting",[["It doesn't matter whether she admits her guilt or not.","她認罪不認罪都沒關係。"]]],"admittedly":[[["adv.",["公认地","诚然"]]],"toefl",8927,1,0,[["Admittedly, it wasn't the best meal I've ever eaten.","不可否认，那并不是我吃过最好的一顿饭。"]]],"admonish":[[["v.",["警告","劝告","训诫","告诫"]]],"toefl gre",12419,0,0,"p:admonished/i:admonishing/3:admonishes",[["He admonished them for being noisy.","他告誡他們不要吵鬧。"]]],"admonition":[[["n.",["警告","劝告","训诫","申戒"]]],null,14319,0,0,"s:admonitions"],"adobe":[[["",["风干砖","土砖","灰质粘土","多孔粘土"]],["n.",["风干土坯"]]],"toefl gre",14939,0,0,"s:adobes"],"adolescence":[[["n.",["青春期","青年期"]]],"gk ielts",6897,1,0,"s:adolescences",[["In adolescence, I hated life and was continually on the verge of suicide, from which, however, I was restrained by the desire to know more mathematics.","在青春期，我厌倦生活，并持续陷入自杀的边缘。然而，在那期间，对数学知识的渴望，使我抑制住了那些负面情绪。"]]],"adolescent":[[["adj.",["青春期的","青少年的"]],["n.",["青少年"]]],"gk cet6 ky toefl gre",3386,2,0,"s:adolescents"],"adopt":[[["v.",["采用","正式通过","收养","接受"],["choose and follow; as of theories, ideas, policies, strategies or pla…"]],["",["采取"]]],"gk cet4 cet6 ky toefl ielts gre",1632,4,1,"d:adopted/i:adopting/3:adopts",[["I think it's better for us to adopt his plan.","我认为采用他的计划对我们比较好。"]]],"adoption":[[["n.",["采用","采纳","收养"]]],"cet6 toefl",3674,0,0,"s:adoptions"],"adoptive":[[["adj.",["有收养关系的","采用的","收养的"]]],null,10779,0,0],"adorable":[[["adj.",["可崇拜的","值得敬慕的","可爱的"]]],null,12799,1,0,[["He loves his puppy. His puppy is really adorable.","他愛他的狗，那隻小狗真的很可愛。"]]],"adoration":[[["n.",["崇拜","爱慕"]]],null,16233,0,0,"s:adorations",[["This 14th of May of 2025 is cloudy skies interspersed with blue spaces. I walked to the Roman Catholic church on St. Albans Road twice, once in the morning and again in the afternoon, my 12th and 13th times this spring. In the morning was confession for the little boys and girls in uniform. They were of different races, in the big worship hall. The priest was in the confession booth talking to a student. At the Adoration Chapel, I noticed a nice pot of orchids on the front left. In the afternoon, the big worship hall was mostly empty, a condition which I usually prefer. At the road was a handsome muscle man in white tank top jogging. The big purple-bloom tree seems like an Empress Tree, a Paulownia, because of the big heart-shaped leaves. Reminiscent of Jacaranda with its purple blooming, it's saudade for me about South America. At Tim Hortons café, I enjoyed Scrambled Eggs with Sausage and Potatoes and an Earl Grey Tea with oat milk in the morning, and an Iced Classic Lemonade in the afternoon. The day was full of walking. At home, I study bits of Lojban and Esperanto. I have many books in Esperanto. I tend towards Animism-Buddhism in my Syncretism.","2025 年 5 月 14 日，天空多雲，間或有藍色空間。我兩次走到聖奧爾本斯路上的羅馬天主教堂，一次在早上，一次在下…"]]],"adore":[[["v.",["崇拜","爱慕","喜爱"]]],"gk cet6 ky toefl ielts gre",7705,2,0,"p:adored/3:adores/i:adoring",[["The students adore the new English teacher.","学生们崇拜新的英语老师。"]]],"adorn":[[["v.",["装饰","使生色"]]],"toefl gre",8007,1,0,"d:adorned/i:adorning/3:adorns",[["The crown is adorned with dozens of divinely lustrous gemstones.","王冠上鑲嵌著數十顆光彩奪目的寶石。"]]],"adornment":[[["n.",["装饰","装饰品"]]],"toefl",19010,0,0,"s:adornments",[["There is a widespread opinion that all study of the mode of oratory is unmanly, and leads to the substitution of artifice and adornment for simplicity and power.","有一種普遍的看法認為，一切對演說方式的研究都是有損男子氣概的，都會以雕飾與浮華取代質樸與力量。"]]],"adrenalin":[[["n.",["肾上腺素"]]],null,0,1,0],"adrenaline":[[["n.",["肾上腺素"]]],null,10433,0,0,"s:adrenalines"],"adrift":[[["adv.",["漂流地","漂浮着","随波逐流地"]],["adj.",["漂浮着的"]]],null,14510,1,0],"adroit":[[["adj.",["灵巧的","敏捷的","聪明的"]]],"toefl gre",26237,0,0],"adulate":[[["v.",["谄媚","过分称赞"]]],"gre",0,0,0,"p:adulated/i:adulating/3:adulates"],"adulation":[[["n.",["谄媚","过分的称赞"]]],null,19049,0,0],"adult":[[["n.",["成人","成虫"],["a fully developed person from maturity onward"]],["adj.",["成年的","成熟的"]]],"gk cet4 ky ielts",969,4,1,"s:adults",[["Two adult tickets and three children's tickets to London, please.","请给我两张到伦敦的成人票，三张儿童票。"]]],"adulterate":[[["adj.",["掺假的","假的","通奸的"]],["v.",["掺杂"]]],"gre",32009,0,0,"d:adulterated/3:adulterates/i:adulterating",[["You should not adulterate wine with water.","你不應該把水混入葡萄酒裡。"]]],"adulteration":[[["n.",["掺杂","掺假的东西","掺加"]]],"toefl",41561,0,0],"adultery":[[["n.",["通奸"]]],null,10957,1,0,"s:adulteries"],"adulthood":[[["n.",["成年"]],["",["成人期"]]],null,7780,0,0,[["The graduation from elementary school to middle school is regarded by some as the first step towards adulthood.","有些人認為從小學升到中學是踏入成年的第一步。"]]],"adumbrate":[[["v.",["画...的轮廓","预示"]]],"gre",35885,0,0,"p:adumbrated/3:adumbrates/i:adumbrating"],"advance":[[["v.",["前进","进展","提高","上涨","使前进"]],["n.",["前进","进展","行过的路程"]],["adj.",["前面的","预先的"]]],"gk cet4 cet6 ky toefl",2296,4,1,"s:advances/d:advanced/i:advancing",[["The world today needs to advance its production of food.","当今世界需推进其食物生产。"]]],"advancement":[[["n.",["前进","进步","提升"]],["",["徙前术"]]],"toefl",6629,1,0,"s:advancements",[["I am honored to be in the timeless city of Cairo, and to be hosted by two remarkable institutions. For over a thousand years, Al-Azhar has stood as a beacon of Islamic learning, and for over a century, Cairo University has been a source of Egypt's advancement.","我很榮幸能來到開羅這座不朽的城市，並受到兩所著名學府的招待。千載以來，艾資哈爾大學一直擔任著伊斯蘭教育的指路明燈；百年…"]]],"advantage":[[["n.",["优点","便利","好处","优势"],["the quality of having a superior or more favorable position"]],["v.",["有助于"],["give an advantage to"]]],"zk gk cet4 ky",1301,4,1,"s:advantages/d:advantaged/i:advantaging",[["If you can use gravity to your advantage, do so.","你如果能利用重力，那就这么做吧。"]]],"advantageous":[[["adj.",["有利的","有益的"]]],"cet6",14081,1,0,[["Being able to use a computer is advantageous.","會用電腦是一個好處。"]]],"advent":[[["n.",["来到","来临"]]],"ky toefl ielts gre",8129,1,0,"s:advents"],"adventitious":[[["",["偶生的","偶发的","异位的"]],["adj.",["偶然的","外来的"]]],"toefl gre",40998,0,0],"adventure":[[["n.",["冒险","冒险经历"]],["v.",["冒险"]]],"gk cet4 ky toefl",2862,2,1,"s:adventures/i:adventuring/p:adventured",[["He wrote a book about a jungle adventure.","他写了一本关于丛林冒险的书。"]]],"adventurer":[[["n.",["冒险家","投机者","冒险者"]]],"toefl",13381,1,0,"s:adventurers",[["Khaki shorts with cargo pockets do not make you an adventurer.","單有卡其褲，還成不了冒險家。"]]],"adventurous":[[["adj.",["喜欢冒险的","有进取心的","危险的"]]],"toefl",10890,1,0],"adverb":[[["n.",["副词"]]],"cet4 ky",26238,0,0,"s:adverbs",[["This is an adverb.","这是个副词。"]]],"adversarial":[[["adj.",["敌手的","对手的","对抗(性)的"]]],null,15137,0,0],"adversary":[[["n.",["敌手","对手"]],["adj.",["敌手的","敌对的"]]],null,7244,1,0,"s:adversaries"],"adverse":[[["adj.",["不利的","敌对的","相反的","逆的"]]],"cet6 ky toefl ielts gre",6307,2,0],"adversely":[[["adv.",["不利","有害","相反","逆","敌对"]]],"toefl",12569,0,0],"adversity":[[["n.",["逆境","不幸","灾祸","灾难"]]],"toefl",11343,1,0,"s:adversities",[["Adversity makes a man wise, not rich.","逆境出人才。"]]],"advert":[[["v.",["提出看法","引起注意","留意"]],["n.",["广告"]]],"gre",35264,2,0,"s:adverts/d:adverted/i:adverting"],"advertise":[[["v.",["做广告","通知","公布"]]],"gk cet4 cet6 ky ielts gre",5124,3,1,"d:advertised/i:advertising/3:advertises",[["The company spends a lot of money on advertising.","那家公司在广告上花了很多钱。"]]],"advertisement":[[["n.",["广告","启事","广告宣传","公告","告示"]]],"zk gk cet4 ielts",5957,2,1,"s:advertisements",[["We've received a lot of applications in answer to our advertisements.","我們已經收到了很多回應我們廣告的申請。"]]],"advertiser":[[["n.",["做广告者","广告客户"]],["",["广告商","广告者"]]],null,7638,0,0,"s:advertisers"],"advertising":[[["n.",["广告业","广告"]],["adj.",["广告的"]],["",["发广告"]]],"ielts",2640,0,1,[["The company spends a lot of money on advertising.","那家公司在广告上花了很多钱。"]]],"advice":[[["n.",["忠告","劝告","意见","报道","通知"],["a proposal for an appropriate course of action"]]],"zk gk cet4 cet6 ky toefl ielts",1641,4,1,[["I need your advice on what I should do next.","我需要你指導我接下來該做甚麼。"]]],"advisable":[[["adj.",["适当的","明智的"]]],"cet4 cet6 ky toefl gre",18573,1,0],"advise":[[["v.",["劝告","给...出主意","通知","建议","提意见"]]],"zk gk cet4 cet6 ky toefl",2552,3,1,"d:advised/i:advising/3:advises",[["She was advised by him to go to the police.","他勸她去報警。"]]],"adviser":[[["n.",["顾问","劝告者","指导教师"]]],null,2720,3,0,"s:advisers"],"advisor":[[["n.",["顾问","劝告者","指导教师"]]],null,5896,0,0,"s:advisors"],"advisory":[[["adj.",["顾问的","咨询的","劝告的","忠告的"]]],null,5108,2,0,[["PARENTAL ADVISORY: If your children use TATOEBA to study languages, please take the time to search any choice words you wouldn't want them to read - and don't be shy! You won't believe some of the uncensored filth they allow on here, since they feel \"language is language.\"","家长指导：如果你的孩子用TATOEBA学语言，请花时间搜索任何你不希望他们读到的词——并且不要害羞！你不会相信他们在这…"]]],"advocacy":[[["n.",["拥护","支持","鼓吹","辩护","辩护术"]]],"gre",5074,1,0],"advocate":[[["n.",["提倡者","拥护者"]],["v.",["主张","提倡"]]],"gk cet4 cet6 ky toefl ielts gre",2623,3,0,"d:advocated/s:advocates/i:advocating",[["China is an advocate for the Diaoyu Islands' sovereignty.","中国主张钓鱼岛的主权。"]]],"aegis":[[["n.",["羊皮盾","保护","庇护","赞助","支持"]]],"gre",18213,0,0],"aerate":[[["",["曝气","充气","吹气"]],["v.",["使暴露于空气中","使充满气体"]]],"gre",26826,0,0,"p:aerated/i:aerating/s:aerates"],"aerial":[[["adj.",["空中的","航空的","空气的","空想的"]],["n.",["天线"]]],"cet6 ky ielts gre",7339,1,0,"s:aerials"],"aerobic":[[["adj.",["需氧的","需氧菌产生的","增氧健身法的"]]],null,8770,0,0,"s:aerobics",[["She goes to aerobics once a week.","她每星期去作一次健美操。"]]],"aerodynamic":[[["adj.",["空气动力学的"]]],null,17229,0,0,"s:aerodynamics"],"aeronautics":[[["n.",["航空学","飞行术"]]],"gre",26576,0,0],"aeroplane":[[["n.",["飞机"]]],"gk cet4 cet6 ky",30278,2,0,"s:aeroplanes",[["The sky was filled with aeroplanes.","天上滿是飛機。"]]],"aerosol":[[["n.",["烟","雾"]],["",["气溶胶","烟雾剂"]]],null,15393,1,0,"s:aerosols/d:aerosolled"],"aerospace":[[["n.",["航天空间","航天技术"]]],"cet6",8798,2,0,[["His dream is to become an aerospace engineer.","他的梦想是成为航天航空工程师。"]]],"aesthete":[[["n.",["审美家","唯美主义者"]]],"gre",29682,0,0,"s:aesthetes"],"aesthetic":[[["adj.",["美学的","审美的","有美感的"]]],"cet6 ky toefl ielts gre",4296,2,0],"aesthetical":[[["adj.",["美学的","艺术的","美的","审美的"]]],"toefl",0,0,0],"aesthetically":[[["adv.",["美学观点上地","审美地"]]],null,16450,0,0],"aesthetics":[[["n.",["美学"]]],null,9286,1,0],"afar":[[["adv.",["由远处","遥远地"]]],null,13131,0,0,"s:afars",[["When a friend comes from afar, is that not delightful?","有朋自远方来，不亦乐乎？"]]],"affable":[[["adj.",["和蔼可亲的","友善的","亲切的","慈祥的"]]],"toefl gre",16207,1,0,[["He was affable and smiling, and he told staff he was visiting friends in a seaside resort popular with day-trippers and, in recent years, associated with gay chic.","他和藹可親，面帶微笑。他告訴工作人員，他正在拜訪朋友，他們住在一個受一日遊遊客歡迎的海濱度假勝地。近年來，這裡與同性戀…"]]],"affair":[[["n.",["事件","事务","恋爱事件"],["a usually secretive or illicit sexual relationship"]]],"gk cet4 cet6 ky toefl",1364,4,1,"s:affairs",[["You have no right to interfere in other people's affairs.","你沒有干涉他人事務的權力。"]]],"affect":[[["v.",["影响","感动","假装","模仿","爱好"],["have an effect upon"]],["n.",["自觉感情"],["the conscious subjective aspect of feeling or emotion"]]],"gk cet4 cet6 ky toefl ielts",963,4,1,"d:affected/i:affecting/3:affects",[["Generally speaking, nobles were only very slightly affected by taxes.","总体来说，贵族受到税收的影响微乎其微。"]]],"affectation":[[["n.",["假装","做作","矫情","矫饰"]]],"gre",23010,0,0,"s:affectations"],"affection":[[["n.",["影响","病","喜爱","情感","倾向"]]],"gk cet4 cet6 ky toefl ielts gre",5137,2,1,"s:affections",[["Everyone knows of his affection for that dog.","人人都知道他對那狗的感情。"]]],"affectionate":[[["adj.",["深情的","充满情爱的"]]],"toefl",12111,1,0,[["My father was no less affectionate and tender to me than my mother was.","我爸爸对我的爱和照顾不比我妈妈少。"]]],"affectionately":[[["adv.",["挚爱地","亲切地"]]],null,14360,0,0],"affective":[[["adj.",["情感的","表达感情的","感情的"]]],"cet6 toefl",8614,0,0],"affidavit":[[["n.",["宣誓书","书面陈述"]],["",["宣誓","声明"]]],"gre",10486,1,0,"s:affidavits"],"affiliate":[[["