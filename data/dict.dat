ay.","我不在的时候，他将是我的代理人。"]]],"deracinate":[[["v.",["根除","杜绝","使脱离传统"]]],"gre",0,0,0,"i:deracinating/p:deracinated/3:deracinates"],"derail":[[["v.",["使出轨"]],["n.",["脱轨器"]],["",["转移指令"]]],null,10587,1,0,"d:derailed/i:derailing/s:derails"],"derailleur":[[["n.",["<法>(自行车)变速器","装有变速器的自行车"]]],null,16558,0,0],"derange":[[["v.",["扰乱","使发狂"]]],"toefl",23529,0,0,"p:deranged/3:deranges/i:deranging",[["Tom is deranged.","湯姆是個瘋子。"]]],"derangement":[[["n.",["捣乱","紊乱","精神错乱","混乱","搅乱"]],["",["错位排列","重排"]]],"gre",33255,0,0,"s:derangements"],"derby":[[["n.",["德比(英国中部都市)","德比赛马","大赛马"]]],null,14262,1,0,"s:derbies"],"deregulate":[[["",["解除管制"]]],null,16898,1,0,"d:deregulated/i:deregulating/3:deregulates"],"deregulation":[[["n.",["撤消(价格等的)管制规定","解除控制"]]],null,8683,0,0],"derelict":[[["adj.",["被抛弃了的","无主的","玩忽职守的"]],["n.",["遗弃物","被遗弃的人","玩忽职守者"]]],"ielts gre",18085,1,0,"s:derelicts"],"dereliction":[[["",["抛弃","遗弃","放弃"]],["n.",["玩忽职守","抛弃物"]]],"gre",25605,0,0,"s:derelictions"],"deride":[[["v.",["嘲弄","嘲笑"]]],"ky toefl gre",14315,1,0,"d:derided/i:deriding/3:derides"],"derision":[[["n.",["嘲笑"]]],null,18311,0,0],"derivation":[[["n.",["推论","推导","来历"]],["",["衍化","诱导"]]],"cet6 gre",20388,0,0,"s:derivations"],"derivative":[[["n.",["引出之物","派生物","衍生字"]],["adj.",["引出的","派生的"]]],"toefl gre",10778,1,0,"s:derivatives",[["If you gamble on the stock market, you are an investor... If you gamble on the derivatives market, you are a trader... If you gamble at the casino, you are a loser... Morality?","如果你在股票市場上賭博，你是個投資者...如果你在衍生性金融商品市場上賭博，你是個商人...如果你在賭場上賭博，你是個…"]]],"derive":[[["v.",["得自","起源"]]],"cet4 cet6 ky toefl ielts",3051,2,1,"d:derived/3:derives/i:deriving",[["From reading good books we can derive pleasure, friendship, experience and instruction.","读书，可以获得乐趣、友谊、经验和指导。"]]],"dermatologist":[[["n.",["皮肤学者","皮肤科医生"]],["",["皮肤病学家","皮肤科医师"]]],"gre",13328,1,0,"s:dermatologists"],"dermatology":[[["n.",["皮肤医学","皮肤病学"]]],null,19840,0,0],"derogate":[[["v.",["贬损","毁损"]]],"gre",38883,0,0,"d:derogated/3:derogates/i: