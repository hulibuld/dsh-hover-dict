,31757,0,0,"s:suffragists"],"suffuse":[[["v.",["遍布","弥漫","充满"]]],"toefl gre",17080,0,0,"d:suffused/3:suffuses/i:suffusing"],"sugar":[[["v.",["加糖于","使甜蜜","粉饰","美化","制成糖"],["sweeten with sugar"]],["n.",["糖","糖块","甜言蜜语"],["a white crystalline carbohydrate used as a sweetener and preservative"]]],"zk gk toefl ielts",1591,3,1,"s:sugars/i:sugaring/p:sugared",[["We need flour, sugar and eggs to make this cake.","我們需要麵粉、砂糖和雞蛋來做這個蛋糕。"]]],"sugarcane":[[["n.",["甘蔗","糖蔗"]]],null,17041,0,0],"sugary":[[["adj.",["含糖的","糖一般的","甜的"]]],null,18595,0,0,"t:sugariest",[["That fat girl consumes too much sugary food.","那个胖女孩吃了太多含高糖份的饮食。"]]],"suggest":[[["v.",["提议","建议","促成","暗示","启发"],["imply as a possibility"]]],"zk gk toefl",430,5,1,"3:suggests/d:suggested/i:suggesting",[["I suggest that you should write him a thank-you letter.","我覺得你應該給他寫一封感謝信。"]]],"suggestion":[[["n.",["提议","意见"]],["",["暗示"]]],"zk gk ielts",2507,3,1,"s:suggestions",[["He thought she spoke reasonably, so he accepted her suggestion.","他觉得她说得很有道理，于是接受了她的建议。"]]],"suggestive":[[["adj.",["提示性的","影射的","暗示的"]]],"gre",10711,1,0],"suicidal":[[["adj.",["自杀的","自杀性的","自我毁灭的"]]],null,8788,1,0],"suicide":[[["n.",["自杀","自杀者"]],["v.",["自杀"]],["adj.",["自杀的"]]],"cet6 ky ielts",2274,3,0,"s:suicides",[["How frustrated must a person be to commit suicide?","一个人得遇到多大的挫折才会自杀？"]]],"suit":[[["n.",["套装","诉讼","请求","起诉","套"],["a set of garments (usually including a jacket and trousers or skirt) …"]],["v.",["适合","使适应","合适","相称"]]],"gk cet4 cet6 ky toefl ielts",1411,4,1,"d:suited/3:suits/i:suiting",[["I can't find the waistcoat of my three piece suit.","我找不到我三件套的背心。"]]],"suitability":[[["n.",["适合","适当"]],["",["适合性","适应性"]]],null,18431,0,0],"suitable":[[["adj.",["适当的","相配的","合适的","适宜的"]]],"gk cet4 cet6 ky toefl ielts",4756,3,1,[["Her acute observation skills make her a very suitable photographer.","她因为敏锐的观察力，很适合当一名摄影师。"]]],"suitably":[[["adv.",["合适地","适当地","相配地"]]],null,18372,1,0],"suitcase":[[["n.",["手提箱"]]],"gk cet6 toefl ielts gre",5600,2,1,"s:suitcases",[["She put two pairs of sheer tights in the suitcase.","她在行李箱中放進了兩條褲襪。"]]],"suite":[[["n.",["随员","套房","(一)组","(一)套","组曲"]],["",["程序组"]]],"gk ky toefl ielts",4726,2,0,"s:suites"],"suitor":[[["n.",["起诉者","请愿者","求婚者","起诉人","原告"]]],null,12528,1,0,"s:suitors"],"sulfate":[[["n.",["硫酸盐","硫酸脂","硫酸盐或酯、根"]]],null,19833,0,0,"p:sulfated/s:sulfates/i:sulfating"],"sulfur":[[["n.",["硫","硫磺"]],["v.",["用硫磺处理"]]],"ky toefl",9550,0,0,"i:sulfuring/p:sulfured/3:sulfurs",[["Sulfur burns with a blue flame.","硫磺燃燒著藍色的火焰。"]]],"sulk":[[["v.",["不高兴","闷闷不乐","不悦","生气","愠怒"]],["n.",["闹情绪","闷闷不乐"]]],null,18787,1,0,"i:sulking/p:sulked/s:sulks"],"sulky":[[["adj.",["生气的","阴沉的"]]],"toefl gre",27653,0,0],"sullen":[[["adj.",["愠怒的","沉闷的","阴沉的"]]],"cet6 toefl gre",12817,1,0],"sully":[[["v.",["玷污","弄脏"]],["n.",["污点","脏污"]]],"toefl gre",17902,0,0,"d:sullied/i:sullying/3:sullies"],"sulphate":[[["n.",["硫酸盐","硫酸酯"]],["v.",["硫酸盐化"]]],null,35642,1,0,"s:sulphates/p:sulphated"],"sulphur":[[["n.",["硫","硫磺"]]],"cet4 cet6 ielts",22759,1,0],"sultan":[[["n.",["苏丹(某些伊斯兰国家统治者的称号)"]]],null,14435,1,0,"s:sultans"],"sultry":[[["adj.",["闷热的","粗暴的","放荡的","激烈的"]]],"toefl gre",15667,0,0,"t:sultriest"],"sum":[[["n.",["总数","总和","金额","概要","顶点"]],["v.",["总计","概括","合计"]],["",["系统实用程序和维护"]]],"cet4 cet6 ky toefl",3843,3,1,"s:sums/d:summed/i:summing",[["The sum of two plus three plus four is nine.","二加三加四的和是九。"]]],"summarily":[[["adv.",["概要地","概略地","立刻"]]],"gre",19090,0,0],"summarize":[[["v.",["概述","总结"]]],"cet4 cet6 ky",5532,1,0,"d:summarized/3:summarizes/i:summarizing",[["Summarize the contents in 60 English words.","請把內容濃縮至六十個英文字以內。"]]],"summary":[[["n.",["摘要","概要"]],["adj.",["摘要的","简略的"]]],"gk cet4 cet6 ky ielts gre",4917,2,1,"s:summaries",[["The following is a summary of the President's speech.","下面是总统讲话的概要。"]]],"summation":[[["n.",["总和","和","合计","总合"]]],"gre",17935,0,0,"s:summations"],"summer":[[["n.",["夏季","全盛时期"],["the warmest season of the year; in the northern hemisphere it extends…"]],["v.",["避暑","过夏天"],["spend the summer"]],["",["加法器"]]],"zk gk ielts",619,4,1,"s:summers/i:summering/p:summered",[["We enjoyed watching the fireworks on a bridge last summer.","去年夏天，我们在桥上看焰火看得很过瘾。"]]],"summertime":[[["n.",["全盛时期","夏季"]]],null,12031,0,0,[["Of all the witches that may be found in all the fairy tales ever told there is none more delightfully sociable than the Sand Witch. This Witch, who lives underneath the heaps of sand at the ocean's edge, where, in the summertime, you dig with your shovel, is not at all like other witches. She never rides on a broomstick, and she never goes down chimneys. In the first place there are no broomsticks or chimneys on the beach at the sea-shore, and in the second place she would not know how to ride on a broomstick or climb down a chimney, if there were. All the Sand Witch knows how to do is to sink into the sand when anything scares her, and to come up through the sand when she sees a chance to get acquainted with a person she never was acquainted with before. So now you know what a Sand Witch is. And if Junior Jenks, seven years old, and dreadfully sunburnt, had known what you know, he would have been much better prepared to face the one that came up right under his nose all of a sudden one hot July morning.","在所有童話故事裡出現的女巫中，沒有一個比沙女巫更討人喜歡、更善於交際了。這位女巫住在海邊堆積如山的沙子下面，夏天的時候…"]]],"summing-up":[[["n.",["总结","结论","评估","证据概述"]]],null,0,1,0],"summit":[[["n.",["顶点","最高阶层","最高级会议"]],["adj.",["政府首脑的","最高级的"]]],"cet4 cet6 ky toefl ielts",3235,4,0,"s:summits",[["The summit of Mt. Fuji was covered in snow.","富士山顶盖满了雪。"]]],"summon":[[["v.",["召唤","召集","号召","振奋","唤起"]],["",["传唤","传讯"]]],"cet6 ky toefl ielts gre",5691,2,0,"d:summoned/i:summoning/3:summons",[["He gained the power to summon ghost trains.","他獲得了召喚幽靈列車的能力。"]]],"sumo":[[["n.",["（日）相扑"]]],null,26302,1,0,[["My sister is cheering for a young Sumo wrestler.","我的姊姊為一個年輕的相撲力士加油。"]]],"sumptuous":[[["adj.",["奢侈的","华丽的"]]],"toefl gre",14631,1,0],"sun":[[["n.",["太阳","日","日光","阳光"],["the star that is the source of light and heat for the planets in the …"]],["v.",["晒","晒太阳"],["expose one's body to the sun"]]],"zk gk",1233,2,1,"s:suns/i:sunning/p:sunned",[["Without the light of the sun, we could see nothing.","如果沒有了陽光，我們就甚麼也看不見了。"]]],"sunbathe":[[["n.",["日光浴"]]],null,22390,1,0,"p:sunbathed/3:sunbathes/i:sunbathing",[["When are we going sunbathing?","我們甚麼時候去日光浴啊？"]]],"sunburn":[[["n.",["日炙","晒斑","晒焦","晒黑"]],["v.",["vi. (使)晒黑","(使)晒得退色","(使)晒焦"]]],"toefl",16724,0,0,"d:sunburned/i:sunburning/s:sunburns",[["Christine stayed in the shade all day, because she didn't want to get a sunburn.","Christine整天待在陰涼的地方，因為她不想被曬傷。"]]],"sunburnt":[[["adj.",["晒黑的","有晒斑的","日炙的"]]],"gk",32133,0,0,[["Of all the witches that may be found in all the fairy tales ever told there is none more delightfully sociable than the Sand Witch. This Witch, who lives underneath the heaps of sand at the ocean's edge, where, in the summertime, you dig with your shovel, is not at all like other witches. She never rides on a broomstick, and she never goes down chimneys. In the first place there are no broomsticks or chimneys on the beach at the sea-shore, and in the second place she would not know how to ride on a broomstick or climb down a chimney, if there were. All the Sand Witch knows how to do is to sink into the sand when anything scares her, and to come up through the sand when she sees a chance to get acquainted with a person she never was acquainted with before. So now you know what a Sand Witch is. And if Junior Jenks, seven years old, and dreadfully sunburnt, had known what you know, he would have been much better prepared to face the one that came up right under his nose all of a sudden one hot July morning.","在所有童話故事裡出現的女巫中，沒有一個比沙女巫更討人喜歡、更善於交際了。這位女巫住在海邊堆積如山的沙子下面，夏天的時候…"]]],"sundae":[[["n.",["圣代冰淇淋"]]],null,19202,0,0,"s:sundaes"],"sunday":[[["adj.",["星期日的","业余的"]],["n.",["星期日"]],["v.",["度星期日"]]],"zk gk ielts",0,4,1,"s:sundays",[["She will return home next Sunday, that is, the tenth.","她下周日回家，也就是10号。"]]],"sunder":[[["v.",["切开","分离"]]],"gre",29641,0,0,"d:sundered/i:sundering/3:sunders"],"sundial":[[["n.",["日规","日晷"]]],"toefl ielts",26138,0,0,"s:sundials"],"sundown":[[["n.",["日落","阔边女帽"]]],null,15989,0,0],"sundry":[[["adj.",["各式各样的","杂的","各种"]]],"gre",20990,1,0,"s:sundries"],"sunflower":[[["n.",["向日葵"]]],"toefl",12373,1,0,"s:sunflowers",[["I like cracking sunflower seeds with my teeth.","我喜欢嗑葵花籽。"]]],"sunglasses":[[["n.",["太阳镜","墨镜","太阳眼镜"]]],"gk toefl",7032,1,0,[["Tom left his sunglasses on the dashboard of my car.","汤姆把他的太阳镜留在我的车的仪表板上了。"]]],"sunlight":[[["n.",["日光","太阳光"]]],"gk cet4 cet6 toefl ielts",3895,2,0,[["Skin shouldn't be exposed to sunlight for too long.","不要把皮肤长时间暴露在阳光里。"]]],"sunlit":[[["adj.",["阳光照射的"]]],"toefl",16959,0,0],"sunni":[[["n.",["〈伊斯兰〉逊尼派教徒"]]],null,5419,0,0,"s:sunnis",[["In this country, the majority of the population espouses Sunni Islam.","在這個國家，大多數人口信奉遜尼派伊斯蘭教。"]]],"sunny":[[["adj.",["阳光充足的","乐观的","快乐的","像太阳的"]]],"zk gk",4866,2,0,"r:sunnier/t:sunniest/s:sunnies",[["And on sunny days all the pigeons flew home.","而在晴天的時候鴿子們都飛回家了。"]]],"sunrise":[[["n.",["日出","黎明","拂晓"]]],"gk cet4 cet6 ky toefl",7313,1,0,"s:sunrises",[["We woke up very early in order to see the sunrise.","我们起得很早为了看到日出。"]]],"sunscreen":[[["n.",["(防晒油中的)遮光剂"]]],null,9978,1,0,"s:sunscreens/i:sunscreening",[["Put on some sunscreen.","涂点防晒吧。"]]],"sunset":[[["n.",["日落","晚年"]]],"gk cet4 cet6 ky toefl",5739,2,0,"s:sunsets",[["Even after sunset there was little moderation in the temperature.","甚至在日落之后，气温也不见降低。"]]],"sunshine":[[["n.",["阳光","光明","晴天"]]],"gk cet4 cet6 ky toefl",7752,2,0,[["Cold and dry, splendid sunshine, what beautiful winter weather!","寒冷乾燥，燦爛的陽光，多麼美麗的冬日天氣!"]]],"sunspot":[[["n.",["太阳黑子","雀斑"]]],null,19264,0,0,"s:sunspots"],"sup":[[["v.",["啜","呷","啜饮","进晚餐"]],["n.",["一口"]]],null,17689,0,0,"i:supping/p:supped/3:sups"],"super":[[["adj.",["上等的","特大的","超级的","极好的","十分的"]],["n.",["跑龙套角色","冗员","特级品","特大号","管理人"]],["adv.",["非常"]]],"gk cet4 cet6 ky",2651,3,0,"s:supers",[["Teachers nowadays are super into testing. It seems that there's another test today.","现在的老师么，非常迷信考试，据说今天又要考试啦。"]]],"superannuated":[[["adj.",["年老退休的","老朽的","体弱退休的","领养老金的","过时的"]]],"gre",41486,0,0],"superb":[[["adj.",["极度的","华丽的","极好的"]]],"gk cet6 ky toefl ielts gre",6911,3,0],"superbly":[[["adv.",["雄伟地","壮丽地","上等地","庄重地"]]],null,18258,0,0],"supercilious":[[["adj.",["傲慢的","自大的","目空一切的"]]],"gre",32081,0,0],"supercomputer":[[["",["巨型计算机","巨型机","超级计算机"]]],null,16832,1,0,"s:supercomputers"],"superconducting":[[["adj.",["超导的","超导电的"]],["",["超导"]]],null,18828,0,0],"superconductor":[[["n.",["超导体","超导电体"]]],null,23824,1,0,"s:superconductors"],"supercontinent":[[["n.",["超大陆"]]],"toefl",40390,0,0,"s:supercontinents"],"superficial":[[["adj.",["表面的","肤浅的","面积的"]],["n.",["表面","外表"]]],"cet4 cet6 ky toefl ielts gre",8281,2,0,[["You have to acquire real skills, not just superficial knowledge.","你要學的是實實在在的技能，而不單是表面的知識。"]]],"superficiality":[[["n.",["表面性的事物","肤浅","浅薄"]]],"gre",26559,0,0,"s:superficialities"],"superficially":[[["adv.",["表面","表面性","浅层","不深","表皮"]]],"cet6 toefl",19088,0,0],"superfluity":[[["n.",["多余","过剩","多余物","过剩品","奢侈"]]],"gre",38373,0,0,"s:superfluities"],"superfluous":[[["adj.",["多余的","过剩的"]]],"ky toefl ielts gre",16195,1,0,[["There was always too much superfluous writing in his essays.","在他的文章中总是有太多肤浅的桥段。"]]],"superheat":[[["v.",["使过热"]],["n.",["过热"]]],"toefl",0,0,0,"d:superheated"],"superhero":[[["n.",["超级英雄"]]],null,17608,0,0],"superhighway":[[["n.",["超级高速公路"]]],null,18583,0,0,"s:superhighways"],"superhuman":[[["adj.",["超人的","人类能力所不能及的"]]],null,18506,0,0,"s:superhumans"],"superimpose":[[["v.",["把(一物)放在另一物的上面","添上","附加","加上","添加"]],["",["重叠","叠加"]]],"gre",14132,1,0,"d:superimposed/i:superimposing/3:superimposes",[["The Berber flag has an upper band of blue like the Mediterranean Sea, then a green band like the plains of Tamazgha, and finally a yellow band representing the desert. Upon these stripes is superimposed the letter Aza (yaz) ⵥ, symbolizing the tifinagh, ancient writing of Imazighen, in red, representing blood and freedom.","柏柏旗幟由三條橫條組成：上半部為藍色，象徵地中海；下半部為綠色，象徵塔馬茲加平原；下半部為黃色，象徵沙漠。在這些條紋之…"]]],"superintend":[[["v.",["指挥","管理","监督"]]],"ielts gre",38942,0,0,"i:superintending/p:superintended/3:superintends"],"superintendent":[[["n.",["监督人","主管人","主日学校校长","主管人(部门)"]]],"toefl",5496,2,0,"s:superintendents"],"superior":[[["n.",["长者","占优势的人","上级"]],["adj.",["上级的","出众的","高傲的"]]],"gk cet4 cet6 ky toefl ielts",3410,3,1,"s:superiors",[["Father has now got a superior position in his office.","現在父親在他的辦公室已經得到了一個上級的地位。"]]],"superiority":[[["n.",["优越","高傲"]],["",["优越性"]]],"cet6 ky gre",7766,0,0,"s:superiorities"],"superlative":[[["adj.",["最上的","无比的","过度的"]],["n.",["最好的人(物)","最高程度","最高级"]]],"gre",24360,1,0,"s:superlatives"],"superman":[[["n.",["具有超人能力的人","超人"]]],"gk",20120,0,0,"s:supermen"],"supermarket":[[["n.",["超级市场","自助售货商店"]]],"zk gk ielts",4682,2,1,"s:supermarkets",[["Currently, my sister works as a cashier at a supermarket.","目前，我妹妹在一家超市当收银员。"]]],"supermodel":[[["n.",["超级名模"]]],null,17789,1,0,"s:supermodels"],"supernatural":[[["adj.",["超自然的","神奇的"]]],"toefl",8600,1,0,"s:supernaturals"],"supernova":[[["n.",["超新星"]]],"gre",9744,1,0,"s:supernovas"],"superpower":[[["n.",["超级强权","超级大国"]]],null,8289,2,0,"s:superpowers",[["Though it is poor in natural resources, Japan has become an economic superpower thanks to international trade.","日本即便是自然资源匮乏，却仍得益于国际贸易，成为了一个强大的经济体。"]]],"supersede":[[["v.",["代替","取代","接替"]],["",["替代","替换","充任"]]],"toefl ielts gre",14213,1,0,"d:superseded/3:supersedes/i:superseding"],"supersonic":[[["adj.",["超声波的"]],["",["超声的"]]],"cet6 ky ielts",17396,1,0],"superstar":[[["n.",["超级明星"]]],null,7012,1,0,"s:superstars"],"superstition":[[["n.",["迷信"]]],"cet6 ky toefl ielts gre",11572,1,0,"s:superstitions",[["Religion is just organised superstition with a bestseller.","宗教不過是有組織的迷信加上一本暢銷書。"]]],"superstitious":[[["adj.",["迷信的","由迷信引起的"]]],"ky",14286,1,0],"superstore":[[["",["超级商店"]]],null,20356,1,0,"s:superstores"],"superstructure":[[["n.",["上部构造