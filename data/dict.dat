]],null,17485,0,0,"s:orbs/i:orbing/p:orbed"],"orbit":[[["n.",["轨道","常轨","眼眶"]],["v.",["绕...轨道而行","进入轨道","盘旋"]]],"gk cet4 cet6 ky toefl ielts",4178,2,0,"s:orbits/i:orbiting/p:orbited",[["It takes 165 years for Neptune to orbit around the sun.","海王星繞行太陽一周要花一百六十五年。"]]],"orbital":[[["adj.",["轨道的","眼眶的"]],["",["轨道"]]],"toefl",9732,1,0,"s:orbitals"],"orbiter":[[["n.",["轨道飞行器","人造卫星"]]],null,16860,0,0,"s:orbiters"],"orchard":[[["n.",["果园","果树林"]]],"cet6 ky toefl ielts gre",7259,1,0,"s:orchards",[["I delight in going to the apple orchard each fall.","我樂意每年秋季去蘋果園。"]]],"orchestra":[[["n.",["管弦乐队","乐队演奏处"]]],"cet4 cet6 ky toefl ielts gre",5347,2,0,"s:orchestras",[["Do you know the concert schedule of London Symphony Orchestra?","你知道伦敦交响乐团的演奏会行程吗？"]]],"orchestral":[[["adj.",["管弦乐队的"]]],null,16850,0,0],"orchestrate":[[["v.",["编管弦乐曲"]]],null,8946,1,0,"d:orchestrated/i:orchestrating/3:orchestrates"],"orchid":[[["n.",["兰花","淡紫色"]],["",["兰科植物"]]],"toefl gre",9332,0,0,"s:orchids",[["This 14th of May of 2025 is cloudy skies interspersed with blue spaces. I walked to the Roman Catholic church on St. Albans Road twice, once in the morning and again in the afternoon, my 12th and 13th times this spring. In the morning was confession for the little boys and girls in uniform. They were of different races, in the big worship hall. The priest was in the confession booth talking to a student. At the Adoration Chapel, I noticed a nice pot of orchids on the front left. In the afternoon, the big worship hall was mostly empty, a condition which I usually prefer. At the road was a handsome muscle man in white tank top jogging. The big purple-bloom tree seems like an Empress Tree, a Paulownia, because of the big heart-shaped leaves. Reminiscent of Jacaranda with its purple blooming, it's saudade for me about South America. At Tim Hortons café, I enjoyed Scrambled Eggs with Sausage and Potatoes and an Earl Grey Tea with oat milk in the morning, and an Iced Classic Lemonade in the afternoon. The day was full of walking. At home, I study bits of Lojban and Esperanto. I have many books in Esperanto. I tend towards Animism-Buddhism in my Syncretism.","2025 年 5 月 14 日，天空多雲，間或有藍色空間。我兩次走到聖奧爾本斯路上的羅馬天主教堂，一次在早上，一次在下…"]]],"ordain":[[["v.",["注定","规定","任命","颁布命令"]]],"gre",13110,1,0,"d:ordained/i:ordaining/3:ordains"],"ordeal":[[["n.",["严酷考验","痛苦经历","煎熬"]],["",["神裁判法","严酷的考验","痛苦的经验"]]],"toefl ielts gre",7701,2,0,"s:ordeals",[["Tom's ordeal was far from over.","汤姆的严酷考验远没有结束。"]]],"order":[[["n.",["次序","规则","命令","顺序","阶数"],["(often plural) a command given by a superior (e.g., a military or law…"]],["v.",["命令","定货","整理","定购"]]],"zk gk ielts",684,4,1,"s:orders/d:ordered/i:ordering",[["He put the books on the shelf out of order.","他胡亂把書本放在架上。"]]],"orderly":[[["n.",["护理员","清道夫","传令兵","勤务兵"]],["adj.",["有秩序的","整齐的","值班的"]],["adv.",["依次地","顺序地"]]],"cet4 cet6 ky toefl ielts",7744,1,0,"s:orderlies"],"ordinance":[[["n.",["法令","条例","圣餐礼","条款"]]],"toefl gre",7919,1,0,"s:ordinances",[["From today on this ordinance is history.","從今天開始，這項規定成為了歷史。"]]],"ordinarily":[[["adv.",["通常","普通","一般地"]]],"cet6",9387,1,0],"ordinary":[[["adj.",["平常的","普通的","平凡的"]],["n.",["平常的人(或事)"]]],"gk cet4 cet6 ky ielts",2268,3,1,"s:ordinaries",[["You cannot solve this problem in an ordinary way.","這個問題不能用普通的辦法解決。"]]],"ordination":[[["n.",["任命","授神职(礼)","颁布法令","排列"]]],null,15209,0,0,"s:ordinations"],"ordnance":[[["n.",["大炮","军械","武器"]]],"gre",19095,1,0,"s:ordnances"],"ore":[[["n.",["矿石"]],["",["矿"]]],"cet4 cet6 ky toefl ielts gre",10340,1,0,"s:ores"],"oregano":[[["n.",["〈植〉牛至"]]],null,11554,0,0],"organ":[[["n.",["风琴","器官","元件","机构","机关"]]],"gk cet4 cet6 ky ielts",3394,2,1,"s:organs",[["The tongue and the palate are the taste organs.","舌头和上颚都是味觉器官。"]]],"organic":[[["adj.",["器官的","有机的","组织的","根本的","有生命的"]]],"cet4 cet6 ky toefl ielts",3070,2,0,"s:organics",[["Tom and Mary own a small organic farm.","汤姆和玛丽拥有一个小型的有机农场。"]]],"organically":[[["adv.",["有机性地","器官上地","有组织地"]]],"toefl",17187,0,0],"organise":[[["v.",["组织","有机化","给