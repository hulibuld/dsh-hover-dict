ers",[["The Island of Taiwan's surface area is thirty-six thousand square kilometers.","臺灣島的面積是三萬六千平方公里。"]]],"kilometre":[[["n.",["公里","千米"]]],"zk ky",0,3,1,"s:kilometres",[["It's a good three kilometres from here to the bank.","从这里到银行足有三公里路。"]]],"kilowatt":[[["n.",["千瓦"]]],"cet6",0,0,0,"s:kilowatts"],"kimono":[[["n.",["和服","(妇女穿着的)宽大晨衣"]]],null,16111,0,0,"s:kimonos",[["You look good in a kimono.","你穿着和服看上去很漂亮。"]]],"kin":[[["n.",["亲戚","同族","血缘关系","家族"]],["adj.",["有亲属关系的","性质类似的","同类的"]]],"cet6 ky ielts gre",7340,1,0],"kind":[[["n.",["种类","性质","方式"],["a category of things distinguished by some common characteristic or q…"]],["adj.",["亲切的","仁慈的","和蔼的"],["having or showing a tender and considerate and helpful nature; used e…"]]],"zk gk",250,2,1,"s:kinds/r:kinder/t:kindest",[["He was kind enough to take me to the hospital.","他好心地把我送到医院。"]]],"kinda":[[["adv.",["有几分","有一点"]]],null,9840,0,0,[["Going out with those clothes? They look kinda bad.","你要穿那種衣服出門？不太好看耶。"]]],"kindergarten":[[["n.",["幼稚园"]]],"gk ky ielts",6121,1,0,"s:kindergartens",[["The teachers are playing games with students in the kindergarten.","幼儿园里，老师正在带领小朋友们嘻戏。"]]],"kindle":[[["v.",["点燃","使着火","引起","照亮","着火"]]],"cet6 toefl ielts gre",16468,0,0,"d:kindled/i:kindling/3:kindles",[["If a fire breaking out light upon thorns, and catch stacks of corn, or corn standing in the fields, he that kindled the fire shall make good the loss.","若火燃起，點燃荊棘叢，燒及禾稼堆垛或田間立穗，則點火之人須賠償損失。"]]],"kindly":[[["adj.",["和蔼的","温和的","爽快的"]],["adv.",["温和地","亲切地"]]],null,10654,2,1,"r:kindlier",[["I wish I had treated the girl more kindly.","我真後悔以前沒有好好對她。"]]],"kindness":[[["n.",["仁慈","亲切","和蔼"]]],"gk cet4 cet6 ky",7682,1,1,"s:kindnesses",[["To forgive others is an act of kindness to yourself.","原諒別人就是善待自己。"]]],"kindred":[[["n.",["家族","相似","亲戚关系"]],["adj.",["同族的","同类的","血缘的"]]],"gre",18790,0,0,"s:kindreds",[["When we come to die, we shall be alone. From all our worldly possessions we shall be about to part. Worldly friends — the friends drawn to us by our position, our wealth, or our social qualities, — will leave us as we enter the dark valley. From those bound to us by stronger ties — our kindred, our loved ones, children, brothers, sisters, and from those not less dear to us who have been made our friends because they and we are the friends of the same Saviour, — from them also we must part. Yet not all will leave us. There is One who \"sticketh closer than a brother\" — One who having loved His own which are in the world loves them to the end.","当我们濒临死亡，我们应该独处。我们将摒离所有身外之物。世间的朋友们-跟我们的地位，财富和社会层次息息相关的朋友，都将离…"]]],"kinetic":[[["adj.",["运动的","运动引起的","动力学的","活动的","动的"]]],"cet6 toefl gre",15176,0,0],"king":[[["v.",["使...成为君主","君临","统治"]],["n.",["国王","君主"]]],"zk gk cet4 ky ielts",2080,4,1,"s:kings",[["When I grow up, I want to be a king.","我長大後想當國王。"]]],"kingdom":[[["",["界(动物","植物","矿物)"]],["n.",["王国","领域"]]],"gk cet4 cet6 ky toefl",4487,2,0,"s:kingdoms",[["This book deals with life in the United Kingdom.","这本书关于生活在英国。"]]],"kingfisher":[[["n.",["鱼狗","翠鸟"]]],null,25174,1,0,"s:kingfishers"],"kingpin":[[["n.",["中心立轴","(非正式)中心人物","首脑","关键人物","(非正式)主要成分"]]],null,19852,0,0,"s:kingpins"],"kink":[[["n.",["扭结","蜷缩"]],["v.",["(使)扭结","(使)绞缠"]]],null,17053,0,0,"s:kinks/i:kinking/d:kinked"],"kinky":[[["adj.",["弯曲的","古怪的"]]],null,19942,0,0,"s:kinkies/r:kinkier",[["\"What's the difference between erotic and kinky?\" \"Erotic is when you use a feather and kinky is when you use a whole chicken.\"","「情色和變態之間有什麼不同之處？」「情色是當你使用一根羽毛，變態是當你使用整隻雞。」"]]],"kinship":[[["n.",["亲属关系","家族关系","关系"]]],"ky",8890,0,0,"s:kinships"],"kiosk":[[["n.",["亭","凉亭","报摊"]]],"gre",13231,1,0,"s:kiosks",[["Regina Anyango, owner of small food kiosk in Nairobi, uses ethanol fuel to prepare meals for customers. Her kitchen is free of fumes and smoke from charcoal use.","雷吉娜安揚戈是奈洛比一家小吃攤的老闆，她用乙醇燃料為顧客準備餐點。她的廚房沒有木炭產生的煙霧與廢氣。"]]],"kiss":[[["v.",["吻","接吻"]],["n.",["吻"]]],"zk gk cet4 ky",2302,3,1,"p:kissed/i:kissing/s:kisses",[["Kissing a person who smokes is like licking an ashtray.","亲吻一个抽烟的人就像在舔烟灰缸。"]]],"kit":[[["n.",["装备","工具箱","成套工具"]],["",["成套部件","成套零件"]]],"cet6 ky ielts",4018,2,0,"s:kits/d:kitted/i:kitting",[["Don't forget to take the first-aid kit.","别忘了带上急救箱。"]]],"kitchen":[[["n.",["厨房","全套炊具"],["a room equipped for preparing meals"]]],"zk gk toefl ielts",1051,4,1,"s:kitchens",[["He was discovered unconscious on the floor of the kitchen.","他被人发现倒在厨房的地板上，不省人事。"]]],"kite":[[["v.",["象风筝一样飞","轻快地移动","使用空头支票","使上升","骗钱"]],["n.",["风筝","筝帆","空头支票","骗子"]]],"zk gk cet4 cet6 ky",9509,1,0,"s:kites/i:kiting/p:kited",[["Let's go to the field and fly kites, what do you say?","咱们到田园去放风筝怎么样？"]]],"kitsch":[[["n.",["粗劣作品","迎合低级趣味的作品"]]],null,18915,1,0],"kitten":[[["n.",["小猫","淘气姑娘"]],["v.",["产仔","卖弄风情"]]],null,9944,1,0,"s:kittens/d:kittened/i:kittening",[["Is there anyone who wants to keep the cute kitten?","有沒有人要養可愛的小貓？"]]],"kiwi":[[["n.",["鹬鸵","地勤人员","新西兰人"]]],null,21895,1,0,"s:kiwis",[["Have you never eaten a kiwi fruit?","你從來沒吃過獼猴桃嗎？"]]],"kleenex":[[["n.",["克里内克丝面巾纸"]]],null,19667,0,0],"km":[[["",["千米","公里"]]],null,0,2,1,"s:kms",[["In towns, speed is limited to 50 km/h.","在市区内，速度被限制在每小时五十公里以内。"]]],"knack":[[["n.",["熟练技术","巧妙手法","诀窍"]],["",["窍门"]]],"gre",11646,1,0,"s:knacks/p:knacked",[["I am not an artist. I never had the knack for it.","我不是藝術家，我一點那方面的天賦都沒有。"]]],"knapsack":[[["n.",["背包"]]],"toefl",17327,0,0,"s:knapsacks"],"knave":[[["n.",["恶棍","骗徒","(纸牌的)杰克","流氓行为","无赖"]]],"gre",29367,0,0,"s:knaves"],"knead":[[["v.",["揉","按摩","捏"]],["",["揉合"]]],"gre",12811,1,0,"i:kneading/p:kneaded/3:kneads"],"knee":[[["n.",["膝","膝盖"],["hinge joint in the human leg connecting the tibia and fibula with the…"]],["v.",["膝行","用膝盖碰"]]],"zk gk cet4 cet6 ky",1488,3,1,"s:knees/i:kneeing",[["Mother applied the medicine to the sore on my knee.","母親把藥膏塗在了我膝蓋的傷口上。"]]],"kneel":[[["v.",["跪下"]]],"cet4 cet6 ky",4938,1,0,"p:knelt/i:kneeling/3:kneels",[["They knelt down and prayed that the war would end soon.","他們跪了下來祈禱，希望戰爭快點結束。"]]],"knell":[[["n.",["丧钟声","哀伤的声音","凶兆"]