nwards":[[["adv.",["向下"]]],null,25950,2,1,[["Water springs out of a fountain, flows downwards in a brook, runs in a beck, stands in a pond, glides in the stream, is whirled about in a whirlpool and causes fens.","水從噴泉中湧出，在溪流中向下流，在溪澗中奔走，在池塘中安定，在河流中順勢流，在漩渦中迴旋，並形成沼澤。"]]],"downwind":[[["adj.",["顺风的"]],["adv.",["顺风"]]],null,18944,0,0],"dowry":[[["n.",["嫁妆","陪嫁物"]]],"gre",17661,0,0,"s:dowries"],"dowse":[[["v.",["探寻水源"]]],null,42830,1,0,"i:dowsing/d:dowsed/3:dowses"],"doyen":[[["n.",["老资格","首席","老前辈","领袖"]]],"gre",34410,0,0,"s:doyens"],"doze":[[["v.",["打瞌睡","假寐","打瞌睡度过"]],["n.",["瞌睡"]]],"ky toefl ielts gre",11330,1,0,"p:dozed/i:dozing/s:dozes",[["Tom dozed off in French class.","汤姆在法语课上打瞌睡了。"]]],"dozen":[[["n.",["打","十二个"]],["adj.",["一打的"]]],"zk gk cet4 ky",1194,4,1,[["In U.S. bakeries, a \"baker's dozen\" is 13, not 12.","在美國的麵包店，「麵包師傅的一打」是13，不是12。"]]],"dr":[[["n.",["博士","医生"]],["",["英钱"]]],"gk",0,0,1,[["Dr. Yukawa played an important part in the scientific study.","汤川博士在科学研究上起了很重要的作用。"]]],"drab":[[["adj.",["土褐色的","单调的"]]],"gre",15038,1,0,"s:drabs/r:drabber/t:drabbest"],"draconian":[[["adj.",["严厉的","残酷的"]]],"gre",16880,1,0],"draft":[[["n.",["气流","草稿","汇票","草案"]],["v.",["起草","征兵"]]],"gk cet4 cet6 ky toefl ielts gre",2624,3,1,"d:drafted/i:drafting/s:drafts",[["Draft beer tastes especially good on a hot day.","生啤酒在大熱天時特別好喝。"]]],"draftsmanship":[[["n.",["制图术"]]],"gre",34460,0,0],"drag":[[["v.",["拖累","拖拉","沉重缓慢地走","拖动"]],["n.",["拖","拖累"]]],"gk cet4 cet6 ky toefl",2127,3,1,"p:dragged/i:dragging/3:drags",[["Tom dragged himself out of bed and put on his clothes.","汤姆从床上爬起来，穿上了衣服。"]]],"dragon":[[["n.",["龙","凶暴的人"]],["",["凶恶的人","凶恶严厉的监护人"]]],"cet4 cet6 ky",5085,2,0,"s:dragons",[["The dragon is one of the cultural emblems of China.","龍是中國的文化圖騰。"]]],"dragonfly":[[["n.",["蜻蜓"]]],"toefl",18401,0,0,"s:dragonflies",[["There is a dragonfly on the ceiling.","天花板上有一隻蜻蜓。"]]],"dragoon":[[["n.",["龙骑兵","骑兵","暴徒"]],["v.",["以武力迫害","弹压","强制"]]],null,28192,1,0,"s:dragoons/d:dragooned/i:dragooning"],"drain":[[["v.",["排出","喝光","耗尽","排水","流干"]],["n.",["排水沟","消耗","排水"]]],"cet4 cet6 ky toefl ielts gre",3601,3,0,"s:drains/d:drained/i:draining",[["He raised the glass to his lips and drained it at one gulp.","他把杯子举到嘴边，一饮而尽。"]]],"drainage":[[["n.",["排水","引流","导液"]]],"cet6 toefl ielts gre",7695,1,0,"s:drainages"],"drama":[[["n.",["戏剧","戏剧艺术"]]],"cet4 cet6 ky toefl ielts",2631,3,1,"s:dramas",[["Because American dramas are very bloody, he doesn't like watching them.","因为他认为美剧镜头很血腥，所以他不喜欢看美剧。"]]],"dramatic":[[["adj.",["戏剧性的","生动的"]]],"cet4 cet6 ky toefl ielts",2119,4,1,"s:dramatics"],"dramatically":[[["adv.",["戏剧地","引人注目地","突然地"]]],"toefl",3364,0,1,[["Since the mid-20th century, the number of hutongs in Beijing has dropped dramatically as they are demolished to make way for new roads and buildings.","二十世纪中以后，北京胡同的数量显著地下降，因为人们把它们拆毁以便给新的楼房和街路让路。"]]],"dramatist":[[["n.",["剧作家"]]],null,21749,1,0,"s:dramatists"],"dramatize":[[["v.",["改编成戏剧","编写剧本","戏剧化"]]],"ky toefl",12771,1,0,"d:dramatized/i:dramatizing/3:dramatizes"],"drape":[[["v.",["用布帘覆盖","披上","成褶皱状"]],["n.",["布帘","褶皱"]]],null,6253,1,0,"d:draped/s:drapes/i:draping",[["This majestic mountain range in the heart of south Asia is crowned with snowcapped peaks and draped with vast glaciers.","這座位於南亞中心的雄偉山脈，山峰白雪皚皚，覆蓋著廣闊的冰川。"]]],"draper":[[["n.",["布商"]]],null,40433,1,0,"s:drapers"],"drapery":[[["n.",["帏帐","布料"]]],null,14987,0,0,"s:draperies"],"drastic":[[["",["峻泻药","剧烈的"]],["adj.",["激烈的"]]],"cet6 ky toefl ielts gre",8118,2,0,[["The invention of TV caused a drastic change in our daily life.","電視的發明為我們的生活模式帶來了巨大的變化。"]]],"drastically":[[["adv.",["激烈地","彻底地"]]],null,8578,0,0,[["They monopolized the supply market and drastically raised prices.","他們壟斷了原物料供應，並開天價。"]]],"draught":[[["n.",["气流","草稿","汇票","通风","拉"]],["v.",["起草","征兵","选派"]]],null,25481,2,0,"s:draughts/i:draughting/d:draughted",[["There's a cold draught coming in through the door.","一股冷風從門外進來。"]]],"draw":[[["v.",["拉","拖","拔剑","拖拉","挨近"]],["n.",["拉","拖","拔出","抽签","平局"],["a gully that is shallower than a ravine"]],["",["翻牌","绘图"]]],"zk gk toefl",592,5,1,"d:drawn/p:drew/i:drawing/3:draws",[["\"Drawing dragons and dotting in the eyes\" is a fable.","画龙点睛是一则寓言故事。"]]],"drawback":[[["n.",["缺点","退税","退款"]]],"gk cet6 ky toefl ielts",8563,1,0,"s:drawbacks",[["What are the advantages and drawbacks of this method?","这方法有什么优点和缺点？"]]],"drawbridge":[[["n.",["(可开闭的)吊桥"]]],"gre",23776,0,0,"s:drawbridges"],"drawer":[[["n.",["抽屉","开票人"]]],"zk gk cet4 cet6 ky toefl ielts",4212,2,1,"s:drawers",[["There should be a box of matches in the top drawer.","最上面的抽屉里应该有一盒火柴。"]]],"drawl":[[["v.",["慢吞吞地说","故意拉长调子讲话"]],["n.",["慢吞吞拉长调子的说话方式"]]],"gre",17106,1,0,"p:drawled/3:drawls/i:drawling"],"drawn-out":[[["adj.",["拖长的","冗长乏味的"]]],null,0,1,0],"dread":[[["n.",["恐惧","可怕的人(或事)"]],["adj.",["可怕的","可怖的"]],["v.",["恐惧","害怕"]]],"cet4 cet6 ky toefl ielts",9181,2,0,"p:dreaded/i:dreading/3:dreads",[["Cleaning up the house is truly my most dreaded task.","打扫屋子真的是我最害怕的工作。"]]],"dreadful":[[["adj.",["可怕的"]]],"cet6 toefl ielts",9280,2,0,[["The consequences of Sendai's earthquake were dreadful!","仙台地震的结果很恐怖。"]]],"dreadfully":[[["adv.",["(非正式)非常","可怕地","令人惊骇地"]]],"toefl",24065,0,0,[["Of all the witches that may be found in all the fairy tales ever told there is none more delightfully sociable than the Sand Witch. This Witch, who lives underneath the heaps of sand at the ocean's edge, where, in the summertime, you dig with your shovel, is not at all like other witches. She never rides on a broomstick, and she never goes down chimneys. In the first place there are no broomsticks or chimneys on the beach at the sea-shore, and in the second place she would not know how to ride on a broomstick or climb down a chimney, if there were. All the Sand Witch knows how to do is to sink into the sand when anything scares her, and to come up through the sand when she sees a chance to get acquainted with a person she never was acquainted with before. So now you know what a Sand Witch is. And if Junior Jenks, seven years old, and dreadfully sunburnt, had known what you know, he would have been much better prepared to face the one that came up right under his nose all of a sudden one hot July morning.","在所有童話故事裡出現的女巫中，沒有一個比沙女巫更討人喜歡、更善於交際了。這位女巫住在海邊堆積如山的沙子下面，夏天的時候…"]]],"dream":[[["n.",["梦","空想","愿望"],["a series of mental images and emotions occurring during sleep"]],["v.",["做梦","想象","梦想"]]],"zk gk cet4 cet6 ky",990,4,1,"s:dreams/i:dreaming/d:dreamed",[["Everyone would like to believe that dreams can come true.","人人都愿意相信美梦可以成真。"]]],"dreamer":[[["n.",["做梦的人","梦想者"]]],null,11747,1,0,"s:dreamers"],"dreamlike":[[["adj.",["梦一般的","梦幻的"]]],null,18765,0,0],"dreamy":[[["adj.",["空幻的","梦想的"]]],null,12473,1,0,"t:dreamiest/r:dreamier"],"dreary":[[["adj.",["沉闷的"]]],"toefl ielts gre",12828,1,0,"t:dreariest/r:drearier"],"dredge":[[["n.",["挖泥机","拖网"]],["v.",["用挖泥机疏浚","(用船)采捞"]]],null,13178,1,0,"i:dredging/p:dredged/3:dredges"],"drench":[[["v.",["使湿透","使充满"]],["n.",["滂沱大雨","弄湿"]]],"ielts gre",12912,1,0,"d:drenched/i:drenching/3:drenches",[["I was caught in a shower and got drenched to the skin.","我遇上了陣雨被淋得全身濕透。"]]],"dress":[[["v.",["穿着","给...穿衣","整理"],["put on clothes"]],["n.",["服装","覆盖物"],["a one-piece garment for a woman; has skirt and bodice"]]],"zk gk ielts",1437,4,1,"d:dressed/s:dresses/i:dressing",[["Where did you get the money to buy that dress?","你從哪兒弄來的錢去買那件衣服？"]]],"dresser":[[["n.",["化妆台","(剧团)服装师","碗柜"]],["",["敷裹员"]]],null,8499,0,0,"s:dressers",[["The hair dresser is cutting the hair with scissors.","理发师正在用剪刀剪头发。"]]],"dribble":[[["v.",["流口水","滴下","使滴下","运球"]],["n.",["点滴","口水","少量"]]],"gre",11717,1,0,"p:dribbled/i:dribbling/s:dribbles"],"drift":[[["n.",["漂流物","漂流","动向"]],["v.",["(使)漂流"]]],"cet4 cet6 ky toefl ielts",3599,3,0,"p:drifted/i:drifting/s:drifts",[["Fluffy white clouds drift across the sky one by one.","一片一片的白雲在上空飄過。"]]],"drifter":[[["n.",["漂流者","漂流物","漂网渔船"]]],null,19501,0,0,"s:drifters"],"driftwood":[[["n.",["漂流木","浮木"]]],"toefl",18250,0,0],"drill":[[["n.",["钻孔机","钻子","播种机","粗斜纹布"]],["v.",["训练","钻孔"]]],"gk cet4 cet6 ky toefl ielts gre",4760,2,0,"i:drilling/s:drills/d:drilled",[["We had a fire drill yesterday.","我們昨天進行了火警演習。"]]],"drink":[[["n.",["饮料","酒"],["a single serving of a beverage"]],["v.",["喝","喝酒"],["take in liquids"]]],"zk gk",1232,4,1,"s:drinks/i:drinking/p:drank/d:drunk",[["During hot weather, be sure to drink lots of water.","天氣熱的時候記住要多喝水。"]]],"drinker":[[["n.",["饮者","酒徒"]]],null,10251,1,0,"s:drinkers",[["Tom is a heavy tea drinker.","湯姆是個茶迷。"]]],"drip":[[["n.",["水滴"]],["v.",["(使)滴下"]]],"cet4 cet6 ky toefl",6019,2,0,"i:dripping/p:dripped/s:drips",[["The sweat was dripping off my brow.","汗水從我的額頭上落下。"]]],"dripstone":[[["n.",["滴水石"]]],"toefl",0,0,0],"drive":[[["n.",["驾车","快车道","推进力","驱动","动力"],["the act of applying force to propel something"]],["v.",["开车","驱使","推动","驾驶","猛击"]]],"zk gk",490,5,1,"p:drove/d:driven/i:driving/3:drives",[["He drove the car, listening to music on the radio.","他一面開車一面聽收音機的音樂。"]]],"drive-in":[[["n.",["免下车餐馆","免下车电影院"]],["adj.",["免下车服务的"]]],null,0,1,0,"s:drive-ins"],"drivel":[[["v.",["淌口水","说傻话","胡说"]],["n.",["胡言乱语","糊涂话"]]],"gre",27601,0,0,"i:drivelling/p:drivelled/3:drivels"],"driver":[[["n.",["驾驶员","驱动器","驱动程序"],["the operator of a motor vehicle"]]],"zk gk ielts",1226,0,1,"s:drivers",[["The driver does not have responsibility for the traffic accident.","司機不需要為這次的交通意外負責。"]]],"driveway":[[["n.",["车道"]]],null,4769,1,0,"s:driveways",[["It's the 26th of April of 2025. Before 14:00, a sunny blue-sky afternoon, I went to my neighbourhood's cul-de-sac to meditatively walk around and around there. I admired the gardens. They reminded me of Daoism: how the microcosm reflects the macrocosm: The puffs of sakura would be a nebula afar. One need not really travel too far. Barb my white neighbour was at her driveway. She and her husband Ken would be going out to buy eggs. They eat many eggs.","那是 2025 年 4 月 26 日。下午兩點前，陽光明媚，萬里無雲。我來到我家附近的死胡同，靜靜地漫步。我欣賞著花園…"]]],"drizzle":[[["n.",["细雨"]],["v.",["下毛毛雨"]]],"toefl gre",9773,1,0,"i:drizzling/p:drizzled/s:drizzles",[["I like drizzles, not rainstorms.","我喜歡下小雨，不喜歡下大雨。"]]],"drizzly":[[["adj.",["下毛毛雨的"]]],"gre",33111,0,0],"droll":[[["adj.",["好笑的","滑稽的","逗趣的"]]],"gre",23727,0,0,"3:drolls"],"drollery":[[["n.",["玩笑"]]],"gre",44487,0,0,"s:drolleries"],"drone":[[["n.",["雄蜂","懒惰者","嗡嗡的声音","无人驾驶飞机(或船)"]],["v.",["嗡嗡作声","混日子","低沉地说"]]],"gre",11442,1,0,"p:droned/s:drones/i:droning",[["Long story short, she’s on the No Fly List and we might have been followed here by drone.","长话短说，她上了禁飞名单，回来时还可能有一架无人飞机跟着我们。"]]],"drool":[[["v.",["流口水","淌","胡说八道","从嘴淌下","过分动感情地表示"]],["n.",["口水","胡说"]]],null,15812,0,0,"i:drooling/p:drooled/3:drools",[["The little child drools whenever he hears of something delicious.","小家伙一听到有好吃的，口涎就流出来好长！"]]],"droop":[[["v.",["下垂","消沉","使下垂"]],["n.",["低垂","消沉"]]],"gre",15135,1,0,"p:drooped/i:drooping/3:droops",[["The heads of the flowers in the garden were drooping.","花園中一片花枝累垂的樣子。"]]],"drop":[[["v.",["放下","掉下","下降","使滴下","丢失"]],["n.",["滴","微量","落下","空投"],["a shape that is spherical and small"]],["",["投入","投入点","接入点","分接点"]]],"zk gk cet4 cet6 ky ielts",690,4,1,"p:dropped/i:dropping/s:drops",[["Drop by drop, the water can conglomerate into a lake.","一滴滴水能聚成湖泊。"]]],"drop-off":[[["n.",["下降","减少"]]],"ielts",0,0,0,"s:drop-offs"],"drop-out":[[["",["漏失信息","丢\"1\""]]],"ielts",0,1,0,"s:drop-outs"],"droplet":[[["n.",["小滴"]]],"toefl gre",12935,1,0,"s:droplets"],"dropout":[[["n.",["退学学生","中途退学"]],["",["离去"]]],"ielts",7969,0,0,"s:dropouts"],"dross":[[["n.",["浮渣","碎屑","渣滓"]]],"gre",35186,0,0],"drought":[[["n.",["干旱","缺乏"]]],"cet4 cet6 ky toefl ielts gre",5353,2,0,"s:droughts",[["During droughts, farmers are barely able to eke out a living.","發生旱災的時候，農民很難維持生計。"]]],"drown":[[["v.",["淹死","把...淹死","淹没"]]],"gk cet4 cet6 ky ielts",4927,2,0,"d:drowned/i:drowning/3:drowns",[["He saved the drowning boy at the risk of his own life.","他奮不顧身地把遇溺的男孩救了起來。"]]],"drowse":[[["v.",["打瞌睡","使瞌睡"]],["n.",["瞌睡"]]],"ielts",32217,0,0,"i:drowsing/p:drowsed/3:drowses"],"drowsiness":[[["",["倦睡","瞌睡"]],["n.",["睡意"]]],"ielts",24761,0,0],"drowsy":[[["",["倦睡的","瞌睡的"]],["adj.",["昏昏欲睡的"]]],"toefl",17024,1,0,"r:drowsier",[["I'd just woken up and was still drowsy.","我那時剛剛起床，還迷迷糊糊的。"]]],"drub":[[["v.",["用棒打","殴打","硬灌(观念等)","敲击"]]],"toefl",34954,0,0,"i:drubbing/3:drubs/d:drubbed"],"drudgery":[[["n.",["苦差事","苦工"]]],"toefl ielts gre",20108,0,0,"s:drudgeries",[["With all its sham, drudgery and broken dreams; it is still a beautiful world.","虽然虚伪、苦痛还有破碎的梦伴随着我，但这仍然是一个美丽的世界。"]]],"drug":[[["n.",["药","麻药","麻醉药"],["a substance that is used as a medicine or narcotic"]],["v.",["吸毒","使服麻醉药","使麻木"],["administer a drug to"]]],"zk gk cet4 cet6 ky",461,5,1,"s:drugs/d:drugged/i:drugging",[["When taking drugs, follow the directions on the bottle carefully.","吃药之前一定要仔细看说明书。"]]],"drugstore":[[["n.",["药房","杂货店"]]],null,9245,1,1,"s:drugstores",[["Where's the nearest drugstore?","最近的藥店在哪裡？"]]],"druid":[[["n.",["巫师","占卜者","祭师"]]],null,28278,1,0,"s:druids",[["A more barbarous form of these rejoicings took place among the rude peoples of the north where great blocks of wood blazed in honor of Odin and Thor, and sacrifices of men and cattle were made to them. Mistletoe was cut then from the sacred oaks with a golden sickle by the Prince of the Druids.","在北方的原始部落中，也存在著一種更野蠻的慶祝形式：他們點燃巨大的木柴，以紀念奧丁和托爾，並向祂們獻祭人和牲畜。德魯伊王…"]]],"drum":[[["v.",["击鼓","作鼓声","打鼓奏出"]],["n.",["鼓","鼓声"]],["",["磁鼓"]]],"zk gk cet4 cet6 ky",4116,3,1,"s:drums/p:drummed/i:drumming",[["I sent this drum to my father.","我送了个长鼓给我父亲。"]]],"drumbeat":[[["n.",["鼓声"]]],null,19131,0,0,"s:drumbeats"],"drummer":[[["",["跑街","旅行商人","旅行销货人"]],["n.",["鼓手","旅行推销员"]]],null,8442,0,0,"s:drummers"],"drumstick":[[["n.",["鼓槌","鸡腿下段"]]],null,19645,0,0,"s:drumsticks"],"drunken":[[["adj.",["酒醉的"]]],null,8167,1,0,[["A drunken man was sleeping on the bench.","一個醉了的男人在長椅上睡觉。"]]],"drunkenness":[[["",["醉酒","酒醉"]]],null,18445,0,0,[["Prostitution, gambling, the use of narcotic substances, drunkenness, disorder, and all other illegal activities are STRICTLY FORBIDDEN.","严禁卖淫嫖娼，赌博，吸毒，酗酒滋事等违法犯罪活动！"]]],"dry":[[["adj.",["干的","无酒的","枯燥无味的","干燥的"],["free from liquid or moisture; lacking natural or normal moisture or d…"]],["v.",["把...弄干","变干"],["remove the moisture from and make dry"]],["n.",["干","干涸"],["a reformer who opposes the use of intoxicating beverages"]]],"zk gk",1561,4,1,"d:dried/i:drying/3:dries/r:drier/t:driest",[["This has been the driest six months in thirty years.","這是三十年代以來最乾旱的六月。"]]],"dryer":[[["n.",["干衣机","干燥剂","催干剂","干燥器","干燥设备"]]],null,9605,1,0,"s:dryers",[["Mary dried her hair with a hair dryer.","瑪莉用吹風機吹乾頭髮。"]]],"dryly":[[["adv.",["冷淡地","枯躁无味地"]]],null,15963,0,0],"dryness":[[["n.",["干燥","干燥无味","冷淡"]]],null,17571,0,0],"dual":[[["adj.",["双重的","双的"]],["n.",["双数"]]],"toefl ielts gre",5602,2,0,"s:duals",[["Microsoft recently unveiled two new dual screen devices.","Microsoft 近期新推出了兩款雙螢幕裝置。"]]],"dualism":[[["n.",["双重性","二元论"]]],null,18628,0,0,"s:dualisms"],"duality":[[["",["二象性","双偶性"]],["n.",["二元性"]]],null,16188,0,0,"s:dualities"],"dub":[[["v.",["配音","轻点","授予称号","击"]],["n.",["一下击鼓声","笨蛋"]]],"ielts",6064,2,0,"d:dubbed/i:dubbing/3:dubs",[["He has dubbed in \"Avatar\".","他为《阿凡达》配了音。"]]],"dubious":[[["adj.",["可疑的","不确定的"]]],"cet6 ky toefl ielts gre",7599,2,0,[["Tom got a computer virus while he was watching videos on dubious Internet sites.","汤姆在可疑的网站上看视频的时候中了电脑病毒。"]]],"duchess":[[["n.",["公爵夫人"]]],null,22314,1,0,"s:duchesses",[["The Queen has gone to a lot of trouble for the Duchess.","女王为公爵夫人费心做了很多。"]]],"duchy":[[["n.",["公爵领地","公国","直辖领地"]]],null,32464,1,0,"s:duchies"],"duck":[[["v.",["没入水中","闪避","猛按...入水","躲避"]],["n.",["鸭子"]]],"zk gk cet4 cet6 ky",3521,2,0,"s:ducks/p:ducked/i:ducking",[["We ate Peking duck in the Chinese restaurant.","我们在中餐厅吃了北京烤鸭。"]]],"duckling":[[["n.",["小鸭子"]]],"gre",21663,0,0,"s:ducklings"],"duct":[[["n.",["管","输送管"]],["v.",["通过管道输送"]]],"gre",8636,1,0,"s:ducts/i:ducting/d:ducted"],"ductile":[[["adj.",["易延展的","韧性的","易教导的"]],["",["延伸性的"]]],"toefl gre",35384,0,0],"dud":[[