ontrolled cel…"]]],"zk cet4 cet6 ky",1029,4,1,"s:cancers",[["Many cancer patients lose their hair because of the chemotherapy.","很多癌症患者都因为化疗而脱发。"]]],"cancerous":[[["adj.",["癌的","似癌的","生癌的"]],["",["癌性的"]]],null,17147,1,0],"candid":[[["adj.",["坦白的","率直的","公正的"]]],"toefl gre",9420,1,0,"s:candids",[["What do I think, you say ... well then, I'll give you my candid opinion.","你問我怎麼想？……好吧，那我就把我的心底話說出來吧。"]]],"candidacy":[[["n.",["候选人的地位","候选资格"]],["",["候选人的身份","资格"]]],"gre",8782,1,0,"s:candidacies"],"candidate":[[["n.",["候选人","投考者"],["someone who is considered for something (for an office or prize or ho…"]],["",["候选","候补者"]]],"gk cet4 cet6 ky toefl ielts gre",957,4,1,"s:candidates",[["Strange to say, no one voted for the candidate.","奇怪的是，誰也沒有投那候選人一票。"]]],"candidly":[[["adv.",["率直地","坦白地"]]],null,16893,0,0],"candle":[[["n.",["蜡烛"]],["v.",["对着光检查"]]],"zk gk cet4 cet6 ky ielts",3928,2,0,"s:candles/i:candling/p:candled",[["A candle without a wick is no candle at all.","蠟燭沒有了芯，就不能算是蠟燭了。"]]],"candlelight":[[["n.",["烛光","黄昏"]]],null,11750,0,0,"s:candlelights",[["Instead of preparing a dinner by candlelight, she put her boyfriend up for auction on eBay.","她没有准备烛光晚餐，而是把她的男友放到Ebay上拍卖。"]]],"candlestick":[[["n.",["蜡杆","蜡烛架"]]],null,17734,1,0,"s:candlesticks",[["I tend to collect tiny little objects, like balms sold on the market, little candles and candlesticks. As long as they are tiny and cutesy, I like them.","我习惯于收集琐碎的物件，像是集市上卖的香膏，小蜡烛与烛台，只要是那种小巧又可爱的东西，我都会很喜欢。"]]],"candor":[[["n.",["坦白","直率"]]],"gre",13158,0,0,[["He does not, in short, write with the candor of a man who is completely confident of his thesis.","簡單來說，他的文筆並沒有流露出那種對自己的論文充滿信心的人應有的直率和坦誠。"]]],"candy":[[["v.",["用糖煮","使结晶为砂糖","结晶为砂糖"]],["n.",["糖果","冰糖"]]],"zk gk cet4 ky",3446,1,1,"p:candied/s:candies/i:candying",[["I prefer cakes or candies to alcohol, but I do drink.","比起酒來，我比較喜歡蛋糕、糖果，可是酒我也不是完全不喝的。"]]],"cane":[[["n.",["手杖","细长的茎","藤条"]],["v.",["以杖击","以藤编制"]]],"cet6 ielts gre",5299,2,0,"s:canes/d:caned/i:caning",[["Sugar ca