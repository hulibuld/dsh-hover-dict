nt":[[["adj.",["最近的","近代的","最新的","新进的"],["new"]]],"zk gk cet4 cet6 ky toefl",567,5,1,[["The number of tourists has increased greatly in recent years.","近年的遊客數量大幅增加。"]]],"recently":[[["adv.",["最近"]]],"cet4 cet6 toefl",699,4,1,[["Tom has not been doing very well at work recently.","汤姆最近在工作中发挥不太好。"]]],"receptacle":[[["n.",["容器","花托","插座","受器"]]],"toefl gre",18066,0,0,"s:receptacles"],"reception":[[["n.",["接待","接受","招待会","感受"]]],"gk cet4 cet6 ky toefl ielts",3944,2,1,"s:receptions",[["The reception in the cellar is really bad.","地下室裏的信號很差。"]]],"receptionist":[[["n.",["接待员"]]],"gk toefl ielts",10281,1,0,"s:receptionists"],"receptive":[[["",["接受的","感受的"]],["adj.",["能接纳的"]]],"toefl gre",9761,1,0,[["As heaven maintains its vigorous motion, the noble person should strive for continuous self-improvement. As the earth's nature is receptive and nurturing, the noble person should cultivate great virtue to support and carry all things.","天行健，君子以自强不息；地势坤，君子以厚德载物。"]]],"receptor":[[["n.",["受体","感觉器官","接受器"]]],"toefl",9755,1,0,"s:receptors",[["When the body is touched, receptors in the skin send messages to the brain causing the release of chemicals such as endorphins.","當身體受到外界觸碰的時候，皮膚的感受器就會向大腦發出信息，令大腦釋放安多芬等的化學物質。"]]],"recess":[[["n.",["休息","休会","放假","凹进处","深处"]],["v.",["使凹进","休假","休息"]]],"gre",7747,1,0,"s:recesses/d:recessed/i:recessing",[["In reality, translation is akin to working for peanuts, since the corresponding meaning of something in one language is often hidden in some deep and impenetrable recesses of the other. As a result, the translator is forced to search all over... Never mind that the picky reader is very difficult to fool.","翻译其实是一件吃力不讨好的事，因为一种语言在另一种语言中的对应物藏在往往隐藏在深不可测之处，翻译者需要百般寻觅，而且，…"]]],"recession":[[["n.",["后退","凹处","衰退","归还"]],["",["退缩"]]],"cet6 ky toefl ielts gre",3576,4,0,"s:recessions",[["The unemployment rate went up to 5% because of the recession.","經濟不景氣失業率上升到了5％。"]]],"recessive":[[["adj.",["后退的","逆行的","隐性的"]],["n.",["隐性性状"]]],"gre",29127,0,0,"s:recessives"],"recharge":[[["v.",["再充电","再装填","再控告","再袭击"]],["n.",["再袭击","再装填"]]],null,13845,1,0,"i:recharging/d:recharged/3:recharges"],"recipe":[[["n.",["食谱","处方","秘诀","取(处方头语)"]]],"gk cet6 ky toefl ielts gre",2509,2,0,"s:recipes",[["The frog and I took turns guessing what the secret recipe was.","青蛙和我轮流猜了秘方是什么。"]]],"recipient":[[["adj.",["领受的","容易接受的","感受性强的"]],["n.",["领受者","容纳者","容器"]]],"cet6 ky toefl ielts gre",3919,2,0,"s:recipients",[["Don't flip-flop the addresses of the sender and recipient!","不要把寄件人、收件人地址的姓名填反了！"]]],"reciprocal":[[["adj.",["互惠的","相互的","相等的","倒数的","彼此相反的"]],["n.",["倒数","互相起作用的事物"]]],"cet6 ky toefl ielts gre",10639,1,0,"s:reciprocals"],"reciprocate":[[["v.",["回报","互换","交换","报答","使往复运动"]]],"gre",15555,1,0,"d:reciprocated/i:reciprocating/3:reciprocates"],"reciprocity":[[["n.",["相互性","相互作用","互惠主义"]],["",["互惠性","相关性"]]],null,13699,0,0,"s:reciprocities"],"recital":[[["n.",["背诵","吟诵","详述"]],["",["叙述","评述","列举"]]],"toefl ielts gre",11952,1,0,"s:recitals"],"recitation":[[["n.",["详述","吟诵","背诵的诗"]],["",["叙述","评述","书面陈述"]]],null,15075,0,0,"s:recitations"],"recite":[[["v.",["背诵","朗读","叙述"]]],"zk gk cet4 cet6 ky ielts",6397,1,0,"i:reciting/p:recited/3:recites",[["His daughter is able to recite a lot of poems.","他的女儿能背诵很多诗。"]]],"reckless":[[["adj.",["不介意的","大意的","鲁莽的","不顾后果的","不注意的"]]],"cet6 ky toefl ielts",8562,1,0,[["Reckless driving can easily lead to an accident.","鲁莽的开车容易造成交通事故"]]],"recklessly":[[["adv.",["不注意","粗心大意","不在乎","鲁莽","不顾后果"]]],null,17422,0,0,[["He survived an accident last year, but still drives recklessly.","他去年在事故中幸存了，可是他仍然很魯莽地開車。"]]],"reckon":[[["v.",["计算","总计","估计","认为","猜想"]]],"cet6 ky toefl ielts gre",8525,3,1,"3:reckons/p:reckoned/i:reckoning",[["I reckon he will be back soon.","我想他会很快回来的。"]]],"reclaim":[[["v.",["开垦","改造","感化","纠正","回收"]]],"cet6 ky toefl ielts gre",7452,1,0,"d:reclaimed/i:reclaiming/3:reclaims",[["With lofty aspirations, we long to feast on the flesh of the Hu invaders when hungry, and drink the blood of the Xiongnu enemies with laughter when thirsty. Awaiting the day when we can reclaim the lost lands, and present ourselves at the imperial court.","壮志饥餐胡虏肉，笑谈渴饮匈奴血。待从头、收拾旧山河，朝天阙。"]]],"reclamation":[[["n.",["开垦","教化"]],["",["经济上的复原再造"]]],"toefl",19656,0,0,"s:reclamations"],"recline":[[["v.",["使斜靠","靠","斜倚","依赖"]]],"ielts gre",15819,1,0,"i:reclining/p:reclined/3:reclines"],"recliner":[[["n.",["躺椅"]]],null,17943,0,0],"recluse":[[["adj.",["隐遁的","偏僻的"]],["n.",["隐遁者","遁世者"]]],"toefl gre",21060,0,0,"s:recluses"],"reclusive":[[["adj.",["隐遁的","隐居的"]]],null,17518,0,0],"recognise":[[["v.",["认识","辩认","认出","承认","认可"]]],"gk",0,0,0,"d:recognised/i:recognising/3:recognises",[["Qing Qing, a seven-year-old panda, can even recognise its name.","一隻七歲的熊貓－青青－甚至能認出它的名字。"]]],"recognition":[[["n.",["赞誉","认得","识别","承认","认可"]]],"cet4 cet6 ky toefl",2441,3,1,"s:recognitions",[["She gave me a smile of recognition.","她給了我一個認可的微笑。"]]],"recognizable":[[["adj.",["可认识的","可承认的","可识别的"]],["",["可被认出的","可辩认的","可被承认的"]]],null,8269,1,0],"recognize":[[["v.",["认出","认可","承认","公认","识别"],["be fully aware or cognizant of"]]],"cet4 cet6 ky toefl",779,4,1,"d:recognized/i:recognizing/3:recognizes",[["I wonder if she'll recognize me after all these years.","過了這麼多年，不知道她還認得我嗎？"]]],"recoil":[[["v.",["退却","畏缩","弹回","撤退","反冲"]],["n.",["畏缩","后退","弹回","反作用","后坐力"]]],"toefl gre",13083,1,0,"p:recoiled/3:recoils/i:recoiling"],"recollect":[[["v.",["回忆","回想","忆起"]]],"cet4 cet6 ky",17984,0,0,"p:recollected/3:recollects/i:recollecting"],"recollection":[[["n.",["记忆","回想","回忆"]]],"toefl gre",7880,0,0,"s:recollections",[["I have no recollection of seeing the man.","我沒有見過那男人的印象。"]]],"recombine":[[["v.",["再结合","重组"]]],"gre",26693,0,0,"i:recombining/d:recombined/s:recombines"],"recommend":[[["v.",["推荐","介绍","劝告","使受欢迎","托付"],["push for something"]]],"gk cet4 cet6 ky toefl",1688,4,1,"d:recommended/3:recommends/i:recommending",[["I don't recommend eating in that restaurant. The food is awful.","我不推荐在那家餐馆吃饭。食物糟糕透了。"]]],"recommendation":[[["n.",["推荐","介绍","