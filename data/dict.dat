,0],"reparation":[[["n.",["补偿","赔偿","弥补","修复","修理"]]],"gre",13025,1,0,"s:reparations"],"repartee":[[["n.",["机敏巧妙的回答","妙语","机智的反驳","巧辩","敏捷答辩的才能"]]],"gre",28110,0,0],"repatriate":[[["v.",["把...遣返","回国"]],["n.",["被遣返回国者"]]],"ielts gre",20545,2,0,"d:repatriated/i:repatriating/s:repatriates"],"repatriation":[[["n.",["遣送回国"]],["",["汇回本国"]]],null,15810,0,0,"s:repatriations"],"repay":[[["v.",["偿还","报答","报复"]]],"cet6 ky",7971,2,0,"d:repaid/i:repaying/3:repays",[["Lend money only to such as will repay it.","只借錢給會還錢的人。"]]],"repayment":[[["n.",["付还","偿还","报复","付还的钱"]]],null,14804,2,0,"s:repayments"],"repeal":[[["v.",["废止","撤消","放弃"]],["n.",["废止","撤消"]]],"cet6 gre",9535,1,0,"d:repealed/i:repealing/3:repeals"],"repeat":[[["v.",["重做","重复","复述","使再现","复制"],["to say, state, or perform again"]],["n.",["重复","反复"],["an event that repeats"]]],"zk gk cet4 cet6 ky toefl",1602,4,1,"p:repeated/i:repeating/3:repeats",[["I know I'm a burden; you don't have to repeat it.","我知道自己是个累赘，你没必要反复提。"]]],"repeatedly":[[["adv.",["重复地","再三地"]]],"cet4 cet6 ky",3245,0,1,[["I'm tossing and turning, repeatedly thinking about what happened today, deeply remorseful.","我辗转反侧，反复思考着白天发生的事，后悔不已。"]]],"repel":[[["v.",["逐退","抵制","使厌恶","抗御","相互排斥"]]],"cet6 ky toefl ielts gre",11198,1,0,"d:repelled/i:repelling/3:repels",[["The scent of cedar repels moths.","雪松的氣味可以驅趕飛蛾。"]]],"repellent":[[["adj.",["抵抗的","排斥的","令人讨厌的","防水的"]],["n.",["防水布","防护剂"]]],"gre",16746,1,0,"s:repellents"],"repent":[[["v.",["后悔","懊悔","忏悔"]],["adj.",["匍匐生根的"]]],"cet4 cet6 ky ielts gre",16583,0,0,"p:repented/3:repents/i:repenting",[["He repented having betrayed his country to the enemy.","他後悔對敵人出賣了他的國家。"]]],"repentance":[[["n.",["后悔","悔改","悔悟"]]],null,17103,0,0],"repercussion":[[["n.",["弹回","反响","反射"]],["",["消退","消肿","浮动诊胎法"]]],"gre",10805,1,0,"s:repercussions"],"repertoire":[[["n.",["全部剧目","全部技能","全部节目","全部作品"]]],"cet6 ky toefl ielts gre",7784,1,0,"s:repertoires",[["Her repertoire on the piano is not very large, but she has learned every piece by heart.","虽然在钢琴上她的造诣不是很深，但是她勤而好学。"]]],"repertory":[[["n.",["仓库","库存","储备","保留剧目轮演"]]],"toefl",13284,1,0,"s:repertories"],"repetition":[[["n.",["重复","背诵","循环","复制品","副本"]]],"cet4 cet6 ky toefl ielts",5821,1,0,"s:repetitions",[["Repetition is the mother of memory.","重复是记忆之母。"]]],"repetitive":[[["adj.",["重复的","反复性的"]]],"toefl",10127,1,0],"repine":[[["v.",["抱怨","发牢骚","向往"]]],"gre",0,0,0,"i:repining/p:repined/3:repines"],"replace":[[["v.",["代替","替换","放回","归还","DOS外部命令:取代或更新文件"],["substitute a person or thing for (another that is broken or inefficie…"]]],"gk cet4 cet6 ky toefl",1182,4,1,"d:replaced/i:replacing/3:replaces",[["Please replace the empty ink cartridge in the printer.","请把打印机里面的空的墨粉鼓换掉。"]]],"replacement":[[["n.",["归还","更换","代替者"]],["",["复位","置换"]]],"cet6 ky ielts",3656,0,0,"s:replacements",[["History develops through the replacement of the old by the new.","新事物取代旧事物推动历史发展。"]]],"replant":[[["v.",["改种","在...再植","使移居"]]],null,18649,0,0,"i:replanting/d:replanted/3:replants"],"replay":[[["v.",["重新比赛","重演"]],["n.",["重赛"]]],null,11529,2,0,"d:replayed/s:replays/i:replaying"],"replenish":[[["v.",["把...重新补足","把...再装满","被再装满","充满"]]],"toefl gre",12129,1,0,"d:replenished/i:replenishing/3:replenishes"],"replete":[[["adj.",["装满的","充满的","充实的","吃饱的"]]],"gre",13185,0,0,"s:repletes/r:more replete/t:most replete"],"replica":[[["n.",["复制品"]],["",["目录分区复制"]]],"toefl gre",9266,1,0,"s:replicas"],"replicate":[[["adj.",["复现的","复制的","折转的","弯回的"]],["v.",["折叠","折转","复制"]],["n.",["复现试验","复制品","高八度音"]]],"toefl",6621,1,0,"d:replicated/3:replicates/i:replicating",[["In London, my hotel was near the Barbican Centre. A memorable event was eating delicious fish and chips wrapped in newspaper, which back home, North Americans could not replicate. My favourite Brits are Olaf Stapledon and J.R.R. Tolkien, respectively a sci-fi writer and a fantasy writer. I have surveyed the British Isles via satellite imagery, and a really interesting area is southwestern England, where there are quaint towns and hamlets.","在倫敦，我住的飯店靠近巴比肯藝術中心。一次難忘的經驗是用報紙包著，吃美味的炸魚薯條，這在北美人家裡是無法複製的。我最喜…"]]],"replication":[[["n.",["回答","反响","复制","第二次答辩","折转"]]],null,12899,0,0,"s:replications"],"reply":[[["v.",["答复","回答","回击","反响","答辩"]],["n.",["答复","回答","答辩"]]],"zk gk cet4 cet6 ky",2219,4,1,"p:replied/s:replies/i:replying",[["She replied that she had never seen the man before.","她回答说她从来没有见过那个男人。"]]],"report":[[["v.",["报告","汇报","转述","报道","揭发"]],["n.",["报告","报道","传说","案情报告","爆炸声"],["a written document describing the findings of some individual or group"]]],"zk gk ielts",450,5,1,"d:reported/s:reports/i:reporting",[["The report proved true as a result of their investigation.","他們的調查結果顯示這篇報導是真實的。"]]],"reportage":[[["n.",["新闻报道","报告文学"]]],"gre",25757,0,0],"reportedly":[[["adv.",["根据传说","根据传闻","据报道"]]],null,4397,2,0],"reporter":[[["n.",["记者","报告者"],["a person who investigates and reports or edits news stories"]],["",["指示器"]]],"gk cet4 cet6 ky",1286,4,0,"s:reporters",[["The reporter elaborated on the method of his investigation.","报告者详尽地说明了他的研究方法。"]]],"reportorial":[[["adj.",["记者的","报道的"]]],"gre",33506,0,0],"repose":[[["v.",["使休息","寄托于","休息","长眠","静卧"]],["n.",["休息","睡眠","静止"]]],"gre",19187,0,0,"i:reposing/p:reposed/3:reposes"],"reposition":[[["n.",["复位","储藏"]],["v.",["改变...的位置","使...复位"]]],null,16232,0,0,"i:repositioning/p:repositioned/3:repositions"],"repository":[[["n.",["贮藏所","贮物器","仓库","博物馆","店铺"]]],"gre",11102,1,0,"s:repositories"],"repossess":[[["v.",["再拿到手","取回"]],["",["重新获得"]]],null,25355,1,0,"d:repossessed/i:repossessing/3:repossesses"],"repossession":[[["n.",["取回"]],["",["重新获得"]]],null,37231,1,0,"s:repossessions"],"reprehend":[[["v.",["申斥","谴责","非难"]]],"gre",0,0,0,"i:reprehending/p:reprehended/3:reprehends"],"reprehensible":[[["",["应受严责的","应受指责的","应受申斥的"]],["adj.",["应斥责的","应该谴责的"]]],"gre",17850,0,0,[["Shocked by the events of September 11th, politicians all over the world condemned the terrorists for their reprehensible deed.","911事件让世人震惊，全球所有的政治家都一致谴责恐怖分子的这一应受人斥责的行径。"]]],"represent":[[["v.",["表现","表示","描绘","讲述","代表"],["take the place of or be parallel or equivalent to"]]],"gk cet4 cet6 ky toefl ielts",687,4,1,"d:represented/3:represents/i:representing",[["He was accredited to the United States to represent Japan.","他被任命为驻美日本大使。"]]],"representation":[[["n.",["表示法","表现","陈述","代表"]],["",["表示法指定"]]],"cet6 toefl",2908,2,0,"s:representations",[["In its graphical representation, the normal distribution is a bell-shaped curve, with the value growing as one moves closer to the middle and decreasing as one moves away.","在图形上，正态分布是一种钟形曲线，越接近中心，取值越大，越远离中心，取值越小。"]]],"representational":[[["adj.",["代表的"]]],null,14423,0,0],"representative":[[["adj.",["描写的","表现的","代理的","代表的","代议制的"],["standing for something else"]],["n.",["代表","众议员","典型"],["a person who represents others"]]],"gk cet4 cet6 ky toefl ielts",1976,4,1,"s:representatives",[["For media inquiries, please contact your local communications or marketing representative.","如需媒體聯絡，請與當地客服中心或行銷團隊聯繫。"]]],"repress":[[["v.",["镇压","抑制","压制"]]],"ky toefl",13023,1,0,"i:repressing/d:repressed/3:represses"],"repressed":[[["adj.",["被镇压的","受约束的","被抑制的"]]],"gre",13398,0,0],"repression":[[["n.",["抑制","压抑","制止"]]],"ky",7683,0,0,"s:repressions"],"repressive":[[["adj.",["压抑的","抑制的","镇压的"]]],"ky",11423,1,0],"reprieve":[[["n.",["缓刑","缓刑令","暂缓"]],["v.",["暂时解救","缓期执行"]]],"gre",16877,1,0,"d:reprieved/i:reprieving/s:reprieves"],"reprimand":[[["n.",["谴责","惩戒","非难"]],["v.",["谴责","惩戒","严责"]]],"gre",14849,1,0,"d:reprimanded/s:reprimands/i:reprimanding",[["The manager reprimanded the man by pounding on the table.","經理以重擊桌子來斥責那名男子。"]]],"reprint":[[["n.",["再版","翻版","重印"]],["v.",["再版","翻版"]]],null,9243,1,0,"d:reprinted/s:reprints/i:reprinting"],"reprisal":[[["n.",["报复","报仇","报复性劫掠","复仇","报复性暴力为"]]],"gre",14937,1,0,"s:reprisals"],"reprise":[[["n.",["年金","重演","重复"]],["v.",["重演","重奏"]]],"gre",20996,1,0,"d:reprised/i:reprising/3:reprises"],"reproach":[[["v.",["责备","申斥","使丢脸"]],["n.",["责备","耻辱"]]],"cet4 cet6 ky toefl ielts gre",18288,1,0,"p:reproached/s: