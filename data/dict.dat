,2558,2,0,"s:disabilities",[["A portion of the proceeds will go to benefit children with disabilities.","我們會把一部分籌得的款項用來幫助殘疾兒童。"]]],"disable":[[["v.",["使失去能力","使残废","(律)使无资格"]],["",["使无效","禁止","关闭"]]],"cet4 cet6 ky ielts",11005,1,0,"d:disabled/i:disabling/3:disables",[["A sprained ankle disabled him from walking for a month.","他把足踝扭傷了，整整一個月不能走路。"]]],"disabled":[[["adj.",["残废的","有缺陷的","失效的"]]],"gk ielts",4412,2,1,[["A sprained ankle disabled him from walking for a month.","他把足踝扭傷了，整整一個月不能走路。"]]],"disabuse":[[["v.",["解迷惑","使省悟"]]],"gre",28116,0,0,"d:disabused/i:disabusing/3:disabuses"],"disadvantage":[[["n.",["缺点","不利","坏处"]]],"gk cet4 cet6 toefl",6291,2,1,"s:disadvantages/d:disadvantaged/i:disadvantaging",[["The comparison between the two was to his disadvantage.","两相比较，他那边的形势更不利一些。"]]],"disaffect":[[["v.",["使疏远","使不忠","使不满意"]]],"gre",0,0,0,"i:disaffecting/p:disaffected/3:disaffects"],"disagree":[[["",["抵触","不同意","争执"]],["v.",["不一致","不适宜"]]],"gk cet4 cet6",2679,2,1,"p:disagreed/3:disagrees/i:disagreeing",[["I have no difficulty finding people who disagree with you.","我找跟您意見相左的人毫無困難。"]]],"disagreeable":[[["adj.",["令人不快的","厌恶的","不合意的"]]],"toefl gre",19879,0,0,[["Tom is one of the most disagreeable people I know.","Tom是我認識最討厭的人之一。"]]],"disagreement":[[["n.",["不合","争论","不一致","不同意","陪审团的意见不一"]]],"gk cet6 ielts",5117,2,1,"s:disagreements",[["It's clear that there's a rather strong disagreement between the two.","很明顯的是這兩者之間有很強烈的分歧。"]]],"disallow":[[["v.",["不许","不准","驳回"]],["",["拒绝接受","拒绝承认","不允许"]]],"toefl",20751,1,0,"d:disallowed/i:disallowing/3:disallows"],"disappear":[[["v.",["消失","不见"],["get lost, as without warning or explanation"]]],"gk cet4 cet6 ky",1578,3,1,"p:disappeared/3:disappears/i:disappearing",[["The fog began to disappear around ten o'clock.","霧在十時左右開始散了。"]]],"disappearance":[[["n.",["看不见","失踪","消失"]]],"cet6",6530,1,0,"s:disappearances",[["We have to look into the disappearance of the doctor.","我们必须调查医生的失踪案。"]]],"disappoint":[[["v.",["使失望"]]],"gk cet4 cet6 ky