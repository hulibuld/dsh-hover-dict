ant.","我吃不起这么贵的餐馆。"]]],"affordability":[[["n.",["支付能力","负担能力","可购性"]]],null,18327,0,0],"affordable":[[["",["普及型"]]],"toefl gre",5234,1,0,[["The laptop provides cutting-edge technology at an affordable price.","這款筆記型電腦價格親民，技術領先。"]]],"affront":[[["v.",["公开侮辱","冒犯","面对"]],["n.",["公开侮辱","轻蔑"]]],"gre",16245,1,0,"d:affronted/s:affronts/i:affronting",[["Placing a restriction on the number of example sentences that non-native speakers can offer in English is an affront to their intelligence and the significant efforts they make to contribute to this collaborative project.","限制非母語人士可提供的英文例句數量，是在侮辱他們的智力，和對合作專案做出的巨大努力。"]]],"aficionado":[[["n.",["狂热爱好者","迷"]]],null,14340,0,0,"s:aficionados"],"afield":[[["adv.",["离开着","偏离着","在战场上"]]],null,17251,1,0],"afire":[[["adj.",["燃烧的","炽烈的"]],["adv.",["燃烧着"]]],null,19880,0,0],"afloat":[[["adj.",["飘浮着的","在海上的","浸满水的","在进行中的"]],["adv.",["飘浮着","在海上","浸满水","在进行中"]]],null,11249,1,0],"afoot":[[["adj.",["徒步的","在进行中的","活动中的"]],["adv.",["徒步","在进行中"]]],null,17330,1,0],"aforementioned":[[["adj.",["上述的","前述的","前面提到过的"]]],null,12169,1,0],"afraid":[[["adj.",["害怕的","恐怕的","遗憾的"],["filled with fear or apprehension"]]],"zk gk",1400,3,1,[["He said that he was afraid it would be rainy.","他说他怕天会下雨。"]]],"africa":[[["n.",["非洲"]]],"gk cet4 ielts",0,0,0,[["The Zulu tribe in South Africa has its own language.","南非的祖魯族人有著自己獨特的語言。"]]],"african":[[["adj.",["非洲的","非洲人的"],["of or relating to the nations of Africa or their peoples"]],["n.",["非洲人"],["a native or inhabitant of Africa"]]],"gk cet4 ielts",1203,0,0,"s:africans",[["The African ground squirrels collaborate and are not aggressive to other mammals.","非洲地松鼠互帮互助，对其他哺乳动物没有攻击性。"]]],"afro":[[["n.",["Afros 非洲式发型"]]],null,23718,1,0,"s:afros"],"afro-caribbean":[[["",["加勒比黑人的"]]],null,0,1,0],"aft":[[["",["现用文件表","自动存款取款"]],["adv.",["在船尾"]]],null,16006,1,0,"s:afts"],"after":[[["prep.",["在...之后","由于"]],["conj.",["在...之后"]],["adv.",["后来"]]],"zk gk",120,5,1,[["I read the book after I had finished my homework.","我做完我的功课后，就读这本书