":[[["n.",["衍射"]]],null,19953,0,0],"diffuse":[[["v.",["散播","传播"]],["adj.",["散开的","弥漫的"]]],"cet6 ky toefl ielts gre",12366,1,0,"d:diffused/3:diffuses/i:diffusing"],"diffusion":[[["n.",["散播","传播","蔓延"]],["",["扩散","弥散","漫射(光)"]]],"toefl",11051,0,0,"s:diffusions"],"dig":[[["v.",["挖","翻土","发掘","挖掘"]],["",["数字","数位"]],["n.",["挖掘"]]],"zk gk",2460,3,1,"p:dug/i:digging/3:digs",[["You are always digging at me about my clothes.","你总是挖苦我的着装。"]]],"digest":[[["v.",["消化","理解"]],["n.",["文摘"]],["",["摘要"]]],"gk cet4 cet6 ky toefl ielts",9447,2,0,"d:digested/i:digesting/3:digests",[["Food you eat that you don't like will not be digested well.","你吃不喜歡的食物會消化不良。"]]],"digestion":[[["",["消化","消化作用","蒸煮","蒸煮作用","煮解"]],["n.",["消化力","领悟"]]],"toefl gre",13954,1,0,"s:digestions",[["Don't eat too much and disrupt the stomach's normal digestion process.","不要因为吃得太多而扰乱胃的正常消化。"]]],"digestive":[[["adj.",["消化的","助消化的"]],["n.",["助消化药"]]],"toefl",11925,1,0,"s:digestives"],"digger":[[["n.",["挖掘者"]]],null,16976,1,0,"s:diggers",[["Idiot! She's not being honest when she says she loves you. Haven't you figured it out yet? She's just a gold digger.","笨蛋！她说她爱你不是真心的。还没有发现吗？她只是钓凯子的。"]]],"digit":[[["n.",["数字","位数","指头"]],["",["数位","位"]]],"gre",8519,1,0,"s:digits",[["Hey, give me your digits. I will tell you about the seaside and the stars.","嘿，把你的電話號碼給我。我會跟你講講海邊和星星的故事。"]]],"digital":[[["adj.",["数字显示的","数字的"]],["n.",["数字仪表","数字式电子表(或时钟)"]],["",["数字","数字式"]]],"gk cet4 cet6 ky ielts",2356,2,0,[["My father bought me a digital watch for birthday present.","我爸爸送了一塊電子錶給我作為生日禮物。"]]],"digitally":[[["adv.",["数位"]]],null,16090,0,0,[["The image was digitally altered.","這張圖片經過數位修改。"]]],"digitize":[[["v.",["使成为数字","使计数化","使数字化"]],["",["数字化"]]],null,17645,0,0,"d:digitized/i:digitizing/3:digitizes"],"dignify":[[["v.",["增威严","使高贵","故作显贵"]]],"toefl",25877,0,0,"i:dignifying/3:dignifies/p:dignified",[["You look very dignified.","你看起來很威嚴。"]]],"dignitary":[[["n.",["高贵的人","高官","高僧","要人"]]],"gre",13805,1,0,"s:dignitaries",[["To strengthen his position, Tom surrounded himself with intellectuals and church dignitaries, one of whom was Brother John.","為了鞏固自己的地位，湯姆身邊聚集了一群知識分子和教會要員，其中一位就是約翰弟兄。"]]],"dignity":[[["n.",["尊严","高贵","高位"]]],"gk cet6 ky toefl ielts gre",4100,2,0,"s:dignities",[["Your action has offended his dignity.","你的行為已經冒犯了他的尊嚴。"]]],"digress":[[["v.",["走向岔道","离题","扯到枝节上"]]],"toefl gre",24122,0,0,"i:digressing/d:digressed/3:digresses"],"digression":[[["n.",["离题","扯到枝节上","偏离"]]],"toefl gre",21375,0,0,"s:digressions"],"dike":[[["n.",["堤防"]],["v.",["筑堤防护"]]],null,17546,0,0,"s:dikes/p:diked/i:diking"],"dilapidate":[[["v.",["(使)荒废","(使)毁坏"]]],"gre",0,0,0,"i:dilapidating/p:dilapidated/3:dilapidates",[["Carol Wick and her husband own a small slice of the American dream, 12 hectares at the edge of the Cascade foothills, southeast of Seattle, Washington. A short walk from her doorstop, past some pastures and a dilapidated barn, is the fir and cedar forest that covers about one-third of her property.","卡羅爾威克和她的丈夫擁有美國人都夢想的一小塊土地，位於華盛頓州西雅圖東南部的喀斯喀特山麓邊緣，佔地 12 公頃。從她家…"]]],"dilapidation":[[["n.",["荒废","破损","崩塌"]],["",["倒塌","毁坏"]]],"gre",40504,0,0,"s:dilapidations"],"dilate":[[["v.",["扩大","详述","膨胀","使膨胀"]]],"toefl ielts gre",18343,1,0,"p:dilated/i:dilating/3:dilates"],"dilatory":[[["",["延期的","拖延的","慢的"]],["adj.",["拖拉的"]]],"gre",32015,0,0],"dilemma":[[["n.",["困境","(进退两难的)窘境"]]],"gk cet6 ky toefl ielts gre",4118,2,0,"s:dilemmas",[["This is the dilemma.","这就是抉择所在。"]]],"dilettante":[[["adj.",["外行的","浅薄的"]],["n.",["业余爱好者"]]],"gre",27819,0,0,"s:dilettanti"],"diligence":[[["n.",["勤奋"]]],"cet6 gre",14741,0,0,[["Her diligence is a good example to us all.","她的用功对我们所有人是一个好的榜样。"]]],"diligent":[[["adj.",["勤勉的","用功的"]]],"cet4 cet6 ky toefl ielts",14139,1,0,[["People say he was really diligent when he was young.","人們說他年輕時很勤力工作。"]]],"diligently":[[["adv.",["勤奋地","勤勉地"]]],"toefl",13952,0,0],"dill":[[["n.",["莳萝","莳萝叶"]],["",["莳罗"]]],null,15830,1,0,"p:dilled"],"dilute":[[["v.",["冲淡","稀释"]],["adj.",["淡的","稀释的"]]],"cet6 ky toefl ielts gre",9506,2,0,"d:diluted/i:diluting/3:dilutes"],"dilution":[[["n.",["冲淡","淡度","稀度","稀释物","冲淡物"]],["",["稀释度的"]]],"toefl",18805,0,0,"s:dilutions"],"dim":[[["adj.",["暗淡的","模糊的"]],["v.",["使暗淡"]],["",["数据解释模块"]]],"cet4 cet6 ky toefl ielts gre",5733,2,0,"d:dimmed/r:dimmer/i:dimming/t:dimmest/3:dims",[["You shouldn't read a book in a room this dim.","你不應該在這麼暗的房間裏看書。"]]],"dime":[[["n.",["10分硬币(美、加)"]]],"toefl",7518,1,0,"s:dimes",[["He who is born for a dime, will never be worth a quarter.","出生是一分錢，永遠不會變成一角錢。"]]],"dimension":[[["n.",["尺寸","次元","面积","维数"]],["v.",["标出尺寸"]]],"gk cet4 cet6 ky toefl ielts gre",2420,2,0,"s:dimensions/d:dimensioned/i:dimensioning",[["That Space, as our mathematicians have it, is spoken of as having three dimensions, which one may call Length, Breadth, and Thickness, and is always definable by reference to three planes, each at right angles to the others.","正如我们的数学家所言，这个空间有三个维度，可称之为长度，宽度和厚度，并且始终可以通过参考三个平面来定义，每个平面彼此成…"]]],"dimensional":[[["",["量纲的","因次的"]],["adj.",["...维的"]]],"toefl",18602,0,0],"diminish":[[["v.",["(使)减少","(使)变小"]]],"cet6 ky toefl ielts",3958,2,0,"d:diminished/3:diminishes/i:diminishing",[["This inner conflict tends to diminish as the years go by.","這種內心的衝突往往會隨著歲月流逝而平息。"]]],"diminuendo":[[["n.",["渐弱演奏(部分)"]],["adj.",["渐弱的"]],["adv.",["渐弱地"]]],"gre",43668,0,0,"s:diminuendos"],"diminution":[[["n.",["减少","缩小","减低","减小"]]],"gre",21683,0,0,"s:diminutions"],"diminutive":[[["adj.",["小的","小型的","指小的"]],["n.",["身材极小的人","指小词","爱称"]]],"toefl",14330,1,0,"s:diminutives"],"dimly":[[["adv.",["微暗","朦胧"]]],"toefl",11736,0,0],"dimple":[[["n.",["酒窝","涟漪"]],["v.",["使起涟漪"]]],"gre",16600,0,0,"s:dimples/i:dimpling/p:dimpled"],"din":[[["v.",["絮絮不休地说","喧闹"]],["n.",["喧嚣"]]],"ielts gre",13151,1,0,"d:dinned/s:dins/i:dinning"],"dine":[[["v.",["用正餐","进餐","宴请"]]],"gk cet6 ky ielts",7360,2,0,"p:dined/i:dining/3:dines",[["Sorry, I was dining and I didn't see the message.","抱歉，我刚才在吃饭，没有看到信息。"]]],"diner":[[["n.",["用餐者"]]],null,5956,1,0,"s:diners"],"dinghy":[[["n.",["小船","橡皮筏","小艇"]]],null,21132,1,0,"s:dinghies"],"dingy":[[["adj.",["暗淡的","昏暗的","邋遢的"]]],"toefl ielts gre",14979,0,0,"s:dingies/t:dingiest/r:dingier"],"dining":[[["n.",["正餐","宴会"]]],"ielts",2952,0,0,[["Sorry, I was dining and I didn't see the message.","抱歉，我刚才在吃饭，没有看到信息。"]]],"dinner":[[["n.",["晚餐","正餐","宴会"],["the main meal of the day served in the evening or at midday"]]],"zk gk ielts",1076,4,1,"s:dinners",[["Dinner is ready, so we can eat whenever we want.","晚餐已經準備好了，我們可以隨時開始吃。"]]],"dinnertime":[[["n.",["正餐时间"]]],null,19301,0,0,"s:dinnertimes",[["It's not dinnertime yet.","现在还不是晚饭时间。"]]],"dinosaur":[[["n.",["恐龙"]]],"gk toefl",5326,2,0,"s:dinosaurs",[["Coming face to face with a dinosaur was a funny experience.","和一只恐龙面对面是一段有趣的经历。"]]],"diocesan":[[["adj.",["主教管区的"]],["n.",["教区主教"]]],"gre",18516,0,0,"s:diocesans"],"diocese":[[["n.",["主教教区"]]],null,9791,1,0,"s:dioceses"],"dioxide":[[["n.",["二氧化物"]]],"gk cet6 toefl ielts",5712,0,0,"s:dioxides",[["Trees give off oxygen and absorb carbon dioxide.","树木排出氧气，吸收二氧化碳。"]]],"dioxin":[[["n.",["二氧(杂)芑"]]],null,18120,0,0,"s:dioxins"],"dip":[[["v.",["浸","降下","把(手、勺等)伸入","舀取"]],["",["双列直插式组件","分布式输入输出系统","双排直插封装"]],["n.",["浸","涉猎"]]],"gk cet4 cet6 ky ielts",4532,2,0,"p:dipped/i:dipping/s:dips",[["The tip of the spear was dipped in a deadly poison.","矛尖浸在一種致命的毒藥裡。"]]],"diploma":[[["n.",["文凭","毕业证书"]]],"gk cet6 ky ielts",8453,1,0,"s:diplomas",[["The principal presented each of the graduates with diploma.","校长向每个毕业生颁发了毕业证书。"]]],"diplomacy":[[["n.",["外交","外交手腕","交际手段","权谋"]]],"toefl",5638,2,0,[["International problems must be solved by diplomacy, not war.","国际问题必须靠外交而非战争解决。"]]],"diplomat":[[["n.",["外交官","有外交手腕的人","外交家","有权谋的人"]]],"ky ielts",4918,3,0,"s:diplomats",[["He is a diplomat at the American Embassy.","他是美国大使馆的外交官。"]]],"diplomatic":[[["adj.",["外交的","老练的","外交上的","文献上的"]]],"cet6 ky toefl ielts gre",3940,3,0,[["There must be a way to arrive at a diplomatic solution.","必须有外交解决的途径。"]]],"diplomatically":[[["adv.",["在外交上","靠外交途径","凭