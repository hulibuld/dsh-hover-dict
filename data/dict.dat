d Skura's voice.","他聽到斯庫拉的聲音，便來了精神。"]]],"perky":[[["adj.",["得意洋洋的","快活的","敏捷的","美观的","傲慢的"]]],"gre",18469,0,0,"r:perkier"],"perm":[[["n.",["电烫的头发","卷发","化学烫的头发"]],["v.",["电烫(发)","化学烫(发)"]]],null,25214,1,0,"s:perms/d:permed/i:perming"],"permanence":[[["n.",["永久","持久","固定性"]],["",["永久性","持久性"]]],"gre",15791,0,0],"permanent":[[["adj.",["永久的","不变的","固定的","持久的"]],["n.",["烫发"]]],"gk cet4 cet6 ky toefl ielts gre",2464,3,1,[["A permanent job is better than a temporary one.","正式工比临时工要好。"]]],"permanently":[[["adv.",["永久","不变","持久"]],["",["永久性的"]]],"cet4 cet6",5676,0,1,[["Alert, in Nunavut, Canada, is the northernmost permanently inhabited place in the world.","加拿大努納武特地區的阿勒特是世界上最北端的永久居住地。"]]],"permeable":[[["adj.",["有渗透性的","能透过的"]],["",["渗透性的","可渗透的"]]],"toefl gre",22049,0,0],"permeate":[[["v.",["弥漫","渗透","充满","影响","感染"]]],"cet6 ky toefl ielts gre",9622,1,0,"3:permeates/p:permeated/i:permeating",[["The air was permeated by the smell of the sea.","空氣中充斥著海的氣息。"]]],"permissible":[[["adj.",["可允许的","可容许程度的"]],["",["容许","允许"]]],"cet6 toefl ielts",12774,1,0],"permission":[[["n.",["许可","允许","认可"]]],"gk cet4 cet6 ky toefl",3233,3,1,"s:permissions",[["The teacher granted me permission to go home early.","老師允許我提前回家。"]]],"permissive":[[["adj.",["许可的","获准的","宽容的","放任的","放纵的"]],["",["表示许可的","随意的","纵容的"]]],"toefl gre",18103,0,0,"s:permissives"],"permit":[[["v.",["允许","容许","可能","使放手做","给以机会"]],["n.",["许可证","许可","执照","通行证"]]],"gk cet4 cet6 ky toefl ielts",2109,3,1,"d:permitted/3:permits/i:permitting",[["Do you think Tom will permit Mary to do that?","你认为汤姆会允许玛丽这么做吗？"]]],"pernicious":[[["adj.",["有害的","致命的","恶劣的","险恶的"]],["",["恶性的"]]],"gre",15964,1,0],"peroxide":[[["n.",["过氧化物"]]],null,18939,0,0,"s:peroxides/i:peroxiding/p:peroxided"],"perpendicular":[[["n.",["垂直线","垂直的位置","直立(姿势)","刚正","垂规"]],["adj.",["垂直的","直立的","陡峭的"]]],"cet6 toefl ielts gre",13882,0,0],"perpetrate":[[["v.",["做(恶)","犯(罪)","胡说","恶劣地做"]],["",["犯","作","行"]]],null,11913,1,0,"d:perpetrated/i:perpetrating/3:perpetrates"],"perpetrator":[[["n.",["作恶者","犯罪者","行凶者"]]],null,7912,0,0,"s:perpetrators"],"perpetual":[[["adj.",["永久的","不断的","无期限的","没完没了的","四季开花的"]],["",["永远的","终身的","持续的"]]],"cet6 ky ielts gre",8766,1,0,"s:perpetuals",[["The idea of perpetual motion is an absurd hypothesis.","永动机这个概念是个荒唐的假说。"]]],"perpetually":[[["adv.",["永恒地","持久地"]]],null,13089,0,0],"perpetuate":[[["v.",["使永存","使不朽","保持"]]],"toefl gre",7642,1,0,"d:perpetuated/i:perpetuating/3:perpetuates",[["Lonely people perpetuate their own loneliness through their fear of others.","孤獨的人會孤獨，是因為他畏懼他人。"]]],"perplex":[[["v.",["使困惑","使复杂化","使为难","困惑","使纠缠不清"]]],"cet6 ky toefl ielts",15354,0,0,"d:perplexed/i:perplexing/3:perplexes",[["He said with a perplexed expression, \"I've heard nothing, so I can't say anything.\"","他的目光十分困惑：「我甚麼也沒聽過，所以甚麼也說不出來。」"]]],"perplexity":[[["n.",["困惑","混乱状态","使人困惑的事物"]]],"ielts",24153,0,0,"s:perplexities"],"perquisite":[[["n.",["额外补贴","特殊待遇","外快","奖金","小费"]]],"gre",28632,0,0,"s:perquisites"],"persecute":[[["v.",["迫害","虐待","困扰","同...捣乱","烦扰"]]],"cet6 ky ielts gre",12900,1,0,"d:persecuted/i:persecuting/3:persecutes",[["They were persecuted.","他們受到迫害。"]]],"persecution":[[["n.",["虐待","迫害运动","迫害","烦扰","困扰"]]],null,8852,0,0,"s:persecutions",[["In spite of the tyrant’s persecution, the hero valiantly carried on the struggle.","尽管受到暴君的迫害，英雄还顽强地斗争。"]]],"perseverance":[[["n.",["毅力","忍耐","锲而不舍","不屈不挠"]]],"ky toefl",13573,0,0,[["Perseverance, as you know, is the key to success.","就像你们知道的那样，毅力是成功的关键。"]]],"persevere":[[["v.",["坚持","孜孜不倦","不屈不挠","(辩论中)固执己见"]]],"cet6 ky toefl ielts",13798,1,0,"p:persevered/3:perseveres/i:persevering"],"persian":[[["n.",["波斯人","波斯语"]]],null,4526,0,0,"s:persians",[["A Persian cat was sleeping under the table.","波斯猫在桌子下面睡觉。"]]],"persiflage":[[["n.",["戏弄","插科打诨","嘲弄","挖苦"]]],"gre",0,0,0],"persist":[[["v.",["坚持","固执","持续","坚称"]]],"cet4 cet6 ky toefl ielts",4351,2,0,"p:persisted/3:persists/i:persisting",[["She persists in saying that her analysis is correct.","她坚持认为自己的分析是正确的。"]]],"persistence":[[["n.",["固执","坚持不懈","持续(性)","存留(状态)"]],["",["持久"]]],"cet6 toefl gre",7491,0,0],"persistent":[[["adj.",["固执的","坚持的","持续的","作用持久的"]]],"cet6 toefl",5269,2,0,[["Be patient and persistent. These things take time.","耐心地坚持下去，这些事急不来。"]]],"persistently":[[["adv.",["坚持地","固执地","一个劲儿"]]],null,16076,0,0,[["The telephone on my desk rang persistently and loudly.","我桌上的电话一直大声响铃。"]]],"persnickety":[[["adj.",["爱挑剔的","吹毛求疵的","精细的"]]],"gre",35792,0,0],"person":[[["n.",["人","人身","人称","法人"],["a human being"]]],"zk gk ielts",345,5,1,"s:persons",[["The only person who's looking forward to Miss Cobb's return.","期望 Cobb 小姐回來的唯一一人。"]]],"persona":[[["n.",["人","人物","角色","外表印象","人格面具"]],["",["伪装人格"]]],null,7526,1,0,"s:personas"],"personable":[[["adj.",["风度好的","讨人喜欢的","具有行为能力的"]]],"gre",19125,0,0],"personage":[[["n.",["重要人士","显要","名士","人物","角色"]]],"gre",19862,0,0,"s:personages"],"personal":[[["adj.",["私人的","涉及隐私的","有人性的","人称的","亲自的"],["concerning or affecting a particular person or his or her private lif…"]],["",["人的","个人的","自身的"],["particular to a given individual"]]],"zk gk cet4 cet6 ky ielts",580,4,1,[["I have to make money to buy a personal computer.","必須要賺錢才能買一台個人計算機。"]]],"personality":[[["n.",["个性","人格","(团体、地方、国家)特有特性","名人"]]],"cet4 cet6 ky toefl ielts",2076,3,1,"s:personalities",[["I get a kick out of her cheerful personality.","她開朗的個性使我覺得快樂。"]]],"personalize":[[["v.",["(贬)使个人化","体现","使人格化","在(物品)上标明姓名/标出地址/标出记号"]]],null,13434,1,0,"p:personalized/i:personalizing/3:personalizes"],"personalized":[[["adj.",["个人化的","个性化的"]]],null,13175,0,0],"personally":[[["adv.",["亲自地","个别地","当面","就本人而言","针对个人地"]]],"gk",2633,3,1,[["James Cameron personally did the official promotion!","卡神親自官宣！"]]],"personification":[[["n.",["拟人","人格化","拟人法","化身","象征"]]],"gre",17240,0,0,"s:personifications"],"personify":[[["v.",["看做人","赋与人性","使人格化","体现","是...的化身"]]],null,14127,1,0,"d:personified/3:personifies/i:personifying"],"personnel":[[["n.",["人员","人事部门","人事科(处)"]],["",["人事","全体人员","职工"]]],"gk cet4 cet6 ky toefl ielts gre",2425,3,0],"perspective":[[["n.",["远景","透视感","(观察问题的)视角","透视法","看法"],["the appearance of things relative to one another as determined by the…"]],["adj.",["透视的","透视法的"]],["",["透视"]]],"cet4 cet6 ky toefl ielts gre",1412,3,0,"s:perspectives",[["We need at least one policymaker on the committee to provide the perspective of someone who can help make decisions about the research.","我們需要至少一個關於委員會的政策制定者，提供有助於做出關於該研究的決策者觀點。"]]],"perspicacious":[[["adj.",["聪颖的","聪明的","敏锐的","有洞察力的"]]],"gre",37165,0,0],"perspicuity":[[["n.",["明晰","明了","简明","表达清楚","易懂"]]],"gre",0,0,0],"perspicuous":[[["adj.",["表达得清楚的","明白的","明了的"]]],"gre",0,0,0],"perspiration":[[["n.",["汗","流汗","努力","出汗"]]],"cet6 toefl",14005,0,0],"perspire":[[["v.",["出汗","流汗","分泌","渗出"]]],"toefl ielts gre",22564,0,0,"i:perspiring/p:perspired/3:perspires"],"persuade":[[["v.",["劝","使相信","恳求","敦促","说服"]]],"gk cet4 cet6 ky toefl",3265,3,1,"d:persuaded/i:persuading/3:persuades",[["You tried to persuade Tom to do that, didn't you?","你之前试着劝过汤姆去做那件事，对吧？"]]],"persuasion":[[["n.",["说服","信念","派别","说服力"]]],"cet6 ky",9532,1,0,"s:persuasions",[["I was born into the Hebrew persuasion, but when I got older I converted to narcissism.","我天生是猶太人，但當我年紀大了的時候，我把它轉換成了自戀。"]]],"persuasive":[[["adj.",["有说服力的","劝诱的","劝导性的"]]],"toefl",8672,1,0,[["The weak point of this book is that it's less than persuasive when the married author recommends not being married.","這本書有一個弱點 ﹣ 作者自己結了婚，但卻建議別人不要結婚，沒有甚麼說服力。"]]],"pertain":[[["v.",["从属于","关于","涉及","附属","适合"]]],"ielts gre",12205,1,0,"i:pertaining/3:pertains/p:pertained"],"pertinacious":[[["adj.",["坚持不放的","执拗的","顽固的","顽强的","(疾病)难以治好的"]]],"gre",0,0,0],"pertinent":[[["adj.",["相关的","中肯的","切题的"]],["",["恰当的","有关的"]]],"cet6 toefl ielts gre",9895,1,0],"perturb":[[["v.",["扰乱","使混乱","使心绪不宁"]]],"toefl ielts",21889,0,0,"d:perturbed/3:perturbs/i:perturbing"],"perturbation":[[["n.",["不安","扰乱","紊乱","烦扰"]],["",["摄动","微扰"]]],null,19948,0,0,"s:perturbations"],"peruse":[[["v.",["熟读","精读","阅读","仔细研究"]]],"gre",14432,0,0,"i:perusing/d:p