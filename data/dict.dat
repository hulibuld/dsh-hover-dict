 winter's flaw!","不，說真的，一點也不；但要循著合理的推論、憑著適度的謹慎 / 跟隨他到那裡，就像這樣：亞歷山大死了，/ 亞歷山大被埋葬…"]]],"loan":[[["v.",["借","供应货款","借给"]],["n.",["贷款","借出"],["the temporary provision of money (usually at interest)"]]],"cet4 cet6 ky toefl ielts",1699,4,1,"s:loans/d:loaned/i:loaning",[["The IMF ruled out any new loans to that country.","国际货币基金组织不考虑再借款给该国。"]]],"loath":[[["adj.",["不情愿的","厌恶的"]]],"toefl ielts gre",16958,0,0,"s:loaths"],"loathe":[[["v.",["厌恶","憎恶"]]],"toefl gre",12607,1,0,"p:loathed/3:loathes/i:loathing",[["I loathe the new president.","我厭惡這位新總統。"]]],"loathing":[[["n.",["非常讨厌","嫌恶","极不情愿"]]],null,17265,0,0],"loathsome":[[["adj.",["讨厌的","可恶的","令人憎恶的"]]],"toefl",22172,0,0,"t:loathsomest"],"lob":[[["v.",["把球挑高","蹒跚地走"]],["n.",["笨人","高球"]]],null,17549,1,0,"p:lobbed/i:lobbing/s:lobs"],"lobby":[[["n.",["大厅","休息室","游说议员者"]],["v.",["游说议员","游说"]]],"cet6 ky toefl ielts gre",3736,3,0,"s:lobbies/i:lobbying/d:lobbied",[["I have a friend waiting for me in the lobby.","有個朋友正在大堂等我。"]]],"lobbyist":[[["n.",["说客"]],["",["院外活动集团成员"]]],null,5317,0,0,"s:lobbyists",[["Lobbyists for the bill funneled bribes into a campaign fund.","該法案的說客把遊說賄款匯入了競選基金。"]]],"lobe":[[["n.",["叶","耳垂","裂片"]]],"gre",11517,1,0,"s:lobes/p:lobed",[["I wonder what ear lobes are for.","我好奇耳垂有什么作用。"]]],"lobster":[[["n.",["龙虾"]]],"toefl",6212,1,0,"s:lobsters",[["The sight of fresh lobster gave me an appetite.","看见新鲜龙虾，我有了食欲。"]]],"local":[[["adj.",["地方性的","当地的","局部的","乡土的","本地的"],["relating to or applicable to or concerned with the administration of …"]],["n.",["当地居民","本地新闻","局部"],["public transport consisting of a bus or train that stops at all stati…"]]],"gk cet4 cet6 ky ielts",423,5,1,"s:locals",[["Many local traditions have fallen into decay in recent years.","近几年，很多当地的传统都衰败了。"]]],"locale":[[["n.",["现场","场所"]]],"gre",9800,0,0,"s:locales"],"locality":[[["n.",["地方","所在","位置","场所","地区"]]],"cet6 ky toefl ielts",11068,1,0,"s:localities"],"localize":[[["v.",["vi. 使地方化","使具有地方性","使限制于局部","确定起源","集中"]],["",["局部化","定位","定域"]]],null,1861