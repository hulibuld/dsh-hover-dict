s sure.","要想成功只需要无知和自信。"]]],"confident":[[["adj.",["有信心的","有把握的"]]],"gk cet4 cet6 ky toefl ielts",2866,3,1,[["I'm fairly confident that I can do that.","我相当有自信我能做到这一点。"]]],"confidential":[[["adj.",["机密的","获他人信赖的","易于信任他人的"]],["",["秘密件"]]],"gk cet6 ky toefl ielts gre",7010,2,0,[["It's confidential.","这是机密。"]]],"confidentiality":[[["",["机密性","保密"]]],null,9034,0,0],"confidently":[[["adv.",["自信地","安心地"]]],null,10966,0,1],"configuration":[[["n.",["结构","表面配置","外形","配置"]]],"cet6 toefl ielts gre",6153,1,0,"s:configurations"],"configure":[[["v.",["装配","使成形"]]],null,13210,0,0,"d:configured/i:configuring/3:configures",[["I need to configure this server with an appropriate firewall system.","我该在这个服务器上设置一个防火墙。"]]],"confine":[[["v.",["限制","使不外出","禁闭","邻接","交界"]],["n.",["边缘","范围","区域"]]],"cet4 cet6 ky toefl ielts gre",5337,2,1,"d:confined/s:confines/i:confining",[["He is confined to bed now.","他现在卧床不起。"]]],"confinement":[[["n.",["限制","被禁闭","分娩","生产"]]],"toefl",10696,1,0,"s:confinements"],"confirm":[[["v.",["证实","确定","批准","使巩固"],["establish or strengthen as with new evidence or facts"]],["",["确认"]]],"gk cet4 cet6 ky toefl ielts gre",1851,4,1,"d:confirmed/3:confirms/i:confirming",[["Can you confirm that it is a correctable error?","你确认那是可纠正的错误吗？"]]],"confirmation":[[["n.",["证实","证明","批准","确认"]]],"cet6 toefl ielts",5360,0,0,"s:confirmations",[["Do not make any modifications before you get confirmations.","在得到确认之前不要进行任何修改。"]]],"confiscate":[[["v.",["没收","把...充公","查抄"]],["adj.",["被没收的"]]],"toefl gre",10551,1,0,"d:confiscated/i:confiscating/3:confiscates",[["The teacher confiscated a student's phone because he was texting in class.","老师没收了一个学生的手机，因为他在课上发短信。"]]],"conflagration":[[["n.",["大火灾","大火","冲突"]],["",["暴燃","快速燃烧"]]],"gre",19480,0,0,"s:conflagrations"],"conflate":[[["v.",["合并","异文合并"]]],"gre",19279,0,0,"d:conflated/i:conflating/3:conflates"],"conflict":[[["n.",["战斗","冲突","矛盾","争执"],["an open clash between two opposing groups (or individuals)"]],["v.",["争执","战斗","冲突","抵触"]]],"gk cet4 cet6 ky toefl ielts gre",1179,4,1,"s:conflicts/p:conflicted/i:conflicting",[["The conflict between blacks and whites in the city became worse.","在这个城市，白人和黑人间的争端愈演愈烈。"]]],"confluence":[[["n.",["合流","合流点","集合","人群"]],["",["融合","汇合"]]],"toefl",13507,0,0,"s:confluences"],"conform":[[["v.",["使一致","使遵守","使符合","一致","符合"]]],"cet6 ky toefl ielts gre",6957,2,0,"3:conforms/i:conforming/p:conformed",[["We must conform to the rules.","我们必须遵守规则。"]]],"conformist":[[["n.",["遵奉习俗","遵纪守法者","遵奉国教会惯例者"]]],"gre",26307,0,0,"s:conformists"],"conformity":[[["n.",["遵照","适合","一致","相似"]],["",["符合度"]]],"cet6 ky toefl gre",11474,1,0,[["Some people prefer conformity, while others seek novelty.","有些人喜欢循规蹈矩，而有些人总喜欢寻求刺激。"]]],"confound":[[["v.",["使混淆","使狼狈","挫败"]]],"toefl gre",10535,1,0,"d:confounded/i:confounding/3:confounds"],"confront":[[["v.",["使面对","对抗","遭遇","使对质","比较"]]],"cet6 ky toefl ielts gre",2415,3,1,"d:confronted/i:confronting/3:confronts",[["Japan is confronted with severe economic problems.","日本正面臨著嚴重的經濟問題。"]]],"confrontation":[[["n.",["对抗","对质","面对"]]],"cet6",4459,3,0,"s:confrontations",[["Everybody knows that Cold War is the confrontation between two nations.","是人都知道冷戰是兩國的對峙。"]]],"confrontational":[[["adj.",["挑衅的","对抗的"]]],null,13483,1,0],"confuse":[[["v.",["使混乱","使狼狈","使困惑"]],["",["混淆"]]],"gk cet4 cet6 ky toefl ielts",3518,2,1,"d:confused/i:confusing/3:confuses",[["That was the part that Tom and I were most confused about.","这是我和汤姆最困惑的部分。"]]],"confused":[[["adj.",["困惑的","混乱的"]]],null,5646,2,1,[["That was the part that Tom and I were most confused about.","这是我和汤姆最困惑的部分。"]]],"confusion":[[["n.",["混乱","混淆","无秩序"]],["",["含混"]]],"cet4 cet6 ky toefl ielts",3335,2,1,"s:confusions",[["Every function should have comments describing its purpose in order to avoid confusion.","每一个函数都应该有描述其目的的注释以避免误解。"]]],"congeal":[[["v.",["(使)冻结","(使)凝结"]]],"gre",22239,0,0,"p:congealed/i:congealing/3:congeals"],"congenial":[[["adj.",["协调的","一致的","适意的","趣味相同的"]]],"toefl gre",16200,1,0],"congenital":[[["adj.",["天生的","先天的"]]],"toefl gre",15666,0,0,[["The brain damage was congenital.","脑损伤是先天的。"]]],"conger":[[["n.",["大海鳗"]]],null,0,1,0,"s:congers"],"congest":[[["v.",["使充满","使拥塞","使充血","充塞","充血"]]],"cet6 gre",0,0,0,"i:congesting/p:congested/s:congests",[["Algiers' streets are getting congested.","阿爾及爾的街道越來越堵塞了。"]]],"congested":[[["adj.",["拥挤的","堵塞的"]],["",["充血的"]]],"toefl",14602,1,0,[["Algiers' streets are getting congested.","阿爾及爾的街道越來越堵塞了。"]]],"congestion":[[["n.",["拥挤","充血","拥塞"]]],"toefl ielts",8954,1,0,"s:congestions"],"congestive":[[["adj.",["充血的","引起拥塞的"]]],null,19649,0,0],"conglomerate":[[["n.",["集成物","混合体","砾岩"]],["adj.",["聚成球形的","砾岩性的"]],["v.",["(使)凝聚成团"]]],"toefl gre",10258,1,0,"s:conglomerates/i:conglomerating/p:conglomerated",[["Drop by drop, the water can conglomerate into a lake.","一滴滴水能聚成湖泊。"]]],"congratulate":[[["v.",["祝贺","庆贺"]]],"gk cet4 cet6 ky",8361,2,0,"d:congratulated/i:congratulating/3:congratulates",[["They congratulated us on our victory.","他們祝賀我們的勝利。"]]],"congratulation":[[["n.",["祝贺","恭喜"]]],"gk cet4 cet6 ky toefl",0,0,0],"congratulations":[[["n.",["祝贺词","祝贺语"]]],null,9990,1,1,[["Please accept my sincere congratulations on your success today.","請接受我對您今天的成功最誠摯的祝賀。"]]],"congregate":[[["v.",["(使)集合","(使)聚集"]],["adj.",["集合在一起的","集体的"]]],"toefl gre",12537,1,0,"i:congregating/d:congregated/3:congregates"],"congregation":[[["",["集会","人一","红衣主教会议"]],["n.",["集合","聚集"]]],null,4989,1,0,"s:congregations"],"congregational":[[["adj.",["会众的","公理教会的"]]],null,17267,0,0],"congress":[[["n.",["国会","会议","讨论会","会合"],["the legislature of the United States government"]]],"cet4 cet6 ky toefl ielts",638,2,1,"s:congresses",[["Tom is running for Congress.","汤姆在竞选国会议员。"]]],"congressional":[[["adj.",["会议的","议会的","国会的","代表大会的","大会的"]]],"toefl",2309,3,0,[["The senator was censured by the congressional ethics committee.","议员受到了议会道德委员会的谴责。"]]],"congressman":[[["n.",["国会议员","众议院议员"]],["",["国会议会"]]],"toefl",5390,2,0,"s:congressmen"],"congruence":[[["n.",["适合","一致","和谐"]]],null,18706,0,0,"s:congruences"],"congruent":[[["adj.",["适合的","一致的","合谐的","全等的"]]],"ielts gre",16664,0,0],"congruity":[[["n.",["适合","一致","共同点"]]],"toefl",38644,0,0],"congruous":[[["adj.",["一致的","适合的","符合的"]]],"gre",44582,0,0],"conical":[[["adj.",["圆锥形的","圆锥的"]]],null,19474,0,0],"conifer":[[["n.",["松柏目植物","针叶树"]]],"toefl gre",16342,1,0,"s:conifers",[["It's Lulu Island, 3 August 2025. After supper—green figs tender with sunlight, sweet vinegar from yesterday’s pickled jar, and reheated Alfredo—I sat on the balcony and watched the conifer. Stillness below, a street without cars, without haste. My lime water, iced, caught the light. Michael, the Franco-Danish ufologist, has been in my conversations lately. We speak of inner things: the trance of smart devices, the mind’s eye dwindling. He says cafés aren’t cafés anymore. People forget how to look, how to linger. I tell him of Arthur in Japan—how he'd stare into blank walls like a monk gazing at emptiness. Lately I ask machines to speak like poets, and they do. They mimic Elizabethan verses and the old wistful lilt of Tagalog ballads. I pick blackberries along the path to Tim Hortons. \"¡Moras!\" I shout like a child. My friend Mora, whose blood flows with Andes mist, would smile. Today, I bought lemons. I meant limes, but lemons are all right. / blackberry morning— / a fig's ghost on my fingers / and the street still sleeps","現在是 2025 年 8 月 3 日，露露島。晚餐後，陽光下嫩綠的無花果，昨天醃製的甜醋，還有重新加熱的阿爾弗雷多義麵…"]]],"conjectural":[[["adj.",["推测的","好推测的"]]],"toefl",33926,0,0],"conjecture":[[["n.",["推测","猜想","揣摩","猜测"]],["v.",["推测","猜想","揣摩"]]],"toefl gre",14535,1,0,"s:conjectures/p:conjectured/i:conjecturing"],"conjoin":[[["v.",["(使)结合","(使)连结","(使)联合"]]],"gre",22133,0,0,"d:conjoined/i:conjoining/3:conjoins"],"conjugal":[[["adj.",["婚姻的","配偶的"]],["",["夫妇的"]]],"gre",21505,0,0,"s:conjugals"],"conjunction":[[["n.",["连接词","联合","结合"]],["",["合取"]]],"cet4 cet6 ky toefl ielts gre",7557,2,0,"s:conjunctions"],"conjure":[[["v.",["念咒文召唤","变戏法","想象","施魔法"]]],"toefl gre",7727,1,0,"3:conjures/d:conjured/i:conjuring"],"connect":[[["v.",["连接","联合","联系"],["connect, fasten, or put together two or more pieces"]]],"zk gk cet4 cet6 ky toefl",1636,2,1,"d:connected/i:connecting/3:connects",[["I often use SSH to remotely connect to my computer.","我经常使用SSH来远程连接到我的电脑。"]]],"connectedness":[[["",["连通性"]]],null,17857,0,0],"connection":[[["n.",["连接","关系","前后关系"],["a relation between things or events (as in the case of one causing th…"]]],"gk cet4 cet6 ky toefl",1421,3,1,"s:connections",[["That parrot was Tobias's only connection with his late father.","那隻鸚鵡是托比亞斯與他已故父親之間唯一的連結。"]]],"connective":[[["adj.",["易于连接的","连接的"]],["n.",["连接物","关联词"]],["",["连接词"]]],null,19421,0,0,"s:connectives"],"connectivity":[[["",["连通性","连通度"]]],null,18177,0,0,"s:connectivities"],"connector":[[["n.",["连结者","联系者","连结物"]],["",["连接口"]]],null,12477,0,0,"s:connectors"],"connivance":[[["n.",["默许","纵容"]]],"toefl",33617,0,0],"connive":[[["v.",["默许","共谋","纵容"]]],"toefl gre",25506,0,0,"i:conniving/d:connived/3:connives"],"connoisseur":[[["n.",["鉴赏家","鉴定家","内行"]]],"toefl gre",14575,1,0,"s:connoisseurs"],"connotation":[[["n.",["含蓄","内涵"]]],"ky gre",11350,1,0,"s:connotations"],"connote":[[["v.",["含蓄着","内涵着","意味着"]]],null,17617,0,0,"3:connotes/p:connoted/i:connoting"],"connubial":[[["adj.",["结婚的","夫妇的","配偶的"]]],"gre",42197,0,0],"conquer":[[["v.",["克服","征服","战胜","得胜"]]],"cet4 cet6 ky toefl ielts gre",6737,2,0,"d:conquered/i:conquering/3:conquers",[["Do you know who conquered Mt. Everest first?","你知道是谁第一个征服珠穆朗玛峰的吗?"]]],"conqueror":[[["n.",["征服者","胜利者"]]],"cet6 ielts",16027,1,0,"s:conquerors",[["Emperor Qin Shi Huang and Emperor Wu of Han, though remarkable in their achievements, somewhat lacked in literary grace; Emperor Taizong of Tang and Emperor Taizu of Song, though commendable in their elegance, still fall slightly short in their brilliance. The proud conqueror, Genghis Khan, knew only how to bend the bow and shoot great eagles. All of them are now bygone, and if you want to count the truly remarkable figures, look to the present age.","惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。一代天骄，成吉思汗，只识弯弓射大雕。俱往矣，数风流人物，还看今朝。"]]],"conquest":[[["n.",["战胜","征服","战利品","赢得","获得"]]],"cet4 cet6 ky ielts gre",7652,1,0,"s:conquests"],"conscience":[[["n.",["良心","道德感","正义感"]]],"gk cet4 cet6 ky toefl ielts gre",4641,2,0,"s:consciences",[["A clear conscience is an extraordinarily soft pillow.","問心無愧是一個非常柔軟的枕頭。"]]],"conscientious":[[["adj.",["有责任心的","负责的","本着良心的"]],["",["凭良心做的","有道德感的"]]],"ky toefl ielts gre",11605,1,0],"conscious":[[["adj.",["有意识的","知觉的","觉察的","清醒的"]]],"cet4 cet6 ky toefl ielts",3845,3,1,[["The warrior is conscious of both his strength and his weakness.","戰士知道自己的力量和弱點。"]]],"consciously":[[["adv.",["自觉地","有意识地"]]],"toefl",8107,0,0],"consciousness":[[["n.",["意识","知觉","自觉"]],["",["(有)意识","清醒"]]],"cet4 cet6 toefl",3224,3,0,"s:consciousnesses",[["He lost consciousness under the influence of the anesthetic.","他在麻醉剂的作用下，他失去了知觉。"]]],"conscript":[[["adj.",["被征入伍的","被征召的"]],["n.",["征兵"]],["v.",["征召"]]],"gre",19067,1,0,"s:conscripts/d:conscripted/i:conscripting"],"conscription":[[["n.",["征兵","募兵","征用(制度)","征用"]]],null,19574,0,0,"s:conscriptions"],"consecrate":[[["v.",["把...供祭祀用","奉献","使神圣"]],["adj.",["被献给神的","神圣的"]]],"toefl gre",20656,1,0,"d:consecrated/i:consecrating/3:consecrates"],"consecutive":[[["adj.",["连续的","联贯的","连接的"]]],"cet6 ky toefl ielts",4845,2,0,[["It snowed for ten consecutive days.","雪持续下了十天。"]]],"consensual":[[["adj.",["在两方愿意下成立的","交感的","同感的"]]],null,13093,0,0],"consensus":[[["n.",["合意","一致","同感"]]],"gk cet6 ky toefl ielts gre",3317,2,0,[["Just what time period is \"Hong Fan\" a product of? Although people have debated this issue for ages, there is still no clear consensus to this day.","《洪范》到底是什么时代的作品, 千百年来人们见仁见智, 至今仍无定论。"]]],"consent":[[["n.",["同意","许可"]],["v.",["同意","赞同"]]],"cet4 cet6 ky ielts gre",4391,2,0,"d:consented/s:consents/i:consenting",[["Do you give your consent to the operation?","你是否同意手术？"]]],"consequence":[[["n.",["结果","重要性","后果","推断"],["a phenomenon that follows and is caused by some previous phenomenon"]]],"gk cet4 cet6 ky toefl ielts gre",1626,3,1,"s:consequences",[["Don't run away from consequences, don't fear them; face them.","不要逃避后果，别怕它们；面对它们。"]]],"consequent":[[["n.",["随后发生的事情","结果"]],["adj.",["作为结果的","合乎逻辑的"]]],"cet6 toefl ielts",14817,1,0,"s:consequents"],"consequential":[[["adj.",["作为结果的","随之发生的","推论的","间接的","重大的"]],["",["结果的","相应而生的","接着发生的"]]],"gre",19493,0,0,"s:consequentials"],"consequently":[[["adv.",["所以"]]],"cet4 cet6 ky toefl",4363,2,0,[["Monsieur D'Espilly, in the year 1772, calculated the population of France at upwards of 22 millions; namely, 10,562,631 males, and 11,451,726 females; consequently the proportion of females to males was about 14 to 13.","1772 年，埃斯皮利先生計算出法國人口超過 2,200 萬人；其中男性 10,562,631 人，女性 11,451…"]]],"conservation":[[["n.",["保护","保存"]]],"gk cet4 cet6 ky toefl ielts",2820,2,0,[["During the holidays, some university students go to Africa as volunteers and help to perfect local wildlife conservation.","一些大学生在假期去非洲做志愿者 ，帮助当地完善野生生物管理。"]]],"conservationist":[[["n.",["自然资源保护论者"]]],"toefl",11943,1,0,"s:conservationists",[["Many conservationists fear the continuing slaughter of whales is pushing these animals towards extinction.","许多自然环境保护主义者担心持续屠杀鲸鱼正推动这些动物走向灭绝。"]]],"conservatism":[[["n.",["保守","守旧性","保守主义","保守党的主张和政策","保守党"]],["",["保守性"]]],"toefl",9228,1,0],"conservative":[[["adj.",["保守的","守旧的","有保存力的"],["resistant to change"]],["",["防腐剂","保存剂"],["having social or political views favoring conservatism"]]],"gk cet4 cet6 ky toefl ielts gre",1837,4,1,"s:conservatives",[["Many conservative women still can't accept fishnet stockings.","很多保守的女生還是接受不了網襪。"]]],"conservatively":[[["adv.",["保存地","保守地","谨慎地"]]],null,17762,0,0],"conservator":[[["n.",["保护者","管理员","管理委员"]],["",["保护人"]]],null,19352,0,0,"s:conservators"],"conservatory":[[["adj.",["保存性的","有保存力的"]],["n.",["温室","音乐学校"]]],"toefl ielts gre",18578,1,0,"s:conservatories"],"conserve":[[["n.",["蜜饯","果酱"]],["v.",["保存","使(能量等)守恒"]]],"cet4 cet6 ky toefl ielts gre",7938,2,0,"d:conserved/i:conserving/3:conserves",[["What I’m getting at is that Zamenhof not only built a linguistic object, but that behind that was an idea — an idea of brotherhood, a pacifist idea. That strength of an ideal — for which Esperantists were even persecuted under Nazism and Stalinism — is still conserved by the community of Esperantists. One cannot say that it has failed, but one thing needs to be said: the reason why any language is successful is always indefinable.","我想说的是，柴门霍夫不仅构建了一个语言学对象，而且在这之后还有一个理念——一个兄弟情谊的理念，一个和平主义的理念。这种…"]]],"consider":[[["v.",["考虑","思考","认为"],["take into consideration for exemplifying purposes"]]],"zk gk cet4 cet6 ky toefl",394,5,1,"d:considered/i:considering/3:considers",[["This is considered to be a matter of great importance.","这被认为是一件大事。"]]],"considerable":[[["adj.",["相当的","可观的","重要的"]]],"cet4 cet6 ky toefl ielts gre",2855,4,1,[["A considerable amount of time and effort have been spent already.","已經花費了很多的時間和精力。"]]],"considerably":[[["adv.",["非常地","很","颇"]]],"toefl",4645,0,1],"considerate":[[["adj.",["体贴的","体谅的","考虑周到的"]]],"gk cet4 cet6 ky toefl ielts",17092,1,0,[["You were considerate not to disturb us.","你考虑周到，没有打扰我们。"]]],"consideration":[[["n.",["考虑","原因","思考","报酬"]]],"gk cet4 cet6 ky toefl",2487,2,1,"s:considerations",[["The first thing you have to take into consideration is time.","你应该考虑的第一件事是时间。"]]],"consign":[[["v.",["交付","储蓄","委托","寄存","托卖"]]],"toefl ielts gre",15519,1,0,"d:consigned/i:consigning/3:consigns"],"consignment":[[["n.",["委托","寄销","寄销品"]]],null,22180,1,0,"s:consignments"],"consist":[[["v.",["组成","存在于","一致"]]],"gk cet4 cet6 ky toefl ielts",2190,3,0,"3:consists/i:consisting/p:consisted",[["The Milky Way consists of about a hundred billion stars.","银河系大约由一千亿颗恒星组成。"]]],"consistency":[[["n.",["坚硬性","黏稠度","一致性","稠度"]]],"toefl gre",4975,1,0,"s:consistencies",[["I'm so busy running about year in, year out. My life has no consistency.","长年累月东奔西走忙死了，生活太没有规律了。"]]],"consistent":[[["adj.",["一致的","坚持