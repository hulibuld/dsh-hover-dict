s"],"stigma":[[["",["柱头","小孔","眼点","气孔","小斑"]],["n.",["耻辱","污名","烙印"]]],"gre",8507,1,0,"s:stigmas"],"stigmatize":[[["v.",["打烙印","诬蔑"]]],"gre",16222,0,0,"d:stigmatized/3:stigmatizes/i:stigmatizing"],"stiletto":[[["n.",["短剑","钻孔锥"]],["",["机载探测地面雷达电子系统"]]],null,18996,0,0,"s:stilettos"],"still":[[["adj.",["静止的","不动的","静寂的","不起泡的","静物摄影的"]],["n.",["蒸馏室","寂静","剧照"],["a static photograph (especially one taken from a movie and used for a…"]],["v.",["蒸馏","(使)平静","(使)静止"],["lessen the intensity of or calm"]],["adv.",["仍然","更","静止地"]],["conj.",["然而","但是"]]],"zk gk toefl",126,5,1,"s:stills/i:stilling/p:stilled",[["No point in threatening me. I'll still tell you nothing.","威胁我也没用，我什么都不会说的。"]]],"stillness":[[["n.",["静止","沉静"]]],"cet6",11128,0,0,"s:stillnesses",[["It's Lulu Island, 3 August 2025. After supper—green figs tender with sunlight, sweet vinegar from yesterday’s pickled jar, and reheated Alfredo—I sat on the balcony and watched the conifer. Stillness below, a street without cars, without haste. My lime water, iced, caught the light. Michael, the Franco-Danish ufologist, has been in my conversations lately. We speak of inner things: the trance of smart devices, the mind’s eye dwindling. He says cafés aren’t cafés anymore. People forget how to look, how to linger. I tell him of Arthur in Japan—how he'd stare into blank walls like a monk gazing at emptiness. Lately I ask machines to speak like poets, and they do. They mimic Elizabethan verses and the old wistful lilt of Tagalog ballads. I pick blackberries along the path to Tim Hortons. \"¡Moras!\" I shout like a child. My friend Mora, whose blood flows with Andes mist, would smile. Today, I bought lemons. I meant limes, but lemons are all right. / blackberry morning— / a fig's ghost on my fingers / and the street still sleeps","現在是 2025 年 8 月 3 日，露露島。晚餐後，陽光下嫩綠的無花果，昨天醃製的甜醋，還有重新加熱的阿爾弗雷多義麵…"]]],"stilt":[[["n.",["高跷","支柱","脚柱"]]],"toefl",17133,0,0,"s:stilts/p:stilted"],"stimulant":[[["adj.",["兴奋性的","激励的","鼓舞的"]],["n.",["兴奋剂","酒精饮料"]]],"toefl gre",14629,1,0,"s:stimulants"],"stimulate":[[["v.",["刺激","激励","鼓舞","起刺激作用"]]],"cet4 cet6 ky toefl ielts",4440,3,0,"d:stimulated/3:stimulates/i:stimulating",[["Tax cuts are often used as a major fiscal tool to stimulate the economy.","减税常被用作刺激经济的主要财政手段。"]]],"stimulation":[[["n.",["刺激","激励","鼓舞","兴奋"]]],"toefl",7974,0,0,"s:stimulations",[["Just as the body needs exercise, so the mind needs stimulation to stay healthy.","正如身體需要鍛煉，所以心靈需要刺激才能保持健康。"]]],"stimulus":[[["n.",["刺激","激励","刺激品","刺激特"]]],"cet6 toefl ielts gre",4525,2,0,"s:stimuli"],"sting":[[["n.",["叮","刺痛","刺激","讽刺"]],["v.",["叮","刺痛","刺激","使苦恼"]]],"cet4 cet6 ky toefl ielts gre",8139,2,1,"d:stung/s:stings/i:stinging",[["I've just been stung by a bee.","我刚给蜜蜂蛰了。"]]],"stinginess":[[["n.",["吝啬"]]],"gre",35332,0,0],"stinging":[[["adj.",["刺人的","刺一般的","激烈的"]]],null,12086,0,0,[["Why do bees die after stinging?","蜜蜂蜇人后为什么会死去呢？"]]],"stingy":[[["adj.",["小气的","吝啬的","缺乏的","有刺的"]]],"toefl gre",18550,0,0,[["Mary doesn't like men who are stingy like Tom.","瑪莉不喜歡跟湯姆一樣吝嗇的男人。"]]],"stink":[[["v.",["发臭味","名声臭","用臭味赶"]],["n.",["臭味","臭气"]]],null,8551,1,0,"3:stinks/p:stank/i:stinking",[["Nail polish remover stinks a lot.","洗甲水的味道很難聞。"]]],"stint":[[["v.",["节省","限制","停止","节约"]],["n.",["吝惜","节约","限额"]]],"gre",8331,1,0,"s:stints/d:stinted/i:stinting"],"stipend":[[["n.",["薪金","定期生活津贴"]],["",["薪水"]]],"toefl",15076,0,0,"s:stipends"],"stipple":[[["n.",["点刻法","点画","点彩"]],["v.",["点刻","点画","点彩"]]],"gre",31896,0,0,"p:stippled/i:stippling/s:stipples"],"stipulate":[[["v.",["规定","保证"]]],"toefl ielts gre",10956,1,0,"p:stipulated/3:stipulates/i:stipulating"],"stipulation":[[["n.",["约束","约定","契约"]],["",["订定","规定","条款"]]],"toefl gre",16026,0,0,"s:stipulations"],"stir":[[["v.",["移动","摇动","激起","惹起","搅拌"],["move an implement through"]],["n.",["骚动","轰动","搅动","监狱"],["a prominent or sensational but short-lived news event"]]],"cet4 cet6 ky toefl gre",1899,3,1,"p:stirred/i:stirring/3:stirs",[["A light breeze stirred the surface of the lake.","微风吹荡着湖面。"]]],"stir-fry":[[["v.",["用旺火煸","用旺火炒"]],["n.",["炒出来的菜","炒菜"]]],null,0,1,0,"s:stir-fries"],"stirrup":[[["n.",["马镫","镫具","U形物"]],["",["钢箍"]]],null,18909,0,0,"s:stirrups"],"stitch":[[["n.",["一针","疼痛","针法","碎布条","针脚"]],["v.",["缝","缝合","装订"]]],"cet4 cet6 ky toefl ielts gre",9743,2,0,"s:stitches/d:stitched/i:stitching",[["A stitch in time saves nine.","小洞及時補，免遭大洞苦。"]]],"stock":[[["n.",["树干","祖先","血统","原料","备料"],["the capital raised by a corporation through the issue of shares entit…"]],["adj.",["存货的","常备的","平凡的","普通的","股票的"]],["v.",["装把手于","进货","备有","放牧","出新芽"]]],"cet4 cet6 ky toefl ielts gre",740,5,1,"s:stocks/d:stocked/i:stocking",[["He's making a lot of money in the stock market.","他炒股賺很多錢。"]]],"stockade":[[["n.",["栅栏","围起的地方"]],["v.",["用栅栏围住"]]],"gre",24774,0,0,"s:stockades/i:stockading/p:stockaded"],"stockbroker":[[["n.",["股票经纪人"]]],null,15448,0,0,"s:stockbrokers"],"stockholder":[[["n.",["股东","股票持有者","股票所有人"]]],"cet6",12990,1,0,"s:stockholders"],"stockist":[[["n.",["存有货物出售的商人","存有货物出售的商行"]],["",["存货商"]]],null,0,1,0,"s:stockists"],"stockpile":[[["n.",["储蓄","积蓄","库存"]],["v.",["储蓄","贮存"]]],null,13559,1,0,"s:stockpiles/i:stockpiling/d:stockpiled"],"stocky":[[["adj.",["矮胖的","健壮结实的"]]],"toefl gre",14898,1,0,"r:stockier",[["On the 14th of April of 2015, I walk to the Richmond Public Market, I first climbing the stairs outside. Inside, the wide atrium-like building is like a garden in a jungle surrounding, I imagine. Already quite hungry, I trot to Captain Wa, the food vendor, to get noodles with squid, fish, and tofu, as well as hot tea. As I eat, a handsome First Nations man in a purple T-shirt walks by. Then a handsome, stocky Jewish fellow walks by. A few minutes later, I begin to thirst, so I get a cold Mint Bubble Green Tea at the vendor QQ Bubble Tea and Coffee. I sit by the stairs to sip. A threesome family sits eating nearby, the man being black, the woman being Oriental, and the child being a hybrid. Addicted to Bubble Tea, I get another one, this time at Peanut's. It is a cold Green Apple Bubble Green Tea. It is delicious. I take the escalator down. On my way to the washroom, I notice a big aquarium full of probably giant red Alaskan king crabs with barnacles on their legs. They remind me of extraterrestrials, somehow. At the bookstore, I buy a heavily illustrated green botany book in sinograms. I left it on top of a box a month ago and it is still there. It is $14. I take the escalator up. Addicted to Bubble Tea, I spend my remaining coins on a cold Lychee Bubble Green Tea. It is delicious with even bits of white lychee flesh.","2015 年 4 月 14 日，我步行前往列治文公共市場，先是爬上了外面的階梯。市場內部寬敞的中庭式建築，讓我感覺彷彿…"]]],"stodgy":[[["adj.",["易吃饱的","塞满的","平凡的","庸俗的","步履艰难的"]]],"toefl gre",21383,0,0],"stoic":[[["adj.",["斯多葛派的","禁欲主义的","不以苦乐为意的","坚忍的","淡泊的"]],["n.",["斯多葛派学者","画廊派的人","禁欲主义者","不介意苦乐的人","高度自制的人"]]],"gre",16316,0,0,"s:stoics"],"stoke":[[["v.",["司炉","(使)大吃"]]],"gre",13140,1,0,"d:stoked/i:stoking/3:stokes"],"stolid":[[["adj.",["缺乏热情的","神经麻木的"]]],"gre",22932,0,0],"stomach":[[["n.",["胃","食欲","欲望","肚子"]],["v.",["吃下","忍受"]]],"zk gk cet4 cet6 ky toefl ielts gre",2503,3,1,"s:stomachs/i:stomaching/p:stomached/3:stomaches",[["I developed a tumor in my stomach, which required surgery.","我得了胃腫瘤，必須動手術切除。"]]],"stomachache":[[["n.",["胃痛","肚子痛"]]],"gk",25221,0,0,[["Correct, one has a stomachache, the other has a headache.","对，一个人肚子疼，另一个人头疼。"]]],"stomp":[[["v.",["跺","践踏","跺脚"]],["n.",["跺脚"]]],null,8646,1,0,"i:stomping/p:stomped/3:stomps",[["The bully stomped on his schoolmate’s lunchbox out of spite.","惡霸惡劣地踐踏同學的午餐便當。"]]],"stone":[[["n.",["石头","宝石","果核","纪念碑","结石"],["building material consisting of a piece of rock hewn in a definite sh…"]],["adj.",["石的","石制的","完全的"]],["v.",["投扔石子","铺石头"]]],"zk gk cet4 cet6 ky ielts",1220,4,1,"s:stones/d:stoned/i:stoning",[["From a distance, this stone looks like a human face.","从远看得话，这个石头看起来像人的脸。"]]],"stonemason":[[["n.",["石工","石匠"]]],"toefl",31114,0,0,"s:stonemasons"],"stonewall":[[["v.",["防守挡击","围以石墙","妨碍或阻碍"]]],"gre"