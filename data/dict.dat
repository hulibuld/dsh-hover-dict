r son's letter.","这位母亲偶尔会重温她的儿子的信件。"]]],"rerun":[[["n.",["重新开动","再度上演"]],["v.",["重新开动","再度上演"]],["",["再运行","重新运行"]]],null,13741,0,0,"i:rerunning/3:reruns/p:reran",[["This program is a rerun.","这个节目是重播。"]]],"resale":[[["n.",["再贩卖","转售"]],["",["再卖","转卖"]]],null,16743,0,0,"s:resales"],"reschedule":[[["",["重安排","重调度","修订计划"]]],"toefl",16954,1,0,"i:rescheduling/d:rescheduled/3:reschedules",[["Testing has been delayed by two days. As a consequence, we need to reschedule the release date.","测试延迟了两天，因此，我们需要重新安排发布日期。"]]],"rescind":[[["v.",["废止","使无效","取消","撤消","解除"]]],"gre",16113,1,0,"d:rescinded/i:rescinding/s:rescinds"],"rescission":[[["n.",["废止","取消","使无效","撤消","解除"]]],"gre",38914,0,0],"rescript":[[["n.",["敕令","诏书","抄书","敕命","命令"]]],"gre",0,0,0,"s:rescripts/p:rescripted"],"rescue":[[["n.",["援救","解救","营救"]],["v.",["援救","救出","营救"]]],"gk cet4 cet6 ky toefl ielts gre",3815,3,1,"d:rescued/i:rescuing/3:rescues",[["The rescue worker searched the area, looking for the child.","援救人员为了找到孩子，仔细搜索了那个区域。"]]],"rescuer":[[["n.",["救助者"]]],null,11600,0,0,"s:rescuers",[["The rescuers searched the surroundings in hopes of finding the child.","援救人员为了找到孩子，仔细搜索了那个区域。"]]],"research":[[["n.",["研究","调查","考察"],["systematic investigation to establish facts"]],["v.",["研究","调查"],["attempt to find out in a systematically and scientific manner"]]],"zk gk cet4 cet6 ky ielts",362,5,1,"i:researching/d:researched/s:researches",[["He should spend more time on this piece of research.","他應該花更多時間在這個研究上。"]]],"researcher":[[["n.",["研究人员"]]],"cet4 cet6",1177,0,0,"s:researchers"],"resell":[[["v.",["再卖","转售","转卖"]]],null,15635,0,0,"i:reselling/3:resells/p:resold"],"resemblance":[[["n.",["相似处","类似","肖像"]]],"cet6 ky toefl ielts",7553,1,0,"s:resemblances",[["I was surprised at his strong resemblance to his father.","他像极了他父亲，这让我震惊。"]]],"resemble":[[["v.",["相似","类似"]]],"gk cet4 cet6 ky toefl ielts",3058,2,0,"3:resembles/i:resembling/p:resembled",[["He speaks English so fluently that he resembles an American.","他说英语流利得就好像