nd no ability to roar: d…"]],["v.",["呕吐"],["beat with a cat-o'-nine-tails"]]],"zk gk",1775,3,1,"s:cats/i:catting/p:catted",[["We have a cat. We are all fond of it.","我们有一只猫。我们都喜欢猫。"]]],"cataclysm":[[["",["渗出","渗液","猝变","聚变"]],["n.",["大洪水","地震","(社会政治的)大变动"]]],"toefl gre",22077,0,0,"s:cataclysms"],"cataclysmic":[[["adj.",["洪水的","灾变的","政治和社会大变动的"]]],null,18690,0,0],"catalog":[[["n.",["目录","大学概况手册","编目"]],["v.",["编目录"]]],"cet4 cet6 ky ielts gre",4443,0,0,"s:catalogs/i:cataloging/p:cataloged",[["Neil Gemmell, a geneticist from the University of Otago in New Zealand, led the study that tried to catalog all living species in the lake by extracting DNA from water samples.","紐西蘭奧塔哥大學的遺傳學家尼爾杰梅爾領導了這項研究，試圖透過從水樣本中提取 DNA 來對湖泊中所有生物物種進行編目。"]]],"catalogue":[[["n.",["目录","大学情况一览"]],["v.",["编入目录"]]],"gk cet6 ielts",6793,2,0,"s:catalogues/d:catalogued/i:cataloguing",[["Brahe catalogued over 1000 stars.","布拉赫为一千多颗恒星做了编目。"]]],"catalyst":[[["n.",["触媒","接触剂","催化剂","刺激因素","促进因素"]]],"cet6 toefl ielts gre",7915,1,0,"s:catalysts"],"catalytic":[[["adj.",["催化的"]]],null,17722,1,0],"catalyze":[[["v.",["催化","促进","刺激"]]],"toefl",22190,0,0,"3:catalyzes/d:catalyzed/i:catalyzing"],"catapult":[[["n.",["弹射器","弹弓","弩炮"]],["v.",["发射"]]],"gre",16678,1,0,"d:catapulted/s:catapults/i:catapulting"],"cataract":[[["n.",["大瀑布","奔流","暴雨","白内障","内障"]]],null,14871,1,0,"s:cataracts"],"catastrophe":[[["n.",["大灾难","大祸"]],["",["突变"]]],"gk cet6 ky toefl ielts gre",6648,2,0,"s:catastrophes",[["Due to the catastrophe caused by the huge tsunami, damage was sustained by the nuclear reactor as well as explosions at the nuclear power plant.","由于特大海啸的灾害，核能融炉遭受损害，造成了原子能发电站爆炸。"]]],"catastrophic":[[["adj.",["悲惨的","灾难的"]]],null,7567,1,0],"catch":[[["v.",["捕捉","赶上","感染","听清楚","抓住"]],["n.",["捕捉","陷阱","捕捉之物","抓","拉手"],["a drawback or difficulty that is not readily evident"]]],"zk gk ielts",586,4,1,"d:caught/i:catching/3:catches",[["A fox is not caught twice in the same snare.","一只狐狸不会两次掉入同一个陷阱里。"]]],"catcher":[[["n.",["捕手","捕捉器"]],[""