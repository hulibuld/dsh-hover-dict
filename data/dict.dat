ativity.","創新創新本身就提升了創新。"]]],"creator":[[["n.",["上帝","创造者","创作者"]]],null,5086,2,0,"s:creators",[["John Dalton was the creator of the atomic theory.","约翰·道尔顿是原子学说的创始人"]]],"creature":[[["n.",["人","动物","创造物","生物"]]],"gk cet4 cet6 ky",2353,2,1,"s:creatures",[["I can't imagine what creatures living on another planet are like.","我无法想象另一个星球上的生物。"]]],"credence":[[["n.",["信任","祭器台","供桌","凭证"]],["",["设计人","创立人","创设人"]]],"toefl gre",14310,1,0],"credential":[[["n.",["国书","凭据","证明书"]],["",["凭证","证书"]]],"cet6 ky toefl",6165,0,0,"p:credentialed"],"credentials":[[["n.",["信任状","国书","文件","身份证明","证书"]]],"ky toefl ielts",0,1,0],"credibility":[[["n.",["可信用","确实性","可靠","证据能力","可信程度"]]],null,4048,0,0,[["This will erode our credibility.","这会损害我们的信誉。"]]],"credible":[[["adj.",["可信的","可靠的"]]],"ielts gre",5991,2,0,[["If you want to be credible, tell people only what they believe.","如果你想使他人相信你的话，那就只说他已经相信的东西吧。"]]],"credit":[[["n.",["信用","信任","荣誉","贷款","学分"],["money available for a client to borrow"]],["v.",["归功于","赞颂","信任","相信"]],["",["信用量"]]],"gk toefl ielts gre",1125,4,1,"d:credited/s:credits/i:crediting",[["Did you bring cash or your credit card with you?","你钱或者信用卡带来没有？"]]],"creditable":[[["adj.",["可称誉的","声誉好的","可信的"]]],null,30817,1,0],"creditor":[[["n.",["债权人","债主","贷方"]]],"toefl",8246,2,0,"s:creditors"],"credo":[[["n.",["信条"]]],"gre",17871,0,0,"s:credos"],"credulous":[[["adj.",["轻信的","易受骗的"]]],"toefl gre",29990,0,0],"creed":[[["n.",["宗教信条","教义","纲领"]]],"toefl",12038,1,0,"s:creeds",[["And tonight, I think about all that she's seen throughout her century in America. The heartache and the hope, the struggle and the progress. The times we were told that we can't, and the people who pressed on with that American creed: Yes, we can.","今天晚上，我想到了她在美国过去一百年间所经历的种种：心痛和希望；斗争和进步；在那里时代，我们被告知我们办不到，一些人继…"]]],"creek":[[["n.",["小溪","小河","小湾"]]],"toefl gre",4931,1,0,"s:creeks",[["There used to be a lot of small creeks in old time Shanghai, which included Zhaojia Creek and Yangjing Creek, but they're all covered up nowadays.","上海以前有许多小河浜，其中有肇家浜、洋泾浜，现在都被填了。"]]],"creep":[[["n.",["爬","徐行","蠕动"]],["v.",["爬","蔓延","潜行"]]],"cet4 cet6 ky toefl ielts gre",5099,2,0,"p:crept/i:creeping/3:creeps",[["Sometimes it's fun to creep yourself out thinking about it.","偶尔偷偷地去想这个问题，还是很有意思的。"]]],"creepy":[[["adj.",["爬行的","令人毛骨悚然的"]]],null,11324,1,0,"r:creepier",[["I always find puppet shows a bit creepy.","我总觉得木偶戏有点吓人。"]]],"cremate":[[["v.",["烧成灰","火葬"]]],null,18777,1,0,"d:cremated/i:cremating/3:cremates"],"cremation":[[["n.",["烧","火葬"]]],null,19877,0,0,"s:cremations"],"creme":[[["n.",["奶油调味液","乳剂","香甜的酒"]]],null,13519,0,0,"r:cremer"],"creole":[[["n.",["克里奥耳人","克里奥耳语","克里奥耳人所讲的法语"]],["adj.",["克里奥耳人的","克里奥耳式法语的"]]],null,13569,1,0,"s:creoles",[["As more time passed, these Creoles became separate languages: Spanish, French, Italian, etc.","隨著時間的流逝，這些克里奧爾語成為了獨立的語言：西班牙語，法語，意大利語等等。"]]],"crepe":[[["n.",["绉丝","绉呢","绉绸","绉布","绉线"]],["",["皱片"]]],null,13430,0,0,"s:crepes/i:creping/p:creped"],"crepuscular":[[["adj.",["微光的","黄昏的","拂晓的","朦胧的"]]],"gre",35924,0,0],"crescendo":[[["n.",["声音渐强"]]],"gre",16560,0,0,"s:crescendos/i:crescendoing/p:crescendoed/3:crescendoes"],"crescent":[[["n.",["新月","新月形(物)"]],["adj.",["新月形的","逐渐增加的"]]],null,12284,1,0,"s:crescents",[["May 8 is World Red Cross Red Crescent Day.","5 月 8 日是世界紅十字會與紅新月日。"]]],"crest":[[["n.",["冠","饰毛","头盔的顶部"]],["v.",["到达绝顶","加以顶饰"]]],"gre",7472,1,0,"s:crests/p:crested/i:cresting"],"crestfallen":[[["adj.",["垂头丧气的","意气沮丧的","气馁的"]]],"gre",27208,0,0],"crevasse":[[["n.",["裂缝","(堤、坝等的)决口","崩溃处"]],["v.",["使有裂缝"]]],"toefl",20113,0,0],"crevice":[[["n.",["裂缝"]],["",["缝"]]],"toefl ielts gre",13625,0,0,"s:crevices/d:creviced",[["The crevice in the boulder on the ocean floor conceals an octopus.","海底的岩石缝里藏着一只章鱼。"]]],"crew":[[["n.",["全体人员","一群人","全体队员"],["the men and women who man a vehicle (ship, aircraft, etc.)"]]],"gk cet4 cet6 ky toefl",1706,3,0,"s:crews/d:crewed/i:crewing",[["Modern ships only need a small crew.","現代船隻只需要一小組的船員。"]]],"crewman":[[["n.",["机组乘员"]]],