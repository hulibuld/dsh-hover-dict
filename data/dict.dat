]],"trammel":[[["n.",["鱼网","拘束","束缚"]],["v.",["拘束","束缚"]]],"gre",42080,0,0,"d:trammelled/s:trammels/i:trammelling"],"tramp":[[["v.",["践踏","重步行走","步行","流浪","走过"]],["n.",["坚实(或沉重)的脚步声","流浪者"]]],"cet4 cet6 ky ielts gre",16137,1,0,"s:tramps/i:tramping/p:tramped"],"trample":[[["n.",["践踏(声)","蹂躏"]],["v.",["践踏","无视"]]],"cet6 toefl ielts gre",11298,1,0,"d:trampled/i:trampling/3:tramples",[["You can relax on the grass, but don't trample it.","你可以休息在草地上，但是别踩它。"]]],"trance":[[["n.",["昏睡状态","恍惚","着迷"]],["v.",["使恍惚","使发呆"]]],"gre",12432,1,0,"s:trances/p:tranced/i:trancing",[["It's Lulu Island, 3 August 2025. After supper—green figs tender with sunlight, sweet vinegar from yesterday’s pickled jar, and reheated Alfredo—I sat on the balcony and watched the conifer. Stillness below, a street without cars, without haste. My lime water, iced, caught the light. Michael, the Franco-Danish ufologist, has been in my conversations lately. We speak of inner things: the trance of smart devices, the mind’s eye dwindling. He says cafés aren’t cafés anymore. People forget how to look, how to linger. I tell him of Arthur in Japan—how he'd stare into blank walls like a monk gazing at emptiness. Lately I ask machines to speak like poets, and they do. They mimic Elizabethan verses and the old wistful lilt of Tagalog ballads. I pick blackberries along the path to Tim Hortons. \"¡Moras!\" I shout like a child. My friend Mora, whose blood flows with Andes mist, would smile. Today, I bought lemons. I meant limes, but lemons are all right. / blackberry morning— / a fig's ghost on my fingers / and the street still sleeps","現在是 2025 年 8 月 3 日，露露島。晚餐後，陽光下嫩綠的無花果，昨天醃製的甜醋，還有重新加熱的阿爾弗雷多義麵…"]]],"tranquil":[[["adj.",["安静的"]]],"cet6 toefl",13037,1,0,"s:tranquils"],"tranquility":[[["n.",["宁静"]]],"toefl ielts gre",15014,0,0,[["As the trees crave tranquility in the ever-persistent wind, the child craves the care of its ever-absent parents.","树欲静而风不息，子欲养而亲不在！"]]],"tranquilizer":[[["",["安定药","镇定药"]]],null,17641,0,0,"s:tranquilizers"],"tranquillity":[[["",["心神稳定"]]],null,19627,0,0],"transact":[[["v.",["办理","处理","作交易","谈判"]]],"toefl",25974,0,0,"d:transacted/i:transacting/3:transacts"],"transaction":[[["n.",["交易","办理","学报","和解协议"]],["",["事务处理"]]],"cet6 ky toefl ielts gre",3813,0,0,"s:transactions"],"transatlantic":[[["adj.",["横渡大西洋的","大西洋彼岸的","美国的"]]],null,12565,1,0],"transcend":[[["v.",["超越","胜过"]]],"cet6 ky toefl ielts gre",6661,1,0,"3:transcends/p:transcended/i:transcending"],"transcendence":[[["n.",["超越","卓越","卓绝"]]],null,13711,0,0],"transcendent":[[["adj.",["卓越的","出类拔萃的","超常的"]],["n.",["卓越的人","超绝物"]]],"ky gre",11634,0,0],"transcendental":[[["adj.",["卓越的","超凡的","先验的"]]],"ky gre",16575,0,0],"transcontinental":[[["adj.",["横贯大陆的","大陆那边的"]]],"toefl",21106,0,0,[["Mary was born prematurely during a 16 hour transcontinental flight.","瑪麗是在16小時跨大陸飛行中早產出生的。"]]],"transcribe":[[["v.",["抄写","译","意译","录制","改编"]],["",["转录"]]],"gre",9467,1,0,"d:transcribed/i:transcribing/3:transcribes"],"transcript":[[["n.",["抄本","副本","成绩单"]],["",["法院文本","官方记录","记录的副本"]]],"toefl ielts",6204,2,0,"s:transcripts"],"transcription":[[["n.",["抄写","抄本"]],["",["转录","转录作用"]]],null,14175,0,0,"s:transcriptions"],"transducer":[[["n.",["换能器","变换器","传感器","翻译机"]]],null,16677,0,0,"s:transducers"],"transfer":[[["v.",["使转移","调转","调任","改变","传递"]],["n.",["迁移","移动","传递","转让","转移"]],["",["传送"]]],"cet4 cet6 ky toefl ielts gre",2315,4,1,"d:transferred/s:transfers/i:transferring",[["Could you please transfer me to Mr. Smith?","請幫我轉接Smith先生。"]]],"transfigure":[[["v.",["使变形","使改观","美化"]]],"gre",28501,0,0,"d:transfigured/3:transfigures/i:transfiguring"],"transfix":[[["v.",["刺穿","使呆住","使固定"]],["",["贯穿","刺通"]]],"toefl",13826,0,0,"d:transfixed/i:transfixing/3:transfixes"],"transform":[[["v.",["使转换","改变","改造","使...变形","转化"]]],"gk cet4 cet6 ky toefl ielts",2185,3,1,"d:transformed/i:transforming/3:transforms",[["Images and videos are transformed into gifs and memes.","图像和视频被转换为GIF和哏。"]]],"transformation":[[["n.",["变形","变质","变化","改革","变换"]]],"ce