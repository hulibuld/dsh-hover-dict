残忍地","残酷地","极"]]],null,17835,0,0],"cruelty":[[["n.",["残酷","野蛮","残酷行为","残忍","虐待"]]],"cet6",8337,0,0,"s:cruelties",[["Cruelty in young people is fostered by violent movies and PC games.","暴力電影和電腦遊戲助長了年輕人的殘暴行為。"]]],"cruise":[[["n.",["巡航","巡弋","漫游"]],["v.",["巡航","巡弋","漫游"]]],"cet6 ky ielts",4681,3,0,"i:cruising/s:cruises/p:cruised",[["The straits were too narrow for the cruise ship.","这个海峡对游艇来说太窄了。"]]],"cruiser":[[["n.",["巡洋舰","巡航飞机","警察巡逻车"]]],null,7543,1,0,"s:cruisers"],"crumb":[[["n.",["碎屑","面包屑","少许"]],["v.",["捏碎","弄碎"]]],"ielts gre",7218,1,0,"s:crumbs/p:crumbed/i:crumbing"],"crumble":[[["v.",["(使)粉碎","(使)成为碎屑","瓦解","崩溃","败落"]]],"toefl ielts gre",7038,2,0,"i:crumbling/d:crumbled/3:crumbles",[["Algeria isn't going to crumble.","阿尔及利亚不会崩溃。"]]],"crumple":[[["v.",["弄皱","压皱","崩溃","变皱"]]],"toefl ielts gre",11820,1,0,"p:crumpled/i:crumpling/3:crumples"],"crunch":[[["v.",["嘎吱嘎吱的咬嚼","压碎","嘎吱嘎吱地踏过"]],["n.",["咬碎","咬碎声"]]],null,7540,2,0,"p:crunched/i:crunching/3:crunches"],"crunchy":[[["adj.",["发嘎吱嘎吱声的"]]],null,13795,0,0,"s:crunchies/r:crunchier"],"crusade":[[["n.",["改革运动","十字军东侵"]],["v.",["从事改革运动","加入十字军"]]],"gre",7310,1,0,"s:crusades/i:crusading/p:crusaded"],"crusader":[[["n.",["十字军战士","改革者"]]],null,14357,0,0,"s:crusaders"],"crush":[[["v.",["压破","征服","塞","弄皱","榨出"]],["n.",["压碎","粉碎","群众","迷恋"]]],"cet4 cet6 ky toefl ielts",4311,2,1,"d:crushed/i:crushing/3:crushes",[["It looks like Tom has a crush on Mary.","看来汤姆热恋着玛丽。"]]],"crust":[[["n.",["外壳","坚硬外皮","面包皮"]],["v.",["盖以硬皮","结硬皮"]]],"cet4 cet6 ky toefl ielts gre",5659,1,0,"s:crusts/d:crusted/i:crusting",[["The snow lay on the ground, frozen into a thick, hard crust.","地上覆盖着积雪，冻成了又硬又厚的壳。"]]],"crustacean":[[["adj.",["甲壳纲的"]],["n.",["甲壳纲动物"]]],"toefl",20077,0,0,"s:crustaceans"],"crusty":[[["",["硬的","有壳的","似外皮的"]],["adj.",["有硬皮的","易怒的"]]],null,13502,1,0,"s:crusties/r:crustier"],"crutch":[[["n.",["拐杖","支撑","依靠"]],["v.",["支撑"]]],"gre",11589,1,0,"s:crutches",[["A young girl on crutches asked Tom where he lived.","一个拄着拐杖的年轻女孩问汤姆他住在哪里。"]]],"crux":[[["n.",["十字架形","关键","难题"]],["",["十字","十字形"]]],"gre",15246,0,0,"s:cruxes"],"cry":[[["v.",["哭","叫","喊","叫喊","大声说"]],["n.",["叫声","哭声","大叫"],["a loud utterance; often in protest or opposition"]]],"zk gk",1351,4,1,"p:cried/i:crying/s:cries",[["Crying out, the little girl was looking for her mother.","小女孩哭着找她的妈妈。"]]],"cryogenic":[[["",["降温的","产低温的"]],["adj.",["低温学的"]]],"gre",24188,0,0],"crypt":[[["n.",["土窖","地穴","地下室"]],["",["隐窝","滤泡","腺管"]]],"gre",18273,1,0,"s:crypts"],"cryptic":[[["adj.",["神秘的","含义模糊的","隐藏的"]],["",["隐蔽的"]]],"toefl gre",14482,1,0],"crystal":[[["n.",["水晶","水晶装饰品","结晶"]],["adj.",["水晶的","水晶一样的","透明的"]]],"cet4 cet6 ky toefl ielts",3574,3,0,"s:crystals",[["Far away beyond the pine-woods, there is a little garden. There the grass grows long and deep, there are the great white stars of the hemlock flower, there the nightingale sings all night long. All night long he sings, and the cold crystal moon looks down, and the yew-tree spreads out its giant arms over the sleepers.","越過松林，遠處有一座小花園。那裡青草長得又長又茂盛，鐵杉花像潔白的星星一樣閃耀，夜鶯整夜唱歌。牠整夜歌唱，冰冷的月光俯…"]]],"crystalline":[[["adj.",["透明的","水晶般的","水晶制的"]]],"toefl",14902,0,0],"crystallization":[[["n.",["结晶","定形","明朗化","具体化"]]],"toefl",28058,0,0,"s:crystallizations"],"crystallize":[[["v.",["使结晶","使具体化","结晶","具体化"]]],"toefl",14941,1,0,"d:crystallized/i:crystallizing/3:crystallizes"],"ct":[[["",["计算机断层扫描","通信终端","计算机终端","计算机断层造影","计数器"]]],null,0,0,1,"s:cts"],"cub":[[["n.",["幼兽","年轻人"]]],"gre",10403,1,0,"s:cubs/i:cubbing/p:cubbed",[["One may only catch the tiger cub by entering the tiger's den.","不入虎穴，焉得虎子。"]]],"cuban":[[["adj.",["古巴的","古巴人的"]],["n.",["古巴人"]]],"toefl",4190,0,0,"s:cubans",[["He was born Cuban.","他生來就是古巴人。"]]],"cube":[[["n.",["立方体","立方"]]],"gk cet4 cet6 ky toefl ielts",5725,2,0,"s:cubes/d:cubed/i:cubing",[["When the heater in the barn fails, you get milk-flavoured ice cubes.","當牛舍的暖氣壞了, 你就會有牛奶味的冰塊。"]]],"cubic":[[["adj.",["立方体的","立方的"]]],"gk cet4 cet6 toefl",7772,1,0],"cubicle":[[["n.",["小卧室"]],["",["小隔间(宿舍或病室中的)"]]],"gre",10473,1,0,"s:cubicles"],"cubism":[[["n.",["立体派"]]],"toefl",22207,0,0],"cuckoo":[[["n.",["杜鹃鸟","布谷鸟"]]],"cet6",21814,1,0,"s:cuckoos/i:cuckooing/p:cuckooed",[["People call this kind of bird a cuckoo.","人們把這種鳥叫做布穀鳥。"]]],"cucumber":[[["n.",["黄瓜","胡瓜"]]],"cet4 cet6 ky toefl ielts",8294,1,0,"s:cucumbers",[["Shall I put in a few cucumbers?","我放幾根黃瓜？"]]],"cuddle":[[["v.",["抚抱","抱着睡","拥抱","依偎","依偎着躺在一起"]],["n.",["搂抱","拥抱"]]],"gre",14556,1,0,"i:cuddling/p:cuddled/s:cuddles"],"cuddly":[[["adj.",["可爱的","适于搂抱的","喜欢拥抱的","可拥抱的"]]],null,20852,1,0,"r:cuddlier/t:cuddliest"],"cue":[[["n.",["提示","线索"]],["v.",["给...暗示(或提示)"]],["",["尾接指令"]]],"cet4 cet6 ky toefl ielts gre",4874,3,0,"s:cues/d:cued/i:cueing"],"cuff":[[["n.",["袖口","一巴掌"]],["v.",["用巴掌打","殴斗"]]],"gre",6960,1,0,"s:cuffs/p:cuffed/i:cuffing",[["Cuff him.","把他铐上。"]]],"cuisine":[[["n.",["烹调风格","烹调法","烹饪","厨房"]]],"gk toefl gre",6403,0,0,"s:cuisines",[["This restaurant serves French cuisine, but with Japanese tableware.","這家餐廳供應法國菜，但使用日式餐具。"]]],"cul-de-sac":[[["n.",["死巷","死胡同","(喻)困境","死路","盲管"]]],null,0,1,0,"s:cul-de-sacs",[["It's the 26th of April of 2025. Before 14:00, a sunny blue-sky afternoon, I went to my neighbourhood's cul-de-sac to meditatively walk around and around there. I admired the gardens. They reminded me of Daoism: how the microcosm reflects the macrocosm: The puffs of sakura would be a nebula afar. One need not really travel too far. Barb my white neighbour was at her driveway. She and her husband Ken would be going out to buy eggs. They eat many eggs.","那是 2025 年 4 月 26 日。下午兩點前，陽光明媚，萬里無雲。我來到我家附近的死胡同，靜靜地漫步。我欣賞著花園…"]]],"culinary":[[["adj.",["厨房的","烹调用的"]]],"toefl gre",7754,1,0,[["India is a region rich in culinary culture.","印度是一个烹饪文化丰富的地区。"]]],"cull":[[["v.",["采","摘","拣"]],["n.",["拣出的等外品","被剔出的动物"]]],null,13212,1,0,"d:culled/i:culling/s:culls",[["Although the male goat kids are often culled because they will never produce milk, they are sometimes castrated instead and allowed to remain in the herd as a \"wether\". With a bell around its neck, such a \"bellwether\" is usually the leader for the rest of the herd.","雖然公山羊羔經常因為無法產奶而被淘汰，但有時牠們會被閹割，並作為「閹羊」留在羊群中。這種脖子上掛著鈴鐺的「領頭羊」通常…"]]],"culminate":[[["v.",["到绝顶","达于极点","达到高潮","使到绝顶","使达到高潮"]]],"cet6 toefl ielts",7686,1,0,"i:culminating/p:culminated/3:culminates"],"culmination":[[["n.",["顶点","高潮","最高点"]]],"toefl gre",12765,0,0,"s:culminations"],"culpability":[[["n.",["可责","有罪性","有过失"]]],null,19365,0,0],"culpable":[[["adj.",["该责备的","有罪的"]],["",["应受处罚","有罪"]]],"toefl gre",20145,0,0,[["According to what she said, he's culpable.","根據她所說的, 他是有罪的。"]]],"culprit":[[["n.",["犯人","罪犯","刑事被告","犯罪者"]]],"gre",8877,1,0,"s:culprits",[["None of them would admit to being the culprit.","他们没有一个人承认自己是犯人。"]]],"cult":[[["n.",["膜拜","礼拜式","祭仪","一群信徒"]],["",["迷信","巫术"]]],"toefl gre",5245,2,0,"s:cults"],"cultivar":[[["n.",["栽培变种","培育植物"]]],null,15047,0,0,"s:cultivars"],"cultivate":[[["v.",["培养","耕作"]]],"cet4 cet6 ky toefl ielts gre",5574,2,0,"d:cultivated/i:cultivating/3:cultivates",[["Good habits should be cultivated in childhood.","好习惯是从小养成的。"]]],"cultivation":[[["n.",["教化","培养","耕作"]]],"toefl ielts",9376,0,0,"s:cultivations"],"cultural":[[["adj.",["文化的","教养的","修养的"],["of or relating to the arts and manners that a group favors"]],["",["培养的"],["denoting or deriving from or distinctive of the ways of living built …"]]],"ielts",932,3,1,[["Furthermore, I still don't think this a huge cultural difference.","而且，我还是认为这准不是个巨大的文化区别。"]]],"culturally":[[["adv.",["从文化角度","文化意义上","在人文学方面"]]],null,5763,0,0],"culture":[[["n.",["文化","修养","耕种"],["a particular society at a particular time and place"]],["v.",["耕种","培养"]]],"zk gk cet4 cet6 ky toefl ielts",611,4,1,"s:cultures/d:cultured/i:culturing",[["The manners and customs of a country reflect its culture.","一个国家的风俗习惯反映了它的文化。"]]],"cumber":[[["v.",["妨害","阻碍","使受苦"]],["n.",["妨害","累赘"]]],"gre",0,0,0,"d:cumbered/i:cumbering/s:cumbers"],"cumbersome":[[["adj.",["笨重的","麻烦的","累赘的"]]],"toefl ielts gre",12228,1,0],"cumin":[[[