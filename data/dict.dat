ue":[[["n.",["评论文章","评论"]]],"toefl gre",4982,1,0,"s:critiques/d:critiqued/i:critiquing"],"critter":[[["n.",["家畜","马","牛","人"]]],null,13669,0,0,"s:critters"],"croak":[[["v.",["呱呱地叫","发牢骚","用嘶哑的声音说"]],["n.",["呱呱叫声","哇哇声"]]],"gre",16607,0,0,"p:croaked/i:croaking/3:croaks",[["The sound of crickets chirping and frogs croaking lulls me to sleep.","蟋蟀的叫声与蛙鸣催我入眠。"]]],"croat":[[["n.",["克罗地亚人","克罗地亚语"]]],null,11483,0,0,"s:croats"],"croatian":[[["adj.",["克罗地亚的","克罗地亚语的","克罗地亚人的"]],["n.",["克罗地亚人","克罗地亚语"]]],null,11282,0,0,"s:croatians"],"crochet":[[["n.",["钩针编织品","钩边"]],["v.",["用钩针编织"]]],"gre",32522,0,0,"i:crocheting/p:crocheted/3:crochets",[["A new art trend in New York City takes the age-old craft of crocheting to the streets, where traditionally walls and fences have been serving as canvases for graffiti artists.","紐約市出現了一種新的藝術潮流，將古老的鉤編工藝帶到了街頭。在那裡，傳統上，牆壁和柵欄一直是塗鴉藝術家的畫布。"]]],"crock":[[["v.",["使受伤","弄衰弱","摩擦脱色","衰竭"]],["n.",["壶","罐","碎瓦片"]]],null,18329,0,0,"s:crocks/p:crocked/i:crocking"],"crockery":[[["n.",["陶器","瓦器"]],["",["土器"]]],"gre",26562,0,0],"crocodile":[[["n.",["鳄鱼"]]],"ielts",10171,1,0,"s:crocodiles/p:crocodiled",[["His leg was bitten by a crocodile.","他的腿被鱷魚咬了。"]]],"croissant":[[["n.",["羊角面包"]]],null,18389,0,0,"s:croissants"],"crony":[[["n.",["密友","亲密伙伴","好朋友"]]],null,13579,1,0,"s:cronies"],"cronyism":[[["n.",["任人唯亲"]]],"gre",25177,0,0],"crook":[[["n.",["钩","弯曲部分","坏蛋"]],["v.",["使弯曲","诈骗","弯曲"]]],"gre",8651,2,0,"s:crooks/p:crooked/i:crooking",[["In our society we find men of integrity along with crooks.","我們的社會良莠不齊。"]]],"croon":[[["v.",["低声歌唱","低唱","低吟"]],["n.",["低唱","低吟","轻哼"]]],"gre",15619,1,0,"p:crooned/i:crooning/3:croons"],"crop":[[["v.",["收割","修剪","种植","收获"]],["n.",["农作物","产量","平头"]],["",["裁剪"]]],"gk cet4 cet6 ky",2461,3,1,"s:crops/d:cropped/i:cropping",[["Without bee pollination, California's almond crop, for example, would be non-existent.","例如，如果沒有蜜蜂授粉，加州的杏仁作物就不會存在。"]]],"cropland":[[["",["农地"]]],null,17687,0,0,"s:croplands"],"cross":[[["n.",["十字架","十字架形物件","