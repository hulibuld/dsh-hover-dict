[["n.",["口是心非","不诚实","表里不一"]],["",["并胚","双畸胎","联胎"]]],"gre",21039,0,0,"s:duplicities"],"durability":[[["",["耐久性","耐用性","持久性"]]],null,11734,0,0,"s:durabilities"],"durable":[[["adj.",["持久的","耐用的"]]],"cet4 cet6 ky toefl ielts",7949,2,0,"s:durables"],"duration":[[["n.",["持续时间","持续"]]],"cet4 cet6 ky toefl ielts gre",5426,2,0,"s:durations"],"duress":[[["n.",["强迫","监禁","威胁"]]],"gre",19646,0,0,"s:duresses"],"during":[[["prep.",["在...的时候"],["In the time of; as long as the action or existence of"]]],"zk gk",198,5,1,[["During hot weather, be sure to drink lots of water.","天氣熱的時候記住要多喝水。"]]],"dusk":[[["n.",["薄暮","傍晚","黄昏"]],["adj.",["微暗的"]],["v.",["(使)微暗"]]],"gk cet4 cet6 ky",7212,1,0,"s:dusks/i:dusking/p:dusked",[["At dusk, the sky glows with a purple light.","傍晚時分，天空泛著紫色的光。"]]],"dusky":[[["adj.",["微暗的","暗淡的","暗黑色的","多黑影的","黑黝黝的"]]],"toefl",18555,0,0,"r:duskier"],"dust":[[["n.",["灰尘","尘埃","粉末","花粉","土"]],["v.",["拂去灰尘","撒","弄成粉末","化为粉末"]]],"gk cet4 cet6 ky ielts",2263,3,1,"i:dusting/p:dusted/s:dusts",[["I sucked up the dust on the floor with a vacuum cleaner.","我用吸塵機把地上的灰塵吸掉了。"]]],"dustbin":[[["n.",["垃圾箱"]]],"gk",28258,1,0,"s:dustbins"],"duster":[[["n.",["掸子","打扫灰尘的人"]]],null,18572,0,0,"s:dusters"],"dusty":[[["adj.",["灰尘多的","无聊的","含糊的","粉末状的"]]],"gk",5298,1,0,"r:dustier"],"dutch":[[["n.",["荷兰人","荷兰语"]],["adj.",["荷兰的"]]],null,4059,0,0,[["I still have lessons in French and Dutch to take.","我还有法语课和荷兰语课要上。"]]],"dutiful":[[["adj.",["尽职的","忠实的","顺从的","守本分的"]]],"gre",19141,1,0],"dutifully":[[["adv.",["忠实地","忠贞地"]]],null,12991,0,0],"duty":[[["n.",["责任","关税","职务","尊敬"],["the social force that binds you to the courses of action demanded by …"]],["",["职责"]]],"zk gk cet4 cet6 ky ielts",1752,4,1,"s:duties",[["I believe that it's my duty to protect these children.","我認為我有義務保護這些孩子。"]]],"duty-free":[[["adj.",["免税的"]]],null,0,1,0,"3:duty-frees",[["Is this a duty-free shop?","這是一間免稅商店嗎？"]]],"duvet":[[["n.",["羽绒被"]]],null,26843,1,0,"s:duvets"],"dvd":[[["",["数字化视频光盘（Digital Video Disk）"]]],"zk gk",0,0,1,[["This is a DVD.","这是DVD。"]]],"dwarf":[[["n.",["矮子","侏儒"]],["v.",["(使)变矮小"]]],"cet6 ky toefl ielts gre",6855,2,0,"s:dwarfs/d:dwarfed/i:dwarfing",[["The populations of China and India dwarf those of every other nation.","中国和印度的人口超过了其他任何国家。"]]],"dwell":[[["v.",["居住","居住(于)","存在(于)"]]],"cet6 ky toefl ielts",7180,1,0,"d:dwelt/3:dwells/i:dwelling",[["He dwells in the country.","他住在鄉下地區。"]]],"dweller":[[["n.",["居民"]]],"toefl",10815,1,0,"s:dwellers",[["City dwellers have a higher death rate than country people do.","城市居民的死亡率高于农村里的人。"]]],"dwelling":[[["n.",["住处"]],["",["住房"]]],"cet4 cet6 ky toefl gre",8213,1,0,"s:dwellings"],"dwindle":[[["v.",["减少","缩小","衰落","使缩小"]]],"toefl ielts gre",10733,1,0,"p:dwindled/i:dwindling/s:dwindles",[["It's Lulu Island, 3 August 2025. After supper—green figs tender with sunlight, sweet vinegar from yesterday’s pickled jar, and reheated Alfredo—I sat on the balcony and watched the conifer. Stillness below, a street without cars, without haste. My lime water, iced, caught the light. Michael, the Franco-Danish ufologist, has been in my conversations lately. We speak of inner things: the trance of smart devices, the mind’s eye dwindling. He says cafés aren’t cafés anymore. People forget how to look, how to linger. I tell him of Arthur in Japan—how he'd stare into blank walls like a monk gazing at emptiness. Lately I ask machines to speak like poets, and they do. They mimic Elizabethan verses and the old wistful lilt of Tagalog ballads. I pick blackberries along the path to Tim Hortons. \"¡Moras!\" I shout like a child. My friend Mora, whose blood flows with Andes mist, would smile. Today, I bought lemons. I meant limes, but lemons are all right. / blackberry morning— / a fig's ghost on my fingers / and the street still sleeps","現在是 2025 年 8 月 3 日，露露島。晚餐後，陽光下嫩綠的無花果，昨天醃製的甜醋，還有重新加熱的阿爾弗雷多義麵…"]]],"dyad":[[["",["二价元集(或基)","双","对","成对之物","并矢"]],["n.",["二","一对","二元一位"]]],null,18814,0,0,"s:dyads"],"dye":[[["v.",["染","染色","被着色"]],["n.",["颜料","染料"]]],"cet4 cet6 ky toefl",8956,2,0,"s:dyes/d:dyed/i:dyeing",[["It's become a hassle to keep on dyeing my hair.","一直染发太麻烦了。"]]],"dyke":[[["n.",["堤"]]],null,23644,1,0,"s:dykes/i:dyking/p:dyked"],"dynamic":[[["adj.",["动态的","有活力的","有力的","动力的","不断变化的"]],["n.",["动力","动态"]]],"gk cet4 cet6 ky toefl ielts gre",3978,2,0],"dynamical":[[["adj.",["动力的","动态的","动力学的","(褒)有生气的","有力的"]],["n.",["动力","动态","原动力"]]],"cet6",28387,0,0],"dynamics":[[["n.",["动力学"]]],"toefl",4071,0,0],"dynamism":[[["n.",["物力论","力本说"]],["",["动力说","动力病原论"]]],null,17078,1,0],"dynamite":[[["v.",["炸毁","破坏"]],["n.",["炸药"]]],null,12133,1,0,"i:dynamiting/p:dynamited/3:dynamites"],"dynamo":[[["n.",["发电机","电机"]]],"cet6 gre",20306,1,0,"s:dynamos"],"dynasty":[[["n.",["朝代","王朝"]]],"gk ky",10552,1,0,"s:dynasties",[["In this tomb from the Han dynasty, a book was found.","這個漢墓中發現了帛書。"]]],"dysfunction":[[["n.",["机能不良","机能障碍"]]],null,9452,0,0,"s:dysfunctions"],"dysfunctional":[[["adj.",["功能失调的"]]],"gre",9869,0,0],"dyslexia":[[["n.",["诵读困难"]]],"gre",20476,0,0,"s:dyslexias"],"dyspeptic":[[["adj.",["消化不良的","引起消化不良的","患消化不良的"]],["n.",["消化不良者"]]],"gre",34500,0,0],"e.g.":[[["",["举例来说"]]],null,0,2,0],"each":[[["pron.",["每个","个人","各自"]],["adj.",["每个","每一"]],["adv.",["每个"]]],"zk gk",192,5,1,[["Mr. and Mrs. Smith live apart from each other now.","史密斯夫妇现在分居了。"]]],"eager":[[["adj.",["热心的","渴望的","热望的"]]],"gk cet4 cet6 ky toefl",3123,3,0,[["He thinks that they are eager for glory.","他以为他们渴望荣耀。"]]],"eagerly":[[["adv.",["渴望","热衷于","热切"]]],null,7470,0,0,[["The pupils listened eagerly during his speech.","他演講的時候，學生們都聽得十分入神。"]]],"eagerness":[[["n.",["热心"]]],null,12855,0,0],"eagle":[[["n.",["鹰","鹰状标饰"]]],"gk cet4 cet6 ky ielts",45890,2,0,"s:eagles/p:eagled/i:eagling",[["As the lion is king of beasts, so is the eagle king of birds.","如果獅子是百獸之王的話，鷹就是百鳥之王了。"]]],"eaglet":[[["n.",["小鹰"]]],"gre",42804,0,0],"ear":[[["n.",["耳朵","倾听","听觉","穗"],["the sense organ for hearing and equilibrium"]],["v.",["抽穗"]]],"zk gk",1337,3,1,"s:ears",[["You'll have to play it by ear at the interview.","在面試的時候你必須見機行事。"]]],"earl":[[["n.",["伯爵"]]],null,19359,0,0,"s:earls",[["This 14th of May of 2025 is cloudy skies interspersed with blue spaces. I walked to the Roman Catholic church on St. Albans Road twice, once in the morning and again in the afternoon, my 12th and 13th times this spring. In the morning was confession for the little boys and girls in uniform. They were of different races, in the big worship hall. The priest was in the confession booth talking to a student. At the Adoration Chapel, I noticed a nice pot of orchids on the front left. In the afternoon, the big worship hall was mostly empty, a condition which I usually prefer. At the road was a handsome muscle man in white tank top jogging. The big purple-bloom tree seems like an Empress Tree, a Paulownia, because of the big heart-shaped leaves. Reminiscent of Jacaranda with its purple blooming, it's saudade for me about South America. At Tim Hortons café, I enjoyed Scrambled Eggs with Sausage and Potatoes and an Earl Grey Tea with oat milk in the morning, and an Iced Classic Lemonade in the afternoon. The day was full of walking. At home, I study bits of Lojban and Esperanto. I have many books in Esperanto. I tend towards Animism-Buddhism in my Syncretism.","2025 年 5 月 14 日，天空多雲，間或有藍色空間。我兩次走到聖奧爾本斯路上的羅馬天主教堂，一次在早上，一次在下…"]]],"early":[[["adj.",["早的","早熟的"],["at or near the beginning of a period of time or course of events or b…"]],["adv.",["很早","初"]]],"zk gk",365,5,1,"r:earlier/t:earliest",[["He used to get up early when he was young.","他小時通常很早起床。"]]],"earmark":[[["n.",["耳上记号","特征","记号","标记"]],["v.",["在耳朵上做记号","标记","指定...作特定用途"]]],null,12180,1,0,"d:earmarked/i:earmarking/3:earmarks"],"earn":[[["v.",["赚得","获得","博得"],["acquire or deserve by one's efforts or actions"]],["",["欧州科学研究网"]]],"gk cet4 ky",1305,4,1,"i:earning/d:earned/3:earns",[["Blondes earn 7% more than women with any other hair color.","金髮女郎比其他顏色頭髮的女人多賺7％。"]]],"earner":[[["n.",["赚钱的人"]]],null,13935,1,0,"s:earners"],"earnest":[[["n.",["定金","诚挚","认真"]],["adj.",["认真的","热心的","重要的"]]],"cet4 cet6 ky toefl gre",7000,2,0,"s:earnests",[["They refused to talk to me in spite of my earnest request.","尽管我恳切地要求，他们还是拒绝跟我说话。"]]],"earnestly":[[["adv.",["诚挚地","认真地"]]],null,15269,0,0,[["If you study earnestly, you can expect to pass the exam.","如果你认真学习，就有希望通过考试。"]]],"earnings":[[["n.",["所赚的钱","工资","收入","收益","盈余"]]],"cet6",2918,3,0,[["Corporate earnings in the first quarter improved sharply.","企业第一季度收益大幅增长。"]]],"earphone":[[["n.",["耳机","听筒"]]],null,18386,0,0,"s:earphones",[["When I study, I listen to music with earphones.","我溫習的時候會戴着耳機聽音樂。"]]],"earplug":[[["n.",["耳塞"]]],"gre",23001,0,0,"s:earplugs",[["I put in earplugs.","我塞了耳塞。"]]],"earring":[[["n.",["耳环","耳饰"]]],"gre",6973,1,0,"s:earrings",[["I got these earrings from my grandmother.","這對耳環是祖母送給我的。"]]],"earshot":[[["n.",["听力所及之范围","可听距离"]]],"gre",16303,0,0],"earsplitting":[[["adj.",["震耳欲聋的"]]],"gre",0,0,0],"earth":[[["n.",["地球","泥土","世界","尘世"],["the 3rd planet from the sun; the planet we live on"]],["v.",["埋入土中","赶入洞内","躲入洞内"]]],"zk gk",1547,4,1,"s:earths/d:earthed/i:earthing",[["It used to be thought that the earth was flat.","以前的人以為地球是平的。"]]],"earthbound":[[["adj.",["只在地球上的","只在地面的","只在陆地的","世俗的","平凡的"]]],null,19899,0,0],"earthen":[[["adj.",["土制的","陶制的"]]],null,17960,0,0],"earthenware":[[["n.",["陶器","土器"]]],"cet6 toefl",19779,0,0,"s:earthenwares"],"earthly":[[["adj.",["地球的","俗世的","可能的"]]],"gre",10176,1,0,[["Life never ends but earthly life does.","生活从不会停止，但世俗生活却会。"]]],"earthquake":[[["n.",["地震"]]],"gk cet4 cet6 ky toefl",4261,2,0,"s:earthquakes",[["If there's a big earthquake, the house could really collapse!","若有大地震，房屋会倒塌呀！"]]],"earthshaking":[[["adj.",["惊天动地的"]]],"gre",0,0,0],"earthy":[[["adj.",["土的","土质的","土味的"]]],"gre",12783,1,0,"r:earthier"],"ease":[[["v.",["使安乐","使安心","减轻","放松","灵活地移动"]],["n.",["安乐","安逸","悠闲"]]],"gk cet4 cet6 ky ielts",3229,3,1,"p:eased/i:easing/3:eases",[["My mind is at ease believing you'll keep the secret.","我十分安心，因為我知道你會