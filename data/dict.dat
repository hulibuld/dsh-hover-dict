.",["调情","挑逗","调戏","不认真的考虑"]]],null,16941,0,0,"s:flirtations"],"flit":[[["n.",["掠过","迁徙"]],["v.",["掠过","迁徙"]]],"gre",14466,1,0,"p:flitted/i:flitting/3:flits"],"float":[[["v.",["浮动","飘动","散播","摇摆","动摇"]],["n.",["漂流物","浮舟","漂浮","浮萍","彩车"]]],"gk cet4 cet6 ky toefl ielts",3140,3,1,"i:floating/p:floated/s:floats",[["The substance is light enough to float on the water.","這種物質很輕，可以浮在水面上。"]]],"flock":[[["n.",["兽群","鸟群","一群人","大量","棉束"]],["v.",["成群而行","聚集","用棉束填满"]]],"cet4 cet6 ky toefl ielts gre",6596,2,0,"s:flocks/p:flocked/i:flocking",[["Birds of a feather flock together.","物以类聚。"]]],"flog":[[["v.",["鞭打","鞭策","严厉的批评","迫使"]]],null,21116,1,0,"i:flogging/d:flogged/3:flogs",[["Then Pilate took Jesus and had Him flogged. The soldiers twisted together a crown of thorns, put it on His head, and dressed Him in a purple robe. And they went up to Him again and again, saying, “Hail, King of the Jews!” and slapping Him in the face.","於是彼拉多把耶穌帶去鞭打。兵丁用荊棘編作冠冕，戴在他頭上，又給他穿上紫袍。他們上前一遍遍地打他，說道：「萬歲，猶太人的…"]]],"flood":[[["v.",["淹没","使泛滥","注满","被淹","溢出"]],["n.",["洪水","大量之水","涨潮"]]],"gk cet4 cet6 ky toefl",3582,3,1,"d:flooded/s:floods/i:flooding",[["A lot of houses were washed away by the flood.","许多房屋被洪水冲走了。"]]],"floodgate":[[["n.",["水门","水闸","防潮水闸"]]],"gre",21192,0,0,"s:floodgates"],"floodlight":[[["n.",["照明灯","泛光"]],["v.",["用泛光灯照亮"]]],null,21032,1,0,"s:floodlights/i:floodlighting/p:floodlit"],"floodplain":[[["n.",["泛滥平原"]]],"toefl",17852,0,0,"s:floodplains"],"floodwaters":[[["",["洪水"]]],null,18037,0,0,[["Some people clung to tree branches for several hours to avoid being washed away by the floodwaters.","为了不被洪水冲走，有的人紧紧地抱着树干长达数个钟头。"]]],"floor":[[["n.",["地板","楼层","底部","底价","地面"],["the inside lower horizontal surface (as of a room, hallway, tent, or …"]],["v.",["铺地板","打倒"]]],"zk gk",639,4,1,"s:floors/d:floored/i:flooring",[["He was discovered unconscious on the floor of the kitchen.","他被人发现倒在厨房的地板上，不省人事。"]]],"floorboard":[[["n.",["一块地板","汽车底部板"]]],null,14191,1,0,"s:floorboards/i:floorboarding",[["Tom pried up the floorboards looking for the hidden gold coins.","湯姆撬開地板，尋找隱藏的金幣。"]]],"flooring":[[["n.",["地板","地板材料","铺地板"]]],null,14473,1,0,"s:floorings",[["An initial medical examination conducted in September showed the elephant’s nails had cracked and were overgrown due to improper care and an insufficient enclosure with flooring that damaged its feet.","9 月進行的初步體檢顯示，由於照料不當和圍欄地面破損，導致大象的爪子開裂並過度生長，從而損傷了牠的腳。"]]],"flop":[[["n.",["砰然落下","拍击声","失败"]],["v.",["笨重地摔","猛落","笨拙地抛下"]],["adv.",["噗通"]]],null,9863,2,0,"p:flopped/i:flopping/s:flops"],"floppy":[[["adj.",["叭嗒叭嗒响的","松软的"]]],"gre",12505,1,0,"s:floppies/r:floppier",[["Floppy disks are the predecessor of hard disks.","软盘是硬盘的前身。"]]],"flora":[[["n.",["植物群","植物区系","植物丛","菌丛"]]],"toefl gre",11331,1,0,"s:floras"],"floral":[[["adj.",["花似的","花的","植物的"]]],"toefl",8357,1,0,"s:florals"],"florentine":[[["n.",["佛罗伦萨人","佛罗伦萨绸"]],["adj.",["佛罗伦萨的"]]],null,18843,0,0,"s:florentines"],"florescence":[[["n.",["开花","花期","全盛期"]],["",["开花期","花候"]]],"gre",44441,0,0],"florid":[[["adj.",["华丽的","红润的"]],["",["鲜红的"]]],"toefl gre",22727,0,0],"florist":[[["n.",["花匠","花商","花卉研究者"]]],null,14041,0,0,"s:florists"],"flotation":[[["",["浮","浮游选矿","浮集(法)","浮选(法)"]]],null,22726,1,0,"s:flotations"],"flounder":[[["v.",["挣扎","折腾","错乱地做事或说话"]]],"toefl gre",16327,2,0,"i:floundering/p:floundered/s:flounders"],"flour":[[["n.",["面粉","粉沫","碎粉","麦粉"]]],"gk cet4 cet6 ky toefl ielts",3429,2,1,"s:flours/p:floured/i:flouring",[["We need flour, sugar and eggs to make this cake.","我們需要麵粉、砂糖和雞蛋來做這個蛋糕。"]]],"flourish":[[["v.",["繁荣","茂盛","活跃","手舞足蹈","挥舞"]],["n.",["挥舞","炫耀","茂盛","兴旺","华丽词藻"]]],"cet4 cet6 ky toefl ielts gre",6209,2,0,"p:flourished/i:flourishing/s:flourishes",[["For how long did the Maya culture flourish?","玛雅文明繁荣了多久？"]]],"flourishment":[[["n.",["繁荣"]]],"ielts",0,0,0],"flout":[[["v.",["嘲笑","愚弄","表示轻蔑"]],["n.",["嘲笑","愚弄","轻视"]]],"toefl gre",19665,1,0,"d:flouted/i:flouting/3:flouts"],"flow":[[["v.",["流动","流泄","畅流","川流不息","飘扬"]],["n.",["流程","流动","流量","洋溢","泛滥"],["t