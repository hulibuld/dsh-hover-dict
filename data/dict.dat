m the lost lands, and present ourselves at the imperial court.","壮志饥餐胡虏肉，笑谈渴饮匈奴血。待从头、收拾旧山河，朝天阙。"]]],"feat":[[["n.",["壮举","功绩","技艺表演"]],["adj.",["灵巧的","合适的","整洁的"]]],"ky toefl ielts gre",7177,2,0,"s:feats"],"feather":[[["v.",["长羽毛","用羽毛装饰"]],["n.",["羽毛"]]],"gk cet4 cet6 ky",4531,2,1,"s:feathers/p:feathered/i:feathering",[["The bird was covered with white feathers.","鸟儿身上铺满了白色的羽毛。"]]],"featherweight":[[["n.",["非常轻的人或物","不重要的人","轻量级选手"]]],null,26501,1,0,"s:featherweights"],"feathery":[[["adj.",["生有羽毛的","柔软如羽毛的"]]],null,17736,0,0],"feature":[[["n.",["面孔的一部分(如眼、口等)","特征","容貌","特色","特写"],["a prominent attribute or aspect of something"]],["v.",["是...的特色","特写","放映","起重要作用"]],["",["特性"]]],"cet4 cet6 ky ielts gre",1190,4,1,"s:features/i:featuring/d:featured",[["It's not a bug, it's an undocumented feature.","这不是一个漏洞，而是一个没有写进文档的特性。"]]],"featureless":[[["adj.",["无特色的","平凡的"]]],null,19329,0,0],"feb.":[[["n.",["二月"]]],null,0,2,0],"febrile":[[["adj.",["发热的","热病的","热性的"]]],"gre",30661,0,0],"february":[[["n.",["二月"]]],"zk gk",0,4,1,[["He has not written to us since last February.","他從去年二月開始就沒寫信給我們。"]]],"fecal":[[["adj.",["排泄物的","渣滓的"]],["",["粪便的"]]],null,15689,0,0],"feces":[[["n.",["粪","屎"]],["",["粪便"]]],null,16631,0,0],"feckless":[[["adj.",["无效的","无能的","不负责任的"]]],"gre",25428,0,0,[["Our feckless opposition party didn't do enough to stop him.","我们软弱的反对派不足以阻止他。"]]],"fecund":[[["adj.",["生殖力旺盛的","多产的","丰饶的","肥沃的"]]],"gre",26800,0,0],"fecundity":[[["n.",["多产","丰饶","肥沃","繁殖力"]],["",["生殖能","生殖力"]]],"toefl gre",22711,0,0],"federal":[[["adj.",["联邦的","联合的","同盟的","联邦制的","联盟的"],["of or relating to the central government of a federation"]]],"cet4 cet6 ky toefl",493,4,1,[["Federal, state, and community officials immediately pledged to rebuild it.","聯邦、州及地方官員立即承諾將其重建。"]]],"federalism":[[["n.",["联邦制","联邦主义"]]],null,14583,1,0],"federalist":[[["n.",["联邦制拥护者","联邦党","联邦派"]]],null,14470,0,0,"s:federalists"],"federally":[[["adv.",["同盟地","联邦地","联邦政府地"]]],null,9203,0,0],"federated":[[["adj.",["联邦的","联合的","