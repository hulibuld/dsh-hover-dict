]],"compass":[[["v.",["包围","达到","图谋","理解"]],["n.",["指南针","范围","音域"]]],"gk cet4 cet6 ky toefl ielts gre",7958,1,0,"s:compasses/p:compassed/i:compassing",[["Tom doesn't know how to use a compass.","汤姆不会使用指南针。"]]],"compassion":[[["n.",["同情","怜悯"]]],"ky toefl gre",4986,2,0,"s:compassions"],"compassionate":[[["adj.",["慈悲的","富于同情心的","照顾性的"]],["v.",["怜悯","同情"]]],"gre",7812,1,0,"i:compassionating/p:compassionated/3:compassionates"],"compatibility":[[["n.",["兼容性"]]],"cet6",12951,0,0,"s:compatibilities",[["Availability may vary by region and device compatibility.","實際提供內容可能因地區與裝置相容性而異。"]]],"compatible":[[["adj.",["能共处的","可并立的","适合的"]],["",["相容的","兼容的"]]],"cet6 ky toefl ielts gre",7017,2,0,"s:compatibles"],"compatriot":[[["adj.",["同国的","同胞的"]],["n.",["同国人"]]],"cet6 gre",15497,1,0,"s:compatriots",[["He is not willing to testify for his compatriot.","他不願意為同胞作證。"]]],"compel":[[["v.",["强迫","迫使"]]],"cet4 cet6 ky toefl ielts gre",4449,2,0,"d:compelled/i:compelling/3:compels",[["No one may be compelled to belong to an association.","不可以强迫任何人加入某个协会。"]]],"compendium":[[["n.",["纲要","概略"]],["",["简述"]]],"gre",18189,0,0,"s:compendia"],"compensate":[[["v.",["偿还","补偿","付报酬"]]],"gk cet6 ky toefl ielts gre",5037,2,0,"d:compensated/i:compensating/3:compensates",[["You must compensate him for the money he lost.","你需要赔偿他损失的钱。"]]],"compensation":[[["n.",["补偿","赔偿金","工资","代偿(机能)"]]],"cet6 ky toefl ielts",3796,3,0,"s:compensations"],"compensatory":[[["adj.",["赔偿的","补偿的","代偿的"]]],"toefl gre",14201,0,0,[["Blind people sometimes develop a compensatory ability to sense the proximity of objects around them.","某些失明者会产生一个弥补性的能力，这个能力让他们察觉到他们与离他们很近的物体的距离。"]]],"compete":[[["v.",["竞争","对抗"]]],"gk cet4 cet6 ky toefl gre",2065,3,1,"i:competing/p:competed/3:competes",[["Only four horses competed in the race.","只有四匹馬參加了比賽。"]]],"competence":[[["n.",["胜任","职称","能力","活性"]]],"gk cet6 toefl ielts gre",5191,1,0,"s:competences"],"competency":[[["",["权能","资格","资产"]],["n.",["足以使人过舒适生活的富裕收入","充裕的生活条件"]]],null,7316,0,0,"s:competencies"],"competent":[[["adj.",["能干的","胜任的","有效的","足够的","有权的"]]],"cet4 cet6 ky toefl",5797,2,0,[["I've been told that you're a very competent person.","有人說你是個很有能力的人。"]]],"competition":[[["n.",["竞争","竞赛","竞销","比赛"],["a business relation in which two parties compete to gain customers"]]],"zk gk cet4 cet6 ky toefl ielts",1345,4,1,"s:competitions",[["This soccer match is full of energetic and splendid competition.","这场足球赛充满着激情和精彩的竞争。"]]],"competitive":[[["adj.",["竞争的"]]],"cet4 cet6 ky ielts",2307,3,1,[["Sometimes hockey players get so competitive that fights break out.","有时候冰球运动员相互挑衅得太厉害以至于会引发斗殴。"]]],"competitively":[[["adv.",["好竞争地","有竞争力地"]]],null,19399,0,0],"competitiveness":[[["",["竞争"]]],"toefl",8110,0,0],"competitor":[[["n.",["竞争者","竞争对手"]]],"gk cet6",3259,3,0,"s:competitors",[["She's a tough competitor, isn't she?","她是強大的對手，不是嗎？"]]],"compilation":[[["n.",["编辑","编纂","编辑(编纂)物"]],["",["编译"]]],null,12566,1,0,"s:compilations"],"compile":[[["v.",["编译","编辑","编纂","收集"]]],"cet4 cet6 ky toefl ielts gre",5289,2,0,"d:compiled/i:compiling/3:compiles",[["Compiling a dictionary demands an enormous amount of time.","編字典是一項極花時間的工作。"]]],"complacence":[[["n.",["满足","自鸣得意","自满"]]],"toefl",45326,0,0],"complacency":[[["n.",["满足","自鸣得意","自满"]]],"gre",14595,0,0],"complacent":[[["adj.",["满足的","自满的","得意的"]]],"gre",14481,2,0],"complain":[[["v.",["抱怨","抗议","控诉"],["express complaints, discontent, displeasure, or unhappiness"]]],"cet4 cet6 ky toefl",1859,4,1,"p:complained/i:complaining/3:complains",[["Actions speak louder than words. Stop complaining and do it.","行动比语言更有说服力。别发牢骚多做事。"]]],"complaint":[[["n.",["诉苦","抱怨","控诉"]],["",["陈诉","病"]]],"cet4 cet6 ky toefl ielts",2325,3,1,"s:complaints",[["An increase in customer complaints could signal a decline in business.","顧客投訴量增加，可能代表生意正在走下坡。"]]],"complaisance":[[["n.",["谦恭","殷勤","顺从"]]],"gre",0,0,0],"complaisant":[[["adj.",["谦恭的","殷勤的","顺从的"]]],"gre",43768,0,0],"complement":[[["n.",["补足物","补语","补数","补码","反相器"]],["v.",["补充","补足"]]],"cet6 ky toefl ielts",6760,2,0,"d:complemented/3:complements/i:complementing",[["A complete intransitive verb takes neither complement nor object.","一个完完全全的不及物动词既没有补语，又没有宾语。"]]],"complementary":[[["adj.",["补充的","补足的"]]],"toefl gre",8490,1,0,"s:complementaries"],"complete":[[["adj.",["完全的","十足的","完成的"]],["v.",["完成","完工","使圆满"],["come or bring to a finish or an end; others finished in over 4 hours\""]]],"zk gk cet4 cet6 ky toefl ielts",1207,5,1,"d:completed/i:completing/3:completes",[["Which is more complete, the first edition or the second?","第一还是第二的版本比较齐全？"]]],"completely":[[["adv.",["完全地","十分地","圆满地"]]],"cet4 cet6",1169,0,1,[["No two rivers in the world are completely the same.","世界上没有两条完全相同的河流。"]]],"completeness":[[["n.",["完全"]],["",["完整性"]]],null,19229,0,0],"completion":[[["",["完井","结束","完工"]],["n.",["完成"]]],"cet6",5019,0,0,"s:completions",[["This building is near completion.","這座建築物快完工了。"]]],"complex":[[["n.",["综合体","情结","络合物"],["a conceptual whole made up of complicated and related parts"]],["adj.",["复杂的","组合的"],["complicated in structure; consisting of interconnected parts"]]],"gk cet4 cet6 ky toefl ielts",1598,4,1,"s:complexes/p:complexed",[["The situation was much more complex than he had thought.","事情可比他所想的要复杂得多。"]]],"complexion":[[["n.",["肤色","情况","局面"]],["",["体质","面色","面容"]]],"ielts gre",10375,1,0,"s:complexions"],"complexity":[[["n.",["复杂","复杂性","复杂的事物"]]],"cet6 toefl",3757,2,0,"s:complexities",[["He's contemplating the complexity of contemporary life.","他思考着现代生活的复杂性。"]]],"compliance":[[["n.",["遵从","顺从","屈从"]],["",["柔顺","顺应"]]],"ky ielts gre",4547,1,0,"s:compliances"],"compliant":[[["adj.",["顺从的","屈从的"]],["",["适用于","配合...使用"]]],"gre",15112,0,0,[["According to custom, the bride should be compliant.","根据习俗，新娘应该循规蹈矩。"]]],"complicate":[[["v.",["弄复杂","使错综","使恶化","变复杂"]]],"cet4 cet6 ky toefl gre",5983,1,1,"d:complicated/3:complicates/i:complicating",[["This form looks kind of complicated. Help me fill it out.","這個表格好像有點複雜，你可以幫我填嗎？"]]],"complicated":[[["adj.",["复杂的"]],["",["并发的"]]],"cet4 cet6 ky toefl ielts",2750,3,1,[["This form looks kind of complicated. Help me fill it out.","這個表格好像有點複雜，你可以幫我填嗎？"]]],"complication":[[["n.",["复杂化","复杂情况"]],["",["并发症","并发病"]]],"cet6 ky toefl ielts",4995,2,0,"s:complications",[["The emergence of a third gender has added legal and administrative complications, creating unnecessary burdens.","第三性別的出現增加了法律和行政上的麻煩，徒增無謂的負擔。"]]],"complicity":[[["n.",["同谋","串通","复杂"]],["",["共谋","共犯关系"]]],"toefl gre",13525,1,0,"s:complicities"],"compliment":[[["n.",["称赞","恭维","敬意"]],["v.",["称赞","褒扬","恭维"]]],"cet6 ky toefl ielts gre",7568,2,0,"s:compliments/p:complimented/i:complimenting",[["You should compliment it with a white camisole.","你裏面要搭一件白色的吊帶。"]]],"complimentary":[[["adj.",["问候的","称赞的","夸奖的"]]],"toefl",13108,1,0,"s:complimentaries"],"comply":[[["",["遵守","承诺","照做"]],["v.",["顺从","依从"]]],"cet6 ky toefl ielts gre",4637,2,0,"d:complied/i:complying/3:complies",[["Not complying with the naming conventions will result in parse errors.","不遵守命名规则会导致解析错误。"]]],"component":[[["n.",["元件","组件","成分"],["an abstract part of something"]],["adj.",["组成的","构成的"]]],"gk cet4 cet6 ky toefl ielts gre",1760,3,0,"s:components",[["The clan system is a key component of traditional Chinese culture.","宗族制度是中国传统文化的重要组成部分。"]]],"comport":[[["v.",["举动","表现","相称","适合"]]],"toefl gre",23213,0,0,"i:comporting/p:comported/s:comports",[["When one is in difficulty and comports themselves well, that is a master.","人之患，在好為人師。"]]],"compose":[[["v.",["组成","写作","作曲","使平静","创作"]],["",["编写"]]],"cet4 cet6 ky toefl ielts gre",3379,3,0,"d:composed/i:composing/3:composes",[["The committee is composed of three men and seven women.","委員會是由三男七女組成的。"]]],"composer":[[["n.",["作曲家","作家","调停者"]]],"cet6 gre",4999,2,0,"s:composers",[["Which of the composers do you like best?","你最喜欢哪位作曲家？"]]],"composite":[[["adj.",["合成的","混合成的","菊科的"]],["n.",["合成物","复合材料","菊科"]]],"cet6 ky ielts",6741,2,0,"s:composites"],"composition":[[["n.",["作文","创作","组成","成分"]]],"zk gk cet4 cet6 ky toefl ielts",3000,1,0,"s:compositions",[["Your composition is very good, and it has few mistakes.","你的作文非常好，而且错误很少。"]]],"compositional":[[["",["组合的"]]],null,14154,0,0],"compost":[[["n.",["混合物","堆肥"]],["v.",["施堆肥于"]]],"gre",6156,2,0,"s:composts/p:composted/i:composting",[["It's a sunny 3rd of July of 2025. On the 7th will be the Star Festival—Tanabata—in Japan. This morning, here on Lulu Island, I strolled to Tim Hortons café twice—Iced Coffee with oat milk, then Strawberry Watermelon Sparkling Quencher with a Sausage Farmer's Wrap. I went to the \"Clam Temple.\" On the way, I glanced at the charming bamboo grove. An old man had dug holes beside it to put compost—eaten mangoes and cherries. At the café, I spoke to Greg, the white man who eventually wants to own a B&B in Kushiro, Hokkaido, with his Japanese wife. The native Ainu and marshes are attractions there. Today, head-shaven Greg is wearing a beige T-shirt and beige shorts—maybe a hint of Chabacano?","今天是 2025 年 7 月 3 日，陽光明媚。7 月 7日是日本的七夕。今天早上，在露露島上，我兩次去了提姆霍頓斯咖…"]]],"composure":[[["n.",["镇静","沉着"]]],"toefl gre",12757,1,0,[["Looks like he has completely lost his composure.","他看起來完全無法鎮定。"]]],"compound":[[["v.",["化合","和解","妥协","使复合","使化合"]],["n.",["混合物","复合词","化合物","院子"]],["adj.",["复合的","混合的","化合的"]]],"cet4 cet6 ky toefl ielts gre",3428,2,0,"s:compounds/d:compounded/i:compounding",[["Do you know what compound words are?","你知道什么是复合词吗？"]]],"comprehend":[[["v.",["理解","包括"]]],"cet6 ky toefl gre",6899,1,0,"d:comprehended/i:comprehending/3:comprehends",[["Many people are unable to comprehend the actions of hackers.","很多人无法理解黑客们的行为。"]]],"comprehensible":[[["adj.",["可理解的"]]],"toefl gre",19208,0,0,[["Legal terminology is not comprehensible to most laypeople.","法律術語是大多數普通人無法理解的。"]]],"comprehension":[[["n.",["理解","包含"]]],"gk cet4 cet6 ky toefl",7826,1,0,[["That was beyond my comprehension.","那超出了我的理解。"]]],"comprehensive":[[["adj.",["广泛的","有理解力的","综合的","全面的"]]],"cet4 cet6 ky toefl gre",2896,3,0,"s:comprehensives",[["The service is also part of a comprehensive subscription plan, allowing users to choose the pricing and features that best fit individual and family needs.","此服務亦包含於綜合訂閱方案中，使用者可依個人或家庭方案選擇適合的價格與內容。"]]],"compress":[[["v.",["压缩","压紧","受压缩小"]],["",["压缩程序"]]],"cet4 cet6 ky toefl ielts gre",9510,1,0,"d:compressed/i:compressing/3:compresses"],"compression":[[["n.",["压缩","压紧"]]],"cet6 toefl",8364,0,0,"s:compressions",[["Data compression algorithms can be classified in two categories: those with data loss and those without data loss.","压缩数据的算法能分为两种：一种会造成数据损失，另一种则不会。"]]],"compressor":[[["n.",["压缩物","压缩机","压肌"]]],null,14780,0,0,"s:compressors"],"comprise":[[["v.",["包含","构成"]]],"cet4 cet6 ky toefl ielts",4392,2,0,"i:comprising/3:comprises/p:comprised",[["The committee is comprised of ten members.","這委員會有 10 位成員。"]]],"compromise":[[["n.",["妥协","折中","折中方案","和解"]],["v.",["妥协处理","危害"]]],"gk cet4 cet6 ky toefl ielts gre",3751,3,0,"s:compromises/d:compromised/i:compromising",[["In our view, we have already made the biggest possible compromise.","对于我们来说，这已经是做出了最大限度的让步了。"]]],"comptroller":[[["",["主计","会计师","审计"]],["n.",["审计官"]]],null,19425,1,0],"compulsion":[[["n.",["强迫","强制"]]],"gre",12079,1,0,"s:compulsions"],"compulsive":[[["adj.",["强制的","强迫的"]],["",["强迫性的"]]],"toefl",11963,1,0,"s:compulsives"],"compulsory":[[["adj.",["被强制的","强迫的","义务的","强制的"]]],"gk cet6 ky toefl ielts gre",12735,2,0,[["Attendance is compulsory for all members.","全員均須出席。"]]],"compunction":[[["n.",["良心的责备","后悔","悔恨"]]],"gre",27278,0,0,"s:compunctions"],"computation":[[["n.",["计算","计数","计算结果","估计","计算法"]]],"toefl",12953,0,0,"s:computations"],"computational":[[["adj.",["计算的"]]],null,13207,0,0],"compute":[[["v.",["计算","估算"]],["n.",["计算","估算"]]],"cet4 cet6 ky toefl ielts",7824,1,0,"d:computed/i:computing/3:computes",[["Can you compute the distance of the moon from the earth?","你可以把地球和月亮之間的距離計算出來嗎？"]]],"computer":[[["n.",["电脑","电子计算机"],["a machine for performing calculations automatically"]],["",["计算机"]]],"zk gk ielts",589,4,1,"s:computers",[["I often use SSH to remotely connect to my computer.","我经常使用SSH来远程连接到我的电脑。"]]],"computerize":[[["v.",["用电脑处理","使电脑化"]],["",["给...装备电脑","用电脑计算"]]],null,30944,2,0,"d:computerized/i:computerizing/3:computerizes"],"computerized":[[["adj.",["电脑的","用电脑处理的","电脑化的"]]],null,8037,0,0],"computing":[[["",["计算"]]],null,7845,2,0,[["Some of my classmates are pure noobs; they know nothing about computing sciences.","我的一些同学真是菜鸟，他们一点都不懂计算机。"]]],"comrade":[[["n.",["同志","伙伴"]]],"gk cet4 cet6 ky",7425,1,0,"s:comrades",[["Comrades! Let's transform Moscow into a model communist city.","同志们，让我们转换莫斯科为理想的共产主义城市。"]]],"con":[[["v.",["精读","仔细研究","默记"]],["n.",["反对者","反对票","肺结核"]],["adv.",["反面地","从反面"]],["adj.",["欺诈的"]],["",["控制台"]]],null,5617,2,0,"s:cons/d:conned/i:conning",[["He's a con man.","他是個騙子。"]]],"concatenate":[[["v.",["如锁链般连接","使连锁","连结"]],["adj.",["连锁的","连结的"]]],"gre",0,0,0,"p:concatenated/i:concatenating/3:concatenates"],"concave":[[["adj.",["凹的","凹面的"]]],"toefl gre",20157,0,0,"s:concaves"],"conceal":[[["v.",["隐藏","掩盖","隐瞒","隐匿","保守秘密"]]],"cet4 cet6 ky toefl ielts gre",5148,2,0,"d:concealed/i:concealing/3:conceals",[["We can normally conceal our thoughts from others.","我们通常会对其他人隐瞒自己的想法."]]],"concealment":[[["n.",["隐匿","隐蔽","躲藏"]],["",["隐瞒","匿报"]]],null,18604,0,0,"s:concealments"],"concede":[[["v.",["承认","退让","让步"]]],"cet6 ky toefl ielts gre",4192,3,0,"p:conceded/i:conceding/3:concedes",[["England’s goalkeeper was criticized for the amount of goals he conceded.","英格兰的守门员因为自己失球过多而被批评。"]]],"conceit":[[["n.",["自负","空想","狂妄"]]],"cet6 toefl gre",17757,1,0,"s:conceits",[["The world tolerates conceit from those who are successful, but not from anybody else.","世界只能容忍有成就的人的自傲。"]]],"conceivable":[[["adj.",["想得到的","可想象的","可理解的"]]],null,10412,1,0],"conceivably":[[["adv.",["想得到地","想象上","以为"]]],null,11991,0,0],"conceive":[[["v.",["构思","认为","怀孕"]]],"cet6 ky toefl ielts gre",4169,2,0,"d:conceived/3:conceives/i:conceiving",[["I can't conceive of living without him.","我無法想像生命中沒有他。"]]],"concentrate":[[["n.",["浓缩","精选"]],["v.",["集中","专心"]]],"gk cet4 cet6 ky ielts gre",2358,3,1,"d:concentrated/i:concentrating/3:concentrates",[["I can't concentrate on my work because of the noise.","由于噪音，我无法集中精力工作了。"]]],"concentration":[[["n.",["集中","专心"]],["",["浓度","浓缩"]]],"cet4 cet6 ky",2752,3,1,"s:concentrations",[["Housing prices in Hsinchu City have risen sharply due to the concentration of the tech industry.","新竹市區的房價因為科技產業聚集而水漲船高。"]]],"concentric":[[["adj.",["同中心的","同轴的"]],["",["同心的","共心的"]]],"toefl gre",16458,0,0],"concept":[[["n.",["观念","概念"],["an abstract or general idea inferred or derived from specific instanc…"]]],"gk cet4 cet6 ky toefl",1158,3,1,"s:concepts",[["I really like the concept of this website.","我觉得这个网站的概念非常好。"]]],"conception":[[["n.",["观念","概念","妊娠","受孕"]]],"cet6 toefl ielts gre",4636,2,0,"s:conceptions"],"conceptual":[[["adj.",["概念的"]]],"toefl",5522,1,0],"conceptualization":[[["",["概念表达"]]],null,12703,0,0,"s:conceptualizations"],"conceptualize":[[["v.",["使概念化"]],["",["概念表达"]]],null,11003,0,0,"d:conceptualized/i:conceptualizing/3:conceptualizes"],"conceptually":[[["adv.",["概念地"]]],null,14829,0,0],"concern":[[["v.",["与...有关","使担心","使挂念"]],["n.",["关心","忧虑"],["something that interests you because it is important or affects you"]]],"gk cet4 cet6 ky ielts",717,5,1,"s:concerns/p:concerned/i:concerning",[["As far as I'm concerned, this coffee is too strong.","这咖啡对我来说太浓了。"]]],"concerned":[[["adj.",["关心的","有关的","参与的","担心的"],["feeling or showing worry or solicitude"]]],"toefl",1128,3,1,[["As far as I'm concerned, this coffee is too strong.","这咖啡对我来说太浓了。"]]],"concert":[[["n.",["音乐会","和声","一致"]],["v.",["协力","协调"]],["",["美国北卡罗来纳州Internet网"]]],"zk gk cet4 cet6 ky toefl ielts",2515,3,1,"s:concerts/i:concerting",[["Do you know the concert schedule of London Symphony Orchestra?","你知道伦敦交响乐团的演奏会行程吗？"]]],"concerted":[[["adj.",["商定的","协定的","一致的","协力的","共同的"]]],"toefl ielts",11285,1,0],"concerto":[[["n.",["协奏曲"]]],"toefl gre",18992,1,0,"s:concertos"],"concession":[[["n.",["特许","让步