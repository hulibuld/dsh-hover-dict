",["船体","笨重的船","废然大物"]]],"gre",19575,1,0,"s:hulks/p:hulked/i:hulking"],"hull":[[["n.",["壳","皮","船体"]],["v.",["去壳"]]],"cet6 gre",6683,2,0,"s:hulls/p:hulled/i:hulling"],"hum":[[["n.",["嗡嗡声","哼声","杂声"]],["v.",["发低哼声","哼","用哼声表示"]],["int.",["哼","嗯"]]],"cet6 ky ielts",6823,2,0,"i:humming/p:hummed/3:hums",[["Stop humming and hawing!","不要再含糊其辞了！"]]],"human":[[["adj.",["人类的","似人类的","人性的","有同情心的"],["characteristic of humanity"]],["n.",["人","人类"]]],"zk gk cet4 ky toefl ielts",399,5,1,"s:humans",[["People used to think that only humans could use language.","以前人們以為只有人類才懂得用語言溝通。"]]],"humane":[[["adj.",["有人情的","人道的","仁慈的"]]],"toefl gre",8511,1,0],"humanism":[[["n.",["人本主义","人文主义","人道主义"]]],null,15197,1,0,[["Existentialism is a humanism.","存在主义是一种人道主义。"]]],"humanist":[[["n.",["人道主义者","人文学者"]]],"toefl",15277,0,0,"s:humanists"],"humanistic":[[["adj.",["人本主义的","人道主义的","人文主义的"]]],"toefl",16807,0,0],"humanitarian":[[["n.",["人道主义者","博爱者","基督凡人论者"]],["adj.",["人道主义的","博爱的","凡人论的"]]],"cet6 toefl",5270,2,0,"s:humanitarians",[["The phrase \"humanitarian bombing\" is an oxymoron.","「人道主義轟炸」一詞是自相矛盾的。"]]],"humanities":[[["n.",["人文学科"]]],null,10509,0,0],"humanity":[[["n.",["人性","人类","博爱"]]],"cet6 ky toefl ielts",3501,2,0,[["All humanity will suffer if a nuclear war breaks out.","一旦爆發核戰爭，受苦的將會是全人類。"]]],"humanize":[[["v.",["赋予人性","教化","使通人情","变为有人性","变得有情"]]],null,18160,0,0,"i:humanizing/p:humanized/3:humanizes"],"humankind":[[["n.",["人类"]]],null,11737,0,0,[["What are your dreams for the future of humankind?","你對人類的未來有什麼幻想嗎？"]]],"humanly":[[["adv.",["从人的角度","充满人性地","在人力所及范围"]]],null,18001,0,0],"humble":[[["adj.",["低下的","谦逊的","粗陋的"]],["v.",["使...卑下","降低...地位","贬抑"]]],"cet4 cet6 ky toefl ielts gre",5970,2,0,"d:humbled/3:humbles/i:humbling",[["Be it ever so humble, there's no place like home.","金窝银窝不如自己的狗窝。"]]],"humbly":[[["adv.",["谦逊地","卑贱地","低声下气地"]]],null,18569,0,0],"humdrum":[[["adj.",["平凡的","单调的","令人厌烦的"]],["n.",["平凡","单调","无聊"]],["v.",["单调令味地进行"]]],"ielts gre",25248,0,0],"humid":[[["adj.",["潮湿的","湿润的","多湿气的"]]],"cet4 cet6 ky toefl gre",10699,1,0,[["It is extremely hot and humid in Bali in December.","12月份巴厘岛极其炎热和潮湿。"]]],"humidity":[[["n.",["湿气","潮湿","湿度"]]],"cet6 ky toefl ielts gre",8375,1,0,"s:humidities"],"humiliate":[[["v.",["使丢脸","使蒙羞","屈辱"]]],"ky toefl ielts gre",9338,1,0,"d:humiliated/i:humiliating/3:humiliates",[["The boy was not humiliated by the laughter of his classmates.","那个男孩没有因为他同学的笑而谦卑。"]]],"humiliation":[[["n.",["耻辱","丢脸","谦卑"]]],"cet6",7690,2,0,"s:humiliations"],"humility":[[["n.",["谦逊","谦虚","谦卑"]]],"toefl gre",9485,1,0,[["Humility often achieves more than pride.","滿招損, 謙受益。"]]],"hummingbird":[[["n.",["蜂鸟"]]],"toefl",14998,0,0,"s:hummingbirds",[["Hummingbirds drink the sweet nectar from certain flowers.","蜂鳥會吸食某些花朵的甜美花蜜。"]]],"humor":[[["n.",["幽默","诙谐","心情"]],["v.",["迎合","牵就","顺应"]]],"cet4 ky gre",3057,0,0,"3:humors/i:humoring/p:humored",[["It is a pity that he has no sense of humor.","可惜他是一個完全沒有幽默感的人。"]]],"humorous":[[["adj.",["富幽默感的","滑稽的","诙谐的"]]],"zk gk cet4 cet6 ky toefl",9877,1,1,[["\"She's not only beautiful but also humorous.\" \"Can she cook?\" \"Who cares?\"","“她又有魅力又风趣！” “那她会做饭吗？” “谁在乎？”"]]],"humour":[[["n.",["幽默","诙谐","情绪","体液"]],["v.",["使满足","迁就"]]],"gk cet4 cet6",0,3,1,"s:humours/i:humouring/p:humoured",[["Tom's main problem is he has no sense of humour.","汤姆的主要问题是他一点幽默感都没有"]]],"hump":[[["v.",["隆起","急速行进","努力","使弓起","使烦恼"]],["n.",["驼背","圆形隆起物","鸵峰"]]],"toefl",13883,1,0,"s:humps/i:humping/p:humped"],"hunch":[[["v.",["弯腰驼背","预感到","耸肩","向前移动","隆起"]],["n.",["肉峰","预感","大块"]]],"gre",9261,1,0,"d:hunched/s:hunches/i:hunching",[["Tom had a hunch that Mary was seeing someone else.","汤姆预感到玛丽在见别人。"]]],"hundred":[[["n.",["百","百个东西"],["ten 10s"]],["num.",["百","百个"]],["adj.",["一百的","许多的"]]],"zk gk",621,5,0,[["This is a three-star hotel; three hundred dollars a night.","这里是三星级宾馆，三百元住一晚。"]]],"hundredth":[[["adj.",["第一百的"]]],null,20547,1,0],"hungarian":[[["adj.",["匈牙利的","匈牙利人的","匈牙利语的"]],["n.",["匈牙利人","匈牙利语"]]],null,10134,0,0,"s:hungarians",[["I'm translating the messages of the bot from English to Hungarian.","我正在把这个机器人的消息从英语翻译成匈牙利语。"]]],"hunger":[[["n.",["饥饿","渴望","饥荒"]],["v.",["使挨饿","挨饿","渴望"]]],"gk cet4 cet6 ky toefl",4584,2,0,"s:hungers/p:hungered/i:hungering",[["Many people are suffering from hunger around the world.","世界上许多人在挨饿。"]]],"hungry":[[["adj.",["饥饿的","荒年的","渴望的","不毛的"]],["",["欠鞣皮"]]],"zk gk",3181,2,1,"r:hungrier/t:hungriest",[["Please give me something to eat. I am so hungry.","可以給我一點吃的嗎？我快餓瘋了啦。"]]],"hunk":[[["adj.",["行的","好的"]],["n.",["大块"]]],"gre",12464,1,0,"s:hunks"],"hunker":[[["v.",["蹲座"]],["n.",["守旧者"]]],null,15585,0,0,"p:hunkered/s:hunkers/i:hunkering"],"hunt":[[["v.",["狩猎","打猎","搜索","猎食","搜寻"]],["n.",["狩猎","追捕","搜寻","猎区"]]],"gk cet4 cet6 ky ielts",3420,3,1,"i:hunting/d:hunted/s:hunts",[["Have you ever seen a snow leopard hunt in the mountains?","你見過雪豹在山上狩獵嗎？"]]],"hunter":[[["n.",["猎人","猎犬","追求者"]]],"gk",3030,3,0,"s:hunters",[["The hunters captured the wild animal with a strong rope net.","獵人們用堅韌的繩網把野生動物捉住了。"]]],"huntsman":[[["n.",["猎人","管猎犬者"]]],null,26792,1,0,"s:huntsmen"],"hurdle":[[["n.",["障碍","跳栏","临时活动篱笆"]],["v.",["用篱笆围","越过","克服"]]],"toefl gre",6611,2,0,"s:hurdles/i:hurdling/p:hurdled"],"hurdler":[[["n.",["跳栏比赛选手","制造竹篱笆者"]]],null,30479,1,0,"s:hurdlers"],"hurl":[[["v.",["用力投掷","发射","愤慨地说出","丢下","猛投"]],["n.",["用力的投掷"]]],"cet6 ky toefl ielts gre",7332,2,0,"p:hurled/i:hurling/3:hurls"],"hurrah":[[["n.",["欢呼声","骚动","欢乐"]],["v.",["欢呼","呼万岁","以欢呼迎接"]],["int.",["万岁"]]],"cet6",27116,0,0,"s:hurrahs/i:hurrahing/p:hurrahed"],"hurricane":[[["n.",["飓风","暴风","暴风雨"]]],"gk cet6 ky toefl ielts gre",4512,2,0,"s:hurricanes",[["After the hurricane, their house was a wreck.","暴风雨过后，他们的房子成了废墟。"]]],"hurriedly":[[["adv.",["仓促地","匆忙地"]]],null,13812,0,0,[["He wrote it hurriedly.","他写得很匆忙。"]]],"hurry":[[["v.",["急派","催促","匆忙","赶快"]],["n.",["匆忙","急忙","急促"]]],"zk gk",3609,2,1,"p:hurried/i:hurrying/3:hurries",[["Come on, we'll be late if you don't hurry up.","快點快點，你還慢吞吞的話我們就要遲到了。"]]],"hurt":[[["v.",["伤害","(使)伤心","危害","刺痛"],["give trouble or pain to"]],["n.",["伤害","创伤","损害"]]],"zk gk cet4 cet6 ky",1140,4,1,"i:hurting/3:hurts",[["She hurt her foot when she fell off her bicycle.","她在从自行车上摔下来时伤到了脚。"]]],"hurtful":[[["adj.",["造成损害的","伤感情的","伤害的"]]],null,15788,0,0],"hurtle":[[["v.",["猛冲","碰撞","突进","猛撞","猛投"]],["n.",["投掷","碰撞","碰撞声"]]],null,12521,1,0,"i:hurtling/p:hurtled/3:hurtles",[["In every direction the great snow-capped peaks hemmed them in, peeping over each other's shoulders to the far horizon. So steep were the rocky banks on either side of them that the larch and the pine seemed to be suspended over their heads, and to need only a gust of wind to come hurtling down upon them.","四面八方都是巍峨的雪峰，將他們包圍起來，彼此交錯，一直延伸到遙遠的地平線。兩側的岩岸陡峭無比，落葉松和松樹彷彿懸在他們…"]]],"husband":[[["n.",["丈夫","管理人","节俭的人"],["a married man; a woman's partner in marriage"]],["v.",["节俭","使成丈夫","持有"]]],"zk gk gre",637,4,1,"s:husbands/i:husbanding/p:husbanded",[["Her husband intends to bring out a new monthly magazine.","他丈夫打算辦月刊。"]]],"husbandry":[[["n.",["农事","饲养业","家政"]]],"toefl gre",22827,0,0],"hush":[[["n.",["肃静","安静","沉默"]],["v.",["(使)肃静","(使)安静","(使)缄默"]],["int.",["嘘","别作声"]]],"cet6 gre",13814,1,0,"p:hushed/i:hushing/3:hushes",[["Oh, hush!","嘘，安静！"]]],"husk":[[["n.",["外壳","皮","无价值之物"]],["v.",["剥...的壳","削皮"]]],"toefl gre",14430,0,0,"s:husks/p:husked/i:husking",[["I am going to husk rice.","我要去碾米。"]]],"husky":[[["adj.",["有壳的","声音沙哑的","强壮的"]],["n.",["强壮结实之人","爱斯基摩人"]]],"gre",14361,1,0,"r:huskier/s:huskies/t:huskiest"],"hustle":[[["v.",["催促","乱挤活动","硬逼","强夺","赶紧"]],["n.",["心碌","挤","推","拥挤喧嚷"]]],"toefl",9394,1,0,"d:hustled/i:hustling/s:hustles",[["Come on, we need to hustle.","快点，我们要加把劲了。"]]],"hustler":[[["n.",["催促者","拉客的人","骗子"]],["",["乱推乱挤的人","非法赚钱的"]]],null,15036,0,0,"s:hustlers"],"hut":[[["n.",["小屋","茅舍","临时军营"]],["v.",["(使)住在茅舍"]]],"cet4 cet6 ky gre",5321,2,0,"s:huts",[["This hut is a very special place.","这个窝棚是个很特别的地方。"]]],"hybrid":[[["n.",["混血儿","杂种","混合物"]],["adj.",["混合的","杂种的","混合语的"]],["",["NetWare的主机实用程序","双重用户建立程序"]]],"toefl gre",6840,2,0,"s:hybrids",[["On the 14th of April of 2015, I walk to the Richmond Public Market, I first climbing the stairs outside. Inside, the wide atrium-like building is like a garden in a jungle surrounding, I imagine. Already quite hungry, I trot to Captain Wa, the food vendor, to get noodles with squid, fish, and tofu, as well as hot tea. As I eat, a handsome First Nations man in a purple T-shirt walks by. Then a handsome, stocky Jewish fellow walks by. A few minutes later, I begin to thirst, so I get a cold Mint Bubble Green Tea at the vendor QQ Bubble Tea and Coffee. I sit by the stairs to sip. A threesome family sits eating nearby, the man being black, the woman being Oriental, and the child being a hybrid. Addicted to Bubble Tea, I get another one, this time at Peanut's. It is a cold Green Apple Bubble Green Tea. It is delicious. I take the escalator down. On my way to the washroom, I notice a big aquarium full of probably giant red Alaskan king crabs with barnacles on their legs. They remind me of extraterrestrials, somehow. At the bookstore, I buy a heavily illustrated green botany book in sinograms. I left it on top of a box a month ago and it is still there. It is $14. I take the escalator up. Addicted to Bubble Tea, I spend my remaining coins on a cold Lychee Bubble Green Tea. It is delicious with even bits of white lychee flesh.","2015 年 4 月 14 日，我步行前往列治文公共市場，先是爬上了外面的階梯。市場內部寬敞的中庭式建築，讓我感覺彷彿…"]]],"hydrant":[[["n.",["给水栓","水龙头","消火栓"]]],"gre",19742,0,0,"s:hydrants"],"hydrate":[[["n.",["水合物","水化合物","氢氧化物"]],["v.",["使成水化合物"]]],"gre",20682,0,0,"d:hydrated/i:hydrating/3:hydrates",[["I hear that keeping yourself hydrated at appropriate times can help prevent heatstroke.","听说适时地补充水分可以预防中暑。"]]],"hydration":[[["n.",["水合"]]],null,19956,0,0],"hydraulic":[[["adj.",["与水有关的","水力的","水压的"]]],"cet6",10564,1,0],"hydrocarbon":[[["n.",["碳氢化合物","烃"]]],"cet6",13630,1,0,"s:hydrocarbons"],"hydroelectric":[[["",["水电的","水电治疗的"]],["adj.",["水力电气的"]]],nu