,0,0,"s:dominations",[["I guess she's into bondage and domination.","我想她想要的是束縛與支配。"]]],"dominican":[[["adj.",["多明尼加共和国的"]]],null,8220,0,0,"s:dominicans"],"dominion":[[["n.",["领土","主权","统治","统治权"]]],"toefl",14454,1,0,"s:dominions",[["In the sphere of thought, absurdity and perversity remain the masters of the world, and their dominion is suspended only for brief periods.","在思想的領域中, 荒誕和墮落仍然主宰著世界, 它們的操控只是短時間地被暫停。"]]],"domino":[[["n.",["化装外衣","面具","骨牌","多米诺骨牌"]]],null,14155,1,0,"s:dominoes"],"don":[[["n.",["西班牙贵族(或绅士)","先生","阁下"]],["v.",["穿上"]]],null,6189,0,0,"s:dons/p:donned/i:donning",[["Confucius said: \" Yu the Great's conduct, I could not point out any flaws. He consumes meager amount of food, while offering boastful riches to the Gods and ancestors; He always don the crudest attire, but wears lavish garments when worshipping; He resides in a small house, yet forges water ways and ditches with all his might. Figures like Yu the Great, I honestly cannot point out any reprehensible flaws.\"","孔子說：\"像夏禹的為人，我找不到可以指責的漏洞。自己吃著菲薄的飲食，而卻用豐厚祭品祭拜祖先與神明；自己平時穿粗劣的衣裳…"]]],"don't":[[["n.",["禁忌"]],["",["(= do not)不要"]]],null,0,5,0,[["Don't trust a man whose past you know nothing about.","不要相信一个你一点都不了解他过去的人。"]]],"donate":[[["v.",["捐赠"]]],"cet6 ky toefl ielts gre",4095,2,0,"d:donated/i:donating/3:donates",[["He donated a large pile of items to the museum.","他將一大堆東西捐贈給博物館。"]]],"donation":[[["n.",["捐赠物","捐款","捐赠","赠品"]]],"toefl ielts",4336,0,0,"s:donations",[["Would the girls please bring the donation boxes up to the stage?","我们请女孩带着募捐箱来到舞台。"]]],"donkey":[[["n.",["驴子","笨蛋","顽固者","辅助发动机","辅助泵"]]],"cet4 ky",9477,1,0,"s:donkeys",[["That's not a horse, it's a donkey.","那不是隻馬，是隻驢子。"]]],"donor":[[["",["给体","供体"]],["n.",["捐赠人"]]],"toefl gre",3847,2,0,"s:donors",[["You cannot be a blood donor.","你不能成为献血者。"]]],"donut":[[["",["电子回旋加速器环状真空室","同步加速器环状真空室"]]],null,14344,0,0,"s:donuts",[["Many of Europe's metropolises are plagued by the donut phenomenon.","许多欧洲的大都市饱受“甜甜圈现象”困扰。"]]],"doodle":[[["v.",["涂