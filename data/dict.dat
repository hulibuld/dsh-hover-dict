],"objectively":[[["adv.",["客观地"]]],null,12438,0,0],"objectivity":[[["n.",["客观","客观现实","客观性"]]],null,10485,0,0,"s:objectivities",[["Beware of anyone who claims objectivity.","要小心那些说自己客观的人。"]]],"oblation":[[["n.",["向上帝的供奉","祭献","(对宗教、慈善业的)损献","祭品"]]],"gre",41873,0,0,"s:oblations"],"obligate":[[["v.",["使负义务","强使","使感激","施恩惠于"]],["adj.",["有责任的","必须的"]]],null,11331,0,0,"d:obligated/i:obligating/3:obligates",[["I felt obligated.","我覺得有義務。"]]],"obligation":[[["n.",["义务","责任","约束","契约","恩惠"]]],"cet4 cet6 ky toefl ielts gre",2988,2,0,"s:obligations",[["Every player is under obligation to keep the rules.","每一位選手都有義務遵守規則。"]]],"obligatory":[[["adj.",["义务的","必须的","强制性的","有拘束的","强制的"]]],"toefl ielts gre",13922,1,0,[["Is it obligatory to rent a car?","租车是必须的吗？"]]],"oblige":[[["v.",["强制","施恩惠于","使感激","施恩惠","帮忙"]]],"cet4 cet6 ky toefl ielts gre",6685,2,0,"d:obliged/3:obliges/i:obliging",[["I'm obliged to find a way out of the resulting situation.","我应该去找到解决问题的办法。"]]],"oblique":[[["adj.",["斜的","倾斜的","间接的","不光明正大的","躲躲闪闪的"]]],"ielts gre",14956,1,0,"s:obliques"],"obliterate":[[["v.",["擦去","冲刷(掉)","消灭","忘掉","盖销(邮票等)"]]],"toefl gre",10389,1,0,"d:obliterated/i:obliterating/3:obliterates",[["A blood-pressure band, or tourniquet, is placed about the arm, and the pressure increased until the forearm becomes cyanosed and the radial pulse is almost obliterated.","將血壓帶 (或止血帶) 套在手臂上，逐漸增加壓力，直到前臂發紺，橈動脈搏動幾乎消失。"]]],"oblivion":[[["n.",["遗忘","(头脑的)一片空白状","湮没","大赦","赦免"]]],"toefl",12315,1,0,"s:oblivions"],"oblivious":[[["adj.",["遗忘的","健忘的","不知不觉的","忘却的","不在意的"]]],"ielts gre",8431,1,0],"oblong":[[["n.",["长方形","长椭圆形"]],["adj.",["长方形的","长椭圆形的"]]],"ielts",21839,0,0,"s:oblongs"],"obloquy":[[["n.",["辱骂","毁谤","耻辱"]]],"toefl gre",0,0,0],"obnoxious":[[["adj.",["可憎的","使人不愉快的","令人讨厌的"]]],"ielts gre",13843,1,0],"obscene":[[["adj.",["淫秽的","猥亵的","讨人厌的","可憎的","海洋的"]]],"cet6 toefl ielts",9798,1,0,[["One must be respectful when speaking, and not say obscene things.","开口要有礼貌，不讲下流话。"]]],"obscenity":[[["n.",["淫秽","淫秽的语言(或行为、动作)","可憎的事"]],["",["猥亵","淫诲","猥亵的言语或行动"]]],null,11789,1,0,"s:obscenities"],"obscure":[[["adj.",["模糊的","昏暗的","难解的","晦涩的","偏僻的"]],["v.",["使变暗","隐藏","使变模糊","使难解"]]],"cet4 cet6 ky toefl ielts gre",5853,2,0,"d:obscured/3:obscures/i:obscuring/r:obscurer",[["The two scholars wrangled over the meaning of an obscure Tibetan phrase.","兩位學者為一句意思含糊的藏文句子爭論了一番。"]]],"obscurity":[[["n.",["阴暗","朦胧","晦涩","费解","身份低微"]]],"gre",12434,0,0,"s:obscurities"],"obsequious":[[["adj.",["谄媚的","奉承的","顺从的"]]],"gre",28840,0,0],"observable":[[["adj.",["可遵守的","可庆祝的","看得见的","可辨别的","观测得到的"]],["n.",["感觉到的事物","现象"]]],null,13504,0,0,"s:observables"],"observance":[[["n.",["观察","遵守","仪式","风俗习惯","奉行"]]],"toefl ielts gre",13271,0,0,"s:observances"],"observant":[[["adj.",["严格遵守...的","留心的","当心的","观察力敏锐的","注意观察的"]]],null,16107,0,0],"observation":[[["n.",["观察","注意","观测","观察力"]]],"cet4 cet6 ky toefl ielts",2105,2,1,"s:observations",[["Her acute observation skills make her a very suitable photographer.","她因为敏锐的观察力，很适合当一名摄影师。"]]],"observational":[[["adj.",["观察的","观测的"]]],null,13153,0,0],"observatory":[[["n.",["天文台","气象台","了望台"]]],"toefl ielts gre",7738,1,0,"s:observatories",[["He built an observatory to study the stars.","為了觀測星象，他建了一座天文台。"]]],"observe":[[["v.",["觉察到","遵守","注意到","庆祝","注意"],["watch attentively"]]],"gk cet4 cet6 ky toefl ielts",1294,3,1,"d:observed/i:observing/3:observes",[["I observe a chimpanzee peel a banana and eat it.","我观察到一只黑猩猩剥了一根香蕉并吃了它。"]]],"observer":[[["n.",["观察者","遵守者","观察员","监场员"]]],"cet4 cet6",2456,3,0,"s:observers",[["My child, be not an observer of omens, since it leadeth to idolatry, nor a user of spells, nor an astrologer, nor a travelling purifier, nor wish to see these things, for from all these things idolatry ariseth.","孩子啊，不可觀兆，它會導致偶像崇拜；不可行巫術，不可占星，不可四處遊走施法除災；也不要想去看這些事，這一切都會引起偶像…"]]],"obsess":[[["v.",["迷住","使困扰"]]],"ky toefl ielts gre",15161,2,0,"3:obsesses/p:obsessed/i:obsessing",[["I have been obsessed with French recently.","我最近着迷于法语。"]]],"obsessed":[[["adj.",["着迷的","无法摆脱的"]]],"toefl gre",6440,0,0,[["I have been obsessed with French recently.","我最近着迷于法语。"]]],"obsession":[[["n.",["困扰","困扰人的情绪"]],["",["强迫观念"]]],"cet6 ky toefl ielts gre",5558,2,0,"s:obsessions",[["Julia Davis, a Russian media commentator, describes Victory Mania as “an unhealthy obsession with military might and past victories.”","俄羅斯媒體評論員朱莉婭戴維斯將勝利狂熱描述為「對軍事實力和舊有勝利的不健康的痴迷」。"]]],"obsessive":[[["adj.",["着迷的"]]],null,10199,1,0,"s:obsessives"],"obsessively":[[["adv.",["过分地","着迷地","着魔似地"]]],null,17841,0,0],"obsolescent":[[["adj.",["在逐步废弃的"]]],"gre",38519,0,0],"obsolete":[[["adj.",["荒废的","成废物的","陈旧的","老式的"]],["n.",["废词","废物"]]],"ky toefl ielts gre",8876,1,0,"d:obsoleted/i:obsoleting",[["Since communism became obsolete and the dictatorship of the proletariat is out of date, capitalism proves to be the best so far, even though it itself is still a threat for humanity.","共产主义失败了，而无产阶级专政现在也已经被淘汰了。虽然资本主义逐渐取而代之，但现在的资本主义对于人类还是一个威胁。"]]],"obstacle":[[["n.",["障碍","妨害物","阻碍"]]],"cet4 cet6 ky toefl ielts gre",3569,2,0,"s:obstacles",[["The bats use ultrasound to locate obstacles.","蝙蝠使用超音波來定位障礙物。"]]],"obstetrician":[[["n.",["产科医师"]]],null,16525,0,0,"s:obstetricians"],"obstetrics":[[["n.",["产科学"]]],null,19511,0,0],"obstinacy":[[["n.",["倔强","顽固","固执行为","(疼痛等)难治"]]],"gre",28241,0,0,[["Miss Wang has a trace of obstinacy in her, but she is still a good student.","王小姐有一点固执，但是她还算是一个好学生。"]]],"obstinate":[[["adj.",["倔强的","顽固的","不让步的"]]],"cet6 ky toefl ielts gre",21852,1,0,[["He is the most obstinate child I have ever seen.","他是我所见的最倔的一个孩子。"]]],"obstreperous":[[["adj.",["吵闹的","喧嚣的","骚乱的","不守秩序的"]]],"gre",32642,0,0],"obstruct":[[["v.",["阻隔","妨碍","阻塞","遮没","设障碍"]]],"ky toefl ielts gre",10703,1,0,"i:obstructing/d:obstructed/3:obstructs",[["The crowd obstructed the police in the discharge of their duties.","群众妨碍了警员执行任务。"]]],"obstruction":[[["n.",["障碍","妨碍","闭塞物"]],["",["梗阻","不通"]]],"ky toefl gre",8999,1,0,"s:obstructions",[["The accusations are shocking: money laundering, tax evasion and obstruction of justice.","这些指控令人震惊:洗钱、逃税和妨碍司法公正。"]]],"obtain":[[["v.",["获得","达到","流行","得到公认"],["come into possession of"]]],"gk cet4 cet6 ky toefl",1595,3,1,"d:obtained/i:obtaining/3:obtains",[["I am able to obtain a registration form for free.","我可以免费获取一份注册表格。"]]],"obtainable":[[["adj.",["能得到的"]]],"toefl gre",25510,0,0],"obtrude":[[["v.",["逼使","强迫","伸出","打扰","强行闯入"]]],"toefl gre",40698,0,0,"p:obtruded/3:obtrudes/i:obtruding"],"obtuse":[[["adj.",["钝的","不锋利的","愚钝的"]],["",["钝形的","迟钝的(智力)"]]],"gre",23968,0,0],"obverse":[[["n.",["(钱币、奖章等)正面","主要的一面","对立面"]],["adj.",["正面的","对应面的","倒转的"]]],"gre",35301,0,0],"obviate":[[["v.",["除去","排除","使成为不必要","避免"]]],"toefl gre",20519,0,0,"3:obviates/i:obviating/d:obviated"],"obvious":[[["adj.",["明显的","明白的","显然的","平淡无奇的"],["easily perceived by the senses or grasped by the mind"]]],"gk cet4 cet6 ky toefl ielts gre",1689,4,1,[["It was obvious that they had told a lie.","他們分明說了謊。"]]],"obviously":[[["adv.",["显而易见地","明显地"]]],"cet4 cet6",1278,4,1,[["Obviously, we don't know if those thermos flasks are their own.","当然，那些热水瓶是不是他们自己的就不得而知了。"]]],"occasion":[[["n.",["场合","时机","机会","诱因","理由"]],["v.",["惹起","引起"]]],"cet4 cet6 ky toefl ielts",2262,4,1,"s:occasions/d:occasioned/i:occasioning",[["On gift-giving occasions, people generally avoid giving money, but there are exceptions.","人們送禮通常都不會送錢，但是也會有例外的情況。"]]],"occasional":[[["adj.",["偶然的","临时的","特殊场合的"]]],"cet4 cet6 ky toefl",3511,3,0,[["Tomorrow's weather should be sunny with occasional rain.","明天天气晴转阵雨。"]]],"occasionally":[[["adv.",["有时候","偶而"]]],"cet4 cet6 toefl",2485,0,1,[["The mother occasionally reread her son's letter.","这位母亲偶尔会重温她的儿子的信件。"]]],"occidental":[[["adj.",["欧美的","西方的","西方国家的"]],["n.",["欧美人","西方人"]]],"gre",23052,1,0,[["Walking through the crosswalk in Downtown Vancouver, BC, many years ago, a Native Indian woman looked at my face and said, \"Don't smile!\" I could see on her face how foreign Occidental culture really strained her life.","我還記得很多年前有一次我在溫哥華的市中心過馬路，一個印第安女人看著我說道：「別笑！」我能從她的臉上看出異域的西方文化真…"]]],"occlude":[[["v.",["使闭塞","隔断","挡住","咬合"]]],"gre",27220,0,0,"3:occludes/d:occluded/i:occluding"],"occult":[[["adj.",["神秘的","不可思议的","超自然的"]],["v.",["掩蔽","隐藏"]],["n.",["神秘之事","神秘学"]]],"gre",18836,1,0,"i:occulting/p:occulted/3:occults"],"occupancy":[[["n.",["占有","居住","占用","占据","据有"]]],null,11641,1,0,"s:occupancies"],"occupant":[[["n.",["占有者","居住者","占用者"]]],"toefl",8319,1,0,"s:occupants"],"occupation":[[["n.",["职业","占有","占有期","占领","占领军"]]],"gk cet4 cet6 ky toefl ielts gre",3334,3,0,"s:occupations",[["The \"family manager\" is a profession, occupation, vocation.","“一家之主”是一份专业工作、事业和使命。"]]],"occupational":[[["adj.",["职业的","军事占领的"]]],"ielts",6488,0,0,[["Demand for occupational therapy has surged in recent years.","这几年对作业疗法的需求在迅速增长。"]]],"occupier":[[["n.",["占用者","居住者","军事占领者"]]],null,20295,1,0,"s:occupiers"],"occupy":[[["v.",["占领","占(时间、空间等)","住进","担任","使从事"]]],"cet4 cet6 ky toefl ielts",2710,4,1,"d:occupied/3:occupies/i:occupying",[["The meeting room is occupied at the moment.","会议室正在使用中。"]]],"occur":[[["v.",["发生","被想到","存在"],["come to one's mind; suggest itself"]]],"gk cet4 cet6 ky toefl ielts",756,4,1,"3:occurs/p:occurred/i:occurring",[["It occurred to me that he might be an industrial spy.","我突然想到他可能是個商業間諜。"]]],"occurrence":[[["n.",["发生","事件","出现"]]],"cet4 cet6 ky toefl ielts gre",6221,1,0,"s:occurrences",[["Both victory and defeat are but an everyday occurrence to a soldier.","胜败是兵家常事。"]]],"ocean":[[["n.",["海洋","广阔","许多","一大片","海"],["a large body of water constituting a principal part of the hydrosphere"]]],"zk gk cet4 ky ielts",1842,3,1,"s:oceans",[["It is very pleasant to cross the ocean by ship.","乘船过海非常舒服。"]]],"oceania":[[["n.",["大洋洲"]]],"gk cet4 cet6",0,0,0,[["Australia is the largest country in Oceania.","澳大利亚是大洋洲最大的国家。"]]],"oceanic":[[["adj.",["海洋的","产于海洋的","在海洋中生活的","广阔的"]]],null,13541,0,0,"s:oceanics"],"oct.":[[["n.",["十月"]]],null,0,2,0],"octave":[[["n.",["八音度","低八度音","高八度音"]]],null,17343,0,0,"s:octaves"],"october":[[["n.",["十月"]]],"zk gk ielts",0,4,1,[["Where were you on October 20th at 2:30 in the afternoon?","你十月二十號下午兩點半的時候在哪兒？"]]],"octogenarian":[[["adj.",["80岁到90岁(的人)的"]],["n.",["80岁到90岁的人"]]],"gre",29499,0,0,"s:octogenarians"],"octopus":[[["n.",["章鱼"]]],"toefl",15455,0,0,[["The crevice in the boulder on the ocean floor conceals an octopus.","海底的岩石缝里藏着一只章鱼。"]]],"ocular":[[["adj.",["眼睛的","用眼的","凭视觉的","目击的"]],["n.",["目镜"]]],"gre",24152,0,0],"odd":[[["adj.",["奇数的","古怪的","剩余的","零散的","各种各样的"]],["",["奇数","奇校验","光数据数字转换器"]],["n.",["奇特的事物","怪人"]]],"cet4 cet6 ky toefl ielts",2738,4,1,[["Even times odd is even, odd times odd is odd.","偶数乘以奇数是偶数，奇数乘以奇数是奇数。"]]],"oddball":[[["adj.",["古怪的","奇怪的"]],["n.",["古怪的人"]]],null,18761,0,0,"s:oddballs"],"oddity":[[["n.",["奇异","奇特","怪人","怪事","怪僻"]]],null,13984,1,0,"s:oddities"],"oddly":[[["adv.",["奇怪地"]]],"toefl",6383,1,1],"odds":[[["n.",["可能性","几率","机会","胜算","不平等"]]],"ky toefl ielts gre",3239,2,0,[["Those two departments are sometimes at odds with each other.","那两个部门有时候意见相左。"]]],"odds-on":[[["adj.",["大半有希望赢的","多半有希望取胜的"]]],null,0,1,0],"ode":[[["n.",["颂诗","赋"]]],"gre",19653,0,0,"s:odes"],"odious":[[["adj.",["可憎的","可厌的","丑恶的"]]],"gre",22215,0,0],"odium":[[["n.",["憎恶","讨厌","臭名"]]],"gre",0,0,0],"odometer":[[["n.",["里程表"]]],"gre",24399,0,0,"s:odometers"],"odor":[[["n.",["气味","香味","名声","意味"]]],"cet6 ky toefl",5311,0,0,"s:odors",[["The attic was a long, low-ceilinged room, dark and fragrant with the odor of the cedar.","閣樓是一個狹長的低矮房間，光線昏暗，瀰漫著雪松的香氣。"]]],"odoriferous":[[["adj.",["散发气味的","臭的"]]],"gre",40663,0,0],"odorless":[[["adj.",["无嗅的","没有气味的"]]],"toefl",24237,0,0,[["So it seems that cloud of odorless deadly gas had a silver lining after all.","只能说，那团无味的致命气体，也不是没有好处。"]]],"odour":[[["n.",["气味","臭气","香气","味道","迹象"]]],"cet4 cet6 ielts",0,1,0,"s:odours",[["This kind of odour is really terrifying.","这种气味真可怕。"]]],"odyssey":[[["n.",["奥德赛(古希腊史诗)"]]],"ielts gre",14698,1,0,"s:odysseys"],"oestrogen":[[["n.",["雌激素","雌甾激素"]]],null,31670,1,0,"s:oestrogens"],"oeuvre":[[["n.",["全部作品"]]],null,17318,0,0,"s:oeuvres"