y":[[["n.",["实验室","研究室","化工厂","检验室","化验室"]]],"zk cet4 cet6 toefl ielts",3132,3,1,"s:laboratories",[["Let's first talk about the experiments done in the laboratory.","讓我們先談談在實驗室中做的實驗。"]]],"labored":[[["adj.",["吃力的","缓慢的","不自然的","矫揉造作的"]]],"gre",23784,0,0],"laborer":[[["n.",["体力劳动者","辅助工"]],["",["劳动者"]]],"toefl",6939,0,0,"s:laborers",[["Thousands of laborers and craftsmen toiled for 22 years to craft the stunning white marble edifice.","數千名工人和工匠辛勤工作了 22 年，才打造出這座令人驚嘆的白色大理石建築。"]]],"laborious":[[["adj.",["艰苦的","费劲的","勤劳的"]]],"toefl ielts",18512,1,0],"laboriously":[[["adv.",["辛苦地","费力地","不流畅地"]]],"toefl",21312,0,0],"labour":[[["n.",["劳动","努力","工作","劳工","分娩"]],["v.",["劳动","努力","苦干","详细分析","使厌烦"]]],"zk gk cet4 cet6",16348,5,1,"s:labours/i:labouring/p:laboured",[["I'm unable to do manual labour.","我不能做體力勞動。"]]],"labourer":[[["n.",["劳动者","干体力工作的工人","劳工"]]],"gk",32892,1,0,"s:labourers",[["I tripped in the alleyway in the darkness, as I crashed my knees on the asphalt. There was a wooden board that covered a wire between houses across the alleyway. It was very dark there at night. My eyeglasses fell off my face. Luckily, a Cantonese labourer with a flashlight helped me. My knees just got scraped. I remember another time when I crashed on my knees. It was at Don José Heights in Quezon City in the Philippines. There was a vastness of Martianesque red soil, wherein the \"talahib\" grass grew. Sometimes, workers intentionally set the grass on fire. My brother and I were still playing, even then, outside. We were still prepubescent. Near burning grass, I stumbled on my knees. My grandmother, Lola Bebe, was so angry. A maid washed my legs in the big tiled sink behind the garage.","我在黑暗的巷子中絆倒，膝蓋砸在柏油路上。一塊木板蓋著巷弄的房屋之間的電線。深夜的巷弄非常之暗。我的眼鏡從眼睛上掉了下來…"]]],"labyrinth":[[["n.",["迷宫","难解事物","迷路","曲径"]]],"toefl gre",11521,1,0,"s:labyrinths"],"lace":[[["n.",["饰带","花边","缎带","鞋带"]],["v.",["结带子","饰以花边","系带子"]],["",["全穿孔"]]],"cet4 cet6 ky toefl ielts gre",6642,2,0,"s:laces/d:laced/i:lacing",[["She has t