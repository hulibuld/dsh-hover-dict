able":[[["adj.",["值得尊重的","人格高尚的","相当数量的"]],["n.",["品格高尚的人"]]],"cet6",7353,2,0,"s:respectables"],"respectful":[[["adj.",["表示尊敬的","有礼貌的","谦恭的"]]],"cet4 cet6",8374,1,0,[["One must be respectful when speaking, and not say obscene things.","开口要有礼貌，不讲下流话。"]]],"respectfully":[[["adv.",["尊敬地"]]],null,12404,0,0,[["No one respectfully bowed towards him.","没有人向他恭敬地鞠躬。"]]],"respective":[[["adj.",["分别的","各自的"]]],"cet4 cet6 ky toefl",5883,1,0,[["Go to your respective seats.","請回到你們各自的座位。"]]],"respectively":[[["adv.",["各自地","独自地","个别地","分别地"]]],"cet4 cet6 toefl",3726,2,0,[["The two boys, aged respectively fourteen and sixteen, were dressed in the army uniform, and wore gold-lace sergeant's chevrons upon their sleeves.","这两个男孩，一个14岁、一个16岁，都穿着军队制服，衣袖上佩戴着镶金色蕾丝边的中士袖章。"]]],"respiration":[[["n.",["呼吸","一口气","呼吸作用"]]],"toefl ielts gre",17458,0,0,"s:respirations"],"respirator":[[["n.",["口罩","防毒面具","人工呼吸装置"]],["",["防尘面罩","防毒面罩"]]],null,16219,0,0,"s:respirators"],"respiratory":[[["adj.",["呼吸的"]]],"toefl",7481,1,0],"respite":[[["n.",["暂缓","缓期执行"]],["v.",["使暂缓"]]],"gre",12950,1,0,"s:respites/i:respiting/p:respited"],"resplendent":[[["adj.",["辉煌的","灿烂的"]]],"gre",20564,0,0],"respond":[[["v.",["以...回答","回答","响应","回报","有反应"],["respond favorably or as hoped"]]],"gk cet4 cet6 ky toefl",920,4,1,"i:responding/p:responded/3:responds",[["I'm sorry, I have to respond to the messages.","不好意思，我必须回复短信。"]]],"respondent":[[["adj.",["回答的","应答的","反射的"]],["n.",["应答者","被告"]]],"gre",2538,1,0,"s:respondents"],"responder":[[["n.",["回答者","响应者","响应器","应答机","响应站"]]],null,15870,0,0,"s:responders"],"response":[[["n.",["反应","回答","响应"],["a result"]],["",["应答"]]],"cet4 cet6 ky ielts gre",725,4,1,"s:responses",[["She made no response to my question.","她沒有回答我的問題。"]]],"responsibility":[[["n.",["责任","职责","负担","可靠性"],["a form of trustworthiness; the trait of being answerable to someone f…"]]],"gk cet4 cet6 ky toefl ielts",1067,4,1,"s:responsibilities",[["The driver does not have responsibility for the traffic accident.","司機不需要為這次的交通意外負責。"]]],"responsible":[[["adj.",["有责任的","负责的","责任重大的","应负责任的","能履行责任的"],["worthy of or requiring responsibility or trust; or held accountable"]]],"cet4 cet6 ky toefl",1365,4,1,[["You will have to be responsible for what you've done.","你要為自己做的事負上責任。"]]],"responsibly":[[["adv.",["认真负责地","可信赖地","可靠地"]]],null,13399,0,0],"responsive":[[["adj.",["回答的","应答的","易感应的"]]],"toefl ielts gre",6912,1,0],"responsiveness":[[["n.",["强烈的反应"]],["",["响应能力"]]],"gre",13943,0,0],"rest":[[["v.",["休息","睡","长眠","安心","静止"]],["n.",["休息","睡眠","安息","稍息","静止"],["freedom from activity (work or strain or responsibility)"]]],"zk gk",673,4,1,"i:resting/p:rested/3:rests",[["The doctor told her that she should take a rest.","医生告诉她要静养。"]]],"restart":[[["v.",["重新开始","重新启动"]]],null,13007,1,0,"d:restarted/i:restarting/3:restarts",[["You need to restart your PC.","您需要重啟電腦。"]]],"restate":[[["v.",["重新叙述","重申","重新陈述","再申明"]]],null,16704,1,0,"d:restated/i:restating/3:restates"],"restaurant":[[["n.",["餐馆","饭店"],["a building where people go to eat"]]],"zk gk ielts",1114,4,1,"s:restaurants",[["I can't afford to eat in such an expensive restaurant.","我吃不起这么贵的餐馆。"]]],"restaurateur":[[["n.",["餐馆老板"]]],null,15835,1,0,"s:restaurateurs"],"restful":[[["adj.",["给人休息的","素雅的","安静的"]]],null,19602,0,0],"restitution":[[["n.",["归还","偿还","赔偿"]],["",["整复","恢复","转回(胎头)"]]],"gre",15053,0,0,"s:restitutions",[["If men quarrel, and the one strike his neighbour with a stone, or with his fist, and he die not, but keepeth his bed: If he rise again and walk abroad upon his staff, he that struck him shall be quit, yet so that he make restitution for his work, and for his expenses upon the physicians.","若有人爭鬥，一人以石頭或拳頭打了鄰人，雖未致死，卻使其臥床不起：若其後能起身、扶杖行走於外，則打人者可免於刑責，但須賠…"]]],"restive":[[["adj.",["不愿向前走的","倔强的","难驾御的"]]],"gre",21413,0,0],"restiveness":[[["n.",["难以驾御","倔强"]]],"gre",38044,0,0],"restless":[[["adj.",["不安静的","慌张的","休息不充分的","不宁的"]]],"cet4 cet6 ky ielts gre",7303,2,0,[["You've had a very restless night.","你度过了很不安宁的一夜。"]]],"restlessness":[[["n.",["坐立不安","不安定"]]],null,17178,0,0],"restoration":[[["n.",["恢复","归还","复位","康复","回复"]]],"toefl",5002,2,0,"s:restorations"],"restorative":[[["adj.",["恢复健康的","滋补的"]],["n.",["兴奋药","补药"]]],"gre",18355,0,0,"s:restoratives"],"restore":[[["v.",["回复","恢复","归还","修补","修复"]]],"cet4 cet6 ky toefl ielts gre",2543,3,1,"d:restored/i:restoring/3:restores",[["A historical landmark has been restored and will reopen.","一座歷史地標已經修復並將重新開放。"]]],"restrain":[[["v.",["抑制","阻止","束缚","遏制","制止"]]],"cet4 cet6 ky toefl ielts gre",6825,2,0,"d:restrained/i:restraining/3:restrains",[["You should learn to restrain yourself.","你應該學習控制自己的情緒。"]]],"restraint":[[["n.",["抑制","克制","束缚"]],["",["约束","拘束"]]],"cet4 cet6 ky toefl gre",5419,2,0,"s:restraints",[["Every situation is an opportunity given to you by the universe. If you know how to make the most out of that situation, do it. It will be a wealth that lasts you a lifetime. If you missed out, gave up, or didn't even attempt to take advantage of the opportunity, the universe will set this chance aside for the next person, in a different time and place. But what's most important is that you lost precious time. Understand what you did wrong, and control the present. Then with proper restraint, if you can dance, dance. If you can sing, sing. If you can be wild, be wild. If you can be lively, be lively.","任何境遇都是宇宙给你的机会，假如你懂得利用、抓紧它。它将是你一生的财富。假如你遗漏、放弃或者没有做出积极的响应，宇宙会…"]]],"restrict":[[["v.",["限制","限定","约束"]]],"gk cet4 cet6 ky toefl",3539,2,1,"d:restricted/i:restricting/3:restricts",[["I feel always restricted here.","我在这里总感到约束。"]]],"restriction":[[["n.",["限制","限定","约束"]]],"gk cet4 cet6 toefl",3127,0,1,"s:restrictions",[["Critics are coming down hard on tightened economic restrictions.","对严格限制经济的批评蜂拥而来。"]]],"restrictive":[[["adj.",["限制的","约束的","限定的"]],["n.",["限制词"]]],"toefl",8527,1,0],"restroom":[[["n.",["洗手间","休息室","更衣室","厕所"]]],null,11694,0,0,[["She just came back from the restroom.","她剛從洗手間回來。"]]],"restructure":[[["v.",["更改结构","重建","调整"]]],null,8138,2,