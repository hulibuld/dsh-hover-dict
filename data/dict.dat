:[[["v.",["使插入","使介于二者间","使干涉","插嘴","干预"]]],"gre",26395,0,0,"p:interposed/i:interposing/3:interposes"],"interpret":[[["v.",["解释","演出","翻译","理解"]]],"cet4 cet6 ky toefl ielts",2755,2,1,"d:interpreted/i:interpreting/3:interprets",[["I interpreted her silence as a refusal.","我認為她的沉默就是表示拒絕。"]]],"interpretation":[[["n.",["解释","演出","翻译","插值","插值法"]]],"cet4 cet6 toefl",2380,2,1,"s:interpretations",[["It is subject to interpretation.","這件事靠個人的立場來解釋。"]]],"interpreter":[[["n.",["直译程序","解释者","口译者","注释器"]]],"gk cet4 cet6",5628,0,0,"s:interpreters",[["She has a strong wish to work as an interpreter.","她非常想当口译。"]]],"interpretive":[[["",["解释的","翻译的"]]],null,9714,0,0],"interracial":[[["adj.",["人种间的","人种混合的"]]],null,11753,0,0],"interregnum":[[["n.",["空位期间","过渡期","中断"]]],"gre",33467,0,0,"s:interregnums"],"interrelated":[[["adj.",["相关的"]]],null,14368,0,0],"interrelationship":[[["n.",["相互关系"]]],null,17664,0,0,"s:interrelationships"],"interrogate":[[["v.",["质问","讯问","审问"]]],"toefl ielts gre",10405,1,0,"d:interrogated/i:interrogating/3:interrogates"],"interrogation":[[["n.",["审问","疑问句","问号"]],["",["询问"]]],null,6705,0,0,"s:interrogations"],"interrogative":[[["n.",["疑问词","问号"]],["adj.",["疑惑的","疑问的"]]],"gre",34959,0,0,"s:interrogatives",[["Use interrogative pronouns to rewrite the sentences below; if you need to, you can add or remove a few words.","用疑问代词表任指格式改写下面的句子，根据需要可以增加或者减少一些词语。"]]],"interrogator":[[["n.",["讯问者","质问者"]],["",["询问机"]]],null,15219,0,0,"s:interrogators"],"interrupt":[[["v.",["中断","妨碍","插嘴","打断"]],["n.",["中断"]]],"gk cet4 cet6 ky toefl gre",3407,2,1,"p:interrupted/i:interrupting/3:interrupts",[["Tom didn't want to interrupt Mary while she was studying.","Tom不想在Mary讀書時騷擾她。"]]],"interruption":[[["n.",["打扰","中断","障碍物"]],["",["间断","阻断","中止"]]],"cet4 cet6",8994,0,1,"s:interruptions"],"intersect":[[["v.",["贯穿","横穿","交错","相交"]]],"ky toefl gre",10941,0,0,"3:intersects/p:intersected/i:intersecting"],"intersection":[[["n.",["交集","十字路口","交叉点"]],["",["逻辑乘","与"]]],"cet6 ky toefl ielts",5760,0,0,"s:intersections/i:intersectioning",[["You can get there by crossing the street at the second intersection.","你从这里过去到那里，穿过第二条横马路就是。"]]],"intersperse":[[["v.",["散布","点缀"]]],"gre",14292,0,0,"d:interspersed/i:interspersing/3:intersperses",[["This 14th of May of 2025 is cloudy skies interspersed with blue spaces. I walked to the Roman Catholic church on St. Albans Road twice, once in the morning and again in the afternoon, my 12th and 13th times this spring. In the morning was confession for the little boys and girls in uniform. They were of different races, in the big worship hall. The priest was in the confession booth talking to a student. At the Adoration Chapel, I noticed a nice pot of orchids on the front left. In the afternoon, the big worship hall was mostly empty, a condition which I usually prefer. At the road was a handsome muscle man in white tank top jogging. The big purple-bloom tree seems like an Empress Tree, a Paulownia, because of the big heart-shaped leaves. Reminiscent of Jacaranda with its purple blooming, it's saudade for me about South America. At Tim Hortons café, I enjoyed Scrambled Eggs with Sausage and Potatoes and an Earl Grey Tea with oat milk in the morning, and an Iced Classic Lemonade in the afternoon. The day was full of walking. At home, I study bits of Lojban and Esperanto. I have many books in Esperanto. I tend towards Animism-Buddhism in my Syncretism.","2025 年 5 月 14 日，天空多雲，間或有藍色空間。我兩次走到聖奧爾本斯路上的羅馬天主教堂，一次在早上，一次在下…"]]],"interstate":[[["adj.",["州际的","国与国之间的","州与州之间的"]]],null,7500,1,0,"s:interstates"],"interstellar":[[["adj.",["星际的"]]],"toefl",11761,0,0],"interstice":[[["n.",["空隙","裂缝"]],["",["小间隙"]]],"gre",0,0,0,"s:interstices"],"intertwine":[[["v.",["(使)纠缠","(使)缠绕"]]],"gre",11522,1,0,"d:intertwined/i:intertwining/3:intertwines"],"interval":[[["n.",["间隔","距离","间歇","间隙"]],["",["时间间隔"]]],"gk cet4 cet6 ky toefl ielts",4646,2,1,"s:intervals",[["The Olympic Games take place at intervals of four years.","每隔四年，奥运会举行一次。"]]],"intervene":[[["v.",["插入","调停","干涉"]],["",["进场干预"]]],"cet6 ky toefl ielts gre",5091,2,0,"p:intervened/3:intervenes/i:intervening",[["We take health for granted until illness intervenes.","我們視健康為理所當然, 直到疾病侵襲。"]]],"intervention":[[["n.",["插入","介入","调停"],["the act of intervening (as to mediate a dispute, etc.)"]],["",["干预"]]],"cet6 toefl ielts",1926,0,0,"s:interventions"],"interventionist":[[["n.",["干涉主义者"]],["adj.",["干涉主义的"]]],null,21535,1,0,"s:interventionists"],"interview":[[["n.",["面谈","访问","接见","面试"],["the questioning of a person (or a conversation in which information i…"]],["v.",["接见","对...进行面谈(试)"],["conduct an interview in television, newspaper, and radio reporting"]]],"zk gk cet4 cet6 ky ielts",944,4,1,"s:interviews/d:interviewed/i:interviewing",[["You'll have to play it by ear at the interview.","在面試的時候你必須見機行事。"]]],"interviewee":[[["n.",["被接见者","被采访者","被面试者"]]],"ielts",14615,1,0,"s:interviewees",[["The interviewer identifies his interviewees.","這名採訪者確認了他的採訪對象。"]]],"interviewer":[[["n.",["会见者","面谈者","进行面试者"]]],"ielts",7827,1,0,"s:interviewers",[["The interviewer introduces the topic of the interview.","採訪者介紹了採訪的主題。"]]],"interweave":[[["v.",["(使)交织","织进","(使)混杂"]]],"gre",16863,1,0,"i:interweaving/3:interweaves/p:interwove/d:interwoven"],"intestate":[[["adj.",["没有遗嘱的","无遗嘱嘱明处置的"]],["n.",["无遗嘱的死亡者"]]],"gre",0,0,0,"s:intestates"],"intestinal":[[["adj.",["肠的","肠内的"]]],null,13499,0,0,[["\"Intestinal fat\" is a kind of sacrifice.","“膟”是一種用牲法。"]]],"intestine":[[["adj.",["内部的","国内的"]],["n.",["肠"]]],"toefl gre",11678,1,0,"s:intestines"],"intifada":[[["n.",["(1987年底爆发的)以色列占领区的巴勒斯坦人暴动"]]],null,16681,0,0],"intimacy":[[["n.",["亲密","熟悉","亲昵行为(言语)","亲近的行为","隐私"]]],"toefl",5670,1,0,"s:intimacies"],"intimate":[[["adj.",["亲密的","私人的","秘密的"]],["v.",["暗示","通知","告诉"]],["n.",["至交"]]],"cet4 cet6 ky toefl ielts gre",4217,2,0,"d:intimated/3:intimates/i:intimating",[["We're intimate friends.","我們是親密的朋友。"]]],"intimately":[[["adv.",["亲切地","亲密地","个人性地"]]],null,9539,0,0],"intimidate":[[["v.",["威胁","恐吓