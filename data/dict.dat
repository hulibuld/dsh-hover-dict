["n.",["帕尔马干酪(意大利产)"]]],null,12650,1,0,"s:parmesans",[["\"I'm going to try to make chicken parmesan for my family tonight,\" said Matthew's sister after trying his recipe.","馬修的姊姊在試過他的食譜後說道：「我今晚要試著為家人做帕瑪森雞排。」"]]],"parochial":[[["adj.",["教区的","地方性的","目光偏狭的"]]],"gre",11615,1,0,"s:parochials",[["He is a member of the parochial board.","他是教區委員會的成員。"]]],"parody":[[["n.",["打油诗文","诙谐的模仿诗文","拙劣的模仿"]],["v.",["拙劣模仿","作模仿诗文"]]],"ielts gre",10507,1,0,"s:parodies/p:parodied/i:parodying"],"parole":[[["n.",["假释","誓言","释放宣言"]],["v.",["宣誓后释放","使假释出狱"]]],null,6699,1,0,"d:paroled/s:paroles/i:paroling"],"paroxysm":[[["n.",["发作","突发","阵发"]]],"gre",28107,0,0,"s:paroxysms"],"parquet":[[["n.",["镶木地板","(剧场)正厅池座"]],["v.",["铺镶木地板"]]],"gre",25408,0,0],"parrot":[[["n.",["鹦鹉","应声虫"]],["v.",["学舌","机械地模仿"]]],"gk toefl",9988,1,0,"s:parrots/i:parroting/p:parroted",[["That parrot was Tobias's only connection with his late father.","那隻鸚鵡是托比亞斯與他已故父親之間唯一的連結。"]]],"parry":[[["v.",["挡开","回避","闪避的回答"]],["n.",["挡开","回避","闪避的回答"]]],"toefl gre",25178,0,0,"p:parried/i:parrying/s:parries",[["Parry, then strike.","先格擋，再反擊。"]]],"parse":[[["v.",["从语法上分析"]],["",["分列"]]],"gre",18644,0,0,"s:parses/d:parsed/i:parsing",[["Not complying with the naming conventions will result in parse errors.","不遵守命名规则会导致解析错误。"]]],"parsimony":[[["n.",["过度节俭","吝啬","惜墨如金"]]],"gre",28966,0,0],"parsley":[[["n.",["皱叶欧芹","荷兰芹"]],["",["绉叶石蛇床"]]],null,6620,2,0,[["The herb used in that pasta sauce might be parsley.","用於那個義大利醬的香草可能是荷蘭芹。"]]],"parson":[[["n.",["教区牧师"]]],null,25984,2,0,"s:parsons"],"part":[[["n.",["部分","局部","零件","要素","等分"],["something determined in relation to something that includes it"]],["v.",["分开","分离","断绝","区别","分配"]],["adj.",["部分的","局部的"]],["adv.",["部分地","有些"]]],"zk gk cet4 ky ielts",178,3,1,"s:parts/d:parted/i:parting",[["Your son took part in the student movement, I hear.","聽說你兒子參與了學生運動。"]]],"part-time":[[["adj.",["兼任的","半工半读的","部分时间的"]],["adv.",["部分时间","兼任地"]]],"ielts",0,2,0,[["My wife's part-time job brings in a little extra money.","我太太兼職的工作賺進了一些額外的錢。"]]],"partake":[[["v.",["参与","分担","分享","带有"]]],null,15537,0,0,"i:partaking/3:partakes/p:partook/d:partaken",[["Humanity's food, cloth, place of living, transport, entertainment are all created together by people around the globe. Also, people who partake in these activities only know a fraction of how the parts are created, without exception. Therefore, when we decide to help ourselves to help the entire world, as long as we focus with our entire being to create, the entire world will help us.","人類食衣住行娛樂用的每一件東西都是全世界的人一起幫我們做出來的，而且參與的每個人都只知道怎麼創造一小部分，沒有例外。因…"]]],"partial":[[["adj.",["部分的","偏袒的","偏爱的"]],["n.",["分音"]]],"cet4 cet6 ky toefl ielts gre",4546,2,0,"s:partials",[["Departure is a partial death but death in essence is not only departure.","离开是部分的死亡，而死亡不仅仅是离开。"]]],"partiality":[[["n.",["偏心","偏颇","不公平","特别喜欢","癖好"]]],"gre",29852,0,0],"partially":[[["adv.",["部分地","一部分地","不公平地"]]],"cet4 cet6 toefl",4379,2,0,[["The London to Amsterdam flight was partially powered with a mixture of coconut and babassu nut oil.","倫敦飛往阿姆斯特丹的航班部分動力來自椰子油和巴巴蘇堅果油的混合物。"]]],"participant":[[["adj.",["有份的","参加的","参与的"]],["n.",["参加者","参与者"],["someone who takes part in an activity"]]],"cet6 ky toefl",1103,2,0,"s:participants",[["There are thousands of participants at today's event.","有成千的人来参加今天的集会。"]]],"participate":[[["v.",["参加","分享","参与","带有","分担"],["share in something"]]],"gk cet4 cet6 ky toefl ielts",1482,3,0,"i:participating/p:participated/3:participates",[["Did you say you wanted to participate in the meeting?","你们说了要参加会议了吗？"]]],"participation":[[["n.",["参与","分享","参股"]]],null,2214,0,0,"s:participations",[["Thank you very much for your participation!","非常感谢你的参与！"]]],"participatory":[[["adj.",["吸引参与的","供人分享的"]]],null,12949,0,0],"particle":[[["n.",["颗粒","粒子","质点","极小量"]]],"cet4 cet6 ky toefl ielts",3683,2,0,"s:particles",[["Tiny particles in the air can cause cancer.","空气中的微粒可以引发癌症。"]]],"particular":[[["adj.",["特别的","独有的","挑剔的","详尽的"]],["n.",["一项(或条、点)","个别项目","详细说明"],["a fact about some part (as opposed to general)"]]],"gk cet4 cet6 ky gre",948,4,1,[["I would like to place particular emphasis on this point.","我想特别强调这一点。"]]],"particularity":[[["n.",["特殊性","特质","个性","细致","苛求"]]],null,17808,0,0,"s:particularities"],"particularize":[[["v.",["详细说明","列举","使特殊"]]],"gre",35126,0,0,"d:particularized/i:particularizing/3:particularizes"],"particularly":[[["adv.",["特别","格外","尤其","详细地","细致地"]]],"cet4 cet6",781,4,1,[["He's just a normal junior high school student, not particularly intelligent.","他只不過是個普普通通的中學生，不算特別聰明。"]]],"particulars":[[["n.",["细节","详细情况","详情","摘要"]]],null,12233,0,0],"particulate":[[["n.",["微粒"]],["adj.",["微粒的"]]],"toefl",15530,0,0,"s:particulates"],"partisan":[[["adj.",["党派的","偏袒的","效忠的","献身的","盲目推崇的"]],["n.",["党羽","虔诚信徒","同党","游击队员"]]],"toefl ielts gre",6222,1,0,"s:partisans"],"partisanship":[[["n.",["党派性","党派偏见","对党派的忠诚"]]],null,13603,0,0,"s:partisanships",[["In this country, we rise or fall as one nation, as one people. Let's resist the temptation to fall back on the same partisanship and pettiness and immaturity that has poisoned our politics for so long.","在这个国家，我们患难与共。让我们抵制重走老路的诱惑，避免重新回到令美国政治长期深受毒害的党派纷争、小题大作、不成熟的表…"]]],"partition":[[["n.",["分割","隔离物","隔墙","财产分割"]],["v.",["区分","瓜分","隔开","分割"]],["",["分区","划分"]]],"cet6 ielts gre",9717,1,0,"d:partitioned/s:partitions/i:partitioning"],"partly":[[["adv.",["部分地","在一定程度上"]]],"gk cet4 cet6 ky",2824,3,1,[["The wall is partly covered with ivy.","墙被常青藤覆盖了一部分。"]]],"partner":[[["n.",["合伙人","股东","伙伴","伴侣"],["a person who is a member of a partnership"]],["v.",["与...合伙","组成一对","做伙伴","当助手"],["provide with a partner"]]],"gk cet4 cet6 ky",1048,4,1,"s:partners/i:partnering/d:partnered",[["Mr. Goat Butt never told me there would be a partner.","羊屁股先生可没告诉我还有搭档。"]]],"partnership":[[["n.",["合伙","合股","合作关系"]],["",["合伙(合作)关系","全体合伙人"]]],null,2912,3,1,"s:partnerships",[["We have reached a partnership agreement.","我们达成了合伙协议。"]]],"parturition":[[["n.",["分娩","生产"]]],"gre",45949,0,0,"s:parturitio