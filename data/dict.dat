elementary":[[["",["元素的","基础的","初级的"]],["adj.",["初步的","基本的"]]],"cet4 cet6 ky toefl ielts gre",2511,1,0,[["When she was in elementary school, the teacher often scolded her.","在小学的时候，她常常被老师骂。"]]],"elephant":[[["n.",["象"]]],"zk gk cet4 cet6 ky",4355,2,0,"s:elephants",[["Nobody understood why the elephant suddenly turned on its owner.","没有人明白为什么大象突然攻击了它的主人。"]]],"elephantine":[[["adj.",["象的","巨大的","粗笨的"]]],"gre",34326,0,0],"elevate":[[["v.",["举起","提拔","鼓舞"]]],"cet6 ky toefl ielts gre",6022,2,0,"d:elevated/3:elevates/i:elevating",[["Two persons were killed when an elevated bike path collapsed in Rio.","当里约热内卢的一条高架自行车道倒塌时，有2人被砸死了。"]]],"elevation":[[["n.",["海拔","提高","仰角"]]],"cet6 toefl",6693,0,0,"s:elevations",[["The treeline in the German alps lies at an elevation of about 1800 meters.","德國阿爾卑斯山的樹線位於海拔約 1800 公尺處。"]]],"elevator":[[["n.",["电梯","升降机"]],["",["提升机"]]],"cet4 cet6 ky toefl ielts",3871,1,1,"s:elevators",[["This elevator is capable of carrying 10 persons at a time.","这部电梯一次能运送10个人。"]]],"eleven":[[["num.",["十一","十一个"]]],"zk gk",4273,5,0,[["It's already eleven. It's high time you were in bed.","十一時了，你該上床睡覺了。"]]],"eleventh":[[["num.",["第十一","十一分之一"]]],null,13428,4,0,[["A stay of execution was ordered at the eleventh hour.","缓期执行在最后关头决定了下来。"]]],"elf":[[["n.",["小精灵","矮人","淘气鬼"]],["",["超低频的简写"]]],null,11795,0,0,"s:elves/p:elfed"],"elicit":[[["v.",["引出","推导出","引起"]]],"cet6 toefl ielts gre",6680,1,0,"d:elicited/i:eliciting/3:elicits",[["The suspect's apparent knowledge of details of the murder can't be used against him in this case since it was elicited by a leading question from the investigator.","嫌疑人對謀殺案細節顯然知情一事，在本案中不得作為不利於他的證據，因為這是調查人員以誘導性提問所套出的。"]]],"eligibility":[[["n.",["适任","合格","合格性"]]],null,8386,0,0,"s:eligibilities",[["The contest has very strict eligibility requirements.","參賽門檻非常高。"]]],"eligible":[[["n.",["有资格者","合格者","适任者"]],["adj.",["有资格当选的","合格的"]]],"cet6 ky toefl ielts gre",4608,2,0,[["If he were a little younger, he would be eligible for the post.","如果他年轻一点，他将很适合这个职位。"]]],"eliminate":[[["v.",["除去","排除","剔除","消除"],["kill in large numbers"]]],"cet4 cet6 ky toefl ielts gre",1838,3,0,"d:eliminated/i:eliminating/3:eliminates",[["The American mission is to eliminate communism from the world.","美国的任务是将共产主义从世界上消除。"]]],"elimination":[[["n.",["除去","消除","消灭"]],["",["消去","脱去"]]],"cet4 cet6 toefl",7330,0,0,"s:eliminations"],"elite":[[["n.",["精华","精锐","中坚分子"]]],"cet6 ky toefl ielts gre",2735,2,0,"s:elites",[["Bates, who won three gold medals at the 1984 Summer Games in Los Angeles, is one of the few elite athletes who has some idea of the stress and emotions that run through athletes like gymnast Simone Biles, who withdrew from some Olympic events at the Games in Japan, and tennis ace Naomi Osaka, who left the prestigious Wimbledon tournament in June.","貝茨曾在 1984 年洛杉磯夏季奧運會上獲得三枚金牌，他是少數幾位能夠體會到像體操運動員西蒙拜爾斯 (她在日本奧運會上…"]]],"elitism":[[["n.",["精英主义"]]],null,19496,0,0],"elitist":[[["n.",["优秀人材","杰出人材"]],["adj.",["优秀人材的","杰出人材的"]]],null,13216,1,0,"s:elitists"],"elixir":[[["n.",["炼金药","不老长寿药","万能药"]],["",["酏剂"]]],"toefl gre",19166,0,0,"s:elixirs"],"elizabethan":[[["adj.",["伊莉莎白一世时代的","伊莉莎白女王的"]],["n.",["伊莉莎白王朝时的人"]]],null,19013,1,0,"s:elizabethans",[["Indeed, a remarkable aspect of the group is the way in which, despite its romantic tone and its Elizabethan form, it yet foreshadows the movement that English drama was about to make toward a ‘realistic’ presentment of life.","確實，這組作品有一個值得關注的特點：儘管它帶有浪漫色彩、採用伊麗莎白時代的形式，卻已預示了英國戲劇即將朝向以「寫實」方…"]]],"elk":[[["n.",["麋鹿"]]],null,6392,0,0,"s:elks"],"ell":[[["n.",["厄尔(英国旧时量布的长度单位)","字母L","L形物"]]],null,18762,0,0,"s:ells"],"ellipsis":[[["n.",["省略","省略符号"]],["",["省略号"]]],"gre",33335,0,0],"elliptical":[[["adj.",["椭圆的"]],["",["椭圆形的"]]],"cet6 toefl gre",13889,0,0,[["Since the orbits are elliptical, the planets do not always have the same distance from the Sun.","由於軌道是橢圓形的，行星和太陽之間的距離不會總是相同。"]]],"elm":[[["n.",["榆树"]],["",["unix操作系统的信件处理程序"]]],"gre",14120,1,0,"s:elms",[["The arboretum includes more than 450 azaleas