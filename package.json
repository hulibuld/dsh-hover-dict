{
  "name": "dsh-hover-dict",
  "version": "0.9.0",
  "private": false,
  "description": "在 DeepSeek Harness 里点选查词与翻译：点击或划选英文单词看释义，划选纯英文句子翻译。生词本、词根词缀、同根词标注，离线词库。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client/src",
    "client/build.mjs",
    "client/test",
    "data",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "docs",
    "scripts"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node client/build.mjs",
    "build:check": "node client/build.mjs --check",
    "verify": "node --check index.js && node client/build.mjs --check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dictionary",
    "hover",
    "ecdict",
    "english",
    "vocabulary",
    "chinese"
  ],
  "author": "dsh-hover-dict contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyfon620/dsh-hover-dict.git"
  },
  "homepage": "https://github.com/joyfon620/dsh-hover-dict"
}